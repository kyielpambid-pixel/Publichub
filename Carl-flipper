local function TeleportTo(x, y, z)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		hrp.CFrame = CFrame.new(x, y + 3, z)
		setStatus("Teleported")
	end
end

local function AutoFarmLoop()
	while autoFarmEnabled do
		for _, zone in ipairs(zones) do
			if not autoFarmEnabled then break end
			BuyAllCarsInZone(zone)
			task.wait(0.1)
		end
		if autoFarmEnabled then
			RepairAllCars()
			task.wait(0.2)
		end
		if autoFarmEnabled then
			SellLowTierCars()
			task.wait(0.2)
		end
		task.wait(math.max(0.3, farmDelay))
	end
end

local function OpenGarage()
	local runtimeGui = player.PlayerGui:FindFirstChild("RuntimeGui")
	local garageBtn = runtimeGui and runtimeGui:FindFirstChild("SideBar") and runtimeGui.SideBar:FindFirstChild("Garage")
	if garageBtn and getconnections then
		pcall(function()
			for _, conn in ipairs(getconnections(garageBtn.Activated)) do
				conn:Fire()
			end
			for _, conn in ipairs(getconnections(garageBtn.MouseButton1Click)) do
				conn:Fire()
			end
		end)
		setStatus("Garage open attempted")
	else
		setStatus("Open garage manually first")
	end
end

