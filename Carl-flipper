local function selectTab(name)
	tabs._active = name
	for n, p in pairs(pages) do
		p.Visible = (n == name)
	end
	HeadTitle.Text = name
	for n, b in pairs(tabs) do
		if typeof(b) == "Instance" then
			if n == name then
				b.BackgroundColor3 = Color3.fromRGB(55, 35, 90)
				b.TextColor3 = THEME.gold
			else
				b.BackgroundColor3 = Color3.fromRGB(36, 24, 55)
				b.TextColor3 = THEME.dim
			end
		end
	end
end

for name, btn in pairs(tabs) do
	if typeof(btn) == "Instance" and btn:IsA("GuiButton") then
		local function onTab()
			selectTab(name)
		end
		btn.MouseButton1Click:Connect(onTab)
		btn.Activated:Connect(onTab)
	end
end

