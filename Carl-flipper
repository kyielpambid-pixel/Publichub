local function GetCarRarity(carName)
	if carName and CarRarity[carName] ~= nil then
		return CarRarity[carName]
	end
	return nil
end

local function GetCarName(slotIndex)
	local playerData = player:FindFirstChild("PlayerData") or ReplicatedStorage:FindFirstChild("PlayerData")
	if playerData then
		local carsFolder = playerData:FindFirstChild("Cars")
			or playerData:FindFirstChild("Inventory")
			or playerData:FindFirstChild("Garage")
		if carsFolder and carsFolder:FindFirstChild(tostring(slotIndex)) then
			local carEntry = carsFolder[tostring(slotIndex)]
			local nameValue = carEntry:FindFirstChild("CarName") or carEntry:FindFirstChild("Name")
			if nameValue and nameValue:IsA("StringValue") then
				return nameValue.Value
			elseif carEntry:IsA("StringValue") then
				return carEntry.Value
			end
		end
	end

	local runtimeGui = player.PlayerGui:FindFirstChild("RuntimeGui")
	local carList = runtimeGui
		and runtimeGui:FindFirstChild("Guis")
		and runtimeGui.Guis:FindFirstChild("Garage")
		and runtimeGui.Guis.Garage:FindFirstChild("MainFrame")
		and runtimeGui.Guis.Garage.MainFrame:FindFirstChild("GridFrame")
		and runtimeGui.Guis.Garage.MainFrame.GridFrame:FindFirstChild("GridFrame")
		and runtimeGui.Guis.Garage.MainFrame.GridFrame.GridFrame:FindFirstChild("CarList")

	if carList and carList:FindFirstChild(tostring(slotIndex)) then
		local label = carList[tostring(slotIndex)]:FindFirstChildWhichIsA("TextLabel", true)
		if label and label.Text ~= "" then
			return label.Text
		end
	end
	return nil
end

