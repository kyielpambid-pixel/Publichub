local function SellSelectedCars()
	if not SellCarRemote then
		setStatus("Sell remote missing")
		return
	end
	local sold = 0
	for slot = 1, 40 do
		local carName = GetCarName(slot)
		if carName then
			local rarity = GetCarRarity(carName)
			if rarity ~= nil and SellToggles[rarity] then
				pcall(function() SellCarRemote:FireServer(tostring(slot)) end)
				sold = sold + 1
				task.wait(0.02)
			end
		end
	end
	setStatus("Sold " .. sold .. " cars (selected rarities)")
end

local function SellLowTierCars()
	if not SellCarRemote then return end
	for slot = 1, 40 do
		local carName = GetCarName(slot)
		if carName then
			local rarity = GetCarRarity(carName)
			if rarity == 0 or rarity == 1 or rarity == 2 then
				pcall(function() SellCarRemote:FireServer(tostring(slot)) end)
				task.wait(0.02)
			end
		end
	end
end

local function BuyCarsInZone(zone)
	if not BuyCarRemote then
		setStatus("Buy remote missing")
		return
	end
	local merchants = Workspace:FindFirstChild("ActiveMerchants")
	if not merchants then
		setStatus("No ActiveMerchants")
		return
	end
	local bought = 0
	for slot = 1, 40 do
		local merchantName = nil
		for _, zoneFolder in ipairs(merchants:GetChildren()) do
			for _, merchant in ipairs(zoneFolder:GetChildren()) do
				local prompt = merchant:FindFirstChild("MerchantPrompt", true)
				if prompt
					and prompt:GetAttribute("MerchantZone") == zone
					and tostring(prompt:GetAttribute("MerchantId")) == tostring(slot) then
					merchantName = merchant.Name
					break
				end
			end
			if merchantName then break end
		end
		if merchantName then
			local rarity = GetCarRarity(merchantName)
			if rarity and BuyToggles[rarity] then
				pcall(function() BuyCarRemote:FireServer(zone, tostring(slot)) end)
				bought = bought + 1
				task.wait(0.01)
			end
		end
	end
	setStatus("Bought " .. bought .. " in " .. zone)
end

local function BuyAllCarsInZone(zone)
	if not BuyCarRemote then return end
	for slot = 1, 40 do
		pcall(function() BuyCarRemote:FireServer(zone, tostring(slot)) end)
		task.wait(0.01)
	end
end

