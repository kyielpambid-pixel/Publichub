local isUnlocked = false
local keyExpiryTime = 0

local function VerifyKey(inputKey)
    local parts = string.split(inputKey, "-")
    if #parts < 6 then return false, "Invalid key format!" end
    local expTimestamp = tonumber(parts[#parts])
    if not expTimestamp then return false, "Invalid key!" end
    if os.time() > expTimestamp then return false, "Key expired! Get a new one." end
    return true, "Key Verified!", expTimestamp
end

local function SaveKey(key)
    pcall(function() if writefile then writefile(KEY_FILE, key) end end)
end

local function ClearSavedKey()
    pcall(function()
        if isfile and isfile(KEY_FILE) and delfile then delfile(KEY_FILE)
        elseif writefile then writefile(KEY_FILE, "") end
    end)
    keyExpiryTime = 0
end

local function LoadSavedKey()
    local ok, data = pcall(function()
        if isfile and isfile(KEY_FILE) and readfile then return readfile(KEY_FILE) end
        return nil
    end)
    if ok and data and data ~= "" then
        local valid, msg, exp = VerifyKey(data)
        if valid then return data, exp end
        ClearSavedKey()
    end
    return nil, nil
end

local function FormatCountdown()
    if not keyExpiryTime or keyExpiryTime <= 0 then return "No key data" end
    local left = keyExpiryTime - os.time()
    if left <= 0 then return "EXPIRED — get new key" end
    local d = math.floor(left / 86400)
    local h = math.floor((left % 86400) / 3600)
    local m = math.floor((left % 3600) / 60)
    local s = left % 60
    if d > 0 then return string.format("%dd %02dh %02dm %02ds", d, h, m, s)
    elseif h > 0 then return string.format("%02dh %02dm %02ds", h, m, s)
    else return string.format("%02dm %02ds", m, s) end
end

do
    local sk, exp = LoadSavedKey()
    if sk and exp then
        keyExpiryTime = exp
        isUnlocked = true
        pcall(function() KeyUI:Destroy() end)
        pcall(function() KeyGui:Destroy() end)
        print("[Arin Kiyeon] Saved key valid — auto unlocked")
    end
end

if not isUnlocked then
    redeemBtn.MouseButton1Click:Connect(function()
        local input = keyBox.Text
        if not input or input == "" then
            keyStatus.Text = "Please enter a key!"
            keyStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end
        keyStatus.Text = "Verifying..."
        keyStatus.TextColor3 = Color3.fromRGB(255, 200, 80)
        task.wait(0.4)
        local valid, message, exp = VerifyKey(input)
        if valid then
            isUnlocked = true
            keyExpiryTime = exp
            SaveKey(input)
            keyStatus.Text = message .. " (Saved)"
            keyStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
            redeemBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
            redeemBtn.Text = "UNLOCKED"
            redeemBtn.Interactable = false
            keyBox.TextEditable = false
            task.wait(0.7)
            KeyUI:Destroy()
            pcall(function() KeyGui:Destroy() end)
        else
            keyStatus.Text = message
            keyStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
            if message and message:find("expired") then ClearSavedKey() end
        end
    end)
    keyBox.FocusLost:Connect(function(enter)
        if enter then redeemBtn.MouseButton1Click:Fire() end
    end)
    repeat task.wait(0.1) until isUnlocked
end

task.spawn(function()
