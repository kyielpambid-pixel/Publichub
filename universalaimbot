-- FLOATING ICON (orange / amber theme)
--==============================================================
task.spawn(function()
    local guiParent = (gethui and gethui()) or nil
    if not guiParent then pcall(function() guiParent = CoreGui end) end
    if not guiParent then guiParent = LocalPlayer:WaitForChild("PlayerGui") end

    local old = guiParent:FindFirstChild("KHUB_FloatIcon")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "KHUB_FloatIcon"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 999999
    sg.Parent = guiParent

    local btn = Instance.new("ImageButton")
    btn.Size = UDim2.fromOffset(54, 54)
    btn.Position = UDim2.new(0, 16, 0.5, -27)
    btn.BackgroundColor3 = Color3.fromRGB(40, 22, 5)
    btn.BackgroundTransparency = 0.2
    btn.Image = LOGO_ID
    btn.AutoButtonColor = false
    btn.ScaleType = Enum.ScaleType.Fit
    btn.ZIndex = 50
    btn.Parent = sg
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 2.4
    stroke.Color = Color3.fromRGB(255, 160, 40)
    stroke.Transparency = 0.1

    local fb = Instance.new("TextLabel", btn)
    fb.Size = UDim2.new(1, 0, 1, 0)
    fb.BackgroundTransparency = 1
    fb.Text = "AK"
    fb.Font = Enum.Font.GothamBold
    fb.TextSize = 14
    fb.TextColor3 = Color3.fromRGB(255, 180, 80)
    fb.ZIndex = 51
    fb.Visible = false
    task.delay(1.5, function()
        if btn.Parent and (btn.Image == "" or btn.ImageTransparency >= 1) then
            fb.Visible = true
        end
    end)

    -- Amber pulse
    task.spawn(function()
        local t = 0
        while sg.Parent do
            local pulse = 0.5 + 0.5 * math.sin(t)
            stroke.Color = Color3.fromRGB(
                255,
                math.floor(140 + 40 * pulse),
                math.floor(30 + 20 * pulse)
            )
            t = t + 0.08
            task.wait(0.04)
        end
    end)

    local dragging, dragStart, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        pcall(function()
            if Library.Toggle then Library:Toggle() end
        end)
    end)
end)

