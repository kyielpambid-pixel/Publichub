local AimStatusLabel = AimbotBox:AddLabel("Aimed: None")

local FOVCircle = nil
pcall(function()
    if Drawing and Drawing.new then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Thickness = 2
        FOVCircle.NumSides = 64
        FOVCircle.Radius = AimbotFOV
        FOVCircle.Filled = false
        FOVCircle.Color = Color3.fromRGB(255, 180, 80)
        FOVCircle.Visible = false
    end
end)

local function GetTargetAimPart(player)
    local char = player.Character
    if not char then return nil end
    if AimPartName == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local function IsVisible(part)
    if not WallCheck or not part then return true end
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(part.Parent)
end

local function IsExcluded(player)
    return ExcludedPlayers[player] == true
end

AimbotBox:AddButton({
    Text = "Exclude Selected Player",
    Func = function()
        if SelectedPlayer and SelectedPlayer ~= LocalPlayer then
            ExcludedPlayers[SelectedPlayer] = true
            Library:Notify({ Title = "Aimbot", Description = "Excluded " .. SelectedPlayer.Name, Time = 2 })
        end
    end
})

AimbotBox:AddButton({
    Text = "Clear Exclusions",
    Func = function()
        table.clear(ExcludedPlayers)
        Library:Notify({ Title = "Aimbot", Description = "Exclusions cleared", Time = 2 })
    end
})

RunService.RenderStepped:Connect(function()
    if not AimbotEnabled then
        pcall(function() if FOVCircle then FOVCircle.Visible = false end end)
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then return end

    pcall(function()
        if FOVCircle then
            FOVCircle.Visible = true
            FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            FOVCircle.Radius = AimbotFOV
        end
    end)

    local target = nil
    local closest = AimbotFOV
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not IsExcluded(plr) then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 then
                local aimPart = GetTargetAimPart(plr)
                if aimPart and IsVisible(aimPart) then
                    local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist <= closest then
                            target = plr
                            closest = dist
                        end
                    end
                end
            end
        end
    end

    CurrentAimTarget = target
    if target and target.Character then
        local aimPart = GetTargetAimPart(target)
        if aimPart then
            local desiredCF = CFrame.new(cam.CFrame.Position, aimPart.Position)
            if StrongLock then
                cam.CFrame = desiredCF
            else
                cam.CFrame = cam.CFrame:Lerp(desiredCF, 0.16)
            end
            AimbotStatusText = "Aimed: " .. target.Name
            pcall(function()
                if AimStatusLabel and AimStatusLabel.SetText then
                    AimStatusLabel:SetText("Aimed: " .. target.Name)
                end
            end)
        end
    else
        AimbotStatusText = "Aimed: None"
        pcall(function()
            if AimStatusLabel and AimStatusLabel.SetText then
                AimStatusLabel:SetText("Aimed: None")
            end
        end)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        AimbotEnabled = not AimbotEnabled
        pcall(function()
            if Library.Toggles and Library.Toggles.AimbotEnabled and Library.Toggles.AimbotEnabled.SetValue then
                Library.Toggles.AimbotEnabled:SetValue(AimbotEnabled)
            end
        end)
    end
end)

