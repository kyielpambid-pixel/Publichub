local function ApplyAmberGlow()
    pcall(function()
        if ThemeManager.SetTheme then
            -- try common names
            ThemeManager:SetTheme("Amber")
        end
    end)
    pcall(function()
        if Library.SetTheme then Library:SetTheme("Amber") end
    end)
    -- Force accent-style notify
