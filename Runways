local flowClient

local function findFlowClient()
    if flowClient and flowClient.Parent then return flowClient end
    pcall(function()
        flowClient = replicatedStorage:FindFirstChild("FlowClient")
        if flowClient then
            flowClient = flowClient:FindFirstChild("ClientRunner")
            if flowClient then
                flowClient = flowClient:FindFirstChild("Event")
            end
        end
    end)
    if not flowClient or not flowClient.Parent then
        for _, value in ipairs(replicatedStorage:GetDescendants()) do
            if value.Name == "Event" and (value:IsA("RemoteEvent") or value:IsA("UnreliableRemoteEvent")) then
                flowClient = value
                break
            end
        end
    end
    return flowClient
end

local espObjects = {}
local scanningLoot = false

task.spawn(function()
    while task.wait(1) do
        local npcList = {}
        local npcsFolder = workspace:FindFirstChild("NPCs")
        if npcsFolder then
            for _, npc in ipairs(npcsFolder:GetChildren()) do
                local humanoid = npc:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local root = npc:FindFirstChild(getgenv().AimPart)
                    root = root or npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                    if root then
                        table.insert(npcList, { Model = npc, Humanoid = humanoid, Root = root })
                    end
                end
            end
        end
        NPCList.NPCs = npcList

        if not scanningLoot and (getgenv().EspLootEnabled or KillAuraEnabled) then
            scanningLoot = true
            task.spawn(function()
                local safeList = {}
                local mapFolder = workspace:FindFirstChild("Map") or workspace
                for i, descendant in ipairs(mapFolder:GetDescendants()) do
                    if i % 150 == 0 then task.wait() end
                    local health = descendant:FindFirstChild("Health")
                    if health and (health:IsA("NumberValue") or health:IsA("IntValue")) then
                        local model = descendant:IsA("Model") and descendant
                        model = model or descendant:FindFirstAncestorOfClass("Model")
                        if not (model and players:GetPlayerFromCharacter(model)) then
                            table.insert(safeList, descendant)
                        end
                    end
                end
                NPCList.Safes = safeList
                task.wait(4)
                scanningLoot = false
            end)
        end
    end
end)

local function createESP(target, text, color, espType)
    if not target or not target.Parent then return end
    local basePart = target:IsA("BasePart") and target or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso") or target.PrimaryPart or target:FindFirstChildOfClass("BasePart")
    if not basePart then return end
    
    local hlName = "ESP_HL_" .. espType
    local bbName = "ESP_BB_" .. espType
    
    if target:FindFirstChild(hlName) or basePart:FindFirstChild(bbName) then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = hlName
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.Parent = target
    
    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Name = bbName
    billboardGui.Size = UDim2.new(0, 200, 0, 50)
    billboardGui.StudsOffset = Vector3.new(0, 3, 0)
    billboardGui.AlwaysOnTop = true
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text
    textLabel.TextColor3 = color
    textLabel.TextStrokeTransparency = 0
    textLabel.TextScaled = false
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.Code
    textLabel.Parent = billboardGui
    
    billboardGui.Parent = basePart
    
    table.insert(espObjects, { highlight = highlight, billboard = billboardGui, target = target })
end

task.spawn(function()
    while task.wait(1.5) do
        for i = #espObjects, 1, -1 do
            if not espObjects[i].target or not espObjects[i].target.Parent then
                table.remove(espObjects, i)
            end
        end
        
        if getgenv().EspNPCsEnabled then
