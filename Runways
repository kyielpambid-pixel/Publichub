                    createESP(cash, "Cash", Color3.fromRGB(50, 255, 50), "Loot")
                end
            end
            
            local lootFolder = workspace:FindFirstChild("Loot")
            if lootFolder then
                for _, loot in ipairs(lootFolder:GetChildren()) do
                    createESP(loot, loot.Name, Color3.fromRGB(0, 255, 255), "Loot")
                end
            end
            
            for _, safe in ipairs(NPCList.Safes) do
                createESP(safe, safe.Name or "Safe", Color3.fromRGB(255, 215, 0), "Loot")
            end
        end
    end
end)

local function killAuraLoop()
    while KillAuraEnabled do
        local remote = findFlowClient()
        local character = localPlayer.Character
        
        if remote and character then
            local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
            
            if rootPart then
                local position = rootPart.Position
                local hitCount = 0
                
                for _, npc in ipairs(NPCList.NPCs) do
                    if not KillAuraEnabled then break end
                    
                    if npc.Root and npc.Humanoid and npc.Humanoid.Health > 0 then
                        if (npc.Root.Position - position).Magnitude <= KillAuraRange then
                            pcall(function()
                                remote:FireServer("NPCs", "Damage", npc.Humanoid, KillAuraDamage)
                            end)
                            hitCount = hitCount + 1
                            
                            if hitCount >= 3 then
                                task.wait()
                                hitCount = 0
                                if rootPart then
                                    position = rootPart.Position
                                end
                            end
                        end
                    end
                end
                
                for _, safe in ipairs(NPCList.Safes) do
                    if not KillAuraEnabled then break end
                    
                    if safe and safe.Parent then
                        local basePart = safe:IsA("BasePart") and safe or safe:FindFirstChildOfClass("BasePart")
                        local safePosition = basePart and basePart.Position or (safe:IsA("Model") and safe:GetPivot().Position)
                        
                        if safePosition and (safePosition - position).Magnitude <= KillAuraRange then
                            pcall(function()
                                remote:FireServer("DamageToOpen", "Damage", safe, KillAuraDamage, "melee")
                            end)
                            hitCount = hitCount + 1
                            
                            if hitCount >= 3 then
                                task.wait()
                                hitCount = 0
                                if rootPart then
                                    position = rootPart.Position
                                end
                            end
                        end
                    end
                end
            end
        end
        
        task.wait(0.15)
    end
end

local function toggleKillAura(enabled)
    KillAuraEnabled = enabled
    if KillAuraEnabled then
        task.spawn(killAuraLoop)
    end
end

local function fillAmmo()
    local remote = findFlowClient()
    if not remote then return end
    
    local containers = {}
    if localPlayer:FindFirstChild("Backpack") then
        table.insert(containers, localPlayer.Backpack)
    end
    if localPlayer.Character then
        table.insert(containers, localPlayer.Character)
    end
    
    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                pcall(function()
                    remote:FireServer("Ammo", "setAmmo", item, AmmoAmount)
                end)
            end
        end
    end
end

local function autoAmmoLoop()
    while AutoAmmoEnabled do
        fillAmmo()
        task.wait(1)
    end
end

local function toggleAutoAmmo(enabled)
    AutoAmmoEnabled = enabled
    if AutoAmmoEnabled then
        task.spawn(autoAmmoLoop)
    end
end

local function freeAllGuns()
    local remote = findFlowClient()
    if not remote then return end
    
    -- Try different remote names for giving guns
    local gunRemotes = {
        "GiveGun",
        "GiveWeapon",
        "GiveItem",
        "BuyGun",
        "BuyWeapon",
        "PurchaseGun",
        "PurchaseWeapon",
        "GetGun",
        "GetWeapon",
        "FreeGun",
        "FreeWeapon",
        "SpawnGun",
        "SpawnWeapon",
    }
    
    -- Try to find gun shop items
    local shopItems = {}
    local shopFolder = workspace:FindFirstChild("Shop") or workspace:FindFirstChild("GunShop") or workspace:FindFirstChild("WeaponShop")
    
    if shopFolder then
        for _, item in ipairs(shopFolder:GetDescendants()) do
            if item:IsA("Tool") then
                table.insert(shopItems, item.Name)
            end
        end
    end
    
    -- Also check replicated storage for gun data
    pcall(function()
        local itemsFolder = replicatedStorage:FindFirstChild("Items") or replicatedStorage:FindFirstChild("Weapons") or replicatedStorage:FindFirstChild("Guns")
        if itemsFolder then
            for _, item in ipairs(itemsFolder:GetChildren()) do
                if item:IsA("Tool") then
                    table.insert(shopItems, item.Name)
                elseif item:IsA("Folder") then
                    for _, tool in ipairs(item:GetChildren()) do
                        if tool:IsA("Tool") then
                            table.insert(shopItems, tool.Name)
                        end
                    end
                end
            end
        end
    end)
    
    -- Try firing different remote names
    for _, remoteName in ipairs(gunRemotes) do
        pcall(function()
            remote:FireServer(remoteName, "all")
        end)
        pcall(function()
            remote:FireServer(remoteName)
        end)
    end
    
    -- Try common gun names
    local commonGuns = {
        "Pistol", "Revolver", "SMG", "Shotgun", "Rifle", "AK47", "M4A1",
        "Glock", "Deagle", "Uzi", "MP5", "AWP", "Sniper", "AR", "Carbine",
        "HuntingRifle", "DoubleBarrel", "PumpShotgun", "TacticalShotgun",
        "MachineGun", "Minigun", "Flamethrower", "RPG", "GrenadeLauncher",
    }
    
    for _, gunName in ipairs(commonGuns) do
        pcall(function()
            remote:FireServer("GiveGun", gunName)
        end)
        pcall(function()
            remote:FireServer("GiveWeapon", gunName)
        end)
        pcall(function()
            remote:FireServer("BuyGun", gunName)
        end)
        pcall(function()
            remote:FireServer("BuyWeapon", gunName)
        end)
    end
    
    -- Try to clone guns from workspace
    pcall(function()
        local gunFolder = workspace:FindFirstChild("Guns") or workspace:FindFirstChild("Weapons")
        if gunFolder then
            for _, gun in ipairs(gunFolder:GetChildren()) do
                if gun:IsA("Tool") and localPlayer.Backpack then
                    local clonedGun = gun:Clone()
                    clonedGun.Parent = localPlayer.Backpack
                end
            end
        end
    end)
end

runService.RenderStepped:Connect(function(deltaTime)
    pcall(function()
        local guiInset = guiService:GetGuiInset()
        local mousePos = touchEnabled and currentCamera.ViewportSize / 2 or userInputService:GetMouseLocation() - guiInset
        
        if getgenv().AimbotEnabled then
            local closestDist = math.huge
            local bestPosition = nil
            local bestPart = nil
            
            for _, npc in ipairs(NPCList.NPCs) do
                if npc.Root and npc.Humanoid and npc.Humanoid.Health > 0 then
                    local screenPos, onScreen = currentCamera:WorldToViewportPoint(npc.Root.Position)
                    
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        
                        if dist < closestDist then
                            closestDist = dist
                            bestPosition = npc.Root.Position
                            bestPart = npc.Root
                        end
                    end
                end
            end
            
            getgenv().AimbotTarget = { position = bestPosition, part = bestPart }
        else
            getgenv().AimbotTarget = { position = nil, part = nil }
        end
        
        local character = localPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and rootPart and humanoid.Health > 0 then
                if getgenv().WalkSpeedEnabled then
                    humanoid.WalkSpeed = getgenv().WalkSpeedValue
                end
                
                if getgenv().TPWalkEnabled and humanoid.MoveDirection.Magnitude > 0 then
                    rootPart.CFrame = rootPart.CFrame + humanoid.MoveDirection * (getgenv().TPWalkValue * deltaTime)
                end
            end
        end
    end)
end)

if not getgenv().AimbotHooked then
    getgenv().AimbotHooked = true
    
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        if not checkcaller() and getgenv().AimbotEnabled and getgenv().AimbotTarget.position then
            if (method == "Raycast" or method == "raycast") and self == workspace then
                local args = { ... }
                if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                    args[2] = (getgenv().AimbotTarget.position - args[1]).Unit * args[2].Magnitude
                    return oldNamecall(self, unpack(args))
                end
                return oldNamecall(self, ...)
            end
            
            if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                local args = { ... }
                if typeof(args[1]) == "Ray" then
                    local origin = args[1].Origin
                    args[1] = Ray.new(origin, (getgenv().AimbotTarget.position - origin).Unit * args[1].Direction.Magnitude)
                    return oldNamecall(self, unpack(args))
                end
                return oldNamecall(self, ...)
            end
            
            return oldNamecall(self, ...)
        end
        
        return oldNamecall(self, ...)
    end))
    
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if not checkcaller() and getgenv().AimbotEnabled and getgenv().AimbotTarget.position then
            if key == "Hit" or key == "hit" then
                if typeof(self) == "Instance" and self:IsA("Mouse") then
                    return CFrame.new(getgenv().AimbotTarget.position)
                end
                return oldIndex(self, key)
            end
            
            if key == "Target" or key == "target" then
                if typeof(self) == "Instance" and self:IsA("Mouse") then
                    return getgenv().AimbotTarget.part
                end
                return oldIndex(self, key)
            end
            
            return oldIndex(self, key)
        end
        
        return oldIndex(self, key)
    end))
end

