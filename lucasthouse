-- ==================== UTILITY ====================
local function isAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChildWhichIsA("BasePart")
end

local function ClearDrawing(obj)
    if Drawings[obj] then
        pcall(function() Drawings[obj]:Remove() end)
        Drawings[obj] = nil
    end
end

local function ClearAllDrawings()
    for obj in pairs(Drawings) do ClearDrawing(obj) end
end

local function CreateText(obj, color)
    if Drawings[obj] then return Drawings[obj] end
    local ok, text = pcall(function()
        local t = Drawing.new("Text")
        t.Size = Settings.TextSize
        t.Color = color
        t.Center = true
        t.Outline = true
        t.OutlineColor = Color3.new(0, 0, 0)
        t.Visible = false
        return t
    end)
    if ok and text then
        Drawings[obj] = text
        return text
    end
end

-- ==================== ESP (Second Code Style) ====================
local function UpdateESP()
    local camPos = Camera.CFrame.Position
    local seen = {}

    if Settings.LocustESP then
        local entities = Workspace:FindFirstChild("Entities")
        local list = entities and entities:GetChildren() or Workspace:GetDescendants()
        for _, model in ipairs(list) do
            if model:IsA("Model") and string.lower(model.Name) == "locust" then
                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                if root then
                    seen[model] = true
                    local text = CreateText(model, Settings.LocustColor)
                    if text then
                        local worldPos = root.Position
                        local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
                        local distance = (worldPos - camPos).Magnitude
                        if onScreen and distance <= Settings.MaxDistance then
                            text.Position = Vector2.new(screenPos.X, screenPos.Y)
                            text.Text = Settings.ShowDistance and string.format("Locust [%.0fm]", distance) or "Locust"
                            text.Color = Settings.LocustColor
                            text.Visible = true
                        else
                            text.Visible = false
                        end
                    end
                    if not Highlights[model] then
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Settings.LocustColor
                        hl.OutlineColor = Color3.new(1, 1, 1)
                        hl.FillTransparency = 0.5
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = model
                        Highlights[model] = hl
                    end
                end
            end
        end
    end

    if Settings.CubeESP then
        for _, obj in ipairs(Workspace:GetChildren()) do
            local color = CubeColors[obj.Name] or Settings.CubeColor
            if CubeColors[obj.Name] and (obj:IsA("Model") or obj:IsA("BasePart")) then
                local root = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if root then
                    seen[obj] = true
                    local text = CreateText(obj, color)
                    if text then
                        local worldPos = root.Position
                        local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
                        local distance = (worldPos - camPos).Magnitude
                        if onScreen and distance <= Settings.MaxDistance then
                            text.Position = Vector2.new(screenPos.X, screenPos.Y)
                            local displayName = obj.Name:gsub("Cube", "")
                            text.Text = Settings.ShowDistance and string.format("%s [%.0fm]", displayName, distance) or displayName
                            text.Color = color
                            text.Visible = true
                        else
                            text.Visible = false
                        end
                    end
                end
            end
        end
    end

    if Settings.DoorESP then
        local doorNames = {"ExitDoor", "DoorWire", "Keyhole", "KeycardReader"}
        for _, doorName in ipairs(doorNames) do
            local door = Workspace:FindFirstChild(doorName)
            if door then
                local root = door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")) or door
                if root and root:IsA("BasePart") then
                    seen[door] = true
                    local text = CreateText(door, Settings.DoorColor)
                    if text then
                        local worldPos = root.Position
                        local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
                        local distance = (worldPos - camPos).Magnitude
                        if onScreen and distance <= Settings.MaxDistance then
                            text.Position = Vector2.new(screenPos.X, screenPos.Y)
                            text.Text = Settings.ShowDistance and string.format("%s [%.0fm]", doorName, distance) or doorName
                            text.Color = Settings.DoorColor
                            text.Visible = true
                        else
                            text.Visible = false
                        end
                    end
                end
            end
        end
    end

    if Settings.WireCutterESP then
        local wc = Workspace:FindFirstChild("WireCutter")
        if wc then
            local part = wc:FindFirstChild("Handle") or wc:FindFirstChildWhichIsA("BasePart")
            if part and part:IsA("BasePart") then
                seen[wc] = true
                local text = CreateText(wc, Settings.WireCutterColor)
                if text then
                    local worldPos = part.Position
                    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
                    local distance = (worldPos - camPos).Magnitude
                    if onScreen and distance <= Settings.MaxDistance then
                        text.Position = Vector2.new(screenPos.X, screenPos.Y)
                        text.Text = Settings.ShowDistance and string.format("WireCutter [%.0fm]", distance) or "WireCutter"
                        text.Color = Settings.WireCutterColor
                        text.Visible = true
                    else
                        text.Visible = false
                    end
                end
            end
        end
    end

    if Settings.KeycardESP then
        local entities = Workspace:FindFirstChild("Entities")
        if entities then
            for _, obj in ipairs(entities:GetChildren()) do
                if obj.Name == "Locust" and obj:IsA("Model") then
                    local handle = obj:FindFirstChild("Handle")
                    if handle and handle:FindFirstChildWhichIsA("ProximityPrompt") then
                        seen[handle] = true
                        local text = CreateText(handle, Settings.KeycardColor)
                        if text then
                            local worldPos = handle.Position
                            local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
                            local distance = (worldPos - camPos).Magnitude
                            if onScreen and distance <= Settings.MaxDistance then
                                text.Position = Vector2.new(screenPos.X, screenPos.Y)
                                text.Text = Settings.ShowDistance and string.format("Keycard [%.0fm]", distance) or "Keycard"
                                text.Color = Settings.KeycardColor
                                text.Visible = true
                            else
                                text.Visible = false
                            end
                        end
                    end
                end
            end
        end
    end

    for obj in pairs(Drawings) do
        if not seen[obj] then
            ClearDrawing(obj)
            if Highlights[obj] then
                pcall(function() Highlights[obj]:Destroy() end)
                Highlights[obj] = nil
            end
        end
    end
end

