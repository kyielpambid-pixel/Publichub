local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Settings = {LocustESP = false, CubeESP = false, DoorESP = false, TPWalk = false, Fullbright = false, NoFog = false, TextSize = 12, LocustColor = Color3.fromRGB(255, 50, 50), DoorColor = Color3.fromRGB(0, 255, 100), MaxDistance = 2000, ShowDistance = true, TPWalkSpeed = 18}
local CubeColors = {["CubeBlue"] = Color3.fromRGB(0, 150, 255), ["CubeRed"] = Color3.fromRGB(255, 50, 50), ["CubeYellow"] = Color3.fromRGB(255, 220, 0), ["CubeGreen"] = Color3.fromRGB(0, 255, 100), ["CubeCyan"] = Color3.fromRGB(0, 255, 255), ["CubePink"] = Color3.fromRGB(255, 100, 200), ["CubePurple"] = Color3.fromRGB(180, 80, 255), ["CubeOrange"] = Color3.fromRGB(255, 140, 0), ["CubeWhite"] = Color3.fromRGB(255, 255, 255), ["CubeBlack"] = Color3.fromRGB(80, 80, 80)}
local Drawings = {}
local OriginalLighting = {Brightness = Lighting.Brightness, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, GlobalShadows = Lighting.GlobalShadows}
local function ClearDrawing(obj) if Drawings[obj] then pcall(function() Drawings[obj]:Remove() end) Drawings[obj] = nil end end
local function ClearAll() for obj, _ in pairs(Drawings) do ClearDrawing(obj) end end
local function CreateText(obj, defaultText, color) if Drawings[obj] then return end local text = Drawing.new("Text") text.Text = defaultText text.Size = Settings.TextSize text.Color = color text.Center = true text.Outline = true text.OutlineColor = Color3.new(0, 0, 0) text.Visible = false Drawings[obj] = text end
local function UpdateESP()
    local camPos = Camera.CFrame.Position
    local seen = {}
    if Settings.LocustESP then
        local entities = workspace:FindFirstChild("Entities")
        if entities then for _, model in ipairs(entities:GetChildren()) do if model.Name == "Locust" and model:IsA("Model") then local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart") if root then seen[model] = true CreateText(model, "Locust", Settings.LocustColor) local text = Drawings[model] local worldPos = root.Position local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos) local distance = (worldPos - camPos).Magnitude if onScreen and distance <= Settings.MaxDistance then text.Position = Vector2.new(screenPos.X, screenPos.Y) text.Text = Settings.ShowDistance and string.format("Locust [%.0fm]", distance) or "Locust" text.Visible = true else text.Visible = false end end end end end
    end
    if Settings.CubeESP then
        for _, obj in ipairs(workspace:GetChildren()) do
            local color = CubeColors[obj.Name]
            if color and (obj:IsA("Model") or obj:IsA("BasePart")) then
                local root = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if root then seen[obj] = true CreateText(obj, obj.Name, color) local text = Drawings[obj] local worldPos = root.Position local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos) local distance = (worldPos - camPos).Magnitude if onScreen and distance <= Settings.MaxDistance then text.Position = Vector2.new(screenPos.X, screenPos.Y) local displayName = obj.Name:gsub("Cube", "") text.Text = Settings.ShowDistance and string.format("%s [%.0fm]", displayName, distance) or displayName text.Visible = true else text.Visible = false end end
            end
        end
    end
    if Settings.DoorESP then
        local door = workspace:FindFirstChild("ExitDoor")
        if door then local root = door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")) or door if root and root:IsA("BasePart") then seen[door] = true CreateText(door, "Exit Door", Settings.DoorColor) local text = Drawings[door] local worldPos = root.Position local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos) local distance = (worldPos - camPos).Magnitude if onScreen and distance <= Settings.MaxDistance then text.Position = Vector2.new(screenPos.X, screenPos.Y) text.Text = Settings.ShowDistance and string.format("Exit Door [%.0fm]", distance) or "Exit Door" text.Visible = true else text.Visible = false end end
        end
    end
    for obj, _ in pairs(Drawings) do if not seen[obj] then ClearDrawing(obj) end end
end
local tpwalkConnection
local function ToggleTPWalk(state)
    Settings.TPWalk = state
    if tpwalkConnection then tpwalkConnection:Disconnect() tpwalkConnection = nil end
    if state then tpwalkConnection = RunService.Heartbeat:Connect(function(dt) local character = LocalPlayer.Character if not character then return end local humanoid = character:FindFirstChildOfClass("Humanoid") local root = character:FindFirstChild("HumanoidRootPart") if not humanoid or not root or humanoid.MoveDirection.Magnitude == 0 then return end root.CFrame = root.CFrame + (humanoid.MoveDirection * Settings.TPWalkSpeed * dt) end) end
end
local function ToggleFullbright(state)
    Settings.Fullbright = state
    if state then Lighting.Brightness = 2 Lighting.Ambient = Color3.fromRGB(180, 180, 180) Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180) Lighting.GlobalShadows = false else Lighting.Brightness = OriginalLighting.Brightness Lighting.Ambient = OriginalLighting.Ambient Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient Lighting.GlobalShadows = OriginalLighting.GlobalShadows end
end
local function ToggleNoFog(state)
    Settings.NoFog = state
    if state then Lighting.FogEnd = 100000 Lighting.FogStart = 0 else Lighting.FogEnd = OriginalLighting.FogEnd Lighting.FogStart = OriginalLighting.FogStart end
end
local function TeleportToDoor()
    local door = workspace:FindFirstChild("ExitDoor") if not door then return end local root = door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")) or door if not root then return end local character = LocalPlayer.Character if not character then return end local hrp = character:FindFirstChild("HumanoidRootPart") if not hrp then return end hrp.CFrame = root.CFrame + Vector3.new(0, 3, 0)
end
local Window = WindUI:CreateWindow({Title = "KHUB", Icon = "bug", Author = "KHUB", Folder = "KHUB", Size = UDim2.fromOffset(320, 300), Transparent = true, Theme = "Dark", Resizable = false, SideBarWidth = 100})
local MainTab = Window:Tab({Title = "Main", Icon = "home"})
MainTab:Toggle({Title = "Fullbright", Value = false, Callback = function(value) ToggleFullbright(value) end})
MainTab:Toggle({Title = "NoFog", Value = false, Callback = function(value) ToggleNoFog(value) end})
MainTab:Button({Title = "Escape", Callback = function() TeleportToDoor() end})
MainTab:Paragraph({Title = "Door needs to be opened"})
local ESPTab = Window:Tab({Title = "ESP", Icon = "eye"})
ESPTab:Toggle({Title = "Locust ESP", Value = false, Callback = function(value) Settings.LocustESP = value if not value and not Settings.CubeESP and not Settings.DoorESP then ClearAll() end end})
ESPTab:Toggle({Title = "Cube ESP", Value = false, Callback = function(value) Settings.CubeESP = value if not value and not Settings.LocustESP and not Settings.DoorESP then ClearAll() end end})
ESPTab:Toggle({Title = "Door ESP", Value = false, Callback = function(value) Settings.DoorESP = value if not value and not Settings.LocustESP and not Settings.CubeESP then ClearAll() end end})
ESPTab:Toggle({Title = "Show Distance", Value = true, Callback = function(value) Settings.ShowDistance = value end})
ESPTab:Slider({Title = "ESP Max Distance", Value = {Min = 100, Max = 5000, Default = 2000}, Callback = function(value) Settings.MaxDistance = value end})
ESPTab:Colorpicker({Title = "Locust Color", Default = Color3.fromRGB(255, 50, 50), Callback = function(color) Settings.LocustColor = color end})
ESPTab:Colorpicker({Title = "Door Color", Default = Color3.fromRGB(0, 255, 100), Callback = function(color) Settings.DoorColor = color end})
local PlayerTab = Window:Tab({Title = "Player", Icon = "user"})
PlayerTab:Toggle({Title = "TPWalk", Value = false, Callback = function(value) ToggleTPWalk(value) end})
RunService.RenderStepped:Connect(UpdateESP)
print("[KHUB] Loaded")
