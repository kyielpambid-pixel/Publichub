    if cabinetConn then cabinetConn:Disconnect() cabinetConn = nil end
    if state then
        cabinetConn = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
