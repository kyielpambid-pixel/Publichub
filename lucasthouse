addToggle(pageSet, "FPS & Ping Overlay", 0, false, function(v)
	statsOverlay.Visible = v
	if statsConn then statsConn:Disconnect() statsConn = nil end
	if v then
		local lastTime, frameCount = tick(), 0
		statsConn = RunService.RenderStepped:Connect(function()
			frameCount = frameCount + 1
			local now = tick()
			if now - lastTime >= 1 then
				local fps = frameCount
				frameCount = 0
				lastTime = now
				local ping = 0
				pcall(function()
					ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
				end)
				statsOverlay.Text = string.format("FPS: %d | Ping: %d", fps, ping)
			end
		end)
	end
end)
