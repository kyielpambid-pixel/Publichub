local function TeleportToDoor()
	local door = Workspace:FindFirstChild("ExitDoor")
	if not door then return end
	local root = door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")) or door
	if not root then return end
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.CFrame = root.CFrame + Vector3.new(0, 3, 0) end
end

local function TeleportSafeZone()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local spawnLocation
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("SpawnLocation") then
			spawnLocation = v
			break
		end
	end
	char.HumanoidRootPart.CFrame = (spawnLocation and spawnLocation.CFrame or CFrame.new(0, 10, 0)) + Vector3.new(0, 3, 0)
end

local function AutoSolveCubes()
	local function move(cubeName, detName)
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name == cubeName then
				for _, det in ipairs(Workspace:GetDescendants()) do
					if det.Name == detName then
						local targetPos = (det:IsA("Model") and det:GetPivot() or det.CFrame) + Vector3.new(0, 2.5, 0)
						if obj:IsA("Model") then
							obj:PivotTo(targetPos)
						elseif obj:IsA("BasePart") then
							obj.CFrame = targetPos
						end
					end
				end
			end
		end
	end
	move("CubeRed", "RedDetector")
	move("CubeYellow", "YellowDetector")
	move("CubeBlue", "BlueDetector")
end

local function ToggleCabinetESP(state)
	Settings.CabinetESP = state
	if cabinetConn then cabinetConn:Disconnect() cabinetConn = nil end
	if state then
		cabinetConn = RunService.RenderStepped:Connect(function()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			for _, obj in ipairs(Workspace:GetDescendants()) do
				local name = string.lower(obj.Name)
				if (name:find("cabinet") or name:find("drawer")) and obj:IsA("Model") then
					if not obj:FindFirstChild("LootedMarker") then
						local objPos = obj:GetPivot().Position
						if hrp and (hrp.Position - objPos).Magnitude <= 6.5 then
							local tag = Instance.new("BoolValue")
							tag.Name = "LootedMarker"
							tag.Parent = obj
							if obj:FindFirstChild("CabinetHL") then obj.CabinetHL:Destroy() end
						else
							if not obj:FindFirstChild("CabinetHL") then
								local hl = Instance.new("Highlight")
								hl.Name = "CabinetHL"
								hl.FillColor = Color3.fromRGB(0, 255, 100)
								hl.OutlineColor = Color3.fromRGB(255, 255, 255)
								hl.FillTransparency = 0.5
								hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								hl.Parent = obj
							end
						end
					end
				end
			end
		end)
	else
		for _, obj in ipairs(Workspace:GetDescendants()) do
			local hl = obj:FindFirstChild("CabinetHL")
			if hl then hl:Destroy() end
		end
	end
end

local function TogglePlayerESP(state)
	Settings.PlayerESP = state
	if playerEspConn then playerEspConn:Disconnect() playerEspConn = nil end
	if state then
		playerEspConn = RunService.RenderStepped:Connect(function()
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player and p.Character then
					local char = p.Character
					local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
					if head then
						if not char:FindFirstChild("PEspHL") then
							local hl = Instance.new("Highlight")
							hl.Name = "PEspHL"
							hl.FillColor = Color3.fromRGB(0, 150, 255)
							hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							hl.Parent = char
						end
						if not head:FindFirstChild("PlayerNameTag") then
							local bg = Instance.new("BillboardGui")
							bg.Name = "PlayerNameTag"
							bg.Size = UDim2.new(0, 120, 0, 30)
							bg.StudsOffset = Vector3.new(0, 2.5, 0)
							bg.AlwaysOnTop = true
							bg.Adornee = head
							bg.Parent = head
							local txt = Instance.new("TextLabel")
							txt.Size = UDim2.new(1, 0, 1, 0)
							txt.BackgroundTransparency = 1
							txt.Text = p.Name
							txt.TextColor3 = Color3.fromRGB(0, 180, 255)
							txt.TextStrokeTransparency = 0.4
							txt.Font = Enum.Font.GothamBold
							txt.TextSize = 14
							txt.Parent = bg
						end
					end
				end
			end
		end)
	else
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				if p.Character:FindFirstChild("PEspHL") then p.Character.PEspHL:Destroy() end
				local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
				if head and head:FindFirstChild("PlayerNameTag") then head.PlayerNameTag:Destroy() end
			end
		end
	end
end

