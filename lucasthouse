local function ClearDrawing(obj)
	if Drawings[obj] then
		pcall(function() Drawings[obj]:Remove() end)
		Drawings[obj] = nil
	end
end

local function ClearAllDrawings()
	for obj in pairs(Drawings) do ClearDrawing(obj) end
end

local function CreateText(obj, color)
	if Drawings[obj] then return Drawings[obj] end
	local ok, text = pcall(function()
		local t = Drawing.new("Text")
		t.Size = Settings.TextSize
		t.Color = color
		t.Center = true
		t.Outline = true
		t.OutlineColor = Color3.new(0, 0, 0)
		t.Visible = false
		return t
	end)
	if ok and text then
		Drawings[obj] = text
		return text
	end
end

local function UpdateESP()
	local camPos = Camera.CFrame.Position
	local seen = {}

	if Settings.LocustESP then
		local entities = Workspace:FindFirstChild("Entities")
		local list = entities and entities:GetChildren() or Workspace:GetDescendants()
		for _, model in ipairs(list) do
			if model:IsA("Model") and string.lower(model.Name) == "locust" then
				local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
				if root then
					seen[model] = true
					local text = CreateText(model, Settings.LocustColor)
					if text then
						local worldPos = root.Position
						local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
						local distance = (worldPos - camPos).Magnitude
						if onScreen and distance <= Settings.MaxDistance then
							text.Position = Vector2.new(screenPos.X, screenPos.Y)
							text.Text = Settings.ShowDistance and string.format("Locust [%.0fm]", distance) or "Locust"
							text.Color = Settings.LocustColor
							text.Visible = true
						else
							text.Visible = false
						end
					end
					if not Highlights[model] then
						local hl = Instance.new("Highlight")
						hl.FillColor = Settings.LocustColor
						hl.OutlineColor = Color3.new(1, 1, 1)
						hl.FillTransparency = 0.5
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.Parent = model
						Highlights[model] = hl
					end
				end
			end
		end
	end

	if Settings.CubeESP then
		for _, obj in ipairs(Workspace:GetChildren()) do
			local color = CubeColors[obj.Name]
			if color and (obj:IsA("Model") or obj:IsA("BasePart")) then
				local root = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
				if root then
					seen[obj] = true
					local text = CreateText(obj, color)
					if text then
						local worldPos = root.Position
						local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
						local distance = (worldPos - camPos).Magnitude
						if onScreen and distance <= Settings.MaxDistance then
							text.Position = Vector2.new(screenPos.X, screenPos.Y)
							local displayName = obj.Name:gsub("Cube", "")
							text.Text = Settings.ShowDistance and string.format("%s [%.0fm]", displayName, distance) or displayName
							text.Color = color
							text.Visible = true
						else
							text.Visible = false
						end
					end
				end
			end
		end
	end

	if Settings.DoorESP then
		local door = Workspace:FindFirstChild("ExitDoor")
		if door then
			local root = door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")) or door
			if root and root:IsA("BasePart") then
				seen[door] = true
				local text = CreateText(door, Settings.DoorColor)
				if text then
					local worldPos = root.Position
					local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
					local distance = (worldPos - camPos).Magnitude
					if onScreen and distance <= Settings.MaxDistance then
						text.Position = Vector2.new(screenPos.X, screenPos.Y)
						text.Text = Settings.ShowDistance and string.format("Exit Door [%.0fm]", distance) or "Exit Door"
						text.Color = Settings.DoorColor
						text.Visible = true
					else
						text.Visible = false
					end
				end
			end
		end
	end

	for obj in pairs(Drawings) do
		if not seen[obj] then
			ClearDrawing(obj)
			if Highlights[obj] then
				pcall(function() Highlights[obj]:Destroy() end)
				Highlights[obj] = nil
			end
		end
	end
end

local function ToggleTPWalk(state)
	Settings.TPWalk = state
	if tpwalkConnection then
		tpwalkConnection:Disconnect()
		tpwalkConnection = nil
	end
	if state then
		tpwalkConnection = RunService.Heartbeat:Connect(function(dt)
			local character = LocalPlayer.Character
			if not character then return end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local root = character:FindFirstChild("HumanoidRootPart")
			if not humanoid or not root or humanoid.MoveDirection.Magnitude == 0 then return end
			root.CFrame = root.CFrame + (humanoid.MoveDirection * Settings.TPWalkSpeed * dt)
		end)
	end
end

local function ToggleFullbright(state)
