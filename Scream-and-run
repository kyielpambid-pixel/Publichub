local OriginalPromptTimes = {}
local PromptConnection = nil
local function MakePromptInstant(prompt)
	if not prompt:IsA("ProximityPrompt") then return end
	if OriginalPromptTimes[prompt] == nil then
		OriginalPromptTimes[prompt] = prompt.HoldDuration
	end
	prompt.HoldDuration = 0
end
local function SetInstantPrompts(enabled)
	Config.Auto.InstantPrompts = enabled
	if enabled then
		for _, object in ipairs(Workspace:GetDescendants()) do
			if object:IsA("ProximityPrompt") then MakePromptInstant(object) end
		end
		if PromptConnection then PromptConnection:Disconnect() end
		PromptConnection = Workspace.DescendantAdded:Connect(function(object)
			if Config.Auto.InstantPrompts and object:IsA("ProximityPrompt") then
				task.defer(function()
					if object.Parent then MakePromptInstant(object) end
				end)
			end
		end)
	else
		if PromptConnection then PromptConnection:Disconnect(); PromptConnection = nil end
		for prompt, oldTime in pairs(OriginalPromptTimes) do
			if prompt.Parent then prompt.HoldDuration = oldTime end
		end
		table.clear(OriginalPromptTimes)
	end
end

local function TriggerPrompt(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end
	if type(fireproximityprompt) == "function" then
		local success = pcall(fireproximityprompt, prompt)
		if success then return true end
	end
	local success = pcall(function()
		prompt:InputHoldBegin()
		if Config.Auto.InstantPrompts then
			task.wait(Config.Search.PressTime)
		else
			task.wait(math.max(prompt.HoldDuration, Config.Search.PressTime))
		end
		prompt:InputHoldEnd()
	end)
	return success
end

local function TeleportToBackpack(info)
	if not info or not info.Handle or not info.Handle.Parent then return false, 0 end
	local position, monsterDistance = FindSafestCirclePosition(info.Handle, Config.Search.Radius, Config.Search.Height, 12)
	if not position then return false, 0 end
	if monsterDistance < Config.Search.MinimumCatDistance then return false, monsterDistance end
	return TeleportCharacter(FaceTarget(position, info.Handle.Position)), monsterDistance
end

local function SearchBackpack(info)
	if not info or not info.Handle.Parent or not info.Prompt.Parent then return true end
	local moved, monsterDistance = TeleportToBackpack(info)
	if not moved then return false, monsterDistance end
	task.wait(Config.Search.TeleportDelay)
	local root = GetRoot()
	if root then
		local newDistance = DistanceFromClosestMonster(root.Position)
		if newDistance < Config.Search.MinimumCatDistance then return false, newDistance end
	end
	StopVelocity()
	for _ = 1, Config.Search.Attempts do
		if not Config.Auto.SearchBackpacks then return false, 0 end
		if not info.Prompt.Parent or not info.Handle.Parent then return true, math.huge end
		TriggerPrompt(info.Prompt)
		task.wait(Config.Search.AfterPrompt)
		if not info.Prompt.Parent or not info.Prompt.Enabled then return true, math.huge end
	end
	return true, math.huge
end

local function UpdateSafeLocation()
	if Searching or SafetyBusy then return end
	local root = GetRoot()
	if not root then return end
	local now = os.clock()
	if now - LastSafeSave < Config.Safety.SaveInterval then return end
	LastSafeSave = now
	local monsterDistance = DistanceFromClosestMonster(root.Position)
	if monsterDistance >= Config.Safety.RecordDistance then
		LastSafeCFrame = root.CFrame
	end
end

local function ReturnAfterSearch()
	local root = GetRoot()
	if not root then return end
	if SearchStartCFrame then
		local distance = DistanceFromClosestMonster(SearchStartCFrame.Position)
		if distance >= 35 then
			TeleportCharacter(SearchStartCFrame)
			return
		end
	end
	if LastSafeCFrame then
		local distance = DistanceFromClosestMonster(LastSafeCFrame.Position)
		if distance >= 35 then
			TeleportCharacter(LastSafeCFrame)
			return
		end
	end
	if DistanceFromClosestMonster(root.Position) >= 35 then return end
	local safestLock = FindSafestLock()
	if safestLock then TeleportToLock(safestLock) end
end

local function AutoSearchBackpacks()
	if Searching then return end
	local root = GetRoot()
	if not root then return end
	Searching = true
	SearchStartCFrame = root.CFrame
	local waiting = GetBackpacks()
	local total, searched, dangerRounds = #waiting, 0, 0
	while Config.Auto.SearchBackpacks and #waiting > 0 do
		local madeProgress = false
		local nextRound = {}
		for _, info in ipairs(waiting) do
			if not Config.Auto.SearchBackpacks then break end
			local success, monsterDistance = SearchBackpack(info)
			if success then
				searched = searched + 1
				madeProgress = true
			else
				table.insert(nextRound, info)
				if monsterDistance and monsterDistance < Config.Search.MinimumCatDistance then
					task.wait(0.03)
				end
			end
			task.wait(Config.Search.BetweenBackpacks)
		end
		waiting = nextRound
		if #waiting == 0 then break end
		dangerRounds = dangerRounds + 1
		if dangerRounds >= Config.Search.MaxDangerRounds then break end
		if not madeProgress then
			task.wait(Config.Search.DangerRetryDelay)
		else
			task.wait(0.08)
		end
	end
	Config.Auto.SearchBackpacks = false
	Searching = false
	ReturnAfterSearch()
	print("[KHUB] Auto Search finished", searched, "/", total)
end

local function AutoSafetyUpdate()
	UpdateSafeLocation()
	if not Config.Auto.AutoSafety then return end
	if Searching or SafetyBusy then return end
	local monster, distance = GetNearestMonster()
	if not monster then return end
	if distance > Config.Safety.DangerDistance then return end
	if os.clock() - LastSafetyTeleport < Config.Safety.Cooldown then return end
	SafetyBusy = true
	LastSafetyTeleport = os.clock()
	if LastSafeCFrame then
		local currentSafety = DistanceFromClosestMonster(LastSafeCFrame.Position)
		if currentSafety >= Config.Safety.DangerDistance then
			TeleportCharacter(LastSafeCFrame)
			task.wait(0.05)
			SafetyBusy = false
			return
		end
	end
	local lock = FindSafestLock()
	if lock then
		TeleportToLock(lock)
		task.wait(0.05)
		local _, afterDistance = GetNearestMonster()
		if afterDistance > Config.Safety.DangerDistance then
			SafetyBusy = false
			return
		end
	end
	local bestBackpack, bestDistance = nil, -math.huge
	for _, info in ipairs(GetBackpacks()) do
		local position, distance = FindSafestCirclePosition(info.Handle, Config.Search.Radius, Config.Search.Height, 12)
		if position and distance > bestDistance then
			bestDistance = distance
			bestBackpack = { Info = info, Position = position }
		end
	end
	if bestBackpack and bestDistance > Config.Safety.DangerDistance then
		TeleportCharacter(FaceTarget(bestBackpack.Position, bestBackpack.Info.Handle.Position))
	end
	SafetyBusy = false
end

-- ========== AUTO PLACE KEYS ON LOCK ==========
-- When player has keys: go to matching lock, place, then stop when done

local PlaceBusy = false

local function IsKeyName(name)
	name = string.lower(tostring(name or ""))
	return name:find("key") ~= nil
end

local function GetPlayerKeys()
	local keys = {}
	local function scan(container)
		if not container then return end
		for _, obj in ipairs(container:GetChildren()) do
			if obj:IsA("Tool") and IsKeyName(obj.Name) then
				table.insert(keys, obj)
			end
		end
	end
	scan(player:FindFirstChild("Backpack"))
	scan(player.Character)
	return keys
end

local function GetKeyColorHint(key)
	local n = string.lower(key.Name)
	if n:find("green") then return "green" end
	if n:find("red") then return "red" end
	if n:find("white") or n:find("silver") then return "white" end
	if n:find("blue") then return "blue" end
	if n:find("yellow") or n:find("gold") then return "yellow" end
	return nil
end

local function MatchLockForKey(key)
	local hint = GetKeyColorHint(key)
	local locks = GetLocks()
	if #locks == 0 then return nil end
	if hint then
		for _, lockInfo in ipairs(locks) do
			if string.lower(lockInfo.Name):find(hint) then
				return lockInfo
			end
		end
	end
	-- fallback nearest lock
	local root = GetRoot()
	if not root then return locks[1] end
	local best, bestD = nil, math.huge
	for _, lockInfo in ipairs(locks) do
		local d = (root.Position - lockInfo.Part.Position).Magnitude
		if d < bestD then bestD = d; best = lockInfo end
	end
	return best
end

local function FindLockPrompt(lockInfo)
	if not lockInfo or not lockInfo.Container then return nil end
	for _, d in ipairs(lockInfo.Container:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local action = string.lower(tostring(d.ActionText) .. " " .. tostring(d.ObjectText) .. " " .. d.Name)
			if action:find("key") or action:find("unlock") or action:find("insert") or action:find("use") or action:find("lock") or true then
				return d
			end
		end
	end
	if lockInfo.Part then
		for _, d in ipairs(lockInfo.Part:GetDescendants()) do
			if d:IsA("ProximityPrompt") then return d end
		end
		local p = lockInfo.Part:FindFirstChildOfClass("ProximityPrompt")
		if p then return p end
	end
	return nil
end

local function EquipKey(key)
	local character = GetCharacter()
	if not character or not key then return false end
	pcall(function()
		-- unequip others
		for _, t in ipairs(character:GetChildren()) do
			if t:IsA("Tool") and t ~= key then
				t.Parent = player.Backpack
			end
		end
		key.Parent = character
	end)
	return key.Parent == character
end

local function PlaceOneKey(key)
	if not key or not key.Parent then return false end
	local lockInfo = MatchLockForKey(key)
	if not lockInfo then
		print("[KHUB] No lock found for", key.Name)
		return false
	end
	EquipKey(key)
	task.wait(0.15)
	TeleportToLock(lockInfo)
	task.wait(0.2)
	StopVelocity()
	local prompt = FindLockPrompt(lockInfo)
	if prompt then
		TriggerPrompt(prompt)
		task.wait(0.15)
		TriggerPrompt(prompt)
	end
	-- also try activating tool
	pcall(function()
		if key.Parent == GetCharacter() then
			key:Activate()
		end
	end)
	-- click detectors on lock
	for _, d in ipairs(lockInfo.Container:GetDescendants()) do
		if d:IsA("ClickDetector") and type(fireclickdetector) == "function" then
			pcall(fireclickdetector, d)
		end
	end
	task.wait(0.35)
	-- success if key left inventory (consumed) or still try next
	local stillHas = false
	for _, k in ipairs(GetPlayerKeys()) do
		if k == key then stillHas = true break end
	end
	print("[KHUB] Placed key", key.Name, "on", lockInfo.Name, stillHas and "(still holding)" or "(consumed)")
	return not stillHas
end

local function AutoPlaceKeysOnce()
	if PlaceBusy then return end
	local keys = GetPlayerKeys()
	if #keys == 0 then
		-- no keys — stop feature
		if Config.Auto.AutoPlaceKeys then
			Config.Auto.AutoPlaceKeys = false
			print("[KHUB] Auto Place Keys stopped — no keys left / all placed")
		end
		return
	end
	PlaceBusy = true
	for _, key in ipairs(keys) do
		if not Config.Auto.AutoPlaceKeys then break end
		pcall(PlaceOneKey, key)
		task.wait(0.4)
	end
	-- if no keys remain, stop
	if #GetPlayerKeys() == 0 then
		Config.Auto.AutoPlaceKeys = false
		print("[KHUB] Auto Place Keys done — all keys placed, stopped")
	end
	PlaceBusy = false
end

task.spawn(function()
	while true do
		task.wait(0.5)
		if Config.Auto.AutoPlaceKeys and not Searching and not SafetyBusy then
			pcall(AutoPlaceKeysOnce)
		end
	end
end)

-- ESP
local MonsterESP = {}
local function CreateMonsterESP(monster)
	if MonsterESP[monster] then return end
	local rootPart = GetMonsterPart(monster)
	if not rootPart then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "_MonsterHighlight"
	highlight.Adornee = monster
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.Enabled = false
	highlight.Parent = monster
	local gui = Instance.new("BillboardGui")
	gui.Name = "_MonsterDistance"
	gui.Adornee = rootPart
	gui.Size = UDim2.fromOffset(220, 38)
	gui.StudsOffset = Vector3.new(0, 3.5, 0)
	gui.AlwaysOnTop = true
	gui.Enabled = false
	gui.Parent = rootPart
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	local box = Instance.new("SelectionBox")
	box.Name = "_MonsterBox"
	box.Adornee = monster
	box.SurfaceTransparency = 1
	box.LineThickness = 0.04
	box.Visible = false
	box.Parent = monster
	MonsterESP[monster] = { Highlight = highlight, Gui = gui, Label = label, Box = box }
end
local function UpdateMonsterESP()
	local root = GetRoot()
	for monster, data in pairs(MonsterESP) do
		if not monster.Parent then
			MonsterESP[monster] = nil
		else
			data.Highlight.Enabled = Config.ESP.MonsterHighlight
			data.Gui.Enabled = Config.ESP.MonsterDistance
			data.Box.Visible = Config.ESP.MonsterBox
			if Config.ESP.MonsterDistance and root then
				local monsterPart = GetMonsterPart(monster)
				if monsterPart then
					local distance = (root.Position - monsterPart.Position).Magnitude
					data.Label.Text = string.format("%s [%.0f studs]", monster.Name, distance)
				end
			end
		end
	end
end

local LockESP = {}
local function CreateLockESP(lockInfo)
	if not lockInfo then return end
	local key = lockInfo.Container
	if LockESP[key] then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "_LockESP"
	highlight.Adornee = lockInfo.Container
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.Enabled = false
	highlight.Parent = lockInfo.Container
	local gui = Instance.new("BillboardGui")
	gui.Name = "_LockDistance"
	gui.Adornee = lockInfo.Part
	gui.Size = UDim2.fromOffset(180, 36)
	gui.StudsOffset = Vector3.new(0, 2.5, 0)
	gui.AlwaysOnTop = true
	gui.Enabled = false
	gui.Parent = lockInfo.Part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	LockESP[key] = { Info = lockInfo, Highlight = highlight, Gui = gui, Label = label }
end
local function ScanLocks()
	for _, lockInfo in ipairs(GetLocks()) do
		CreateLockESP(lockInfo)
	end
end
local function UpdateLockESP()
	local root = GetRoot()
	for container, data in pairs(LockESP) do
		if not container.Parent then
			LockESP[container] = nil
		else
			data.Highlight.Enabled = Config.ESP.LockESP
			data.Gui.Enabled = Config.ESP.LockESP
			if Config.ESP.LockESP and root and data.Info.Part and data.Info.Part.Parent then
				local distance = (root.Position - data.Info.Part.Position).Magnitude
				data.Label.Text = string.format("%s [%.0f studs]", data.Info.Name, distance)
			end
		end
	end
end

local OriginalLighting = {
	Brightness = Lighting.Brightness,
	ClockTime = Lighting.ClockTime,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	GlobalShadows = Lighting.GlobalShadows,
}
local EffectStates, AtmosphereStates = {}, {}
local function SetFullbright(enabled)
	FullbrightOn = enabled
	if enabled then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
		Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)
		Lighting.GlobalShadows = false
		for _, object in ipairs(Lighting:GetChildren()) do
			if object:IsA("BloomEffect") or object:IsA("DepthOfFieldEffect")
				or object:IsA("ColorCorrectionEffect") or object:IsA("SunRaysEffect")
				or object:IsA("BlurEffect") then
				if EffectStates[object] == nil then EffectStates[object] = object.Enabled end
				object.Enabled = false
			elseif object:IsA("Atmosphere") then
				if AtmosphereStates[object] == nil then
					AtmosphereStates[object] = { Density = object.Density, Haze = object.Haze, Glare = object.Glare }
				end
				object.Density = 0
				object.Haze = 0
				object.Glare = 0
			end
		end
	else
		Lighting.Brightness = OriginalLighting.Brightness
		Lighting.ClockTime = OriginalLighting.ClockTime
		Lighting.Ambient = OriginalLighting.Ambient
		Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
		Lighting.GlobalShadows = OriginalLighting.GlobalShadows
		for object, state in pairs(EffectStates) do
			if object.Parent then object.Enabled = state end
		end
		for object, state in pairs(AtmosphereStates) do
			if object.Parent then
				object.Density = state.Density
				object.Haze = state.Haze
				object.Glare = state.Glare
			end
		end
		table.clear(EffectStates)
		table.clear(AtmosphereStates)
	end
end

local OriginalHumanoid = setmetatable({}, { __mode = "k" })
local function SaveHumanoid(humanoid)
	if OriginalHumanoid[humanoid] then return end
	OriginalHumanoid[humanoid] = {
		WalkSpeed = humanoid.WalkSpeed,
		JumpHeight = humanoid.JumpHeight,
		UseJumpPower = humanoid.UseJumpPower,
	}
end
local function ApplyPlayerMods()
	local humanoid = GetHumanoid()
	if not humanoid then return end
	SaveHumanoid(humanoid)
	if Config.Player.WalkSpeedEnabled then
		humanoid.WalkSpeed = Config.Player.WalkSpeed
	end
	if Config.Player.JumpEnabled then
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = Config.Player.JumpHeight
	end
end
local function RestoreWalkSpeed()
	local humanoid = GetHumanoid()
	if not humanoid then return end
	local state = OriginalHumanoid[humanoid]
	if state then humanoid.WalkSpeed = state.WalkSpeed end
end
local function RestoreJump()
	local humanoid = GetHumanoid()
	if not humanoid then return end
	local state = OriginalHumanoid[humanoid]
	if state then
		humanoid.UseJumpPower = state.UseJumpPower
		humanoid.JumpHeight = state.JumpHeight
	end
end

