local function GetCharacter()
	return player.Character
end
local function GetRoot()
	local character = GetCharacter()
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end
local function GetHumanoid()
	local character = GetCharacter()
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end
local function StopVelocity()
	local root = GetRoot()
	if not root then return end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end
local function TeleportCharacter(targetCFrame)
	local character = GetCharacter()
	if not character then return false end
	StopVelocity()
	character:PivotTo(targetCFrame)
	StopVelocity()
	return true
end

local function IsMonsterName(name)
	for _, wanted in ipairs(Config.MonsterNames) do
		if name == wanted then return true end
	end
	return false
end
local function GetMonsterPart(monster)
	if not monster then return nil end
	return monster:FindFirstChild("HumanoidRootPart")
		or monster.PrimaryPart
		or monster:FindFirstChildWhichIsA("BasePart", true)
end
local function GetMonsters()
	local result = {}
	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("Model") and IsMonsterName(object.Name) then
			table.insert(result, object)
		end
	end
	return result
end
local function DistanceFromClosestMonster(position)
	local closest, found = math.huge, false
	for _, monster in ipairs(GetMonsters()) do
		local part = GetMonsterPart(monster)
		if part then
			found = true
			local distance = (position - part.Position).Magnitude
			if distance < closest then closest = distance end
		end
	end
	if not found then return math.huge end
	return closest
end
local function GetNearestMonster()
	local root = GetRoot()
	if not root then return nil, math.huge end
	local nearest, bestDistance = nil, math.huge
	for _, monster in ipairs(GetMonsters()) do
		local part = GetMonsterPart(monster)
		if part then
			local distance = (root.Position - part.Position).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				nearest = monster
			end
		end
	end
	return nearest, bestDistance
end

local function FaceTarget(position, targetPosition)
	local target = Vector3.new(targetPosition.X, position.Y, targetPosition.Z)
	if (target - position).Magnitude < 0.1 then
		target = position + Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(position, target)
end

local function FindSafestCirclePosition(part, radius, height, samples)
	if not part or not part.Parent then return nil, -math.huge end
	local bestPosition, bestMonsterDistance = nil, -math.huge
	samples = samples or 12
	for i = 1, samples do
		local angle = ((i - 1) / samples) * math.pi * 2
		local position = part.Position + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
		local monsterDistance = DistanceFromClosestMonster(position)
		if monsterDistance > bestMonsterDistance then
			bestMonsterDistance = monsterDistance
			bestPosition = position
		end
	end
	return bestPosition, bestMonsterDistance
end

local function GetBackpacks()
	local folder = Workspace:FindFirstChild("BackPack")
	if not folder then return {} end
	local result = {}
	for _, backpack in ipairs(folder:GetChildren()) do
		local handle = backpack:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			local prompt = handle:FindFirstChild("SearchBackpack")
			if prompt and prompt:IsA("ProximityPrompt") then
				table.insert(result, { Model = backpack, Handle = handle, Prompt = prompt })
			end
		end
	end
	return result
end

local LockNames = { "GreenLock", "RedLock", "WhiteLock" }
local function GetLockMainPart(container)
	if not container then return nil end
	local directLock = container:FindFirstChild("Lock")
	if directLock and directLock:IsA("BasePart") then return directLock end
	if container:IsA("BasePart") then return container end
	return container:FindFirstChildWhichIsA("BasePart", true)
end
local function GetLocks()
	local result = {}
	for _, name in ipairs(LockNames) do
		local container = Workspace:FindFirstChild(name)
		if container then
			local part = GetLockMainPart(container)
			if part then
				table.insert(result, { Name = name, Container = container, Part = part })
			end
		end
	end
	return result
end

local function GetLockTeleportCFrame(lockInfo)
	if not lockInfo or not lockInfo.Part then return nil end
	local part = lockInfo.Part
	local character = GetCharacter()
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	if character then table.insert(exclude, character) end
	if lockInfo.Container then table.insert(exclude, lockInfo.Container) end
	rayParams.FilterDescendantsInstances = exclude
	local bestPosition, bestScore = nil, -math.huge
	for i = 1, 16 do
		local angle = ((i - 1) / 16) * math.pi * 2
		local candidate = part.Position + Vector3.new(math.cos(angle) * 4, 0, math.sin(angle) * 4)
		local result = Workspace:Raycast(candidate + Vector3.new(0, 7, 0), Vector3.new(0, -18, 0), rayParams)
		if result and result.Instance and result.Normal.Y > 0.55 then
			if not result.Instance:IsA("BasePart") or result.Instance.CanCollide then
				local position = result.Position + Vector3.new(0, 3, 0)
				local monsterDistance = DistanceFromClosestMonster(position)
				if monsterDistance > bestScore then
					bestScore = monsterDistance
					bestPosition = position
				end
			end
		end
	end
	if not bestPosition then
		bestPosition = part.Position + Vector3.new(0, 2.5, 4)
	end
	return FaceTarget(bestPosition, part.Position)
end

local function FindNearestLock()
	local root = GetRoot()
	if not root then return nil end
	local best, bestDistance = nil, math.huge
	for _, lockInfo in ipairs(GetLocks()) do
		local distance = (root.Position - lockInfo.Part.Position).Magnitude
		if distance < bestDistance then
			bestDistance = distance
			best = lockInfo
		end
	end
	return best
end
local function FindSafestLock()
	local best, bestDistance = nil, -math.huge
	for _, lockInfo in ipairs(GetLocks()) do
		local distance = DistanceFromClosestMonster(lockInfo.Part.Position)
		if distance > bestDistance then
			bestDistance = distance
			best = lockInfo
		end
	end
	return best
end
local function TeleportToLock(lockInfo)
	if not lockInfo then return false end
	local cframe = GetLockTeleportCFrame(lockInfo)
	if not cframe then return false end
	return TeleportCharacter(cframe)
end

