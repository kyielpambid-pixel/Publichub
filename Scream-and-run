	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(math.clamp((get()-min)/(max-min),0,1),0,1,0)
	fill.BackgroundColor3 = THEME.accent; fill.BorderSizePixel = 0; fill.ZIndex = 10; fill.Parent = track
	corner(fill, 5)
	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0,16,0,16); knob.AnchorPoint = Vector2.new(0.5,0.5)
	knob.Position = UDim2.new(math.clamp((get()-min)/(max-min),0,1),0,0.5,0)
	knob.BackgroundColor3 = THEME.white; knob.BorderSizePixel = 0; knob.ZIndex = 11; knob.Parent = track
	corner(knob, 8)
	local dragging = false
	local function applyFromX(x)
		local absPos = track.AbsolutePosition.X
		local absSize = math.max(track.AbsoluteSize.X, 1)
		local rel = math.clamp((x - absPos) / absSize, 0, 1)
		local val = math.floor(min + (max - min) * rel + 0.5)
		set(val)
		lbl.Text = text .. ": " .. tostring(val)
		fill.Size = UDim2.new(rel,0,1,0)
		knob.Position = UDim2.new(rel,0,0.5,0)
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; applyFromX(i.Position.X)
		end
	end)
	knob.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if not dragging then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
			applyFromX(i.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return row
end

