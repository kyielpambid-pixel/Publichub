do
	local Visual = Tabs.Misc:AddLeftGroupbox("Visual")

	Visual:AddButton({
		Text = "Camera Unlocker",
		Func = function()
			local player = LocalPlayer
			local camera = workspace.CurrentCamera
			if player.CameraMode == Enum.CameraMode.Classic and player.CameraMaxZoomDistance >= 20 then
				N("Camera", "Already unlocked")
				return
			end
			player.CameraMode = Enum.CameraMode.Classic
			player.CameraMinZoomDistance = 0.5
			player.CameraMaxZoomDistance = 50
			camera.CameraSubject = player.Character and player.Character:FindFirstChild("Humanoid") or camera.CameraSubject
			camera.CameraType = Enum.CameraType.Custom
			N("Camera", "Third-person unlocked — zoom out")
		end,
	})

	local fullBrightEnabled1 = false
	local autoNightLoop
	local function applyFullBright1()
		if not fullBrightEnabled1 then return end
		local hour = Lighting:GetMinutesAfterMidnight() / 60
		if hour >= 18 or hour < 6 then
			Lighting.Ambient = Color3.new(1, 1, 1)
			Lighting.Brightness = 10
			Lighting.GlobalShadows = false
		else
			Lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
			Lighting.Brightness = 1
			Lighting.GlobalShadows = true
		end
	end
	Visual:AddToggle("FbToggle1", {
		Text = "Auto Full Bright",
		Default = false,
		Callback = function(Value)
			fullBrightEnabled1 = Value
			if autoNightLoop then autoNightLoop:Disconnect(); autoNightLoop = nil end
			if Value then
				applyFullBright1()
				autoNightLoop = Lighting:GetPropertyChangedSignal("ClockTime"):Connect(applyFullBright1)
			else
				Lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
				Lighting.Brightness = 1
				Lighting.GlobalShadows = true
			end
		end,
	})

	local noFogEnabled, fogLoop = false, nil
	local function removeFog()
		Lighting.FogEnd = 1000000
		Lighting.FogStart = 0
		local atmosphere = Lighting:FindFirstChild("Atmosphere")
		if atmosphere then
			atmosphere.Density = 0
			atmosphere.Offset = 0
			atmosphere.Haze = 0
			atmosphere.Color = Color3.new(1, 1, 1)
		end
	end
	local function restoreFog()
		Lighting.FogEnd = 1000
		Lighting.FogStart = 200
		local atmosphere = Lighting:FindFirstChild("Atmosphere")
		if atmosphere then
			atmosphere.Density = 0.3
			atmosphere.Haze = 0.5
			atmosphere.Color = Color3.fromRGB(200, 200, 200)
		end
	end
	Visual:AddToggle("NoFogToggle", {
		Text = "Remove Fog",
		Default = false,
		Callback = function(Value)
			noFogEnabled = Value
			if fogLoop then fogLoop:Disconnect(); fogLoop = nil end
			if Value then
				removeFog()
				fogLoop = RunService.Heartbeat:Connect(removeFog)
			else
				restoreFog()
			end
		end,
	})

	local Bypass = Tabs.Misc:AddRightGroupbox("Bypass")

	getgenv().bandageBypassEnabled = false
	Bypass:AddToggle("BypassBandageT", {
		Text = "Bypass Bandage Delay (R)",
		Default = false,
		Callback = function(Value)
			getgenv().bandageBypassEnabled = Value
		end,
	})
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if getgenv().bandageBypassEnabled and input.KeyCode == Enum.KeyCode.R then
			local character = LocalPlayer.Character
			if character then
				local bandage = character:FindFirstChild("Bandage")
				if bandage and bandage:IsA("Tool") then
					pcall(function() bandage.Use:FireServer() end)
				end
			end
		end
	end)

	local ReloadStatus = false
	local originalReloadTimes = {}
	Bypass:AddToggle("ReloadToggle", {
		Text = "Bypass Reload Delay",
		Default = false,
		Callback = function(Value)
			ReloadStatus = Value
			if Value then
				task.spawn(function()
					while ReloadStatus do
						local character = LocalPlayer.Character
						if character then
							for _, tool in pairs(character:GetChildren()) do
								if tool:IsA("Tool") and tool:FindFirstChild("WeaponConfiguration") then
									local reloadDuration = tool.WeaponConfiguration:FindFirstChild("ReloadDuration")
									if reloadDuration then
										if not originalReloadTimes[tool] then
											originalReloadTimes[tool] = reloadDuration.Value
										end
										reloadDuration.Value = 0
									end
								end
							end
						end
						task.wait(0.1)
					end
				end)
			else
				local character = LocalPlayer.Character
				if character then
					for _, tool in pairs(character:GetChildren()) do
						if tool:IsA("Tool") and tool:FindFirstChild("WeaponConfiguration") then
							local reloadDuration = tool.WeaponConfiguration:FindFirstChild("ReloadDuration")
							if reloadDuration and originalReloadTimes[tool] then
								reloadDuration.Value = originalReloadTimes[tool]
							end
						end
					end
				end
				table.clear(originalReloadTimes)
			end
		end,
	})

	local FireStatus = false
	local originalFireTimes = {}
	Bypass:AddToggle("FireDeToggle", {
		Text = "Bypass Fire Delay",
		Default = false,
		Callback = function(Value)
			FireStatus = Value
			if Value then
				task.spawn(function()
					while FireStatus do
						local character = LocalPlayer.Character
						if character then
							for _, tool in pairs(character:GetChildren()) do
								if tool:IsA("Tool") and tool:FindFirstChild("WeaponConfiguration") then
									local fireDuration = tool.WeaponConfiguration:FindFirstChild("FireDelay")
									if fireDuration then
										if not originalFireTimes[tool] then
											originalFireTimes[tool] = fireDuration.Value
										end
										fireDuration.Value = 0.15
									end
								end
							end
						end
						task.wait(0.1)
					end
				end)
			else
				local character = LocalPlayer.Character
				if character then
					for _, tool in pairs(character:GetChildren()) do
						if tool:IsA("Tool") and tool:FindFirstChild("WeaponConfiguration") then
							local fireDuration = tool.WeaponConfiguration:FindFirstChild("FireDelay")
							if fireDuration and originalFireTimes[tool] then
								fireDuration.Value = originalFireTimes[tool]
							end
						end
					end
				end
				table.clear(originalFireTimes)
			end
		end,
	})

	local function skipHoldPrompt(prompt)
		if prompt and prompt:IsA("ProximityPrompt") and prompt.HoldDuration > 0 then
			if prompt:GetAttribute("OriginalHold") == nil then
				prompt:SetAttribute("OriginalHold", prompt.HoldDuration)
			end
			prompt.HoldDuration = 0
		end
	end
	Bypass:AddToggle("SkipHoldToggle", {
		Text = "Bypass Hold Prompt",
		Default = false,
		Callback = function(Value)
			getgenv().SkipHold = Value
			if Value then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("ProximityPrompt") then skipHoldPrompt(obj) end
				end
			else
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("ProximityPrompt") then
						local originalHold = obj:GetAttribute("OriginalHold")
						if originalHold then
							obj.HoldDuration = originalHold
							obj:SetAttribute("OriginalHold", nil)
						end
					end
				end
			end
		end,
	})
	workspace.DescendantAdded:Connect(function(obj)
		if getgenv().SkipHold then
			task.wait(0.1)
			skipHoldPrompt(obj)
		end
	end)

