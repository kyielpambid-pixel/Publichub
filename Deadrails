-- NPC tracking
local trackedNPCs, descConn, trackUsers = {}, nil, 0
local function trackNPC(h)
	local m = h.Parent
	if m and m:IsA("Model") and not trackedNPCs[m] and not Players:GetPlayerFromCharacter(m) then
		trackedNPCs[m] = h
	end
end
local function startNPCTrack()
	trackUsers += 1
	if trackUsers > 1 then return end
	for _, o in ipairs(workspace:GetDescendants()) do
		if o:IsA("Humanoid") then trackNPC(o) end
	end
	descConn = workspace.DescendantAdded:Connect(function(o)
		if o:IsA("Humanoid") then trackNPC(o) end
	end)
end
local function stopNPCTrack()
	if trackUsers == 0 then return end
	trackUsers -= 1
	if trackUsers > 0 then return end
	if descConn then descConn:Disconnect(); descConn = nil end
	table.clear(trackedNPCs)
end
local function getClosestNPCId(range)
	range = range or 15
	local root = getRoot()
	if not root then return nil end
	local best, bd
	for m, h in pairs(trackedNPCs) do
		if not m.Parent then trackedNPCs[m] = nil
		elseif h.Health > 0 then
			local id = m:GetAttribute("ServerEntityId")
			local nr = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
			if id and nr then
				local d = (nr.Position - root.Position).Magnitude
				if d <= range and (not bd or d < bd) then best, bd = id, d end
			end
		end
	end
	return best
end

