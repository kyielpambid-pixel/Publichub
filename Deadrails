	btn.TextColor3 = THEME.text
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 12
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.ZIndex = 10
	btn.Parent = row
	corner(btn, 6)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.Parent = btn
	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, 0, 0, 0)
	list.Position = UDim2.new(0, 0, 0, 34)
	list.BackgroundColor3 = THEME.card
	list.BackgroundTransparency = 0.1
	list.BorderSizePixel = 0
	list.Visible = false
	list.ZIndex = 30
	list.ScrollBarThickness = 3
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.Parent = row
	corner(list, 6)
	local lay = Instance.new("UIListLayout")
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Parent = list
	local function refreshLabel()
		local names = {}
		for k, v in pairs(selected) do if v then table.insert(names, k) end end
		table.sort(names)
		if #names == 0 then
			btn.Text = text .. ": (none)"
		elseif #names <= 2 then
			btn.Text = text .. ": " .. table.concat(names, ", ")
		else
			btn.Text = text .. ": " .. #names .. " selected"
		end
	end
	local function rebuild()
		for _, ch in ipairs(list:GetChildren()) do
			if ch:IsA("TextButton") then ch:Destroy() end
		end
		for i, opt in ipairs(options) do
			local o = Instance.new("TextButton")
			o.Size = UDim2.new(1, 0, 0, 26)
			o.BackgroundColor3 = selected[opt] and Color3.fromRGB(40, 90, 60) or THEME.element
			o.BackgroundTransparency = 0.3
			o.Text = (selected[opt] and "✓ " or "  ") .. opt
			o.TextColor3 = selected[opt] and THEME.green or THEME.text
			o.Font = Enum.Font.Gotham
			o.TextSize = 11
			o.TextXAlignment = Enum.TextXAlignment.Left
			o.LayoutOrder = i
			o.ZIndex = 31
			o.Parent = list
			corner(o, 4)
			local op = Instance.new("UIPadding")
			op.PaddingLeft = UDim.new(0, 8)
			op.Parent = o
			o.MouseButton1Click:Connect(function()
				if multi then
					selected[opt] = not selected[opt]
				else
					table.clear(selected)
					selected[opt] = true
					open = false
					list.Visible = false
					row.Size = UDim2.new(1, 0, 0, 36)
				end
				o.BackgroundColor3 = selected[opt] and Color3.fromRGB(40, 90, 60) or THEME.element
				o.Text = (selected[opt] and "✓ " or "  ") .. opt
				o.TextColor3 = selected[opt] and THEME.green or THEME.text
				refreshLabel()
				if callback then
					if multi then
						callback(selected)
					else
						callback(opt)
					end
				end
			end)
		end
		list.Size = UDim2.new(1, 0, 0, math.min(26 * #options + 4, 140))
	end
	btn.MouseButton1Click:Connect(function()
		open = not open
		list.Visible = open
		row.Size = UDim2.new(1, 0, 0, open and (36 + math.min(26 * #options + 4, 140)) or 36)
		if open then rebuild() end
	end)
	rebuild()
	refreshLabel()
	return {
		SetOptions = function(_, opts)
			options = opts or {}
			rebuild()
			refreshLabel()
		end,
		GetSelected = function() return selected end,
	}
end

