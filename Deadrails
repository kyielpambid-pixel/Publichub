-- VFly
local vflyConn, vflyKeys = nil, {}
local VEL_N, GYRO_N = "KHUB_VFlyVel", "KHUB_VFlyGyro"
local function stopVFly()
	if vflyConn then vflyConn:Disconnect(); vflyConn = nil end
	table.clear(vflyKeys)
	local root = getRoot()
	if root then
		local v = root:FindFirstChild(VEL_N); if v then v:Destroy() end
		local g = root:FindFirstChild(GYRO_N); if g then g:Destroy() end
	end
end
local function startVFly()
	stopVFly()
	if not getRoot() then return false end
	vflyConn = RunService.RenderStepped:Connect(function()
		local root = getRoot()
		local cam = workspace.CurrentCamera
		if not root or not cam then return end
		local vel = root:FindFirstChild(VEL_N)
		if not vel then
			vel = Instance.new("BodyVelocity"); vel.Name = VEL_N
			vel.MaxForce = Vector3.new(9e9, 9e9, 9e9); vel.Parent = root
		end
		local gy = root:FindFirstChild(GYRO_N)
		if not gy then
			gy = Instance.new("BodyGyro"); gy.Name = GYRO_N
			gy.MaxTorque = Vector3.new(9e9, 9e9, 9e9); gy.P = 9e4; gy.Parent = root
		end
		gy.CFrame = root.CFrame
		local ccf = cam.CFrame
		local x = (vflyKeys[Enum.KeyCode.D] and 1 or 0) - (vflyKeys[Enum.KeyCode.A] and 1 or 0)
		local z = (vflyKeys[Enum.KeyCode.W] and 1 or 0) - (vflyKeys[Enum.KeyCode.S] and 1 or 0)
		local move = ccf.RightVector * x + ccf.LookVector * z
		local up = State.VFlyQE and vflyKeys[Enum.KeyCode.E]
		local dn = State.VFlyQE and vflyKeys[Enum.KeyCode.Q]
		local speed = State.VFlySpeed * 50
		local vert = (up and 1 or 0) - (dn and 1 or 0)
		vel.Velocity = move * speed + Vector3.new(0, vert * speed, 0)
	end)
	return true
end
UserInputService.InputBegan:Connect(function(i, gp)
	if not gp then vflyKeys[i.KeyCode] = true end
end)
UserInputService.InputEnded:Connect(function(i)
	vflyKeys[i.KeyCode] = nil
end)

