end)

-- Item list scan for filters
local function scanObjectIds()
	local list = {}
	local ok, folder = pcall(function() return RS.Shared.Universe.Object.Objects end)
	if not ok or not folder then return list end
	local seen = {}
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("ModuleScript") and not seen[d.Name] then
			seen[d.Name] = true
			table.insert(list, d.Name)
		end
	end
	table.sort(list)
	return list
end
local function scanGunNames()
	local names, seen = {}, {}
	local ok, f = pcall(function() return RS.Shared.Universe.Object.Objects.Weapon.Gun end)
	if ok and f then
		for _, d in ipairs(f:GetDescendants()) do
			if d:IsA("ModuleScript") and not seen[d.Name] then
				seen[d.Name] = true
				table.insert(names, d.Name)
			end
		end
	end
	if #names == 0 then
		local ok2, tf = pcall(function() return RS.Assets.Tools.Weapon.Gun end)
		if ok2 and tf then
			for _, ch in ipairs(tf:GetChildren()) do table.insert(names, ch.Name) end
		end
	end
	table.sort(names)
	return names
end

