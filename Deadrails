-- Farm loop
local farmRun = 0
task.spawn(function()
	while true do
		local any = State.FarmBond or State.FarmMoney or State.BringItems or State.NearbyItems or State.ItemAura
		if any then
			if not ECS then pcall(loadECS) end
			if ECS then
				pcall(function()
					local world, comps = ECS.world, ECS.comps
					local st = world:get_resource(comps.ClientStateResource)
					local character = st and st.localCharacter
					if not character then return end
					if not world:has(character, comps.Sack) then
						world:add(character, comps.Sack)
						world:set(character, comps.Sack, { contents = {}, maxContents = 10 })
					end
					local myPos = ecsMyPos()
					if not myPos then return end
					local bondNear, bondFar = {}, {}
					local bondTotal, checked = 0, 0
					for id in world:query(comps.Storable, comps.ObjectId) do
						local objectId = world:get(id, comps.ObjectId)
						if objectId == "bond" then bondTotal += 1 end
						local isBond = (State.FarmBond and objectId == "bond") or (State.FarmMoney and objectId == "money_bag")
						local isBring = not isBond and State.BringItems and filterAllows(State.BringFilter, objectId)
						local isNearby = not isBond and State.NearbyItems and filterAllows(State.NearbyFilter, objectId)
						local isPickup = not isBond and State.ItemAura and filterAllows(State.PickupFilter, objectId)
						if isBond or isBring or isNearby or isPickup then
							local serverEntity = ECS.replicator:get_server_entity(id)
							if serverEntity and serverEntity ~= id then
								local tr = world:get(id, comps.Transform)
								local pos = tr and (tr.Position or tr.p)
								local dist = pos and (pos - myPos).Magnitude or math.huge
								if isBond then
									local range = objectId == "money_bag" and State.MoneyBagDist or State.NearbyDist
									if dist <= range then table.insert(bondNear, serverEntity)
									else table.insert(bondFar, serverEntity) end
								else
									if isBring and dist > State.MinBring then
										ECS.remotes.Store:FireServer(serverEntity)
										ECS.remotes.Store:FireServer()
										if State.BringDelay > 0 then task.wait(State.BringDelay) end
									end
									if isNearby and dist <= State.NearbyDist and world:has(id, comps.Actionable) then
										ECS.actionable:FireServer(serverEntity)
										if State.NearbyDelay > 0 then task.wait(State.NearbyDelay) end
									end
									if isPickup and dist <= State.AuraRange and world:has(id, comps.Pickupable) then
										ECS.pickup:FireServer(serverEntity)
										if State.PickupDelay > 0 then task.wait(State.PickupDelay) end
									end
								end
							end
						end
						checked += 1
						if checked % 20 == 0 then task.wait() end
					end
					if State.FarmBond and State.AutoRetryBond and bondTotal == 0 then
						pcall(function() RS.Shared.Universe.Network.RemoteEvent.ResetCharacter:FireServer() end)
						pcall(function() RS.Remotes.EndDecision:FireServer(false) end)
					end
					for _, sr in ipairs(bondNear) do
						ECS.actionable:FireServer(sr)
						if State.BondDelay > 0 then task.wait(State.BondDelay) end
					end
					for _, sr in ipairs(bondFar) do
						if not (State.FarmBond or State.FarmMoney) then break end
						ECS.remotes.Store:FireServer(sr)
						ECS.remotes.Store:FireServer()
						ECS.actionable:FireServer(sr)
						if State.BondDelay > 0 then task.wait(State.BondDelay) end
					end
				end)
			end
			task.wait(State.FarmDelay)
		else
			task.wait(0.4)
		end
	end
end)

