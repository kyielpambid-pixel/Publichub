local function doSteal()
	if not S.Steal then return end
	if isCarrying() then
		stealStatus = "Depositing"
		depositStolen()
		return
	end
	local root = getRoot()
	if not root then
		stealStatus = "Waiting for character"
		return
	end
	local crates = listCrates()
	if #crates == 0 then
		stealStatus = "Searching for crates"
		return
	end
	local now = os.clock()
	local target, bestDist
	for _, crate in ipairs(crates) do
		local untilAt = stealBlocked[crate.model]
		if not (untilAt and untilAt > now) then
			stealBlocked[crate.model] = nil
			local dist = (crate.position - root.Position).Magnitude
			if not bestDist or dist < bestDist then
				target, bestDist = crate, dist
			end
		end
	end
	if not target then
		stealStatus = "Searching for crates"
		return
	end
	stealStatus = "Grabbing"
	local prompt = target.prompt
	fastPrompt(prompt)
	local spot = stealAnchor(target)
	streamAround(spot)
	tp(CFrame.new(spot + Vector3.new(0, 3, 0)))
	if not S.Steal then return end
	local burst = math.clamp(S.StealBurst or 3, 1, 10)
	local deadline = os.clock() + 1.0
	local fired = false
	while S.Steal and os.clock() < deadline do
		if isCarrying() or not (prompt.Parent and prompt.Enabled) then break end
		for _ = 1, burst do
			if firePrompt(prompt) then fired = true end
		end
		RunService.Heartbeat:Wait()
		if isCarrying() then break end
		local me = getRoot()
		local nowSpot = stealAnchor(target)
		if me and (me.Position - nowSpot).Magnitude > 8 then
			tp(CFrame.new(nowSpot + Vector3.new(0, 3, 0)))
		end
	end
	if isCarrying() then
		last.Steal = os.clock()
		stealStatus = "Depositing"
		depositStolen()
	else
		stealBlocked[target.model] = os.clock() + (fired and 0.6 or 0.3)
	end
end

local function doPlace()
	if not S.Place then return end
	if isCarrying() then depositStolen() return end
	if os.clock() - last.Place < 0.55 then return end
	local _, floor = getPlot()
	if not floor then return end
	local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
	if not isCrateTool(tool) then
		local list = heldCrateTools()
		if #list == 0 then return end
		equipTool(list[1])
		task.wait(0.15)
		if isCarrying() then return end
		tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
		if not isCrateTool(tool) then return end
	end
	local spot = findPlaceSpot(floor)
	if not spot then return end
	streamAround(spot)
	tp(CFrame.new(spot + Vector3.new(0, 4, 0)))
	task.wait(0.1)
	if not S.Place then return end
	local yaw = 0
	if tool and tool:GetAttribute("CrateAreaId") == "Angelic" then
		local r = getRoot()
		if r then
			local lv = r.CFrame.LookVector
			yaw = math.atan2(-lv.X, -lv.Z)
		end
	end
	if re_PLACE_AT then
		local ok = pcall(function() re_PLACE_AT:FireServer(spot, yaw) end)
		if ok then last.Place = os.clock() end
	end
end

local function doOpen()
	if not S.Open then return end
	if os.clock() - last.Open < 0.35 then return end
	local plot = select(1, getPlot())
	local root = getRoot()
	if not plot or not root then return end
	local best, bestPos, bestDist
	for _, d in ipairs(plot:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled and d.ActionText == "Open Crate" then
			local parent = d.Parent
			local pos
			if parent and parent:IsA("BasePart") then
				pos = parent.Position
			else
				local model = d:FindFirstAncestorWhichIsA("Model")
				if model then pos = model:GetPivot().Position end
			end
			if pos then
				local dist = (pos - root.Position).Magnitude
				if not bestDist or dist < bestDist then
					best, bestPos, bestDist = d, pos, dist
				end
			end
		end
	end
	if not best or not bestPos then return end
	streamAround(bestPos)
	tp(CFrame.new(bestPos + Vector3.new(0, 3, 0)))
	task.wait(0.1)
	if not S.Open then return end
	if firePrompt(best) then last.Open = os.clock() end
end

