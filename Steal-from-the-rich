local function treadmillCF(belt, model)
	if not belt or not belt:IsA("BasePart") then return nil end
	local yaw = model and tonumber(model:GetAttribute("MountYaw")) or 0
	return belt.CFrame * CFrame.new(0, belt.Size.Y / 2 + 3, 0) * CFrame.Angles(0, math.rad(yaw), 0)
end

local function listCrates()
	local folder = Workspace:FindFirstChild("Crates")
	if not folder then return {} end
	local out = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("IsCrate") == true then
			local areaId = child:GetAttribute("AreaId")
			local tier = child:GetAttribute("CrateTier")
			if zoneOk(areaId) and rarityOk(tier) then
				local prompt = findStealPrompt(child)
				if prompt then
					table.insert(out, {
						model = child,
						areaId = areaId,
						tier = tier,
						prompt = prompt,
						position = child:GetPivot().Position,
					})
				end
			end
		end
	end
	return out
end

local function stealAnchor(crate)
	local prompt = crate.prompt
	local holder = prompt and prompt.Parent
	if holder then
		if holder:IsA("BasePart") then return holder.Position end
		if holder:IsA("Attachment") then return holder.WorldPosition end
	end
	local ok, pivot = pcall(function() return crate.model:GetPivot().Position end)
	return ok and pivot or crate.position
end

local function depositStolen()
	local deposit = Vector3.new(2437, 4, -928)
	streamAround(deposit)
	if not tp(CFrame.new(deposit + Vector3.new(0, 3, 0))) then return false end
	local deadline = os.clock() + 4
	while alive() and isCarrying() and os.clock() < deadline do
		tp(CFrame.new(deposit + Vector3.new(0, 3, 0)))
		RunService.Heartbeat:Wait()
	end
	return not isCarrying()
end

local function findPlaceSpot(floor)
	if not floor or not floor:IsA("BasePart") then return nil end
	local y = floor.Position.Y + floor.Size.Y / 2
	local halfX = math.max(1, floor.Size.X / 2 - 2.5)
	local halfZ = math.max(1, floor.Size.Z / 2 - 2.5)
	for x = -halfX, halfX, 3.2 do
		for z = -halfZ, halfZ, 3.2 do
			local pos = (floor.CFrame * CFrame.new(x, floor.Size.Y / 2, z)).Position
			local candidate = Vector3.new(pos.X, y, pos.Z)
			local blocked = false
			local plot = floor.Parent
			if plot then
				for _, child in ipairs(plot:GetChildren()) do
					if child.Name == "AppraisingCrate" or child.Name == "ItemStand" then
						local p = child:GetPivot().Position
						local dx, dz = p.X - candidate.X, p.Z - candidate.Z
						if dx * dx + dz * dz < 9 then blocked = true break end
					end
				end
			end
			if not blocked then return candidate end
		end
	end
	return Vector3.new(floor.Position.X, y + 3, floor.Position.Z)
end

local function heldCrateTools()
	local list = {}
	local char = LocalPlayer.Character
	if char then
		for _, c in ipairs(char:GetChildren()) do
