	local listLay = Instance.new("UIListLayout")
	listLay.Padding = UDim.new(0, 3)
	listLay.SortOrder = Enum.SortOrder.LayoutOrder
	listLay.Parent = list
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 4)
	listPad.PaddingBottom = UDim.new(0, 4)
	listPad.PaddingLeft = UDim.new(0, 4)
	listPad.PaddingRight = UDim.new(0, 4)
	listPad.Parent = list

	local function countSelected()
		local n = 0
		for _, v in pairs(stateTable) do if v then n = n + 1 end end
		return n
	end

	local function refreshHeader()
		local n = countSelected()
		hdrLbl.Text = string.format("%s  (%d selected)", title, n)
	end

	for i, item in ipairs(items) do
		local on = stateTable[item] == true
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, -4, 0, 26)
		row.BackgroundColor3 = on and Color3.fromRGB(20, 60, 40) or THEME.element
		row.BackgroundTransparency = 0.2
		row.Text = ""
		row.LayoutOrder = i
		row.ZIndex = 13
		row.Parent = list
		corner(row, 5)

		local mark = Instance.new("TextLabel")
		mark.Size = UDim2.new(0, 18, 1, 0)
		mark.Position = UDim2.new(0, 6, 0, 0)
		mark.BackgroundTransparency = 1
		mark.Text = on and "✓" or ""
		mark.TextColor3 = THEME.green
		mark.Font = Enum.Font.GothamBold
		mark.TextSize = 12
		mark.ZIndex = 14
		mark.Parent = row

		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(1, -30, 1, 0)
		name.Position = UDim2.new(0, 26, 0, 0)
		name.BackgroundTransparency = 1
		name.Text = item
		name.TextColor3 = on and THEME.green or THEME.text
		name.Font = Enum.Font.GothamMedium
		name.TextSize = 11
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.ZIndex = 14
		name.Parent = row

		row.MouseButton1Click:Connect(function()
			on = not on
			stateTable[item] = on
			row.BackgroundColor3 = on and Color3.fromRGB(20, 60, 40) or THEME.element
			mark.Text = on and "✓" or ""
			name.TextColor3 = on and THEME.green or THEME.text
			refreshHeader()
			notify(item, on and "Selected" or "Deselected", on)
		end)
	end

	local function setOpen(v)
		open = v
		arrow.Text = open and "▲" or "▼"
		if open then
			local h = math.min(160, #items * 29 + 12)
			list.Size = UDim2.new(1, 0, 0, h)
			list.Visible = true
		else
			list.Size = UDim2.new(1, 0, 0, 0)
			list.Visible = false
		end
	end

	header.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)
	refreshHeader()
	return wrap
end

