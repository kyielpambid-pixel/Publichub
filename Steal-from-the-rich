local function startLoop(name, delaySec, fn)
	gens[name] = (gens[name] or 0) + 1
	local gen = gens[name]
	task.spawn(function()
		while alive() and S[name] and gens[name] == gen do
			pcall(fn)
			task.wait(type(delaySec) == "function" and delaySec() or delaySec)
		end
	end)
end

local function setFlag(name, on, delaySec, fn)
	S[name] = on and true or false
	if S[name] then
		startLoop(name, delaySec, fn)
	else
		gens[name] = (gens[name] or 0) + 1
	end
end

