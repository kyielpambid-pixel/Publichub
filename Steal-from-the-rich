do
	local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
	Orb.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = OrbWrap.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	Orb.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local d = input.Position - dragStart
			OrbWrap.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

local function matchBind(kc, bindKey)
	local bound = S.Keybinds[bindKey]
	return bound and bound ~= Enum.KeyCode.Unknown and kc == bound
end

UserInputService.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local kc = i.KeyCode

	-- Toggle UI (custom + backup RightCtrl / K)
	if matchBind(kc, "ToggleUI")
		or kc == Enum.KeyCode.RightControl
		or kc == Enum.KeyCode.K then
		setVisible(not Main.Visible)
		return
	end

	if matchBind(kc, "AutoSteal") then
		local on = not S.Steal
		setFlag("Steal", on, 0.05, doSteal)
		notify("Auto Steal", on and "Enabled" or "Disabled", on)
		return
	end
	if matchBind(kc, "AutoSell") then
		local on = not S.Sell
		setFlag("Sell", on, 1.2, doSell)
		notify("Auto Sell", on and "Enabled" or "Disabled", on)
		return
	end
	if matchBind(kc, "Fly") then
		S.Fly = not S.Fly
		if not S.Fly and flyBV then
			pcall(function() flyBV:Destroy() end)
			flyBV = nil
			local hum = getHum()
			if hum then hum.PlatformStand = false end
		elseif S.Fly then
			local hum = getHum()
			if hum then hum.PlatformStand = true end
		end
		notify("Fly", S.Fly and "Enabled" or "Disabled", S.Fly)
		return
	end
	if matchBind(kc, "Noclip") then
		S.Noclip = not S.Noclip
		if not S.Noclip then
			for part, can in pairs(noclipSnaps) do
				if part and part.Parent then part.CanCollide = can end
			end
			table.clear(noclipSnaps)
		end
		notify("Noclip", S.Noclip and "Enabled" or "Disabled", S.Noclip)
		return
	end
	if matchBind(kc, "WalkSpeed") then
		S.WalkSpeedOn = not S.WalkSpeedOn
		local hum = getHum()
		if hum then hum.WalkSpeed = S.WalkSpeedOn and S.WalkSpeed or 16 end
		notify("WalkSpeed", S.WalkSpeedOn and "Enabled" or "Disabled", S.WalkSpeedOn)
		return
	end
	if matchBind(kc, "InfJump") then
		S.InfJump = not S.InfJump
		notify("Inf Jump", S.InfJump and "Enabled" or "Disabled", S.InfJump)
		return
	end

	if S.InfJump and kc == Enum.KeyCode.Space then
		local hum = getHum()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

UserInputService.JumpRequest:Connect(function()
	if S.InfJump then
		local hum = getHum()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

