end

local function doBuySlot()
	if not S.BuyEquipSlot then return end
	if os.clock() - last.BuySlot < 1.5 then return end
	local plot, floor = getPlot()
	if not floor then return end
	if rf_ITEM_LOADOUT then
		local ok, data = pcall(function() return rf_ITEM_LOADOUT:InvokeServer("list") end)
		if ok and type(data) == "table" then
			local price = tonumber(data.NextPrice)
			if price and price > 0 and not canAfford(price) then return end
			if type(data.Slots) == "number" and type(data.NextSlots) == "number" and data.NextSlots <= data.Slots then
				return
			end
		end
	end
	if re_PLOT_UPGRADE then
		local ok = pcall(function() re_PLOT_UPGRADE:FireServer(floor, true) end)
		if ok then last.BuySlot = os.clock() end
	end
end

local function doTreadmill()
	if not S.Treadmill then return end
	if LocalPlayer:GetAttribute("OnTreadmill") == true then return end
	if os.clock() - last.Treadmill < 0.8 then return end
	local belt, model = getTreadmill()
	if not belt then return end
	local cf = treadmillCF(belt, model)
	if not cf then return end
	streamAround(cf.Position)
	tp(cf)
	last.Treadmill = os.clock()
end

local function doUpgrade(remote, signName, key, cooldown)
	if os.clock() - (last[key] or 0) < (cooldown or 1.5) then return end
	local plot = select(1, getPlot())
	if not plot or not remote then return end
	local sign = plot:FindFirstChild(signName, true)
	if sign then
		if sign:GetAttribute("CanAfford") == false then return end
		local price = tonumber(sign:GetAttribute("UpgradePrice"))
		if price and price > 0 and not canAfford(price) then return end
	end
	local ok = pcall(function() remote:FireServer(plot) end)
	if ok then last[key] = os.clock() end
end

local function doClaimIndex()
	if not S.ClaimIndex then return end
	if os.clock() - last.Claim < 2 then return end
	if Network then
		local ok = pcall(function() Network.FireServer("INDEX_CLAIM_ALL") end)
		if ok then last.Claim = os.clock() end
	end
end

local function doBuyTrails()
	if not S.BuyTrails then return end
	if os.clock() - last.Trails < 1.2 then return end
	local bought = false
	for _, trail in ipairs(Trails) do
		if not S.BuyTrails then break end
		if S.TrailOwned[trail.Id] ~= true then
			local price = tonumber(trail.Price) or 0
			if canAfford(price) and Network then
				local ok = pcall(function() Network.FireServer("TRAIL_BUY", trail.Id) end)
				if ok then
					bought = true
					task.wait(0.2)
				end
			end
		end
	end
	if bought then
		last.Trails = os.clock()
		pcall(function() Network.FireServer("TRAIL_STATE") end)
	end
end

local function doSell()
	if not S.Sell then return end
	if os.clock() - last.Sell < 1.2 then return end
	local mode = SellModeMap[S.SellMode] or "all"
	if rf_SELL_QUOTE then
		local ok, data = pcall(function() return rf_SELL_QUOTE:InvokeServer() end)
		if ok and type(data) == "table" then
			if mode == "held" then
				if not (data.HeldLabel and data.HeldPrice) then return end
			elseif mode == "all" then
				local count = tonumber(data.AllCount) or 0
				if count <= 0 then return end
			end
		end
	end
	if S.TeleportToSeller then
		local cf = getSellerCFrame()
		local root = getRoot()
		if root and (root.Position - cf.Position).Magnitude > 12 then
			streamAround(cf.Position)
			tp(cf)
			task.wait(0.08)
		end
		if not S.Sell then return end
	end
	if re_SELL_DO then
		local ok = pcall(function() re_SELL_DO:FireServer(mode) end)
		if ok then last.Sell = os.clock() end
	end
end

