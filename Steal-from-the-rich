local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local c = LocalPlayer.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function tp(cf)
	local r = getRoot()
	if not r or typeof(cf) ~= "CFrame" then return false end
	r.AssemblyLinearVelocity = Vector3.zero
	r.AssemblyAngularVelocity = Vector3.zero
	r.CFrame = cf
	return true
end

local function streamAround(pos)
	if typeof(pos) ~= "Vector3" then return end
	pcall(function()
		if LocalPlayer.RequestStreamAroundAsync then
			task.defer(function()
				pcall(function() LocalPlayer:RequestStreamAroundAsync(pos) end)
			end)
		end
	end)
end

local function fastPrompt(prompt)
	pcall(function()
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
		if prompt.MaxActivationDistance < 40 then
			prompt.MaxActivationDistance = 40
		end
	end)
end

local promptCache = setmetatable({}, { __mode = "k" })
local function findStealPrompt(model)
	local cached = promptCache[model]
	if not (cached and cached.Parent and cached:IsDescendantOf(model)) then
		cached = nil
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.ActionText == "Steal" then
				cached = d
				break
			end
		end
		promptCache[model] = cached
		if cached then fastPrompt(cached) end
	end
	if cached and cached.Enabled then return cached end
	return nil
end

local function firePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
	if type(fireproximityprompt) ~= "function" then return false end
	local ok = pcall(fireproximityprompt, prompt)
	return ok
end

local function canAfford(price)
	local n = tonumber(price)
	if not n or n <= 0 then return true end
	if not InfiniteMath or not ClientBalanceService then return true end
	local ok, res = pcall(function()
		local bal = ClientBalanceService.Balance
		if bal == nil then return true end
		return bal >= InfiniteMath.new(n)
	end)
	return ok and res == true
end

local function isCrateTool(tool)
	if not tool or not tool:IsA("Tool") then return false end
	if tool:GetAttribute("IsBatTool") or tool:GetAttribute("IsBearTrapTool") or tool:GetAttribute("IsTreadmill") then
		return false
	end
	return tool:GetAttribute("CrateUid") ~= nil
end

local function isCarrying()
	return LocalPlayer:GetAttribute("CarryingStolen") == true
end

local function rarityOk(tier)
	if type(tier) ~= "string" or tier == "" then return false end
	local any = false
	for _, v in pairs(S.RarityFilter) do if v then any = true break end end
	if not any then return true end
	return S.RarityFilter[tier] == true
end

local function zoneOk(areaId)
	if type(areaId) ~= "string" or areaId == "" then return false end
	local any = false
	for _, v in pairs(S.ZoneFilter) do if v then any = true break end end
	if not any then return true end
	local label = LabelByZoneId[areaId]
	if label and S.ZoneFilter[label] == true then return true end
	return S.ZoneFilter[areaId] == true
end

local function getPlot()
	for _, child in ipairs(Workspace:GetChildren()) do
		if child.Name:match("^Plot Building %d+$") then
			local floor = child:FindFirstChild("floor")
			if floor and floor:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
				return child, floor
			end
		end
	end
	return nil, nil
end

local function getBaseCFrame()
	local plot, floor = getPlot()
	if floor and floor:IsA("BasePart") then
		local spawn = floor:FindFirstChild("PlayerSpawn")
		if spawn and spawn:IsA("BasePart") then
			return spawn.CFrame * CFrame.new(0, 3, 0)
		end
		return CFrame.new(floor.Position + Vector3.new(0, floor.Size.Y / 2 + 3, 0))
	end
	return nil
end

local function getSellerCFrame()
	local map = Workspace:FindFirstChild("Map")
	local vendors = map and map:FindFirstChild("Vendors")
	local sells = vendors and vendors:FindFirstChild("SellPlaces")
	local sell1 = sells and sells:FindFirstChild("Sell1")
	local npc = sell1 and sell1:FindFirstChild("sellnpc NEW")
	if npc and npc:IsA("Model") then
		return npc:GetPivot() * CFrame.new(0, 2, 5)
	end
	if sell1 then
		local pp = sell1:FindFirstChildWhichIsA("ProximityPrompt", true)
		local parent = pp and pp.Parent
		if parent and parent:IsA("BasePart") then
			return CFrame.new(parent.Position + Vector3.new(0, 3, 4))
		end
	end
	return CFrame.new(2437.8, 5, -860)
end

local function getZonePos(label)
	local id = ZoneIdByLabel[label] or label
	local partName = ZonePartById[id]
	if partName then
		for _, root in ipairs({ Workspace:FindFirstChild("Map"), Workspace }) do
			if root then
				local p = root:FindFirstChild(partName, true)
				if p and p:IsA("BasePart") then
					return Vector3.new(p.Position.X, p.Position.Y + 3, p.Position.Z)
				end
			end
		end
	end
	local crates = Workspace:FindFirstChild("Crates")
	if crates then
		for _, child in ipairs(crates:GetChildren()) do
			if child:GetAttribute("AreaId") == id then
				local pos = child:GetPivot().Position
				return Vector3.new(pos.X, pos.Y + 3, pos.Z)
			end
		end
	end
	return nil
end

local function getTreadmill()
	local folder = Workspace:FindFirstChild("Treadmills")
	if not folder then return nil, nil end
	local personal = folder:FindFirstChild("PersonalTreadmill_" .. tostring(LocalPlayer.UserId))
	if personal then
		local belt = personal:FindFirstChild("Belt", true)
		if belt and belt:IsA("BasePart") then return belt, personal end
	end
