do
	local host = (type(gethui) == "function" and gethui()) or CoreGui
	pcall(function()
		local old = host:FindFirstChild("KHUB_BL_Float")
		if old then old:Destroy() end
	end)
	task.spawn(function()
		for _ = 1, 20 do
			task.wait(0.1)
			for _, parent in ipairs({ host, CoreGui, player:FindFirstChild("PlayerGui") }) do
				if not parent then continue end
				for _, g in ipairs(parent:GetChildren()) do
					if g:IsA("ScreenGui") and g.Name ~= "KHUB_BL_Float" then
						for _, d in ipairs(g:GetDescendants()) do
							if (d:IsA("TextLabel") or d:IsA("TextButton")) then
								local t = string.lower(tostring(d.Text or ""))
								if t:find("lua land") then pcall(function() d.Text = "KHUB" end) end
							end
						end
					end
				end
			end
		end
	end)
	local floatGui = Instance.new("ScreenGui")
	floatGui.Name = "KHUB_BL_Float"
	floatGui.ResetOnSpawn = false
	floatGui.IgnoreGuiInset = true
	floatGui.DisplayOrder = 99999
	pcall(function() floatGui.Parent = host end)
	if not floatGui.Parent then floatGui.Parent = player:WaitForChild("PlayerGui") end
	local OpenBtn = Instance.new("ImageButton")
	OpenBtn.Size = UDim2.fromOffset(58, 58)
	OpenBtn.Position = UDim2.new(0, 16, 0.45, 0)
	OpenBtn.BackgroundColor3 = Color3.fromRGB(18, 14, 10)
	OpenBtn.BorderSizePixel = 0
	OpenBtn.Image = LOGO_ID
	OpenBtn.ScaleType = Enum.ScaleType.Fit
	OpenBtn.Parent = floatGui
	Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 160, 40)
	stroke.Thickness = 2
	stroke.Parent = OpenBtn
	local tag = Instance.new("TextLabel")
	tag.Size = UDim2.new(0, 64, 0, 16)
	tag.Position = UDim2.new(0.5, -32, 1, 2)
	tag.BackgroundTransparency = 1
	tag.Text = "KHUB"
	tag.Font = Enum.Font.GothamBold
	tag.TextSize = 11
	tag.TextColor3 = Color3.fromRGB(255, 180, 60)
	tag.Parent = OpenBtn
	local function findMain()
		for _, parent in ipairs({ host, CoreGui, player:FindFirstChild("PlayerGui") }) do
			if parent then
				for _, g in ipairs(parent:GetChildren()) do
					if g:IsA("ScreenGui") and g.Name ~= "KHUB_BL_Float" then
						local mf = g:FindFirstChild("MainFrame")
						if mf and mf.Size.X.Offset > 200 then return mf end
					end
				end
			end
		end
	end
	local dragMoved, dragging, start, pos
	OpenBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragMoved = false
			start = input.Position
			pos = OpenBtn.Position
		end
	end)
	OpenBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if not dragMoved then
				local m = findMain()
				if m then m.Visible = not m.Visible end
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - start
			if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then dragMoved = true end
			OpenBtn.Position = UDim2.new(pos.X.Scale, pos.X.Offset + d.X, pos.Y.Scale, pos.Y.Offset + d.Y)
		end
	end)
end

print("[KHUB] Basketball Legends by Khub")
