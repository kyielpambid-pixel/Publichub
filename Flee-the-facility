local LPR = LPC:FindFirstChild("HumanoidRootPart") or LPC.PrimaryPart

LocalPlayer.CharacterAdded:Connect(function(c)
    repeat task.wait() LPC = c; LPH = c:FindFirstChildOfClass("Humanoid"); LPR = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart until LPC and LPH and LPR
end)

local RemoteEvent = ReplicatedStorage:FindFirstChild("RemoteEvent") or ReplicatedStorage:WaitForChild("RemoteEvent", 2)

local Toggle = {
    ESP_Player = false, ESP_Computer = false, ESP_FreezePod = false, ESP_ExitDoor = false,
    HitAura = false, HitAuraRange = 10, AutoTie = false, AutoTieRange = 5,
    NoTaskFailed = false, AutoHelpCP_silent = false, AutoHelpCP = false,
    AntiFling = false, TouchFling = false,
    CamNoclip = false, CamDMode = false, CamMaxZoom = false, CamMaxZoomDis = 50,
    FullBright = false, TPWalk = false, TPWalkSpeed = 50,
    InfJump = false, Noclip = false, AntiAfk = false, AntiRagdoll = false,
    SlowBeast = false, UntieBeast = false,
}

local function findroot_or(c)
    if not (c and c.Parent) then return nil, nil end
    local humanoid = c:FindFirstChildOfClass("Humanoid")
    local root = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso") or c.PrimaryPart
    return root, humanoid
end

local function GetCurrentMap()
    local map
    local ov = ReplicatedStorage:FindFirstChild("CurrentMap")
    if ov and ov:IsA("ObjectValue") and ov.Value then map = ov.Value end
    if not map then
        local comp = Workspace:FindFirstChild("ComputerTable")
        if comp and comp.Parent then map = comp.Parent end
    end
    if not map then
        local pod = Workspace:FindFirstChild("FreezePod")
        if pod and pod.Parent then map = pod.Parent end
    end
    return map
end

local function GetHiddenGui()
    if gethui then return gethui() end
    return game:GetService("CoreGui")
end

