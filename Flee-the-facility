task.spawn(function()
    while true do
        task.wait(0.01)
        if Toggle.TPWalk and LPC and LPH then
            local move = LPH.MoveDirection
            if move.Magnitude > 0 then
                LPC:TranslateBy(move * Toggle.TPWalkSpeed * 0.01 * 10)
            end
        end
        if Toggle.Noclip and LPC then
            for _, c in pairs(LPC:GetDescendants()) do
                if c:IsA("BasePart") and c.CanCollide then c.CanCollide = false end
            end
        end
    end
end)

