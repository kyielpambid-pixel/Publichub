-- ESP Loop
local espFolder = Instance.new("Folder")
espFolder.Name = "KhubESP"
espFolder.Parent = GetHiddenGui()

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            for _, child in pairs(espFolder:GetChildren()) do child:Destroy() end
            
            if Toggle.ESP_Player then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local head = p.Character:FindFirstChild("Head")
                        if head then
                            local bb = Instance.new("BillboardGui")
                            bb.Name = p.Name
                            bb.Adornee = head
                            bb.Size = UDim2.new(5, 0, 5, 0)
                            bb.AlwaysOnTop = true
                            bb.Parent = espFolder
                            local lbl = Instance.new("TextLabel")
                            lbl.Size = UDim2.fromScale(1, 1)
                            lbl.BackgroundTransparency = 1
                            lbl.TextSize = 11
                            lbl.Font = Enum.Font.FredokaOne
                            lbl.TextColor3 = Color3.new(0, 1, 0)
                            lbl.Text = p.Name
                            lbl.Parent = bb
                        end
                    end
                end
            end
            
            local map = GetCurrentMap()
            if map then
                for _, o in pairs(map:GetChildren()) do
                    local part = o:FindFirstChildWhichIsA("BasePart")
                    if part then
                        local show = false
                        local name = ""
                        local color = Color3.new(1, 1, 1)
                        
                        if Toggle.ESP_Computer and o.Name == "ComputerTable" then
                            show = true; name = "Computer"; color = Color3.new(1, 1, 0)
                        elseif Toggle.ESP_FreezePod and o.Name == "FreezePod" then
                            show = true; name = "FreezePod"; color = Color3.new(0, 0, 1)
                        elseif Toggle.ESP_ExitDoor and o.Name == "ExitDoor" then
                            show = true; name = "ExitDoor"; color = Color3.new(1, 0, 0)
                        end
                        
                        if show then
                            local bb = Instance.new("BillboardGui")
                            bb.Adornee = part
                            bb.Size = UDim2.new(5, 0, 5, 0)
                            bb.AlwaysOnTop = true
                            bb.Parent = espFolder
                            local lbl = Instance.new("TextLabel")
                            lbl.Size = UDim2.fromScale(1, 1)
                            lbl.BackgroundTransparency = 1
                            lbl.TextSize = 11
                            lbl.Font = Enum.Font.FredokaOne
                            lbl.TextColor3 = color
                            lbl.Text = name
                            lbl.Parent = bb
                        end
                    end
                end
            end
        end)
    end
end)

MainTab:CreateSection("Beast")

MainTab:CreateSlider("Hit Aura Range", 5, 15, 10, function(Value) Toggle.HitAuraRange = Value end)
MainTab:CreateToggle("Hit Aura", function(Value) Toggle.HitAura = Value end)
MainTab:CreateSlider("Auto Tie Range", 5, 100, 5, function(Value) Toggle.AutoTieRange = Value end)
MainTab:CreateToggle("Auto Tie", function(Value) Toggle.AutoTie = Value end)

task.spawn(function()
    while true do
        task.wait(0.15)
        if LPC and LPR then
            local hammerEvent = LPC:FindFirstChild("HammerEvent", true)
            if hammerEvent then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local Stats = p:FindFirstChild("TempPlayerStatsModule")
                        if Stats then
                            local Ragdoll = Stats:FindFirstChild("Ragdoll")
                            local Captured = Stats:FindFirstChild("Captured")
                            if Ragdoll and Captured then
                                local root = findroot_or(p.Character)
                                if root and (root.Position - LPR.Position).Magnitude <= Toggle.HitAuraRange then
                                    if Toggle.HitAura and not (Ragdoll.Value or Captured.Value) then
                                        hammerEvent:FireServer("HammerHit", root)
                                    end
                                    if Toggle.AutoTie and Ragdoll.Value and not Captured.Value and (root.Position - LPR.Position).Magnitude <= Toggle.AutoTieRange then
                                        hammerEvent:FireServer("HammerTieUp", root, root.Position)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

