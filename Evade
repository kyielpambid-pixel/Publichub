-- Fullbright
local fbOriginal = nil
local fbConn = nil
local function captureFB()
	if fbOriginal then return end
	pcall(function()
		fbOriginal = {
			Brightness = Lighting.Brightness,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			GlobalShadows = Lighting.GlobalShadows,
			FogEnd = Lighting.FogEnd,
			ClockTime = Lighting.ClockTime,
		}
	end)
end
local function applyFB()
	pcall(function()
		Lighting.GlobalShadows = false
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
		Lighting.FogEnd = 1e10
		Lighting.ClockTime = 12
	end)
end
local function setFullBright(on)
	Config.EnableFullBright = on
	if on then
		captureFB()
		applyFB()
		if not fbConn then
			fbConn = RunService.Heartbeat:Connect(function()
				if Config.EnableFullBright then applyFB() end
			end)
		end
	else
		if fbConn then fbConn:Disconnect() fbConn = nil end
		if fbOriginal then
			pcall(function()
				for k, v in pairs(fbOriginal) do Lighting[k] = v end
			end)
		end
	end
	SaveSettings()
end

