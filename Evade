-- CONFIG
local ConfigTab = Window:Tab({ Title = "Config", Icon = "lucide:save" })
local cfgName = "default"
local ConfigFolder = "KHUB_Evade_Configs"
ConfigTab:Input({
	Title = "Config name",
	Placeholder = "default",
	Value = "default",
	Callback = function(text)
		cfgName = (text and text:gsub("%s+", "") ~= "") and text:gsub("%s+", "") or "default"
	end,
})
ConfigTab:Button({
	Title = "Save Config",
	Icon = "lucide:save",
	Callback = function()
		SaveSettings()
		pcall(function()
			if isfolder and not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
			if writefile then
				writefile(ConfigFolder .. "/" .. cfgName .. ".json", HttpService:JSONEncode(Config))
			end
		end)
		notify("Saved: " .. cfgName, "lucide:check")
	end,
})
ConfigTab:Button({
	Title = "Load Config",
	Icon = "lucide:folder-open",
	Callback = function()
		local ok, raw = pcall(function()
			return readfile(ConfigFolder .. "/" .. cfgName .. ".json")
		end)
		if ok and raw then
			local data = HttpService:JSONDecode(raw)
			for k, v in pairs(data) do
				if Config[k] ~= nil then Config[k] = v end
			end
			notify("Loaded: " .. cfgName, "lucide:check")
		else
			notify("Load failed", "lucide:x")
		end
	end,
})
ConfigTab:Button({
	Title = "Delete Config",
	Icon = "lucide:trash-2",
	Callback = function()
		pcall(function() delfile(ConfigFolder .. "/" .. cfgName .. ".json") end)
		notify("Deleted: " .. cfgName, "lucide:trash")
	end,
})

