-- Revive / Carry / AutoSave loops
task.spawn(function()
	while true do
		task.wait(0.5)
		if Config.EnableReviveAura or Config.EnableAutoCarry or Config.EnableAutoSave then
			local cs = FindCharService()
			local interact = GetInteractRemote()
			local hrp = getHRP()
			if cs and interact and hrp then
				local ok, chars = pcall(function() return cs:GetCharacters() end)
				if ok and chars then
					for i = 1, #chars do
						local v = chars[i]
						if type(v) == "table" and v.Done and not v.Local and v.PrimaryPart then
							local okS, isDown = pcall(function() return v.State and v.State.State == "Downed" end)
							if okS and isDown then
								local dist = (v.PrimaryPart.Position - hrp.Position).Magnitude
								if Config.EnableReviveAura and dist < 30 then
									pcall(function() interact:FireServer("Revive", v.Tag, true) end)
								end
								if Config.EnableAutoCarry and dist < Config.CarryRange then
									pcall(function() interact:FireServer("Carry", v.Tag) end)
								end
								if Config.EnableAutoSave and dist < 80 then
									pcall(function()
										hrp.CFrame = CFrame.new(v.PrimaryPart.Position + Vector3.new(0, 2, 0))
										interact:FireServer("Revive", v.Tag, true)
									end)
								end
							end
						end
					end
				end
			end
		end
	end
end)

-- Auto force spawn
task.spawn(function()
	local last = 0
	while true do
		task.wait(0.25)
		if Config.EnableAutoForceSpawn and (tick() - last >= 3) then
			local cs = FindCharService()
			if cs then
				local ok, chars = pcall(function() return cs:GetCharacters() end)
				if ok and chars then
					for i = 1, #chars do
						local v = chars[i]
						if type(v) == "table" and v.Local then
							local okS, isDown = pcall(function() return v.State and v.State.State == "Downed" end)
							if okS and isDown then
								last = tick()
								pcall(function()
									local r = ReplicatedStorage:FindFirstChild("Events")
									local sp = r and r:FindFirstChild("SetPlayerMode")
									if sp then sp:FireServer(true) end
								end)
							end
							break
						end
					end
				end
			end
		end
	end
end)

-- Anti bot
task.spawn(function()
	local last = 0
	while true do
		task.wait(0.25)
		if Config.EnableAntiBot and (tick() - last >= 0.3) then
			local hrp = getHRP()
			local cs = FindCharService()
			if hrp and cs then
				local ok, chars = pcall(function() return cs:GetCharacters() end)
				if ok and chars then
					for i = 1, #chars do
						local v = chars[i]
						if type(v) == "table" and v.AI == true and v.PrimaryPart then
							local dist = (v.PrimaryPart.Position - hrp.Position).Magnitude
							if dist < Config.AntiBotDistance then
								last = tick()
								local angle = math.random() * math.pi * 2
								local rad = math.random(20, 40)
								local cand = hrp.Position + Vector3.new(math.cos(angle) * rad, 0, math.sin(angle) * rad)
								hrp.CFrame = CFrame.new(cand.X, hrp.Position.Y + 3, cand.Z)
								break
							end
						end
					end
				end
			end
		end
	end
end)

