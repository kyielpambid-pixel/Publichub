-- Fly (superhero style)
local flyConn = nil
local function setFly(on)
	Config.EnableFly = on
	if on then
		if flyConn then return end
		flyConn = RunService.RenderStepped:Connect(function()
			if not Config.EnableFly then return end
			local hrp = getHRP()
			local hum = getHum()
			if not hrp or not hum then return end
			local cam = Workspace.CurrentCamera
			local move = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
			if move.Magnitude > 0 then
				hrp.AssemblyLinearVelocity = move.Unit * Config.FlySpeed
			else
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
			hum.PlatformStand = true
		end)
	else
		if flyConn then flyConn:Disconnect() flyConn = nil end
		local hum = getHum()
		if hum then hum.PlatformStand = false end
	end
	SaveSettings()
end

-- Figure 8
local figure8T, figure8CenterCF, figure8Conn, figure8PrevWalk = 0, nil, nil, 16
local function StopFigure8()
	if figure8Conn then figure8Conn:Disconnect() figure8Conn = nil end
	local hum = getHum()
	if hum then hum.WalkSpeed = figure8PrevWalk end
	figure8CenterCF = nil
end
local function StartFigure8()
	StopFigure8()
	local hrp = getHRP()
	local hum = getHum()
	if not hrp or not hum then return end
	figure8PrevWalk = hum.WalkSpeed
	hum.WalkSpeed = 0
	figure8T = 0
	local look = hrp.CFrame.LookVector
	figure8CenterCF = CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(look.X, look.Z), 0)
	figure8Conn = RunService.Heartbeat:Connect(function(dt)
		if not Config.EnableFigure8 then return end
		local hrp2 = getHRP()
		if not hrp2 or not figure8CenterCF then return end
		figure8T = figure8T + Config.Figure8Speed * dt
		local R, t = Config.Figure8Radius, figure8T
		local localX = R * math.cos(t)
		local localZ = (R * 0.5) * math.sin(2 * t)
		local tanX = -R * math.sin(t)
		local tanZ = R * math.cos(2 * t)
		local right, forward, origin = figure8CenterCF.RightVector, figure8CenterCF.LookVector, figure8CenterCF.Position
		local worldPos = origin + right * localX + forward * localZ
		worldPos = Vector3.new(worldPos.X, origin.Y, worldPos.Z)
		local worldTan = right * tanX + forward * tanZ
		if worldTan.Magnitude > 0.01 then
			hrp2.CFrame = CFrame.new(worldPos, worldPos + worldTan)
		else
			hrp2.CFrame = CFrame.new(worldPos)
		end
		hrp2.AssemblyLinearVelocity = Vector3.zero
	end)
end

-- Char service / interact (Evade internals)
local CharServiceModule, InteractRemote
local function FindCharService()
	if CharServiceModule then return CharServiceModule end
	if not getgc then return nil end
	local ok, gcTable = pcall(getgc, true)
	if not ok or not gcTable then return nil end
	for i = 1, #gcTable do
		local v = gcTable[i]
		if type(v) == "table" then
			local ok2, has = pcall(rawget, v, "GetCharacters")
			if ok2 and has then CharServiceModule = v break end
		end
	end
	return CharServiceModule
end
local function GetInteractRemote()
	if InteractRemote then return InteractRemote end
	pcall(function()
		InteractRemote = ReplicatedStorage:WaitForChild("Events", 5):WaitForChild("Interact", 5)
	end)
	return InteractRemote
end

-- ESP Down
local espDownEntries = {}
local espDownConn = nil
local function espDownClearAll()
	for tag, e in pairs(espDownEntries) do
		pcall(function() if e.highlight then e.highlight:Destroy() end end)
		pcall(function() if e.billboard then e.billboard:Destroy() end end)
	end
	table.clear(espDownEntries)
end
local function setEspDown(on)
	Config.EnableEspDown = on
	if on then
		if espDownConn then return end
		local acc = 0
		espDownConn = RunService.Heartbeat:Connect(function(dt)
			acc = acc + dt
			if acc < 0.2 then return end
			acc = 0
			local cs = FindCharService()
			if not cs then return end
			local ok, chars = pcall(function() return cs:GetCharacters() end)
			if not ok or not chars then return end
			local downedNow = {}
			for i = 1, #chars do
				local v = chars[i]
				if type(v) == "table" and v.Done and not v.Local and v.Tag and v.PrimaryPart then
					local okS, isDown = pcall(function() return v.State and v.State.State == "Downed" end)
					if okS and isDown then downedNow[v.Tag] = v end
				end
			end
			for tag in pairs(espDownEntries) do
				if not downedNow[tag] then
					local e = espDownEntries[tag]
					pcall(function() if e.highlight then e.highlight:Destroy() end end)
					pcall(function() if e.billboard then e.billboard:Destroy() end end)
					espDownEntries[tag] = nil
				end
			end
			for tag, v in pairs(downedNow) do
				if not espDownEntries[tag] then
					local hl = Instance.new("Highlight")
					hl.Adornee = v.PrimaryPart.Parent or v.PrimaryPart
					hl.FillColor = Color3.fromRGB(255, 140, 0)
					hl.OutlineColor = Color3.fromRGB(255, 140, 0)
					hl.FillTransparency = 0.5
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Parent = v.PrimaryPart
					local bb = Instance.new("BillboardGui")
					bb.Adornee = v.PrimaryPart
					bb.AlwaysOnTop = true
					bb.Size = UDim2.new(0, 200, 0, 30)
					bb.StudsOffset = Vector3.new(0, 3, 0)
					bb.Parent = v.PrimaryPart
					local lbl = Instance.new("TextLabel")
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.BackgroundTransparency = 1
					lbl.Text = "[DOWN]"
					lbl.TextColor3 = Color3.fromRGB(255, 140, 0)
					lbl.Font = Enum.Font.GothamBold
					lbl.TextSize = 14
					lbl.Parent = bb
					espDownEntries[tag] = { highlight = hl, billboard = bb }
				end
			end
		end)
	else
		if espDownConn then espDownConn:Disconnect() espDownConn = nil end
		espDownClearAll()
	end
	SaveSettings()
end

-- Main movement loop state
local autoJumpNext, autoCrouchNext = 0, 0
local trimpWasAir = false
local voidThreshold = -50

RunService.Heartbeat:Connect(function()
	local hrp = getHRP()
	local hum = getHum()
	if not hrp or not hum or hum.Health <= 0 then return end

	-- Speed
	if Config.EnableSpeedMultiplier then
		hum.WalkSpeed = 16 * Config.SpeedMultiplierValue
	end

	-- Teleport walk
	if Config.EnableTeleportWalk then
		local move = hum.MoveDirection
		if move.Magnitude > 0 then
			hrp.CFrame = hrp.CFrame + move * (Config.TeleportMovementSpeed * 0.05)
		end
	end

	-- Jump height
	if Config.EnableEnhancedJump then
		hum.UseJumpPower = true
		hum.JumpPower = Config.JumpHeight
	end

	-- Gravity
	if Config.EnableGravityMod then
		Workspace.Gravity = 196.2 * Config.GravityScale
	end

	-- Auto jump
	if Config.AutoJump then
		local now = tick()
		if now >= autoJumpNext and hum.FloorMaterial ~= Enum.Material.Air then
			hum.Jump = true
			autoJumpNext = now + (1 / math.max(Config.AutoJumpSpeed, 0.5))
		end
	end

	-- Infinite slide (simple forward boost while shift-like crouch state)
	if Config.EnableInfiniteSlide then
		local move = hum.MoveDirection
		if move.Magnitude > 0.1 then
			local vel = hrp.AssemblyLinearVelocity
			local boost = move.Unit * Config.InfiniteSlideSpeed
			hrp.AssemblyLinearVelocity = Vector3.new(boost.X, vel.Y, boost.Z)
		end
	end

	-- Frontal jump boost in air
	if Config.EnableFrontalJump and hum.FloorMaterial == Enum.Material.Air then
		local look = hrp.CFrame.LookVector
		local vel = hrp.AssemblyLinearVelocity
		local add = look * (Config.FrontalJumpSpeed * 0.02)
		hrp.AssemblyLinearVelocity = Vector3.new(vel.X + add.X, vel.Y, vel.Z + add.Z)
	end

	-- Back jump
	if Config.EnableBackJump and hum.FloorMaterial == Enum.Material.Air then
		local look = -hrp.CFrame.LookVector
		local vel = hrp.AssemblyLinearVelocity
		local add = look * (Config.BackJumpSpeed * 0.02)
		hrp.AssemblyLinearVelocity = Vector3.new(vel.X + add.X, vel.Y, vel.Z + add.Z)
	end

	-- Void escape
	if Config.EnableVoidEscape and hrp.Position.Y < voidThreshold then
		pcall(function()
			hrp.CFrame = CFrame.new(0, 50, 0)
		end)
	end

	-- Auto trimp
	if Config.EnableAutoTrimp then
		local isAir = hum.FloorMaterial == Enum.Material.Air
		if isAir then
			local vel = hrp.AssemblyLinearVelocity
			if vel.Y < 0 then
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y * 0.5, vel.Z)
			end
		elseif trimpWasAir then
			local vel = hrp.AssemblyLinearVelocity
			local hs = Vector3.new(vel.X, 0, vel.Z).Magnitude
			local impulse = math.max(hs, 20) * Config.AutoTrimpMultiplier
			hrp.AssemblyLinearVelocity = Vector3.new(vel.X, impulse, vel.Z)
		end
		trimpWasAir = isAir
	end

	-- FOV
	if Config.EnableFOV then
		camera.FieldOfView = Config.FOV
	end
end)

