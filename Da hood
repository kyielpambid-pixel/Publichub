local function FormatMoney(value)
	local n = math.floor(tonumber(value) or 0)
	local sign = n < 0 and "-" or ""
	local s = tostring(math.abs(n))
	while true do
		local replaced, count = s:gsub("^(%d+)(%d%d%d)", "%1,%2")
		s = replaced
		if count == 0 then break end
	end
	return sign .. s
end

