	tag.Text = "KHUB"
	tag.Font = Enum.Font.GothamBold
	tag.TextSize = 9
	tag.TextColor3 = colors.gold
	tag.ZIndex = 101
	tag.Parent = orb

	local function show(on)
		win.Visible = on
		orb.Visible = not on
	end
	minBtn.MouseButton1Click:Connect(function() show(false) end)
	orb.MouseButton1Click:Connect(function() show(true) end)

	local dragging, dStart, sPos
	header.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dStart = i.Position; sPos = win.Position
		end
	end)
	header.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	local oDrag, oStart, oPos
	orb.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			oDrag = true; oStart = i.Position; oPos = orb.Position
		end
	end)
	orb.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			oDrag = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
		if dragging and dStart then
			local d = i.Position - dStart
			win.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
		end
		if oDrag and oStart then
			local d = i.Position - oStart
			orb.Position = UDim2.new(oPos.X.Scale, oPos.X.Offset + d.X, oPos.Y.Scale, oPos.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.KeyCode == Enum.KeyCode.RightShift or i.KeyCode == Enum.KeyCode.RightControl or i.KeyCode == Enum.KeyCode.K then
			show(not win.Visible)
		end
	end)
end

function HUB.Unload()
	if HUB.dead then return end
	HUB.dead = true
	flying = false; noclip = false; infJump = false
	antiRagdoll = false; wsEnabled = false; jpEnabled = false; hipEnabled = false
	pcall(function() if flyConn then flyConn:Disconnect() end end)
	pcall(stopNoclip)
	pcall(stopAntiRagdoll)
	pcall(function() if hitboxEnabled then stopHitboxLoop() end end)
	for _, c in ipairs(HUB.conns) do pcall(function() c:Disconnect() end) end
	for _, d in ipairs(HUB.drawings) do pcall(function() d:Remove() end) end
	if fovCircle then pcall(function() fovCircle:Remove() end) end
	for _, h in ipairs(HUB.highlights) do pcall(function() h:Destroy() end) end
	for part, hl in pairs(moneyESP) do pcall(function() hl:Destroy() end); moneyESP[part] = nil end
	pcall(function()
		local hum = GetHumanoid()
		if hum then hum.PlatformStand = false; hum.WalkSpeed = 16; hum.JumpPower = 50; hum.HipHeight = 2 end
	end)
	Workspace.Gravity = defaultGravity
	Camera.FieldOfView = defaultFOV
	pcall(function() gui:Destroy() end)
	_G.KHUB_DaHood = nil
end

