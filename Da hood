	if not hrp then return end
	if tweenTP then
		local dist = (hrp.Position - cf.Position).Magnitude
		local tw = TweenService:Create(hrp, TweenInfo.new(math.clamp(dist / 80, 0.4, 1.5), Enum.EasingStyle.Quad), { CFrame = cf })
		tw:Play()
	else
		hrp.CFrame = cf
	end
end

