    Name      = "Stats",
    Icon      = "chart-line",
    SearchBar = false,
})

StatsTab:CreateSection("Statistics")

local kpmLabel = StatsTab:CreateLabel("Kills Per Minute: 0.00")
local killsLabel = StatsTab:CreateLabel("Total Kills: 0")

task.spawn(function()
    while task.wait(1) do
        local currentKills = (leaderstats and leaderstats:FindFirstChild("Kills") and leaderstats.Kills.Value) or 0
        local elapsed = (tick() - startTime) / 60
        kpmLabel:Set(string.format("Kills Per Minute: %.2f", (currentKills - startKills) / math.max(0.01, elapsed)))
        killsLabel:Set(string.format("Total Kills: %d", currentKills))
    end
end)

