local function doSellAll()
	local prof = fetchProfile()
	local inv = invArtifacts(prof)
	if #inv == 0 then return end
	local count, total = 0, 0
	for _, v in ipairs(inv) do
		count += 1
		total += scoreValue(v.Record)
	end
	local part = sellPart(true)
	if part and part:IsA("BasePart") then
		tpCF(part.CFrame)
		task.wait(0.25)
	end
	local r = remote("RequestSellAll")
	if r then pcall(function() r:FireServer(count, total) end) end
	task.wait(SELL_DELAY)
end

local function doSellFiltered()
	local prof = fetchProfile()
	local inv = invArtifacts(prof)
	local r = remote("RequestSellEquipped")
	if not r then return end
	local part = sellPart(false)
	for _, v in ipairs(inv) do
		if not alive() or not State.AutoSell then break end
		local rar = v.Record.RarityId
		if next(State.SellRarities) == nil or State.SellRarities[rar] or State.SellRarities[tostring(rar)] then
			if equipArtifact(v.Uid) then
				if part and part:IsA("BasePart") then
					tpCF(part.CFrame)
					task.wait(0.25)
				end
				pcall(function() r:FireServer(v.Uid) end)
				task.wait(SELL_DELAY)
			end
		end
	end
end

local function doSell()
	if State.SellMode == "Sell Filtered" then doSellFiltered() else doSellAll() end
end

