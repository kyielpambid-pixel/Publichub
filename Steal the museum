	pcall(function() Treadmills = require(shared.Config.Treadmills) end)
	pcall(function() MuseumTiers = require(shared.Config.MuseumTiers) end)
	table.clear(ZoneNames)
	table.clear(ZoneByCat)
	if MuseumTiers and MuseumTiers.Order then
		for _, v in ipairs(MuseumTiers.Order) do
			local def = MuseumTiers.Get and MuseumTiers.Get(v) or (MuseumTiers.Defs and MuseumTiers.Defs[v])
			if def and def.DisplayName then
				table.insert(ZoneNames, def.DisplayName)
				local cat = tonumber(def.CategoryId) or tonumber(v)
				if cat then ZoneByCat[cat] = def.DisplayName end
			end
		end
	end
	table.clear(RarityList)
	if Rarities and Rarities.Order then
		for _, v in ipairs(Rarities.Order) do table.insert(RarityList, v) end
	end
	return true
end
