	if ok and r then return r end
	local folder = RS:FindFirstChild("STM_Remotes") or RS:FindFirstChild("Shared")
	if folder then
		local f = folder:FindFirstChild(name, true)
		if f then return f end
	end
	return nil
end

local function loadModules()
	local ok, shared = pcall(function() return RS:WaitForChild("Shared", 8) end)
	if not ok or not shared then return false end
	pcall(function() Remotes = require(shared.Remotes) end)
	pcall(function() Rarities = require(shared.Config.Rarities) end)
	pcall(function() Mutations = require(shared.Config.Mutations) end)
	pcall(function() Quality = require(shared.Config.Quality) end)
	pcall(function() Index = require(shared.Config.Artifacts.Index) end)
	pcall(function() HeadMasks = require(shared.Config.HeadMasks) end)
