local function doPlace()
	local prof = fetchProfile()
	local plot = myPlot()
	local inv = invArtifacts(prof)
	local slots = freeSlots(plot, prof)
	if #inv == 0 or #slots == 0 then return end
	for i, item in ipairs(inv) do
		local slot = slots[i]
		if not slot or not alive() or not State.AutoPlace then break end
		placeOne(item, slot)
		task.wait(PLACE_DELAY)
	end
end

local function doReplaceBetter()
	local prof = fetchProfile()
	local plot = myPlot()
	if not plot then return end
	local inv = invArtifacts(prof)
	local placed = placedArtifacts(prof)
	if #inv == 0 or #placed == 0 then return end
	local best, worst = inv[1], placed[1]
	if not best or not worst or best.Score <= worst.Score then return end
	local pickup = remote("RequestPickupArtifact")
	if not pickup then return end
	local slotIdx = worst.SlotIndex
	pcall(function() pickup:FireServer(worst.Uid) end)
	task.wait(PLACE_DELAY)
	if not alive() then return end
	prof = fetchProfile()
	local slotModel
	local slotsFolder = plot:FindFirstChild("Slots")
	if slotsFolder and slotIdx then
		slotModel = slotsFolder:FindFirstChild(tostring(slotIdx))
		if not slotModel then
			for _, ch in ipairs(slotsFolder:GetChildren()) do
				if tonumber(ch:GetAttribute("SlotIndex")) == slotIdx then slotModel = ch break end
			end
		end
	end
	local spawn = slotModel and slotModel:FindFirstChild("SpawnPart", true)
	local prompt = spawn and spawn:FindFirstChild("PlacePrompt")
	if not (spawn and prompt and prompt.Enabled) then
		local free = freeSlots(plot, prof)
		if free[1] then spawn, prompt = free[1].Spawn, free[1].Prompt end
	end
	if spawn and prompt then
		placeOne(best, { Spawn = spawn, Prompt = prompt })
	end
end

