local function mutationOf(id)
	if not Mutations then return nil end
	return Mutations.Get and (Mutations.Get(id) or Mutations.Get("None")) or nil
end

local function scoreIncome(rec)
	if type(rec) ~= "table" or not Index then return 0 end
	local art = Index.Get and Index.Get(rec.ArtifactId)
	if not art then return 0 end
	local base = tonumber(art.BaseIncome) or 0
	local rar = Rarities and Rarities.Get and Rarities.Get(rec.RarityId)
	local mut = mutationOf(rec.MutationId)
	local rm = rar and tonumber(rar.IncomeMultiplier) or 1
	local mm = mut and tonumber(mut.IncomeMultiplier) or 1
	local qm = 1
	if Quality and Quality.IncomeMultiplier then
		local ok, v = pcall(Quality.IncomeMultiplier, tonumber(rec.Quality) or 10)
		if ok and type(v) == "number" then qm = v end
	end
	return base * rm * mm * qm
end

local function scoreValue(rec)
	if type(rec) ~= "table" or not Index then return 0 end
	local art = Index.Get and Index.Get(rec.ArtifactId)
	if not art then return 0 end
	local base = tonumber(art.BaseValue) or 0
	local rar = Rarities and Rarities.Get and Rarities.Get(rec.RarityId)
	local mut = mutationOf(rec.MutationId)
	local rm = rar and tonumber(rar.ValueMultiplier) or 1
	local mm = mut and tonumber(mut.ValueMultiplier) or 1
	return math.floor(base * rm * mm + 0.5)
end

local function invArtifacts(prof)
	local out = {}
	if not (prof and type(prof.Artifacts) == "table") then return out end
	for uid, rec in pairs(prof.Artifacts) do
		if type(rec) == "table" and rec.State == "Inventory" then
			table.insert(out, { Uid = uid, Record = rec, Score = scoreIncome(rec) })
		end
	end
	table.sort(out, function(a, b) return a.Score > b.Score end)
	return out
end

local function placedArtifacts(prof)
	local out = {}
	if not (prof and type(prof.Artifacts) == "table") then return out end
	for uid, rec in pairs(prof.Artifacts) do
		if type(rec) == "table" and rec.State == "Placed" then
			local si = rec.Placement and tonumber(rec.Placement.SlotIndex)
			table.insert(out, { Uid = uid, Record = rec, Score = scoreIncome(rec), SlotIndex = si })
		end
	end
	table.sort(out, function(a, b) return a.Score < b.Score end)
	return out
end

local function zoneAllowed(catId)
	if next(State.StealZones) == nil then return true end
	local name = ZoneByCat[tonumber(catId)]
	return name and State.StealZones[name] == true
end

local function catFromAttr(attr)
	local n = string.match(tostring(attr or ""), "^category_(%d+)_")
	return n and tonumber(n) or nil
end

local function worldSteals()
	local folder = Workspace:FindFirstChild("Runtime") and Workspace.Runtime:FindFirstChild("WorldArtifacts")
	local list = {}
	if not folder then return list end
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") then
			local attr = child:GetAttribute("ArtifactId")
			local cat = catFromAttr(attr)
			if zoneAllowed(cat) then
				local part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)
				local prompt = part and part:FindFirstChild("StealPrompt")
				if part and prompt and prompt.Enabled then
					local rec = {
						ArtifactId = attr,
						RarityId = child:GetAttribute("RarityId"),
						MutationId = child:GetAttribute("MutationId"),
						Quality = child:GetAttribute("Quality"),
					}
					table.insert(list, { Model = child, Spawn = part, Prompt = prompt, Score = scoreIncome(rec), Rec = rec })
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.Score > b.Score end)
	return list
end

local function freeSlots(plot, prof)
	local slots = {}
	if not plot then return slots end
	local folder = plot:FindFirstChild("Slots")
	if not folder then return slots end
	local used = {}
	for _, p in ipairs(placedArtifacts(prof)) do
		if p.SlotIndex then used[p.SlotIndex] = true end
	end
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") and child:GetAttribute("SlotLocked") ~= true then
			local idx = tonumber(child:GetAttribute("SlotIndex"))
			if idx and not used[idx] then
				local spawn = child:FindFirstChild("SpawnPart", true)
				local prompt = spawn and spawn:FindFirstChild("PlacePrompt")
				if spawn and prompt and prompt.Enabled then
					table.insert(slots, { Slot = child, Index = idx, Spawn = spawn, Prompt = prompt })
				end
			end
		end
	end
	table.sort(slots, function(a, b) return a.Index < b.Index end)
	return slots
end

local function equipArtifact(uid)
	local hum = getHum()
	if not hum then return false end
	hum:UnequipTools()
	task.wait(0.12)
	if not alive() then return false end
	local tool
	local char, bp = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
	for _, cont in ipairs({ char, bp }) do
		if cont then
			for _, ch in ipairs(cont:GetChildren()) do
				if ch:IsA("Tool") and ch:GetAttribute("ArtifactUid") == uid then tool = ch break end
			end
		end
		if tool then break end
	end
	if not tool then return false end
	if tool.Parent ~= LocalPlayer.Character then
		hum:EquipTool(tool)
		task.wait(0.2)
	end
	return true
end

local function waitCarry(timeout)
	local untilT = os.clock() + (timeout or 3)
	while alive() and os.clock() < untilT do
		if State.Carrying then return true end
		task.wait(0.1)
	end
	return State.Carrying ~= nil
end

local function waitInv(uid, timeout)
	local untilT = os.clock() + (timeout or 4)
	while alive() and os.clock() < untilT do
		local prof = fetchProfile()
		local art = prof and prof.Artifacts and prof.Artifacts[uid]
		if art and art.State == "Inventory" then return true end
		if not State.Carrying and art == nil then return false end
		task.wait(0.2)
	end
	return false
end

local function waitPlaced(uid, timeout)
	local untilT = os.clock() + (timeout or 3)
	while alive() and os.clock() < untilT do
		local prof = fetchProfile()
		local art = prof and prof.Artifacts and prof.Artifacts[uid]
		if art and art.State == "Placed" then return true end
		task.wait(0.2)
	end
	return false
end

local function placeOne(item, slotInfo)
	if not equipArtifact(item.Uid) then
		task.wait(0.4)
		if not equipArtifact(item.Uid) then return false end
	end
	tpCF(slotInfo.Spawn.CFrame)
	task.wait(0.25)
	if not alive() then return false end
	firePrompt(slotInfo.Prompt)
	return waitPlaced(item.Uid, PLACE_DELAY + 1)
end

