	if not (prof and prof.Unlocks) then return end
	local slots = tonumber(prof.Unlocks.ActiveArtifactSlots) or 10
	local price = Plots and Plots.GetActiveSlotUpgradePrice and Plots.GetActiveSlotUpgradePrice(slots)
	local cash = tonumber(prof.Cash) or 0
	if type(price) == "number" and cash >= price then
		local r = remote("RequestUpgradePlot")
		if r then pcall(function() r:FireServer() end) end
	end
end

local function doBuyMasks()
	local prof = fetchProfile()
	if not prof or not HeadMasks then return end
	local cash = tonumber(prof.Cash) or 0
	local owned = prof.OwnedMasks or {}
	local buy = remote("RequestBuyMask")
	local equip = remote("RequestEquipMask")
	if not buy then return end
	local bestId, bestOrder = prof.EquippedMaskId, -1
	local sorted = HeadMasks.Sorted and HeadMasks.Sorted() or {}
	for _, v in ipairs(sorted) do
		if not alive() or not State.AutoBuyMasks then break end
		local id, price, order = v.Id, tonumber(v.Price) or 0, tonumber(v.Order) or 0
		if owned[id] then
			if order > bestOrder then bestOrder, bestId = order, id end
		elseif cash >= price then
			pcall(function() buy:FireServer(id) end)
			task.wait(PLACE_DELAY)
			prof = fetchProfile()
			cash = tonumber(prof and prof.Cash) or cash
			owned = prof and prof.OwnedMasks or owned
			if owned[id] and order > bestOrder then bestOrder, bestId = order, id end
		end
	end
	if equip and bestId and bestId ~= "" and bestId ~= (prof and prof.EquippedMaskId) then
		pcall(function() equip:FireServer(bestId) end)
	end
end

local function doUpgradeTreadmill()
	local prof = fetchProfile()
	if not (prof and prof.Unlocks and Treadmills) then return end
	local lvl = tonumber(prof.Unlocks.TreadmillLevel) or 1
	local price = Treadmills.GetUpgradePrice and Treadmills.GetUpgradePrice(lvl)
	local cash = tonumber(prof.Cash) or 0
	if type(price) == "number" and cash >= price then
		local r = remote("RequestUpgradeTreadmill")
		if r then pcall(function() r:FireServer() end) end
	end
end

local function treadmillPart(plot)
	if not plot then return nil end
	local tm = plot:FindFirstChild("Treadmill")
	if not tm then return nil end
	local prof = State.Profile or fetchProfile()
	local lvl = prof and prof.Unlocks and tonumber(prof.Unlocks.TreadmillLevel)
	if lvl then
		local model = tm:FindFirstChild(tostring(lvl))
		if model then
			local p = model:FindFirstChild("StandPart", true) or model:FindFirstChild("Hitbox", true)
			if p and p:IsA("BasePart") then return p end
		end
	end
	for _, child in ipairs(tm:GetChildren()) do
		if child:IsA("Model") and child.Name ~= "UpgradeSign" then
			local p = child:FindFirstChild("StandPart", true) or child:FindFirstChild("Hitbox", true)
			if p and p:IsA("BasePart") then return p end
		end
	end
	local p = tm:FindFirstChild("StandPart", true) or tm:FindFirstChild("Hitbox", true)
	return p and p:IsA("BasePart") and p or nil
end

