	local function fadeOutAudio(duration)
		if not introSound then return end
		local startVolume = introSound.Volume
		local steps = 10
		for i = 1, steps do
			if not introSound then break end
			introSound.Volume = startVolume * (1 - (i / steps))
			_tw(duration / steps)
		end
		if introSound then
			introSound.Volume = 0
			introSound:Stop()
		end
	end

