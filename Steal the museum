			local cur = intensity * (1 - (elapsed / duration))
			if cur < 1 then cur = 1 end
			local ox = math.random(-_mf(cur), _mf(cur))
			local oy = math.random(-_mf(cur * 0.5), _mf(cur * 0.5))
			leftLabel.Position = _U(0.5, -12 + ox, 0.5, oy)
