local function setInstantPrompt(on)
	if not on then
		for pr, data in pairs(promptOrig) do
			if pr.Parent then
				pr.HoldDuration = data.HoldDuration
				pr.MaxActivationDistance = data.MaxActivationDistance
				pr.RequiresLineOfSight = data.RequiresLineOfSight
			end
		end
		table.clear(promptOrig)
		return
	end
	local function apply(pr)
		if not pr:IsA("ProximityPrompt") then return end
