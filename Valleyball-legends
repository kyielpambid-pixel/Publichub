UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift or i.KeyCode == Enum.KeyCode.RightControl or i.KeyCode == Enum.KeyCode.K then
        setVisible(not Win.Visible)
    end
    if i.KeyCode == Enum.KeyCode.R then doSilentSpike() end
    if i.KeyCode == Enum.KeyCode.N then
        State.autoCounter = not State.autoCounter
        Config.AutoCounter = State.autoCounter
        print("[KHUB] Auto Counter:", State.autoCounter)
    end
end)

