-- ============================================================
-- CONFIG SAVE/LOAD
-- ============================================================
local CONFIG_FOLDER = "KHUB_Configs"
local selectedConfig = nil
local configList = {}

local function ensureFolder()
    pcall(function()
        if makefolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
    end)
end

local function listConfigs()
    configList = {}
    pcall(function()
        if listfiles and isfolder and isfolder(CONFIG_FOLDER) then
            for _, path in ipairs(listfiles(CONFIG_FOLDER)) do
                local name = string.match(path, "([^/\\]+)%.json$")
                if name then table.insert(configList, name) end
            end
        end
    end)
    table.sort(configList)
    return configList
end

local function saveConfig(name, data)
    if not name or name == "" then return false, "Empty name" end
    ensureFolder()
    local ok, err = pcall(function()
        if not writefile then error("writefile not supported") end
        writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data or Config))
    end)
    return ok, err
end

local function loadConfig(name)
    if not name or name == "" then return nil, "No config" end
    local ok, result = pcall(function()
        if not readfile or not isfile then error("readfile not supported") end
        local path = CONFIG_FOLDER .. "/" .. name .. ".json"
        if not isfile(path) then error("File not found") end
        return HttpService:JSONDecode(readfile(path))
    end)
    if ok then return result else return nil, result end
end

local function deleteConfig(name)
    if not name or name == "" then return false, "No config" end
    local ok, err = pcall(function()
        if not delfile or not isfile then error("delfile not supported") end
        local path = CONFIG_FOLDER .. "/" .. name .. ".json"
        if isfile(path) then delfile(path) else error("File not found") end
    end)
    return ok, err
end

