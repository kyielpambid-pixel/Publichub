local function switchPage(name, title)
    for k, p in pairs(pages) do p.Visible = (k == name) end
    PageTitle.Text = title or name
    tabButtons.ActiveId = name

    for id, btn in pairs(tabButtons) do
        if type(id) == "string" and not id:find("_") then
            local active    = (id == name)
            local iconFrame = tabButtons[id .. "_Frame"]
            local glow      = tabButtons[id .. "_Glow"]
            local bar       = tabButtons[id .. "_Bar"]
            local lbl       = tabButtons[id .. "_Label"]
            local icon      = tabButtons[id .. "_Icon"]
            local stroke    = tabButtons[id .. "_Stroke"]

            if active then
                TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundTransparency = 0.05 }):Play()
                if iconFrame then TweenService:Create(iconFrame, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play() end
                if glow then TweenService:Create(glow, TweenInfo.new(0.3), { BackgroundTransparency = 0.55, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 3, 0.5, -17) }):Play() end
                if bar then bar.Visible = true end
                if lbl then lbl.TextColor3 = THEME.gold end
                if icon then icon.ImageColor3 = Color3.fromRGB(255, 255, 255) end
                if stroke then stroke.Color = THEME.gold; stroke.Transparency = 0.15 end
            else
                TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundTransparency = 0.25 }):Play()
                if iconFrame then TweenService:Create(iconFrame, TweenInfo.new(0.2), { BackgroundTransparency = 0.15 }):Play() end
                if glow then TweenService:Create(glow, TweenInfo.new(0.25), { BackgroundTransparency = 0.85, Size = UDim2.fromOffset(28, 28), Position = UDim2.new(0, 6, 0.5, -14) }):Play() end
                if bar then bar.Visible = false end
                if lbl then lbl.TextColor3 = THEME.text end
                if icon then icon.ImageColor3 = Color3.fromRGB(220, 200, 240) end
                if stroke then stroke.Color = THEME.accent; stroke.Transparency = 0.45 end
            end
        end
    end
end

