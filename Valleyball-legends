local function updateScale()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vx = cam.ViewportSize.X
    local scale
    if vx < 500 then scale = math.clamp(vx / 900, 0.55, 0.85)
    elseif vx < 900 then scale = math.clamp(vx / 1100, 0.7, 0.95)
    else scale = math.clamp(vx / 1350, 0.8, 1.15) end
    WinUIScale.Scale = scale
end
pcall(function()
    Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end)
