local function getBallPart(ball)
    for _, d in ipairs(ball:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end

local function updateHitboxes()
    if not State.hitboxEnabled then return end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name:match("^CLIENT_BALL_%d+$") then
            local hb = child:FindFirstChild("PARASITE.BALL")
            local base = getBallPart(child)
            if not hb and base then
                local part = Instance.new("Part")
                part.Name = "PARASITE.BALL"
                part.Shape = Enum.PartType.Ball
                part.Size = Vector3.new(2, 2, 2) * State.hitboxScale
                part.CFrame = base.CFrame
                part.Anchored = true
                part.CanCollide = false
                part.Transparency = State.hitboxTransparency
                part.Material = Enum.Material.ForceField
                part.Color = State.hitboxColor
                part.Parent = child
            elseif hb then
                hb.Size = Vector3.new(2, 2, 2) * State.hitboxScale
                hb.Color = State.hitboxColor
                hb.Transparency = State.hitboxTransparency
            end
        end
    end
end

local function clearHitboxes()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name:match("^CLIENT_BALL_%d+$") then
            local hb = child:FindFirstChild("PARASITE.BALL")
            if hb then hb:Destroy() end
        end
    end
end

local function setHitboxColor(name)
    local map = {
        Invisible = {Color3.fromRGB(255,255,255), 1},
        White     = {Color3.fromRGB(255,255,255), 0.3},
        Green     = {Color3.fromRGB(0,255,0),     0.3},
        Blue      = {Color3.fromRGB(0,0,255),     0.3},
        Red       = {Color3.fromRGB(255,0,0),     0.3},
        Yellow    = {Color3.fromRGB(255,255,0),   0.3},
        Purple    = {Color3.fromRGB(128,0,128),   0.3},
        Orange    = {Color3.fromRGB(255,165,0),   0.3},
        Pink      = {Color3.fromRGB(255,105,180), 0.3},
    }
    local e = map[name]
    if e then
        State.hitboxColor = e[1]
        State.hitboxTransparency = e[2]
        if State.hitboxEnabled then updateHitboxes() end
    end
end

local ballService = ReplicatedStorage.Packages
    and ReplicatedStorage.Packages._Index
    and ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"]
    and ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"].knit
    and ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"].knit.Services
    and ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"].knit.Services.BallService

local function installSpikeHooks()
    if not ballService then return end
    if State._spikeHooked then return end
    State._spikeHooked = true

    local meta = getrawmetatable and getrawmetatable(game)
    if not meta then return end
    local orig = meta.__namecall
    if setreadonly then setreadonly(meta, false) end

    meta.__namecall = function(self, ...)
        local method = getnamecallmethod and getnamecallmethod()
        local args = {...}
        if self == ballService.RF.Interact and method == "InvokeServer" then
            local a1 = args[1]
            if type(a1) == "table" then
                if State.redirectSpike and a1.Move == "Spike" then
                    local look = Workspace.CurrentCamera.CFrame.LookVector
                    a1.LookVector = look
                    a1.Direction = look
                    if a1.MoveDirection then a1.MoveDirection = look end
                end
                if State.sanjuTilt and a1.Move == "Spike" then
                    if a1.TiltDirection and a1.LookVector then
                        local td = a1.TiltDirection
                        if math.abs(td.X) > 0.01 or math.abs(td.Z) > 0.01 then
                            local lv = a1.LookVector
                            local v = Vector3.new(td.X, 0, td.Z)
                            a1.LookVector = Vector3.new(lv.X + v.X * 0.3, lv.Y, lv.Z + v.Z * 0.3).Unit
                            a1.TiltDirection = Vector3.new(td.X * 1.35, td.Y, td.Z * 1.35)
                        end
                    end
                end
                if State.maxCharge and a1.Move == "Spike" then
                    a1.Charge = 1
                    a1.SpecialCharge = 1
                end
            end
            return orig(self, a1)
        end
        return orig(self, ...)
    end
    if setreadonly then setreadonly(meta, true) end
end

