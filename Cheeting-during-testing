local CFG_PATH = "KHUB_CDT/config.json"
local function saveConfig()
    pcall(function()
        if not isfolder then return end
        if not isfolder("KHUB_CDT") then makefolder("KHUB_CDT") end
        writefile(CFG_PATH, HttpService:JSONEncode({
            AntiCaught        = State.AntiCaught,
            SafeDistance      = State.SafeDistance,
            PhotoSafeDistance = State.PhotoSafeDistance,
            SavedAnswers      = State.SavedAnswers,
            Radar             = State.Radar,
            TeacherESP        = State.TeacherESP,
            DeskESP           = State.DeskESP,
        })); notify("Config saved")
    end)
end
local function loadConfig()
    pcall(function()
        if not isfile or not isfile(CFG_PATH) then notify("No config"); return end
        local d = HttpService:JSONDecode(readfile(CFG_PATH))
        if type(d)~="table" then return end
        if d.SafeDistance      then State.SafeDistance      = d.SafeDistance      end
        if d.PhotoSafeDistance then State.PhotoSafeDistance = d.PhotoSafeDistance end
        if d.AntiCaught ~= nil then State.AntiCaught        = d.AntiCaught        end
        if d.Radar      ~= nil then State.Radar             = d.Radar             end
        if d.TeacherESP ~= nil then State.TeacherESP        = d.TeacherESP        end
        if d.DeskESP    ~= nil then State.DeskESP           = d.DeskESP           end
        if d.SavedAnswers      then State.SavedAnswers       = d.SavedAnswers; refreshSavedUI() end
        notify("Config loaded")
    end)
end

