local function equipTool(namePart)
    pcall(function()
        local bp  = player:FindFirstChild("Backpack")
        local ch  = player.Character
        if not bp or not ch then return end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and string.lower(t.Name):find(namePart) then
                if hum then hum:EquipTool(t) end; return
            end
        end
    end)
end
local function equipPencil() equipTool("pencil"); pencilPlay("Idle") end
