local function putAway()
    pcall(function()
        local hum = (player.Character or {}):FindFirstChildOfClass("Humanoid")
        if hum then hum:UnequipTools() end
    end)
    phonePlay("stop"); phoneTool("Unequip"); phonePlay("Idle")
end

