local function submitAnswer(q, choice)
    -- *the pencil exhales and marks the bubble with cold certainty*
    pencilPlay("Idle")
    pcall(function()
        local rem = RemAnswer or RS:FindFirstChild("PlayerAnswerTable")
        if not rem then return end
        if rem:IsA("RemoteFunction") then
            rem:InvokeServer(q, choice)
        elseif rem:IsA("RemoteEvent") then
            rem:FireServer(q, choice)
        end
    end)
    task.wait(State.DelayAnswer)
end

-- ══════════════════════════════════════════════════════════
--  PARSE + READ PHONE GUI ANSWERS
-- ══════════════════════════════════════════════════════════
local function parseAnswerText(text)
    local found = {}
    if not text or text == "" then return found end
    local up = string.upper(text)
    for q, a in up:gmatch("(%d+)%s*[%.%):%-%s]%s*([ABCD])") do
        found[tonumber(q)] = a
    end
    for q, a in up:gmatch("(%d+)%s+([ABCD])%f[%s%z%p]") do
        if not found[tonumber(q)] then found[tonumber(q)] = a end
    end
    return found
end

local function readPhoneAnswers()
    local answers = {}
    local function scanGui(root)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                local t = d.Text or ""
                if #t > 0 then
                    for q, a in pairs(parseAnswerText(t)) do
                        answers[q] = a
                    end
                end
            end
        end
    end
    pcall(function() scanGui(player:FindFirstChild("PlayerGui")) end)
    pcall(function()
        local ch = player.Character
        if ch then
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") and string.lower(t.Name):find("phone") then
                    scanGui(t)
                end
            end
        end
    end)
    local count = 0
    for q, a in pairs(answers) do
        State.SavedAnswers[q] = a; count = count + 1
    end
    return count
end

local function getMaxQ(tbl)
    local mx = 0
    for q in pairs(tbl or {}) do
        if type(q)=="number" and q>mx then mx=q end
    end
    return mx
end

local function formatSavedAnswers()
    local keys = {}
    for q in pairs(State.SavedAnswers) do table.insert(keys, q) end
    table.sort(keys)
    if #keys == 0 then return "No answers yet.\nAuto flow will load them." end
    local lines = { "📋 Answers  (" .. #keys .. " loaded)" }
    for _, q in ipairs(keys) do
        table.insert(lines, string.format("  %2d.  %s", q, State.SavedAnswers[q]))
    end
    return table.concat(lines, "\n")
end

local function refreshSavedUI()
    if SavedLabelRef and SavedLabelRef.Parent then
        SavedLabelRef.Text = formatSavedAnswers()
    end
end

-- ══════════════════════════════════════════════════════════
--  ANSWER HIGHLIGHTS  (persist even after answered)
-- ══════════════════════════════════════════════════════════
local function clearHighlights()
    for _, h in ipairs(State.HighlightFrames) do
        pcall(function() h:Destroy() end)
    end
    State.HighlightFrames = {}
end

local function applyHighlights()
    -- *highlights stay — answered or not, they burn into the paper*
    if next(State.SavedAnswers) == nil then return end
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end

    -- kill old highlights first, then re-stamp
    clearHighlights()

    local rows = {}
    for _, inst in ipairs(pg:GetDescendants()) do
        if inst:IsA("Frame") or inst:IsA("ScrollingFrame") then
            local letters = {}
            for _, k in ipairs(inst:GetChildren()) do
                if k:IsA("TextButton") or k:IsA("TextLabel") then
                    local t = (k.Text or ""):upper():gsub("%s","")
                    if t=="A" or t=="B" or t=="C" or t=="D" then
                        letters[t] = k
                    end
                end
            end
            local cnt = 0; for _ in pairs(letters) do cnt=cnt+1 end
            if cnt >= 2 then
                table.insert(rows, { frame=inst, letters=letters })
            end
        end
    end
    table.sort(rows, function(a,b)
        return a.frame.AbsolutePosition.Y < b.frame.AbsolutePosition.Y
    end)

    local applied = 0
    for i, rowData in ipairs(rows) do
        local ans = State.SavedAnswers[i]
        if ans then
            local target = rowData.letters[ans]
            if target then
                local hl = Instance.new("Frame")
                hl.Size                  = UDim2.new(1,6,1,6)
                hl.Position              = UDim2.new(0,-3,0,-3)
                hl.BackgroundColor3      = THEME.hi
                hl.BackgroundTransparency = 0.45
                hl.BorderSizePixel       = 0
                hl.ZIndex                = target.ZIndex + 5
                hl.Parent               = target
                corner(hl, 99)

                local st = Instance.new("UIStroke", hl)
                st.Color = THEME.gold; st.Thickness=2.5; st.Transparency=0.05

                -- question number badge
                local numLbl = Instance.new("TextLabel", hl)
                numLbl.Size                  = UDim2.new(0,15,0,11)
                numLbl.Position              = UDim2.new(0,-7,0,-9)
                numLbl.BackgroundColor3      = Color3.fromRGB(15,10,30)
                numLbl.BackgroundTransparency = 0.1
                numLbl.Text                  = tostring(i)
                numLbl.Font                  = Enum.Font.GothamBold
                numLbl.TextSize              = 8
                numLbl.TextColor3            = THEME.gold
                numLbl.BorderSizePixel       = 0
                numLbl.ZIndex                = hl.ZIndex+1
                corner(numLbl, 3)

                table.insert(State.HighlightFrames, hl)
                applied = applied+1
            end
        end
    end
    notify("✨ Highlighted " .. applied .. " answers")
end

-- ══════════════════════════════════════════════════════════
--  SUBMIT ALL SAVED
-- ══════════════════════════════════════════════════════════
local function submitSaved()
    local keys = {}
    for q in pairs(State.SavedAnswers) do table.insert(keys,q) end
    table.sort(keys)
    local n = 0
    for _, q in ipairs(keys) do
        if State.AntiCaught and isDanger() then
            equipPencil(); setPhase("danger")
            notify("Stopped – teacher near"); break
        end
        submitAnswer(q, State.SavedAnswers[q])
        -- highlights persist — don't clear them here
        n = n+1
    end
    return n
end

-- ══════════════════════════════════════════════════════════
--  3-SECOND COUNTDOWN LOAD  (visible in UI)
-- ══════════════════════════════════════════════════════════
local function doCountdownLoad()
    -- *the phone screen flickers; numbers descend like a detonator*
    for i = 3, 1, -1 do
        notify("📱 Loading answers... " .. i)
        if CountdownRef and CountdownRef.Parent then
            CountdownRef.Text = tostring(i)
            CountdownRef.Visible = true
        end
        task.wait(1)
    end
    if CountdownRef and CountdownRef.Parent then
        CountdownRef.Visible = false
    end
end

-- ══════════════════════════════════════════════════════════
--  AUTO FLOW  photo → 3s countdown load → highlight → answer
-- ══════════════════════════════════════════════════════════
local function runAutoFlow()
    if State.Running then return end
    if not State.AutoFlow then return end
    State.Running = true

    task.spawn(function()
        while State.Running and State.AutoFlow do
            if isDanger() then
                if State.AntiCaught then
                    putAway(); equipPencil(); setPhase("danger")
                end
                task.wait(0.5); continue
            end

            -- PHASE 1: take photo
            if isSafeForPhoto() then
                setPhase("photo"); notify("📷 Taking photo...")
                takePhoto(); task.wait(State.DelayPhoto)
            end

            if isDanger() then task.wait(0.4); continue end

            -- PHASE 2: open phone, countdown 3s, read answers
            if isSafeForPhoto() then
                setPhase("load")
                openPhoneAnswers()
                doCountdownLoad()

                local count = readPhoneAnswers()
                refreshSavedUI()
                if count > 0 then
                    notify("Loaded " .. count .. " answers ✓")
                    applyHighlights()
                else
                    notify("No answers parsed — retrying next cycle")
                end
            end

            if isDanger() then task.wait(0.4); continue end

            -- PHASE 3: auto equip pencil → auto answer all
            if isSafeForPhoto() and next(State.SavedAnswers) ~= nil then
                setPhase("answer")
                equipPencil(); task.wait(0.2)
                local n = submitSaved()
                -- re-apply highlights so they stay visible after answering
                applyHighlights()
                if n > 0 then notify("✍ Auto answered " .. n .. " questions") end
                task.wait(0.6)
            end

            setPhase("idle"); task.wait(2.0)
        end

        State.Running = false; setPhase("idle")
    end)
end

