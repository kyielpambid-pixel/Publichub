-- world-to-radar projection
local RADAR_HALF = RADAR_SIZE / 2
local function worldToRadar(myPos, targetPos)
    local camCF = Camera.CFrame
    local look  = camCF.LookVector
    local fl    = Vector3.new(look.X,0,look.Z)
    if fl.Magnitude > 0.01 then fl=fl.Unit else fl=Vector3.new(0,0,-1) end
    local right = Vector3.new(-fl.Z,0,fl.X)
    local delta = targetPos - myPos
    local lx    = delta:Dot(right)
    local lz    = delta:Dot(fl)
    local scale = RADAR_HALF / RADAR_RANGE
    local px    = RADAR_HALF + lx*scale
    local py    = RADAR_HALF - lz*scale
    local cx,cy = px-RADAR_HALF, py-RADAR_HALF
    local dist  = math.sqrt(cx*cx+cy*cy)
    if dist > RADAR_HALF then
        local norm = RADAR_HALF/dist
        px = RADAR_HALF + cx*norm
        py = RADAR_HALF + cy*norm
    end
    return px, py
end

-- radar render loop (pulse teacher dot)
local tPulse = 0
RunService.RenderStepped:Connect(function(dt)
    if not State.Radar then return end
    local myChar = player.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local myPos  = myHRP.Position

    -- teacher dot
    local tHRP = findTeacherHRP()
    if tHRP then
        local tx, ty = worldToRadar(myPos, tHRP.Position)
        TeacherDot.Position = UDim2.new(0,tx-5,0,ty-5)
        TeacherDot.Visible  = true

        -- pulse stroke
        tPulse = tPulse + dt*3
        tDotStroke.Transparency = (math.sin(tPulse)+1)/2 * 0.7

        -- tracker line
        local dx, dy = tx-RADAR_HALF, ty-RADAR_HALF
        local len    = math.sqrt(dx*dx+dy*dy)
        TrackerLine.Size     = UDim2.new(0,math.max(1,len),0,1)
        TrackerLine.Position = UDim2.new(0,RADAR_HALF,0,RADAR_HALF)
        TrackerLine.Rotation = math.deg(math.atan2(dy,dx))
        TrackerLine.Visible  = true

        local dist = (myPos - tHRP.Position).Magnitude
        if dist < State.SafeDistance then
            RadarStatus.Text       = string.format("⚠ DANGER  %.0fm", dist)
            RadarStatus.TextColor3 = THEME.danger
            radarFrameStroke.Color = THEME.danger
        elseif dist < State.PhotoSafeDistance then
            RadarStatus.Text       = string.format("⚡ CAUTION  %.0fm", dist)
            RadarStatus.TextColor3 = THEME.caution
            radarFrameStroke.Color = THEME.caution
        else
            RadarStatus.Text       = string.format("✓ CLEAR  %.0fm", dist)
            RadarStatus.TextColor3 = THEME.safe
            radarFrameStroke.Color = THEME.safe
        end
    else
        TeacherDot.Visible   = false
        TrackerLine.Visible  = false
        RadarStatus.Text     = "NO TEACHER"
        RadarStatus.TextColor3 = THEME.dim
        radarFrameStroke.Color = THEME.violet
    end

    -- other player dots (violet)
    local seen = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local pHRP = p.Character:FindFirstChild("HumanoidRootPart")
            if pHRP then
                seen[p.UserId] = true
                local dot    = getPlayerDot(p.UserId)
                local px, py = worldToRadar(myPos, pHRP.Position)
                dot.Position = UDim2.new(0,px-3,0,py-3)
                dot.Visible  = true
            end
        end
    end
    for uid, dot in pairs(playerDotPool) do
        if not seen[uid] then dot.Visible=false end
    end
end)

