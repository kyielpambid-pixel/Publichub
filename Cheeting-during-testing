-- ══════════════════════════════════════════════════════════
local function setVisible(on)
    Win.Visible=on; Orb.Visible=not on
end

MinBtn.MouseButton1Click:Connect(function() setVisible(false) end)
Orb.MouseButton1Click:Connect(function()   setVisible(true)  end)

-- main window drag
local dragging, dragStart, startPos
TitleBar.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        dragging=true; dragStart=i.Position; startPos=Win.Position
    end
end)
TitleBar.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        dragging=false
    end
end)

-- orb drag
local orbDrag,orbStart,orbPos
Orb.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        orbDrag=true; orbStart=i.Position; orbPos=Orb.Position
    end
end)
Orb.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        orbDrag=false
    end
end)

UserInputService.InputChanged:Connect(function(i)
    if i.UserInputType~=Enum.UserInputType.MouseMovement and
       i.UserInputType~=Enum.UserInputType.Touch then return end
    if dragging and dragStart then
        local d=i.Position-dragStart
        Win.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,
                                 startPos.Y.Scale,startPos.Y.Offset+d.Y)
    end
    if orbDrag and orbStart then
        local d=i.Position-orbStart
        orbBase=UDim2.new(orbPos.X.Scale,orbPos.X.Offset+d.X,
                           orbPos.Y.Scale,orbPos.Y.Offset+d.Y)
        Orb.Position=orbBase
    end
end)

UserInputService.InputBegan:Connect(function(input,gp)
    if gp then return end
    if input.KeyCode==Enum.KeyCode.RightShift or
       input.KeyCode==Enum.KeyCode.RightControl or
       input.KeyCode==Enum.KeyCode.K then
        setVisible(not Win.Visible)
    end
    -- R = show radar
    if input.KeyCode==Enum.KeyCode.R then
        RadarFrame.Visible=not RadarFrame.Visible
    end
end)

