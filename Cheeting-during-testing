local cachedTeacherHRP = nil

local function findTeacherModels()
    local models = {}
    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") then
            local n = string.lower(m.Name)
            if n:find("teacher") or m:GetAttribute("IsTeacher") then
                table.insert(models, m)
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local n = string.lower(p.Name .. (p.DisplayName or ""))
            if n:find("teacher") and p.Character then
                table.insert(models, p.Character)
            end
        end
    end
    return models
end

local function findTeacherHRP()
    local models = findTeacherModels()
    for _, m in ipairs(models) do
        local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
        if r then cachedTeacherHRP = r; return r end
    end
    return cachedTeacherHRP
end

local function findDeskModels()
    local desks = {}
    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") or m:IsA("BasePart") then
            local n = string.lower(m.Name)
            if n:find("desk") or n:find("table") or n:find("seat") then
                table.insert(desks, m)
            end
        end
    end
    return desks
end

local function distToTeacher()
    local myChar = player.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return 999 end
    local t = findTeacherHRP()
    if not t then return 999 end
    return (myHRP.Position - t.Position).Magnitude
end

local function isDanger()       return distToTeacher() < State.SafeDistance      end
local function isSafeForPhoto() return distToTeacher() >= State.PhotoSafeDistance end

