local ORB_COLS={THEME.accent,THEME.gold,THEME.cyan,THEME.pink}

-- pulse ring
local rng1 = Instance.new("Frame", Orb)
rng1.Size=UDim2.new(1,0,1,0); rng1.AnchorPoint=Vector2.new(0.5,0.5)
rng1.Position=UDim2.new(0.5,0,0.5,0)
rng1.BackgroundTransparency=1; rng1.ZIndex=49
corner(rng1,99)
local rs1=Instance.new("UIStroke",rng1)
rs1.Color=THEME.gold; rs1.Thickness=1.8; rs1.Transparency=0.1

task.spawn(function()
    local ci=1
    while rng1.Parent do
        rng1.Size=UDim2.new(1,0,1,0); rs1.Transparency=0.08
        TweenService:Create(rng1,TweenInfo.new(1.1,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),
            {Size=UDim2.new(1,18,1,18)}):Play()
        TweenService:Create(rs1,TweenInfo.new(1.1,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),
            {Transparency=1}):Play()
        task.wait(1.4); ci=(ci%#ORB_COLS)+1; rs1.Color=ORB_COLS[ci]
    end
end)

local orbBase=Orb.Position
task.spawn(function()
    local t=0
    while Orb.Parent do
        t=t+task.wait(0.033)
        if Orb.Visible then
            Orb.Position=UDim2.new(orbBase.X.Scale,orbBase.X.Offset,
                orbBase.Y.Scale,orbBase.Y.Offset+math.sin(t*1.8)*3)
        end
    end
end)

task.spawn(function()
    local t,ci=0,1
    while Orb.Parent do
        t=t+task.wait(0.033)
        local frac=(math.sin(t*0.7)+1)/2
        local nxt=(ci%#ORB_COLS)+1
        orbStroke.Color=lerpColor(ORB_COLS[ci],ORB_COLS[nxt],frac)
        if frac>0.98 then ci=nxt end
    end
end)

