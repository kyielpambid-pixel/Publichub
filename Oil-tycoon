local function getAllStrictlyGreenObjects()
	local paths = {}
	local tycoon = Workspace:FindFirstChild("Tycoon")
	local searchFolders = {tycoon and tycoon:FindFirstChild("Buttons"), tycoon and tycoon:FindFirstChild("Paths"), Workspace}
	for _, folder in ipairs(searchFolders) do
		if folder then
			for _, obj in ipairs(folder:GetDescendants()) do
				if obj:IsA("Model") or obj:IsA("BasePart") then
					local isRobux, hasGreen, hasRed = false, false, false
					for _, desc in ipairs(obj:GetDescendants()) do
						if desc:IsA("BasePart") then
							local color = desc.Color
							if color.G > color.R + 0.05 and color.G > color.B + 0.05 then
								hasGreen = true
							elseif color.R > color.G + 0.05 and color.R > color.B + 0.05 then
								hasRed = true
							end
						end
						if desc:IsA("SurfaceGui") or desc:IsA("BillboardGui") then
							for _, label in ipairs(desc:GetDescendants()) do
								if label:IsA("TextLabel") and string.find(label.Text:lower(), "robux") then
									isRobux = true
								end
							end
						end
					end
					if hasGreen and not hasRed and not isRobux then
						table.insert(paths, obj)
					end
				end
			end
		end
	end
	return paths
end

local function getAllSpecificOilSources()
	local sources = {}
	local tycoon = Workspace:FindFirstChild("Tycoon")
	if tycoon then
		local other = tycoon:FindFirstChild("Other")
		if other then
			local oil = other:FindFirstChild("Oil")
			if oil then
				for _, sourceFolder in ipairs(oil:GetChildren()) do
					local oilSourcePart = sourceFolder:FindFirstChild("OilSource")
					if oilSourcePart and oilSourcePart:IsA("BasePart") then
						table.insert(sources, oilSourcePart)
					end
				end
			end
		end
	end
	if #sources == 0 then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name == "OilSource" and obj:IsA("BasePart") then
				table.insert(sources, obj)
			end
		end
	end
	return sources
end

