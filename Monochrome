-- INFINITE STAMINA (Sprint Inf — energy never decreases)
--------------------------------------------------------------------
local STAMINA_NAMES = {
	"stamina", "energy", "sprint", "endurance", "run", "stam", "fatigue", "breath"
}

local function isStaminaName(n)
	n = string.lower(tostring(n or ""))
	for _, k in ipairs(STAMINA_NAMES) do
		if n:find(k) then return true end
	end
	return false
end

local function forceStamina(obj)
	if not obj then return end
	-- Attributes
	pcall(function()
		for _, attr in ipairs(obj:GetAttributes()) do
			-- GetAttributes returns dict in modern Roblox; handle both
		end
		local attrs = obj:GetAttributes()
		if typeof(attrs) == "table" then
			for name, val in pairs(attrs) do
				if isStaminaName(name) and typeof(val) == "number" then
					obj:SetAttribute(name, 100)
					obj:SetAttribute(name, 999)
				end
			end
		end
		-- common attribute names
		for _, an in ipairs({"Stamina", "stamina", "Energy", "energy", "Sprint", "MaxStamina", "CurrentStamina"}) do
			if obj:GetAttribute(an) ~= nil then
				obj:SetAttribute(an, 999)
			end
		end
	end)
	-- Values
	for _, v in ipairs(obj:GetDescendants()) do
		if v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("DoubleConstrainedValue") or v:IsA("IntConstrainedValue") then
			if isStaminaName(v.Name) then
				pcall(function()
					if v.MaxValue then v.Value = v.MaxValue else v.Value = 999 end
				end)
			end
		end
		if v:IsA("BoolValue") and isStaminaName(v.Name) then
			pcall(function() v.Value = true end)
		end
	end
end

