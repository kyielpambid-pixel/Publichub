-- Original source: scan CodeNote TextLabel inside monochrome
local function findCodeText()
	local mono = getMono()
	if not mono then return "" end
	for _, obj in ipairs(mono:GetDescendants()) do
		if string.lower(obj.Name):find("codenote") then
			local foundTxt = ""
			for _, sub in ipairs(obj:GetDescendants()) do
				if sub:IsA("TextLabel") and sub.Text ~= "" then
					foundTxt = sub.Text
					break
				end
			end
			if foundTxt == "" and obj:IsA("TextLabel") then
				foundTxt = obj.Text
			end
			if foundTxt ~= "" then
				return foundTxt
			end
		end
	end
	return ""
end

