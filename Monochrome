if not ESPFolder.Parent then ESPFolder.Parent = player:WaitForChild("PlayerGui") end

local function clearESP(prefix)
	for _, obj in ipairs(ESPFolder:GetChildren()) do
		if not prefix or obj.Name:find(prefix) then obj:Destroy() end
	end
end

local function addFullBodyESP(model, color, tag, labelText)
	if not model or not model.Parent then return end
	local id = tag .. "_" .. tostring(model)
	if ESPFolder:FindFirstChild(id) then return end

	local holder = Instance.new("Folder")
	holder.Name = id
	holder.Parent = ESPFolder

	-- Full body Highlight — visible THROUGH WALLS
	local hl = Instance.new("Highlight")
	hl.Name = "BodyHL"
	hl.Adornee = model
	hl.FillColor = color
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.25
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = holder

	-- Extra: red box on every BasePart (full body, also through walls via AlwaysOnTop Highlight)
	if tag == "MON" then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") then
				local partHL = Instance.new("Highlight")
				partHL.Adornee = part
				partHL.FillColor = Color3.fromRGB(255, 0, 0)
				partHL.OutlineColor = Color3.fromRGB(255, 80, 80)
				partHL.FillTransparency = 0.4
				partHL.OutlineTransparency = 0
				partHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				partHL.Parent = holder
			end
		end
	end

	local part = model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Head")
		or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart")
	if part then
		local bb = Instance.new("BillboardGui")
		bb.Adornee = part
		bb.Size = UDim2.fromOffset(150, 32)
		bb.StudsOffset = Vector3.new(0, 3.5, 0)
		bb.AlwaysOnTop = true
		bb.Parent = holder

		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.Text = labelText or model.Name
		txt.TextColor3 = color
		txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		txt.TextStrokeTransparency = 0.2
		txt.Font = Enum.Font.GothamBold
		txt.TextSize = 13
		txt.Parent = bb
	end
end

