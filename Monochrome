	else
		for i, name in ipairs(configList) do
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -8, 0, 26)
			btn.BackgroundColor3 = (selectedConfig == name) and THEME.accent or Color3.fromRGB(30, 22, 42)
			btn.BackgroundTransparency = (selectedConfig == name) and 0.3 or 0.2
			btn.Text = "  " .. name
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = 11
			btn.TextColor3 = (selectedConfig == name) and THEME.gold or THEME.text
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.ZIndex = 12
			btn.LayoutOrder = i
			btn.Parent = ListFrame
			corner(btn, 5)
			btn.MouseButton1Click:Connect(function()
				selectedConfig = name
				NameBox.Text = name
				StatusLbl.Text = "Selected: " .. name
				StatusLbl.TextColor3 = THEME.gold
				refreshConfigList()
			end)
		end
	end
	ListFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(90, #configList * 30 + 8))
end

