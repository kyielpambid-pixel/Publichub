						or nameL:find("hunter") or nameL:find("seek") or nameL:find("figure")
						or nameL:find("enemy") or nameL:find("npc") or nameL:find("creature")
						or nameL:find("chaser") or nameL:find("threat") or nameL:find("ai")
					-- any non-player humanoid = monster candidate
					local hum = obj:FindFirstChildOfClass("Humanoid")
					if hum and not Players:GetPlayerFromCharacter(obj) then
						isMon = true
					end
					-- has animator + parts but not a player
					if not isMon and obj:FindFirstChildWhichIsA("BasePart") and obj:FindFirstChildOfClass("AnimationController") then
