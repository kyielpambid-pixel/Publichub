--------------------------------------------------------------------
-- AUTO FILL CODE
-- Uses found code (e.g. 4527). Sets EACH digit slot to the right number.
-- Does NOT spam all prompts (that overshoots / cycles past the digit).
--------------------------------------------------------------------
local lastFilledCode = ""
local lastFillTime = 0
local isFilling = false

local function extractDigits(code)
	local digits = {}
	for d in string.gmatch(tostring(code or ""), "%d") do
		table.insert(digits, d)
	end
	return digits
end

local function getKeypadRoot()
	local mono = getMono()
	if not mono then return nil end
	for _, obj in ipairs(mono:GetDescendants()) do
		local n = string.lower(obj.Name)
		if n:find("keypad") or n:find("codelock") or n:find("digitlock") then
			return obj
		end
	end
	-- fallback: any model with 4 single-digit labels
	for _, obj in ipairs(mono:GetDescendants()) do
		if obj:IsA("Model") or obj:IsA("Folder") then
			local count = 0
			for _, sub in ipairs(obj:GetDescendants()) do
				if (sub:IsA("TextLabel") or sub:IsA("TextBox")) and tostring(sub.Text):match("^%d$") then
					count = count + 1
				end
			end
			if count >= 4 then return obj end
		end
	end
	return mono
end

local function getDigitSlots(root)
	local slots = {}
	if not root then return slots end
	for _, obj in ipairs(root:GetDescendants()) do
		if (obj:IsA("TextLabel") or obj:IsA("TextBox")) and tostring(obj.Text):match("^%d$") then
			table.insert(slots, obj)
		end
	end
	-- left → right order
	table.sort(slots, function(a, b)
		local ok1, p1 = pcall(function() return a.AbsolutePosition.X end)
		local ok2, p2 = pcall(function() return b.AbsolutePosition.X end)
		if ok1 and ok2 then return p1 < p2 end
		return tostring(a) < tostring(b)
	end)
	return slots
end

local function clickSlot(slot)
	-- click detectors / prompts near this digit display
	local parents = { slot, slot.Parent, slot.Parent and slot.Parent.Parent }
	for _, p in ipairs(parents) do
		if p then
			for _, d in ipairs(p:GetDescendants()) do
				if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
					firePromptOrClick(d)
					return true
				end
			end
			if p:IsA("BasePart") then
				for _, d in ipairs(p:GetChildren()) do
					if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
						firePromptOrClick(d)
						return true
					end
				end
			end
		end
	end
	return false
end

local function setSlotToDigit(slot, targetDigit)
	-- cycle this ONE slot until it shows the target (max 12 clicks)
	for _ = 1, 12 do
		local current = tostring(slot.Text or ""):match("%d") or ""
		if current == targetDigit then
			return true
		end
		clickSlot(slot)
		task.wait(0.22)
	end
	return tostring(slot.Text or ""):match("%d") == targetDigit
end

task.spawn(function()
	while true do
		task.wait(0.8)
		if Config.AutoFillCode and not isFilling then
			pcall(function()
				local targetCode = findCodeText()
				local digits = extractDigits(targetCode)
				if #digits < 4 then return end
				local codeStr = table.concat(digits)
				if codeStr == lastFilledCode and (os.clock() - lastFillTime) < 10 then return end

				isFilling = true
				CodeDisplay.Visible = true
				CodeDisplay.Text = "AUTO-FILLING: " .. codeStr

				local root = getKeypadRoot()
				local slots = getDigitSlots(root)

				if #slots >= 4 then
					-- set each of the first 4 slots to the correct digit only
					for i = 1, 4 do
						if not Config.AutoFillCode then break end
						CodeDisplay.Text = "AUTO-FILLING: " .. codeStr .. "  [" .. i .. "/4 → " .. digits[i] .. "]"
						setSlotToDigit(slots[i], digits[i])
						task.wait(0.15)
					end
				else
					-- fallback: click digit buttons matching each number once (no spam)
					for i, d in ipairs(digits) do
						if not Config.AutoFillCode then break end
						CodeDisplay.Text = "AUTO-FILLING: " .. codeStr .. "  (" .. i .. "/" .. #digits .. ")"
						local mono = getMono()
						if mono then
							for _, obj in ipairs(mono:GetDescendants()) do
								local n = string.lower(obj.Name)
								local t = (obj:IsA("TextButton") or obj:IsA("TextLabel")) and tostring(obj.Text or ""):gsub("%s+", "") or ""
								if n == d or n == "btn" .. d or t == d then
									if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
										firePromptOrClick(obj)
									elseif obj:IsA("TextButton") and firesignal then
										pcall(function()
											firesignal(obj.MouseButton1Click)
											firesignal(obj.Activated)
										end)
									else
										for _, sub in ipairs(obj:GetDescendants()) do
											if sub:IsA("ProximityPrompt") or sub:IsA("ClickDetector") then
												firePromptOrClick(sub)
											end
										end
									end
								end
							end
						end
						task.wait(0.35)
					end
				end

				-- submit / enter once
				pcall(function()
					local mono = getMono()
					if not mono then return end
					for _, obj in ipairs(mono:GetDescendants()) do
						local n = string.lower(obj.Name)
						if n:find("enter") or n:find("submit") or n:find("confirm") or n:find("ok") then
							if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
								firePromptOrClick(obj)
							end
						end
					end
					local rs = game:GetService("ReplicatedStorage")
					for _, remote in ipairs(rs:GetDescendants()) do
						if remote:IsA("RemoteEvent") then
							local rn = string.lower(remote.Name)
							if rn:find("code") or rn:find("keypad") or rn:find("submit") or rn:find("unlock") then
								pcall(function()
									remote:FireServer(codeStr)
									remote:FireServer(tonumber(codeStr) or codeStr)
								end)
							end
						end
					end
				end)

				lastFilledCode = codeStr
				lastFillTime = os.clock()
				CodeDisplay.Text = "CODE SET: " .. codeStr
				isFilling = false
			end)
			isFilling = false
		end
	end
end)

