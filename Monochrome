-- Strict Sequential Auto-Fill (Fills digit 1 until match, locks it, then moves to digit 2, etc.)
createToggle(KeyCard, "Auto-Fill Code (Strict Sequential) [Key: T]", 196, Enum.KeyCode.T, function(state)
	getgenv().AutoFillCodeActive = state
	CodeDisplay.Visible = state
	task.spawn(function()
		while getgenv().AutoFillCodeActive do
			task.wait(0.5)
			pcall(function()
				local mono = Workspace:FindFirstChild("monochrome")
				if not mono then return end
				local targetCode = ""
				for _, obj in ipairs(mono:GetDescendants()) do
					if obj.Name:lower():find("codenote") then
						local foundTxt = ""
						for _, sub in ipairs(obj:GetDescendants()) do
							if sub:IsA("TextLabel") and sub.Text ~= "" then foundTxt = sub.Text break end
						end
						if foundTxt == "" and obj:IsA("TextLabel") then foundTxt = obj.Text end
						if foundTxt ~= "" and #foundTxt >= 4 then
							targetCode = foundTxt
							break
						end
					end
				end
				
				if targetCode ~= "" then
					CodeDisplay.Visible = true
					CodeDisplay.Text = "AUTO-FILLING: " .. targetCode
					
					-- Extract each individual target digit character
					local d1 = targetCode:sub(1,1)
					local d2 = targetCode:sub(2,2)
					local d3 = targetCode:sub(3,3)
					local d4 = targetCode:sub(4,4)
					
					-- Find the keypad lock buttons/prompts in the world
					for _, keypad in ipairs(mono:GetDescendants()) do
						local nameL = keypad.Name:lower()
						if nameL:find("keypad") or nameL:find("lock") or nameL:find("code") then
							for _, prompt in ipairs(keypad:GetDescendants()) do
								if prompt:IsA("ProximityPrompt") or prompt:IsA("ClickDetector") then
									-- Fills strictly one by one sequentially
									if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) else fireclickdetector(prompt) end
									task.wait(0.2)
								end
							end
						end
					end
				else
					CodeDisplay.Text = "CODE: SEARCHING..."
				end
			end)
		end
		if not getgenv().AutoFillCodeActive and not getgenv().CodeFinderOnly then 
			CodeDisplay.Visible = false 
		end
	end)
end)

