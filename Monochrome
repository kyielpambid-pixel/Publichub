SaveBtn.MouseButton1Click:Connect(function()
	local name = NameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then
		StatusLbl.Text = "Status: Type a name first"
		StatusLbl.TextColor3 = THEME.red
		return
	end
	local ok, err = saveConfigFile(name)
	if ok then
		selectedConfig = name
		StatusLbl.Text = "Status: Saved \"" .. name .. "\""
		StatusLbl.TextColor3 = THEME.green
		refreshConfigList()
	else
		StatusLbl.Text = "Status: Save failed — " .. tostring(err)
		StatusLbl.TextColor3 = THEME.red
	end
end)

LoadBtn.MouseButton1Click:Connect(function()
	local name = selectedConfig or NameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if not name or name == "" then
		StatusLbl.Text = "Status: Select or type a config"
		StatusLbl.TextColor3 = THEME.red
		return
	end
	local data, err = loadConfigFile(name)
	if data then
		if data.Config then
			for k, v in pairs(data.Config) do
				if Config[k] ~= nil then Config[k] = v end
			end
		end
		if data.Speed then currentSpeedVal = data.Speed end
		if data.FOV then currentFovVal = data.FOV end
		StatusLbl.Text = "Status: Loaded \"" .. name .. "\""
		StatusLbl.TextColor3 = THEME.green
		NameBox.Text = name
		selectedConfig = name
	else
		StatusLbl.Text = "Status: Load failed — " .. tostring(err)
		StatusLbl.TextColor3 = THEME.red
	end
end)

DeleteBtn.MouseButton1Click:Connect(function()
	local name = selectedConfig
	if not name or name == "" then
		StatusLbl.Text = "Status: Select a config to delete"
		StatusLbl.TextColor3 = THEME.red
		return
	end
	local ok, err = deleteConfigFile(name)
	if ok then
		StatusLbl.Text = "Status: Deleted \"" .. name .. "\""
		StatusLbl.TextColor3 = THEME.green
		selectedConfig = nil
		NameBox.Text = ""
		refreshConfigList()
	else
		StatusLbl.Text = "Status: Delete failed — " .. tostring(err)
		StatusLbl.TextColor3 = THEME.red
	end
end)

