local activeToggles = {}

local function createToggle(parent, text, yPos, defaultKey, callback)
	local f = Instance.new("TextButton")
	f.Size = UDim2.new(1, -16, 0, 32)
	f.Position = UDim2.new(0, 8, 0, yPos)
	f.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	f.BackgroundTransparency = 0.3
	f.Text = "  " .. text
	f.Font = Enum.Font.GothamBold
	f.TextSize = 11
	f.TextColor3 = THEME.text
	f.TextXAlignment = Enum.TextXAlignment.Left
	f.ZIndex = 11
	f.AutoButtonColor = false
	f.Parent = parent
	corner(f, 7)
	mkstroke(f, THEME.accent, 1, 0.3)

	local status = Instance.new("TextLabel")
	status.Size = UDim2.fromOffset(50, 20)
	status.Position = UDim2.new(1, -55, 0.5, -10)
	status.BackgroundTransparency = 1
	status.Text = "OFF"
	status.Font = Enum.Font.GothamBold
	status.TextSize = 11
	status.TextColor3 = Color3.fromRGB(255, 90, 90)
	status.TextXAlignment = Enum.TextXAlignment.Right
	status.ZIndex = 12
	status.Parent = f

	local enabled = false
	local function triggerToggle()
		enabled = not enabled
		status.Text = enabled and "ON" or "OFF"
		status.TextColor3 = enabled and Color3.fromRGB(90, 255, 120) or Color3.fromRGB(255, 90, 90)
		callback(enabled)
	end

	f.MouseButton1Click:Connect(triggerToggle)
	if defaultKey then activeToggles[defaultKey] = triggerToggle end
	return f
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if activeToggles[input.KeyCode] then activeToggles[input.KeyCode]() end
end)

