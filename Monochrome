createToggle(KeyCard, "Auto Take Key + TP [Key: Z]", 36, Enum.KeyCode.Z, function(state)
	getgenv().AutoTakeKeyTP = state
	task.spawn(function()
		while getgenv().AutoTakeKeyTP do
			task.wait(0.4)
			pcall(function()
				local mono = Workspace:FindFirstChild("monochrome")
				local char = player.Character
				if not mono or not char or not char:FindFirstChild("HumanoidRootPart") then return end
				for _, item in ipairs(mono:GetChildren()) do
					if item.Name:match("^HiddenKey") or item.Name:lower():find("key") then
						local targetPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
						if targetPart then
							char.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
							for _, desc in ipairs(item:GetDescendants()) do
								if desc:IsA("ProximityPrompt") then fireproximityprompt(desc)
								elseif desc:IsA("ClickDetector") then fireclickdetector(desc) end
							end
						end
					end
				end
			end)
		end
	end)
end)

