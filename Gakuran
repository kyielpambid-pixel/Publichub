	makeBtn(c, "Save Config", Color3.fromRGB(40, 80, 50), function()
		local name = nameBox.Text ~= "" and nameBox.Text or selected
		if name == "" then name = "default" end
		local ok, err = saveConfig(name)
		statusLbl.Text = ok and ("Saved: " .. name) or ("Fail: " .. tostring(err))
		statusLbl.TextColor3 = ok and THEME.green or THEME.red
		selected = name
		refresh()
	end)
	makeBtn(c, "Load Config", Color3.fromRGB(40, 50, 90), function()
		local name = nameBox.Text ~= "" and nameBox.Text or selected
		if name == "" then statusLbl.Text = "Type a name"; return end
		local ok, err = loadConfig(name)
		statusLbl.Text = ok and ("Loaded: " .. name) or ("Fail: " .. tostring(err))
		statusLbl.TextColor3 = ok and THEME.green or THEME.red
	end)
	makeBtn(c, "Delete Config", Color3.fromRGB(90, 35, 45), function()
		local name = nameBox.Text ~= "" and nameBox.Text or selected
		if name == "" then return end
		deleteConfig(name)
		statusLbl.Text = "Deleted: " .. name
		statusLbl.TextColor3 = THEME.gold
		nameBox.Text = ""
		selected = ""
		refresh()
	end)
	makeBtn(c, "Refresh List", THEME.card, function() refresh() end)
	refresh()
end

