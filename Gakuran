					if Opt.ESPChams or Opt.ESPBoxes then
						k.hl.Adornee = char
						k.hl.Enabled = true
						local col = Opt.ESPColor or Color3.fromRGB(235, 235, 235)
						if Opt.ESPStaff and staffSeen and staffSeen[plr] then
							col = Color3.fromRGB(255, 70, 70)
						elseif Opt.Whitelist and Opt.Whitelist[plr.Name] then
							col = Color3.fromRGB(90, 255, 140)
						end
						k.hl.FillColor = col
						k.hl.OutlineColor = col
					else
						k.hl.Enabled = false
					end
					k.bb.Adornee = head or hrp
					k.bb.Enabled = Opt.ESPNames or Opt.ESPDist or Opt.ESPStyle
					k.name.Visible = Opt.ESPNames == true
					k.name.Text = plr.Name
					k.dist.Visible = Opt.ESPDist == true
					k.dist.Text = math.floor(dist) .. "m"
					if Opt.ESPStyle then
						local st = styleOf(plr)
						if st and st ~= "" and string.lower(st) ~= "base" then
							k.dist.Text = k.dist.Text .. " | " .. st
						end
					end
				else
					clearEsp(plr)
				end
			else
				clearEsp(plr)
			end
		end
	end
end)
Players.PlayerRemoving:Connect(function(plr) clearEsp(plr) end)

