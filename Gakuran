-- CONFIG SAVE
local CFG_FOLDER = "KHUB_Gakuran"
local function ensureFolder()
	if not isfolder then return false end
	pcall(function()
		if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
	end)
	return true
end
local function listConfigs()
	local names = {}
	if not listfiles then return names end
	ensureFolder()
	local ok, files = pcall(listfiles, CFG_FOLDER)
	if not ok or type(files) ~= "table" then return names end
	for _, path in ipairs(files) do
		local name = tostring(path):match("([^/\\]+)%.json$")
		if name then table.insert(names, name) end
	end
	table.sort(names)
	return names
end
local function saveConfig(name)
	if not writefile or not name or name == "" then return false, "missing" end
	ensureFolder()
	local data = {}
	for k, v in pairs(Opt) do
		if type(v) ~= "table" and typeof(v) ~= "Vector3" and typeof(v) ~= "Color3" then
			data[k] = v
		elseif type(v) == "table" and k == "Whitelist" then
			data[k] = v
		end
	end
	local ok, err = pcall(function()
		writefile(CFG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	end)
	return ok, err
end
local function loadConfig(name)
	if not readfile or not isfile or not name then return false, "missing" end
	local path = CFG_FOLDER .. "/" .. name .. ".json"
	if not isfile(path) then return false, "not found" end
	local ok, raw = pcall(readfile, path)
	if not ok then return false, raw end
	local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return false, "bad json" end
	for k, v in pairs(data) do
		if Opt[k] ~= nil then Opt[k] = v end
	end
	return true
end
local function deleteConfig(name)
	if not delfile or not name then return false end
	pcall(function() delfile(CFG_FOLDER .. "/" .. name .. ".json") end)
	return true
end

