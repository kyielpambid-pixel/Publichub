if e[1] == name and e[2].Parent then
if Workspace.StreamingEnabled then
safe(function() LocalPlayer:RequestStreamAroundAsync(e[2].Position) end)
task.wait(0.15)
end
tpTo(CFrame.new(dropPoint(e[2])))
return true
end
end
return false
end


