local function expandHitbox(p)
	if p == player or Allies[p.UserId] then return end
	local char = p.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		if not originalSizes[p.UserId] then originalSizes[p.UserId] = head.Size end
		if not originalTransparencies[p.UserId] then originalTransparencies[p.UserId] = head.Transparency end
		head.Size = Vector3.new(currentSizeVal, currentSizeVal, currentSizeVal)
		head.Transparency = 1
		head.CanCollide = false
		head.Massless = true
	end
end
local function restoreHitbox(p)
	local char = p.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		head.Size = originalSizes[p.UserId] or Vector3.new(2, 1, 1)
		head.Transparency = originalTransparencies[p.UserId] or 0
		head.CanCollide = true
		head.Massless = false
	end
end

RunService.RenderStepped:Connect(function()
