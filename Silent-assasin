	listScroll.Size = UDim2.new(1,-4,1,-4); listScroll.Position = UDim2.new(0,2,0,2)
	listScroll.BackgroundTransparency = 1; listScroll.ScrollBarThickness = 3
	listScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y; listScroll.CanvasSize = UDim2.new(0,0,0,0)
	listScroll.ZIndex = 9; listScroll.Parent = listFrame
	local listLay = Instance.new("UIListLayout"); listLay.Padding = UDim.new(0,3); listLay.Parent = listScroll
	local selectedCfg = nil

	local function refreshCfg()
		for _, ch in ipairs(listScroll:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
		for _, n in ipairs(listConfigs()) do
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1,-6,0,26)
			b.BackgroundColor3 = selectedCfg == n and THEME.accent2 or Color3.fromRGB(22,28,56)
			b.Text = n; b.Font = Enum.Font.Gotham; b.TextSize = 12; b.TextColor3 = THEME.text
			b.ZIndex = 10; b.Parent = listScroll; corner(b, 6)
			b.MouseButton1Click:Connect(function() selectedCfg = n; nameBox.Text = n; refreshCfg() end)
		end
	end

	btn(c, "Save Config", function()
		local n = nameBox.Text:gsub("%s+", "")
		if n == "" then statusCfg.Text = "Enter a name"; return end
		ensureFolder()
		local data = {
			esp = espActive, hitbox = hitboxActive, size = currentSizeVal,
			loopKill = loopKillActive, antiAfk = antiAfk,
			savedAt = os.date("%Y-%m-%d %H:%M:%S"),
		}
		local ok = pcall(function()
			writefile(ConfigFolder.."/"..n..".json", HttpService:JSONEncode(data))
		end)
		statusCfg.Text = ok and ("Saved: "..n) or "Save failed"
		refreshCfg()
	end, Color3.fromRGB(40,80,50))

	btn(c, "Load Config", function()
		local n = selectedCfg or nameBox.Text:gsub("%s+", "")
		if n == "" then statusCfg.Text = "Select a config"; return end
		local ok, raw = pcall(function() return readfile(ConfigFolder.."/"..n..".json") end)
		if not ok or not raw then statusCfg.Text = "Load failed"; return end
		local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if ok2 and type(data) == "table" then
			if data.esp ~= nil then
				espActive = data.esp
				if espActive then refreshAllESP() else for _, ch in ipairs(ESPRoot:GetChildren()) do ch:Destroy() end end
			end
			if data.hitbox ~= nil then
				hitboxActive = data.hitbox
				if hitboxActive then
					for _, p in ipairs(Players:GetPlayers()) do expandHitbox(p) end
				else
					for _, p in ipairs(Players:GetPlayers()) do restoreHitbox(p) end
				end
			end
			if data.size then currentSizeVal = data.size end
			if data.loopKill ~= nil then loopKillActive = data.loopKill end
			if data.antiAfk ~= nil then antiAfk = data.antiAfk end
		end
		statusCfg.Text = "Loaded: "..n
	end, Color3.fromRGB(40,50,90))

	btn(c, "Delete Config", function()
		local n = selectedCfg or nameBox.Text:gsub("%s+", "")
		if n == "" then statusCfg.Text = "Select a config"; return end
		pcall(function() delfile(ConfigFolder.."/"..n..".json") end)
		selectedCfg = nil; statusCfg.Text = "Deleted: "..n; refreshCfg()
	end, Color3.fromRGB(90,30,40))

	btn(c, "Refresh List", refreshCfg)
	task.defer(refreshCfg)
end

