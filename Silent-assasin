local function clearPlayerESP(uid)
	local f = ESPRoot:FindFirstChild("P_" .. tostring(uid))
	if f then f:Destroy() end
end

local function applyPurpleESP(p)
	if p == player or not espActive then return end
	local char = p.Character
	if not char then return end
	local key = "P_" .. tostring(p.UserId)
	local folder = ESPRoot:FindFirstChild(key)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = key
		folder.Parent = ESPRoot
	end
	local hl = folder:FindFirstChild("BodyHL")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "BodyHL"
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillColor = ESP_FILL
		hl.OutlineColor = ESP_OUTLINE
		hl.FillTransparency = 0.35
		hl.OutlineTransparency = 0
		hl.Parent = folder
	end
	hl.Adornee = char
	hl.Enabled = true
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			pcall(function()
				if part.LocalTransparencyModifier > 0.5 then
					part.LocalTransparencyModifier = 0
				end
			end)
		end
	end
	local head = char:FindFirstChild("Head")
	if head then
		local bgui = folder:FindFirstChild("NameTag")
		if not bgui then
			bgui = Instance.new("BillboardGui")
			bgui.Name = "NameTag"
			bgui.AlwaysOnTop = true
			bgui.Size = UDim2.new(0, 120, 0, 28)
			bgui.StudsOffset = Vector3.new(0, 2.8, 0)
			bgui.MaxDistance = 500
			bgui.Parent = folder
			local text = Instance.new("TextLabel")
			text.Name = "Label"
			text.Size = UDim2.new(1, 0, 1, 0)
			text.BackgroundTransparency = 1
			text.TextColor3 = ESP_OUTLINE
			text.TextStrokeTransparency = 0.2
			text.TextStrokeColor3 = Color3.new(0, 0, 0)
			text.Font = Enum.Font.GothamBold
			text.TextSize = 13
			text.Parent = bgui
		end
		bgui.Adornee = head
		local label = bgui:FindFirstChild("Label")
		if label then
			local dist = ""
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local my = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp and my then
				dist = " [" .. math.floor((hrp.Position - my.Position).Magnitude) .. "m]"
			end
			label.Text = p.Name .. dist
		end
	end
end

local function refreshAllESP()
	if not espActive then
		for _, c in ipairs(ESPRoot:GetChildren()) do c:Destroy() end
		return
	end
	local alive = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			alive[p.UserId] = true
			applyPurpleESP(p)
		end
	end
	for _, c in ipairs(ESPRoot:GetChildren()) do
		local uid = tonumber(string.match(c.Name, "P_(%d+)"))
		if uid and not alive[uid] then c:Destroy() end
	end
end

