	local function ensureFolder()
		if isfolder and not isfolder(ConfigFolder) then pcall(function() makefolder(ConfigFolder) end) end
	end
	local function listConfigs()
		ensureFolder(); if not listfiles then return {} end
		local out = {}
		pcall(function()
			for _, f in ipairs(listfiles(ConfigFolder)) do
				local n = f:match("([^/\\]+)%.json$"); if n then table.insert(out, n) end
			end
		end)
		return out
	end

	local listFrame = Instance.new("Frame")
	listFrame.Size = UDim2.new(1,0,0,100); listFrame.BackgroundColor3 = THEME.inner
	listFrame.ZIndex = 8; listFrame.Parent = c; corner(listFrame, 8)
