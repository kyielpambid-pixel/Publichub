				local tabPad = Instance.new("UIPadding", TabScroll)
				tabPad.PaddingTop = UDim.new(0, 12)
				tabPad.PaddingLeft = UDim.new(0, 10)
				tabPad.PaddingRight = UDim.new(0, 10)
			end
			local TabButtons, Pages = {}, {}
			local function CreatePage(name)
				local page = Instance.new("ScrollingFrame", Main)
				page.Size = UDim2.new(1, -130, 1, -46)
				page.Position = UDim2.new(0, 130, 0, 42)
				page.BackgroundTransparency = 1
				page.BorderSizePixel = 0
				page.ScrollBarThickness = 4
				page.ScrollBarImageColor3 = Color3.fromRGB(200, 80, 120)
				page.Visible = false
				page.AutomaticCanvasSize = Enum.AutomaticSize.Y
				page.ZIndex = 10
				Instance.new("UIListLayout", page).Padding = UDim.new(0, 8)
				local pad = Instance.new("UIPadding", page)
				pad.PaddingTop = UDim.new(0, 10)
				pad.PaddingLeft = UDim.new(0, 12)
				pad.PaddingRight = UDim.new(0, 12)
				pad.PaddingBottom = UDim.new(0, 14)
				Pages[name] = page
				return page
			end
			local function SetActiveTab(btn, pageKey)
				for _, b in pairs(TabButtons) do
					b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
					b.BackgroundTransparency = 0.6
					b.TextColor3 = Color3.fromRGB(200, 160, 175)
				end
				if btn then
					btn.BackgroundColor3 = Color3.fromRGB(140, 40, 75)
					btn.BackgroundTransparency = 0.3
					btn.TextColor3 = Color3.fromRGB(255, 230, 240)
				end
				for _, p in pairs(Pages) do
					p.Visible = false
				end
				if Pages[pageKey] then
					Pages[pageKey].Visible = true
				end
			end
			local function CreateTab(displayName, pageKey, order)
				local btn = Instance.new("TextButton", TabScroll)
				btn.Size = UDim2.new(1, 0, 0, 34)
				btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				btn.BackgroundTransparency = 0.6
				btn.Text = displayName
				btn.Font = Enum.Font.GothamBold
				btn.TextSize = 12
				btn.TextColor3 = Color3.fromRGB(200, 160, 175)
				btn.TextXAlignment = Enum.TextXAlignment.Left
				btn.ZIndex = 11
				btn.LayoutOrder = order
				Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
				Instance.new("UIPadding", btn).PaddingLeft = UDim.new(0, 12)
				TabButtons[pageKey] = btn
				btn.MouseButton1Click:Connect(function()
					SetActiveTab(btn, pageKey)
				end)
				return btn
			end
			local function CreateToggle(parent, text, callback, default)
				local frame = Instance.new("Frame", parent)
				frame.Size = UDim2.new(1, 0, 0, 40)
				frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				frame.BackgroundTransparency = 0.6
				frame.ZIndex = 11
				Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
				local label = Instance.new("TextLabel", frame)
				label.Size = UDim2.new(1, -60, 1, 0)
				label.Position = UDim2.new(0, 12, 0, 0)
				label.BackgroundTransparency = 1
				label.Text = text
				label.Font = Enum.Font.GothamBold
				label.TextSize = 12
				label.TextColor3 = Color3.fromRGB(240, 210, 225)
				label.TextXAlignment = Enum.TextXAlignment.Left
				label.ZIndex = 12
				local toggleBg = Instance.new("Frame", frame)
				toggleBg.Size = UDim2.new(0, 40, 0, 20)
				toggleBg.Position = UDim2.new(1, -50, 0.5, -10)
				toggleBg.BackgroundColor3 = Color3.fromRGB(45, 22, 40)
				toggleBg.ZIndex = 12
				Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)
				local knob = Instance.new("Frame", toggleBg)
				knob.Size = UDim2.new(0, 16, 0, 16)
				knob.Position = UDim2.new(0, 2, 0.5, -8)
				knob.BackgroundColor3 = Color3.fromRGB(180, 80, 130)
				knob.ZIndex = 13
				Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
				local btn = Instance.new("TextButton", toggleBg)
				btn.Size = UDim2.new(1, 0, 1, 0)
				btn.BackgroundTransparency = 1
				btn.Text = ""
				btn.ZIndex = 14
				local state = default or false
				if state then
					knob.Position = UDim2.new(1, -18, 0.5, -8)
					knob.BackgroundColor3 = Color3.fromRGB(255, 140, 180)
					toggleBg.BackgroundColor3 = Color3.fromRGB(130, 40, 85)
				end
				btn.MouseButton1Click:Connect(function()
					state = not state
					local _sc3 = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
					local _sc5 = state and Color3.fromRGB(255, 140, 180) or Color3.fromRGB(180, 80, 130)
					TweenService:Create(knob, TweenInfo.new(0.15), { Position = _sc3, BackgroundColor3 = _sc5 }):Play()
					local _sc7 = state and Color3.fromRGB(130, 40, 85) or Color3.fromRGB(45, 22, 40)
					TweenService:Create(toggleBg, TweenInfo.new(0.15), { BackgroundColor3 = _sc7 }):Play()
					callback(state)
				end)
			end
			local function CreateButton(parent, text, callback)
				local btn = Instance.new("TextButton", parent)
				btn.Size = UDim2.new(1, 0, 0, 36)
				btn.BackgroundColor3 = Color3.fromRGB(140, 40, 80)
				btn.BackgroundTransparency = 0.4
				btn.Text = text
				btn.Font = Enum.Font.GothamBold
				btn.TextSize = 12
				btn.TextColor3 = Color3.new(1, 1, 1)
				btn.ZIndex = 11
				Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
				btn.MouseButton1Click:Connect(callback)
			end
			local function CreateLabel(parent, text)
				local lbl = Instance.new("TextLabel", parent)
				lbl.Size = UDim2.new(1, 0, 0, 22)
				lbl.BackgroundTransparency = 1
				lbl.Text = text
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 14
				lbl.TextColor3 = Color3.fromRGB(255, 200, 215)
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.ZIndex = 11
			end
			local HomePage = CreatePage("Home")
			local homeTab = CreateTab("Home", "Home", 1)
			do
				local welcomeCard = Instance.new("Frame", HomePage)
				welcomeCard.Size = UDim2.new(1, 0, 0, 120)
				welcomeCard.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				welcomeCard.BackgroundTransparency = 0.5
				welcomeCard.ZIndex = 11
				Instance.new("UICorner", welcomeCard).CornerRadius = UDim.new(0, 10)
				local av = Instance.new("ImageLabel", welcomeCard)
				av.Size = UDim2.new(0, 55, 0, 55)
				av.Position = UDim2.new(0, 14, 0.5, -27)
				av.BackgroundColor3 = Color3.fromRGB(45, 20, 36)
				av.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. player.UserId .. "&width=150&height=150&format=png"
				av.ZIndex = 12
				Instance.new("UICorner", av).CornerRadius = UDim.new(1, 0)
				local function ml(parent, text, y, size, color)
					local l = Instance.new("TextLabel", parent)
					l.Size = UDim2.new(1, -85, 0, 16)
					l.Position = UDim2.new(0, 80, 0, y)
					l.BackgroundTransparency = 1
					l.Text = text
					l.Font = Enum.Font.Gotham
					l.TextSize = size or 11
					local _sc3 = color or Color3.fromRGB(220, 190, 205)
					l.TextColor3 = _sc3
					l.TextXAlignment = Enum.TextXAlignment.Left
					l.ZIndex = 12
					return l
				end
				ml(welcomeCard, "Welcome, " .. player.DisplayName .. "!", 14, 13, Color3.fromRGB(255, 220, 235))
				ml(welcomeCard, "@" .. player.Name, 36)
				ml(welcomeCard, "Soccer Player | Mobile", 58, 11, Color3.fromRGB(255, 170, 200))
				ml(welcomeCard, "Generate Key Active", 80, 11, Color3.fromRGB(200, 150, 180))
			end
			do
				local FarmPage = CreatePage("Farm")
				CreateTab("Farm", "Farm", 2)
				CreateLabel(FarmPage, "Farm")
				CreateToggle(FarmPage, "Auto Steal Best (OG)", function(v)
					AutoStealBest = v
					if v then
						task.spawn(AutoStealOG)
					end
				end, false)
				CreateToggle(FarmPage, "Auto Steal Spain", function(v)
					AutoStealSpain = v
					if v then
						local Spain = FindSpainBlock()
						SpainWasFound = Spain ~= nil
						task.spawn(AutoStealSpainBlock)
					else
						SpainWasFound = false
					end
				end, false)
				CreateToggle(FarmPage, "Auto Collect Earnings", function(v)
					AutoCollect = v
					if v then
						task.spawn(AutoCollectEarnings)
					end
				end, false)
				CreateButton(FarmPage, "Collect Earnings (Once)", function()
					task.spawn(function()
						local Plot = GetPlayerPlot()
						if not Plot or not CollectEarnings then
							return
						end
						local Stands = GetStands(Plot)
						if not Stands then
							return
						end
						for _, Stand in ipairs(Stands:GetChildren()) do
							pcall(function()
								CollectEarnings:FireServer(tostring(Stand.Name))
							end)
							task.wait(COLLECT_STAND_DELAY)
						end
					end)
				end)
			end
			do
				local UpgradesPage = CreatePage("Upgrades")
				CreateTab("Upgrades", "Upgrades", 3)
				CreateLabel(UpgradesPage, "Upgrades")
				CreateToggle(UpgradesPage, "Auto Buy Jump", function(v)
					AutoBuyJump = v
					if v then
						task.spawn(AutoBuyJumpPower)
					end
				end, false)
				CreateToggle(UpgradesPage, "Auto Upgrade Stands", function(v)
					AutoUpgradeStands = v
					if v then
						task.spawn(AutoUpgrade)
					end
				end, false)
				CreateButton(UpgradesPage, "Set Jump 1x", function()
					JumpAmount = 1
				end)
				CreateButton(UpgradesPage, "Set Jump 5x", function()
					JumpAmount = 5
				end)
				CreateButton(UpgradesPage, "Set Jump 10x", function()
					JumpAmount = 10
				end)
			end
			do
				local SettingsPage = CreatePage("Settings")
				CreateTab("Settings", "Settings", 4)
				CreateLabel(SettingsPage, "Settings")
				CreateButton(SettingsPage, "Load FluentPro UI (PC Style)", function()
					ScreenGui:Destroy()
					pcall(function()
						local targets = { CoreGui, player:FindFirstChild("PlayerGui") }
						if gethui then
							table.insert(targets, gethui())
						end
						for _, t in pairs(targets) do
							if t then
								local f = t:FindFirstChild("KHUB_FloatIcon")
								if f then
									f:Destroy()
								end
							end
						end
					end)
					loadFluentProUI()
				end)
				CreateButton(SettingsPage, "Unload KHUB", function()
					unloadAll()
					ScreenGui:Destroy()
					pcall(function()
						local targets = { CoreGui, player:FindFirstChild("PlayerGui") }
						if gethui then
							table.insert(targets, gethui())
						end
						for _, t in pairs(targets) do
							if t then
								local f = t:FindFirstChild("KHUB_FloatIcon")
								if f then
									f:Destroy()
								end
							end
						end
					end)
				end)
			end
			SetActiveTab(homeTab, "Home")
			do
				local OpenBtn
				local _, btn = createFloatingIcon(function()
					Main.Visible = not Main.Visible
					if OpenBtn then
						OpenBtn.Visible = not Main.Visible
					end
				end)
				OpenBtn = btn
				OpenBtn.Visible = false
				Close.MouseButton1Click:Connect(function()
					Main.Visible = false
					OpenBtn.Visible = true
				end)
			end
			local draggingMain, dragStart, startPos
			Top.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingMain = true
					dragStart = input.Position
					startPos = Main.Position
				end
			end)
			Top.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingMain = false
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if draggingMain and dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local d = input.Position - dragStart
					Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
				end
			end)
			print("[KHUB] Soccer Player Mobile loaded!")
		end
	end
end
if isMobile then
	loadMobileUI()
else
	loadFluentProUI()
end
