-- Soccer logic
do
	local Remotes, CollectEarnings, BuySpeedUpgrade
	pcall(function()
		Remotes = ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Network"):WaitForChild("Remotes", 5)
		if Remotes then
			CollectEarnings = Remotes:FindFirstChild("Collect Earnings")
			BuySpeedUpgrade = Remotes:FindFirstChild("Buy Speed Upgrade")
		end
	end)
	local ReturnCFrame = CFrame.new(189, 3, 279)
	local AutoStealBest = false
	do
		local AutoStealSpain = false
		local AutoCollect = false
		local AutoBuyJump = false
		local AutoUpgradeStands = false
		local JumpAmount = 1
		local SpainWasFound = false
		local STEAL_TELEPORT_WAIT = 0.2
		local STEAL_PROMPT_WAIT = 0.2
		local STEAL_RETURN_WAIT = 0.2
		local STEAL_LOOP_WAIT = 0.2
		local COLLECT_STAND_DELAY = 0.005
		local COLLECT_LOOP_DELAY = 0.15
		local UPGRADE_STAND_DELAY = 0.01
		local UPGRADE_LOOP_DELAY = 0.15
		local JUMP_UPGRADE_DELAY = 0.25
		local function GetRootPart()
			local Character = LocalPlayer.Character
			if not Character then
				return nil
			end
			return Character:FindFirstChild("HumanoidRootPart")
		end
		local function FirePrompt(Prompt)
			if not Prompt then
				return false
			end
			local Success = false
			pcall(function()
				if fireproximityprompt then
					fireproximityprompt(Prompt)
					Success = true
					return
				end
				Prompt:InputHoldBegin()
				task.wait(math.max(Prompt.HoldDuration, 0.05))
				Prompt:InputHoldEnd()
				Success = true
			end)
			return Success
		end
		local function IsOwnedByPlayer(Object)
			if not Object then
				return false
			end
			local Owner = Object:FindFirstChild("Owner") or Object:FindFirstChild("owner")
			if not Owner then
				return false
			end
			if Owner:IsA("ObjectValue") then
				return Owner.Value == LocalPlayer or Owner.Value and Owner.Value.Name == LocalPlayer.Name
			end
			if Owner:IsA("StringValue") then
				return Owner.Value == LocalPlayer.Name or Owner.Value == LocalPlayer.DisplayName
			end
			local Success, Value = pcall(function()
				return Owner.Value
			end)
			if Success and Value then
				return tostring(Value) == LocalPlayer.Name or tostring(Value) == LocalPlayer.DisplayName
			end
			return false
		end
		local function GetPlayerPlot()
			local Plots = Workspace:FindFirstChild("Plots")
			if not Plots then
				return nil
			end
			for _, Plot in ipairs(Plots:GetChildren()) do
				if IsOwnedByPlayer(Plot) then
					return Plot
				end
			end
			for _, Object in ipairs(Plots:GetDescendants()) do
				if IsOwnedByPlayer(Object) then
					return Object
				end
			end
			return nil
		end
		local function GetStands(Plot)
			if not Plot then
				return nil
			end
			local _sc3 = Plot:FindFirstChild("Stands") or Plot:FindFirstChild("stands")
			local Stands = _sc3
			if _sc3 then
				return Stands
			end
			for _, Object in ipairs(Plot:GetDescendants()) do
				if Object.Name:lower() == "stands" then
					return Object
				end
			end
			return nil
		end
		local function GetUpgradePrompt(Stand)
			if not Stand then
				return nil
			end
			for _, Object in ipairs(Stand:GetDescendants()) do
				if Object:IsA("ProximityPrompt") and Object.Name == "ConsoleUpgradePrompt" then
					return Object
				end
			end
			local Upgrade = Stand:FindFirstChild("Upgrade", true)
			if Upgrade then
				local Prompt = Upgrade:FindFirstChildWhichIsA("ProximityPrompt", true)
				if Prompt then
					return Prompt
				end
			end
			return Stand:FindFirstChildWhichIsA("ProximityPrompt", true)
		end
		local function FindSpainBlock()
			local Live = Workspace:FindFirstChild("Live")
			if not Live then
				return nil
			end
			local Street = Live:FindFirstChild("Slimes")
			if not Street then
				return nil
			end
			for _, Object in ipairs(Street:GetChildren()) do
				local Name = string.lower(Object.Name)
				if string.find(Name, "spain", 1, true) then
					return Object
				end
			end
			return nil
		end
		local function AutoStealOG()
			while AutoStealBest do
				local RootPart = GetRootPart()
				local Live = Workspace:FindFirstChild("Live")
				local _sc3 = Live and Live:FindFirstChild("Slimes")
				local Slimes = _sc3
				if RootPart and _sc3 then
					for _, Object in ipairs(Slimes:GetChildren()) do
						if not AutoStealBest then
							break
						end
						if Object.Name == "OG Lucky Block" or Object.Name == "OG" then
							local _sc5 = Object:FindFirstChild("RootPart") or Object:FindFirstChild("HumanoidRootPart") or Object.PrimaryPart
							local ObjectRoot = _sc5
							local Prompt = Object:FindFirstChildWhichIsA("ProximityPrompt", true)
							if _sc5 then
								RootPart.CFrame = ObjectRoot.CFrame + Vector3.new(0, 2, 0)
								task.wait(STEAL_TELEPORT_WAIT)
								if Prompt then
									FirePrompt(Prompt)
								end
								task.wait(STEAL_PROMPT_WAIT)
								RootPart.CFrame = ReturnCFrame
								task.wait(STEAL_RETURN_WAIT)
							end
						end
					end
				end
				task.wait(STEAL_LOOP_WAIT)
			end
		end
		local function AutoStealSpainBlock()
			while AutoStealSpain do
				local Spain = FindSpainBlock()
				if not (Spain ~= nil) then
					if SpainWasFound then
						SpainWasFound = false
					end
				else
					if not SpainWasFound then
						SpainWasFound = true
					end
					local RootPart = GetRootPart()
					if RootPart and Spain then
						local _sc3 = Spain:FindFirstChild("RootPart") or Spain:FindFirstChild("HumanoidRootPart") or Spain.PrimaryPart
						local ObjectRoot = _sc3
						local Prompt = Spain:FindFirstChildWhichIsA("ProximityPrompt", true)
						if _sc3 then
							RootPart.CFrame = ObjectRoot.CFrame + Vector3.new(0, 2, 0)
							task.wait(STEAL_TELEPORT_WAIT)
							if Prompt then
								FirePrompt(Prompt)
							end
							task.wait(STEAL_PROMPT_WAIT)
							RootPart.CFrame = ReturnCFrame
							task.wait(STEAL_RETURN_WAIT)
						end
					end
				end
				task.wait(0.5)
			end
			SpainWasFound = false
		end
		local function AutoCollectEarnings()
			while AutoCollect do
				local Plot = GetPlayerPlot()
				if Plot and CollectEarnings then
					local Stands = GetStands(Plot)
					if Stands then
						for _, Stand in ipairs(Stands:GetChildren()) do
							if not AutoCollect then
								break
							end
							pcall(function()
								CollectEarnings:FireServer(tostring(Stand.Name))
							end)
							task.wait(COLLECT_STAND_DELAY)
						end
					end
				end
				task.wait(COLLECT_LOOP_DELAY)
			end
		end
		local function AutoBuyJumpPower()
			while AutoBuyJump do
				if BuySpeedUpgrade then
					pcall(function()
						BuySpeedUpgrade:FireServer(JumpAmount)
					end)
				end
				task.wait(JUMP_UPGRADE_DELAY)
			end
		end
		local function AutoUpgrade()
			while AutoUpgradeStands do
				local Plot = GetPlayerPlot()
				if Plot then
					local Stands = GetStands(Plot)
					if Stands then
						for _, Stand in ipairs(Stands:GetChildren()) do
							if not AutoUpgradeStands then
								break
							end
							local Prompt = GetUpgradePrompt(Stand)
							if Prompt then
								FirePrompt(Prompt)
								task.wait(UPGRADE_STAND_DELAY)
							end
						end
					end
				end
				task.wait(UPGRADE_LOOP_DELAY)
			end
		end
		local function unloadAll()
			AutoStealBest = false
			AutoStealSpain = false
			AutoCollect = false
			AutoBuyJump = false
			AutoUpgradeStands = false
		end
		local function createFloatingIcon(onClick)
			local guiParent = gethui and gethui() or nil
			if not guiParent then
				pcall(function()
					guiParent = CoreGui
