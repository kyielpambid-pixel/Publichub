addToggle(pages["Combat"], "Silent Aim", false, function(v)
	silentAimEnabled = v
	if not GunClientModule or not originalGetAimDirection then return end
	if v then
		GunClientModule.GetAimDirection = function(self)
			local origin = self:GetFireOrigin()
			if not origin then
				if self.HumanoidRootPart then origin = self.HumanoidRootPart.Position
				else return originalGetAimDirection(self) end
			end
			local target = updateClosestTarget(origin)
			if target then
				local dir = clampDirection((target.Position - origin).Unit)
				if dir.Magnitude > 0.001 then return dir end
			end
			return originalGetAimDirection(self)
		end
	else
		GunClientModule.GetAimDirection = originalGetAimDirection
	end
end)

