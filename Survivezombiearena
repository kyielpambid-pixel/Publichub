local cachedTarget, lastUpdateTime = nil, 0
local UPDATE_INTERVAL, MAX_PITCH = 0.1, math.rad(60)

local function isValidZombie(model)
	if not model or not model:IsA("Model") then return false end
	local ac = model:FindFirstChild("AnimationController")
	return ac and ac:IsA("AnimationController")
end

local function getHRP(model)
	if not model:IsA("Model") then return nil end
	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

local function getClosestZombieRootPart(origin)
	if not ZombiesFolder then return nil end
	local closestDistSq, closestPart = math.huge, nil
	for _, child in ipairs(ZombiesFolder:GetChildren()) do
		if isValidZombie(child) then
			local rp = getHRP(child)
			if rp and rp:IsA("BasePart") then
				local d = rp.Position - origin
				local distSq = d.X * d.X + d.Y * d.Y + d.Z * d.Z
				if distSq < closestDistSq then
					closestDistSq = distSq
					closestPart = rp
				end
			end
		end
	end
	return closestPart
end

local function updateClosestTarget(origin)
	local now = tick()
	if now - lastUpdateTime > UPDATE_INTERVAL then
		lastUpdateTime = now
		cachedTarget = getClosestZombieRootPart(origin)
	end
	return cachedTarget
end

local function clampDirection(direction)
	local flatDir = Vector3.new(direction.X, 0, direction.Z)
	if flatDir.Magnitude < 0.001 then return direction end
	flatDir = flatDir.Unit
	local verticalAngle = math.asin(math.clamp(direction.Y, -1, 1))
	if math.abs(verticalAngle) > MAX_PITCH then
		local newY = math.sin(MAX_PITCH * math.sign(verticalAngle))
		local newFlat = math.cos(MAX_PITCH)
		return (flatDir * newFlat + Vector3.new(0, newY, 0)).Unit
	end
	return direction
end

