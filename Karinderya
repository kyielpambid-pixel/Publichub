local buyBackoff = {}

local function restockIngredients()
    local inv = LocalPlayer:FindFirstChild("Ingredients")
    if not inv then
        Stats.StockState = "No ingredient folder"
        return
    end

    local cash = getCash()
    local now = os.clock()
    local packsBought, ingredientTypes, spent = 0, 0, 0
    local broke, capped, backedOff, sharedFull = 0, 0, 0, 0

    local keys = {}
    for key, cfg in pairs(IngredientsConfig) do
        if type(key) == "string" and type(cfg) == "table"
        and tonumber(cfg.Cost) and tonumber(cfg.YieldAmount) then
            table.insert(keys, key)
        end
    end

    local sharedTotals = {}
    local sharedCounts = {}
    for _, key in ipairs(keys) do
        local cfg = IngredientsConfig[key]
        local category = cfg.Category
        if SharedIngredientCaps[category] then
            local child = inv:FindFirstChild(key)
            sharedTotals[category] = (sharedTotals[category] or 0)
                + (child and tonumber(child.Value) or 0)
            sharedCounts[category] = (sharedCounts[category] or 0) + 1
        end
    end

    table.sort(keys, function(a, b)
        local aCategory = IngredientsConfig[a].Category
        local bCategory = IngredientsConfig[b].Category
        if aCategory == bCategory and SharedIngredientCaps[aCategory] then
            local aValue = inv:FindFirstChild(a)
            local bValue = inv:FindFirstChild(b)
            local aUnits = aValue and tonumber(aValue.Value) or 0
            local bUnits = bValue and tonumber(bValue.Value) or 0
            if aUnits ~= bUnits then return aUnits < bUnits end
        end
        local aOrder = tonumber(IngredientsConfig[a].LayoutOrder) or math.huge
        local bOrder = tonumber(IngredientsConfig[b].LayoutOrder) or math.huge
        return aOrder == bOrder and a < b or aOrder < bOrder
    end)

    for _, key in ipairs(keys) do
        if (Library and Library.Unloaded) or not State.StockEnabled then break end

        local cfg = IngredientsConfig[key]
        local child = inv:FindFirstChild(key)
        local units = child and tonumber(child.Value) or 0
        local cost = tonumber(cfg.Cost)
        local yieldAmount = tonumber(cfg.YieldAmount)
        local category = cfg.Category
        local sharedCap = SharedIngredientCaps[category]
        local cap = sharedCap
            or tonumber(cfg.StockCap or cfg.MaxStock)
            or State.StockCap
        local target = sharedCap
            and math.min(State.StockTarget,
                math.floor(sharedCap / math.max(1, sharedCounts[category] or 1)))
            or math.min(State.StockTarget, cap)
        local threshold = math.min(State.StockThreshold, target)
        local waitUntil = buyBackoff[key]

        if waitUntil and now < waitUntil then
            backedOff = backedOff + 1
        elseif units >= cap then
            capped = capped + 1
        elseif units < threshold then
            local headroom = math.floor((cap - units) / yieldAmount)
            if sharedCap then
                headroom = math.min(headroom, math.floor(
                    (sharedCap - (sharedTotals[category] or 0)) / yieldAmount))
            end
            local packs = math.min(
                math.ceil(math.max(0, target - units) / yieldAmount),
                headroom)
            local affordable = math.floor(
                math.max(0, cash - State.CashReserve) / cost)
            packs = math.min(packs, affordable)

            if headroom < 1 and sharedCap then
                sharedFull = sharedFull + 1
            elseif affordable < 1 then
                broke = broke + 1
                buyBackoff[key] = now + State.BrokeBackoff
            elseif packs > 0 then
                local boughtThisIngredient = 0

                for _ = 1, packs do
                    if (Library and Library.Unloaded) or not State.StockEnabled then break end
                    local okCall, success, msg = pcall(function()
                        return BuyIngredient:InvokeServer(key, 1, "Cash")
                    end)
                    if not okCall or not success then
                        buyBackoff[key] = os.clock() + State.BrokeBackoff
                        Stats.StockState = string.format(
                            "%s refused: %s", key, tostring(msg or success))
                        break
                    end

                    boughtThisIngredient = boughtThisIngredient + 1
                    packsBought = packsBought + 1
                    spent = spent + cost
                    cash = cash - cost
                    if sharedCap then
                        sharedTotals[category] =
                            (sharedTotals[category] or 0) + yieldAmount
                    end
                    Stats.StockBought = Stats.StockBought + 1
                    task.wait(0.18)
                end

                if boughtThisIngredient > 0 then
                    ingredientTypes = ingredientTypes + 1
                end
            end
        end
    end

    if packsBought > 0 then
        Stats.StockState = string.format(
            "Bought %d pack%s across %d ingredient%s for \u{20B1}%d",
            packsBought, packsBought == 1 and "" or "s",
            ingredientTypes, ingredientTypes == 1 and "" or "s", spent)
    elseif broke > 0 then
        Stats.StockState = string.format("Low cash \u{20B1}%d - holding reserve \u{20B1}%d",
            cash, State.CashReserve)
    elseif sharedFull > 0 then
        Stats.StockState = string.format(
            "Shared drink storage full (%d/%d)",
            sharedTotals.Softdrinks or 0,
            SharedIngredientCaps.Softdrinks)
    elseif backedOff > 0 then
        Stats.StockState = string.format(
            "Waiting to retry %d ingredient%s", backedOff,
            backedOff == 1 and "" or "s")
    elseif capped > 0 then
        Stats.StockState = string.format("Stocked (%d at cap)", capped)
    else
        Stats.StockState = "All stocked"
    end
end

