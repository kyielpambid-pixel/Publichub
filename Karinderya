local function stepTakeOrder()
    if not GetCounterInfo or not AssignNPC then return end
    local ok, npc, freeTables = pcall(function()
        return GetCounterInfo:InvokeServer()
    end)
    if not ok or type(npc) ~= "table" then return end

    local order = npc.Order
    local food = order and FoodConfig[order]
    local template = npc.TemplateName or ""
    local npcData = NPCTypes[template]

    if food and Config.MinOrderValue > 0 and (food.Cost or 0) < Config.MinOrderValue then
        if Config.AutoReject and RejectNPC then
            pcall(function() RejectNPC:FireServer() end)
            Stats.Rejected = Stats.Rejected + 1
        end
        return
    end

    if npcData and Config.MaxRunaway < 100 then
        if (npcData.RunawayChance or 0) > Config.MaxRunaway then
            if Config.AutoReject and RejectNPC then
                pcall(function() RejectNPC:FireServer() end)
                Stats.Rejected = Stats.Rejected + 1
            end
            return
        end
    end

    local missing = missingIngredients(order)
    if #missing > 0 then
        if Config.AutoBuyIngredients then
            Stats.Status = "Buying " .. table.concat(missing, ", ")
            for _, key in ipairs(missing) do buyIngredient(key) end
            task.wait(0.2)
            missing = missingIngredients(order)
        end
        if #missing > 0 then
            if Config.AutoReject and RejectNPC then
                pcall(function() RejectNPC:FireServer() end)
                Stats.Rejected = Stats.Rejected + 1
            end
            return
        end
    end

    freeTables = (type(freeTables) == "table") and freeTables or {}
    local slot = freeTables[1]
    if not slot then
        Stats.Status = "Waiting for tables"
        return
    end

    local npcId = npc.NpcId or npc.TemplateName or ""
    local sent = pcall(function()
        AssignNPC:FireServer({
            Slot = slot.Slot, Seat = slot.Seat,
            NPCName = npcId, NpcId = npcId,
        })
    end)
    if sent then
        Stats.Assigned = Stats.Assigned + 1
        Stats.Status = "Seated " .. tostring(npc.TemplateName)
    end
end

local function carryingFood()
    if HandState and typeof(HandState.IsHoldingFood) == "function" then
        local ok, res = pcall(HandState.IsHoldingFood)
