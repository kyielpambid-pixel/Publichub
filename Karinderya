local TrailFolder = Instance.new("Folder")
TrailFolder.Name = "_KHUB_Trails"
TrailFolder.Parent = Workspace

local function drawTrailLine(fromPos, toPos, color)
    if not Config.ShowTrailLine then return end
    local dist = (toPos - fromPos).Magnitude
    if dist < 0.5 then return end

    local part = Instance.new("Part")
    part.Name = "_trail_" .. tick()
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = color or Color3.fromRGB(160, 90, 255)
    part.Transparency = 0.35
    part.Size = Vector3.new(0.15, 0.15, dist)
    part.CFrame = CFrame.lookAt((fromPos + toPos) * 0.5, toPos)
    part.Parent = TrailFolder

    TweenService:Create(part, TweenInfo.new(Config.TrailLineLife, Enum.EasingStyle.Linear), {
        Transparency = 1,
        Size = Vector3.new(0.05, 0.05, dist),
    }):Play()

    task.delay(Config.TrailLineLife + 0.1, function()
        if part and part.Parent then part:Destroy() end
    end)
end

local MoveLock = false
local MoveLockTime = 0

local function acquireMove(timeout)
    local now = os.clock()
    if MoveLock and (now - MoveLockTime > 5) then MoveLock = false end
    local waited = 0
    timeout = timeout or 3
    while MoveLock and waited < timeout do
        task.wait(0.03)
        waited = waited + 0.03
        if MoveLock and (os.clock() - MoveLockTime > 5) then
            MoveLock = false
            break
        end
    end
    if MoveLock then return false end
    MoveLock = true
    MoveLockTime = os.clock()
    return true
end

local function releaseMove()
    MoveLock = false
end

local function teleportBypass(targetPos, customMicroStuds, customMicroDelay, customMaxSteps)
    local root = getRoot()
    if not root then return false end

    local startPos = root.Position
    local dist = (startPos - targetPos).Magnitude
    if dist < 1 then return true end

    local prevCollide = {}
    if Config.WallBypass then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                prevCollide[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    end

    local microStuds = customMicroStuds or Config.TrashMicroStuds
    local microDelay = customMicroDelay or Config.TrashMicroDelay
    local maxSteps = customMaxSteps or Config.TrashMicroMax
    
    local steps = math.ceil(dist / microStuds)
    steps = math.clamp(steps, 3, maxSteps)
    
    local speedMul = math.clamp(Config.BypassSpeed / 400, 0.25, 5)
    local stepDelay = microDelay / speedMul
    stepDelay = math.clamp(stepDelay, 0.003, 0.03)

    for i = 1, steps do
        local t = i / steps
        local r = getRoot()
        if not r then break end

        local lerped = startPos:Lerp(targetPos, t)
        local floatY = math.sin(t * math.pi) * Config.BypassFloatY
        local newCF = CFrame.new(lerped + Vector3.new(0, floatY, 0))

        if i > 1 then
            drawTrailLine(r.Position, newCF.Position, Color3.fromRGB(160, 90, 255))
        end

        r.CFrame = newCF
        task.wait(stepDelay)
    end

    local finalRoot = getRoot()
    if finalRoot then
        finalRoot.CFrame = CFrame.new(targetPos)
    end

    if Config.WallBypass then
        for part, collide in pairs(prevCollide) do
            if part and part.Parent then
                pcall(function() part.CanCollide = collide end)
            end
        end
    end

    return true
end

