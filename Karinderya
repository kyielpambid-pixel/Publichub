local function restaurantBusy(plot)
    if carryingFood() then return true end
    if Config.DishEnabled then
        if countHeldAttribute("IsDirty") > 0 then return true end
        if countSinkDishes(plot) >= Config.DishBatchSize then return true end
    end
    return false
end

local function findTrashSpawner()
    local names = {"GlobalTrashSpawner", "TrashSpawner", "TrashSpawns", "GlobalTrash", "Trash", "TrashFolder"}
    for _, name in ipairs(names) do
        local found = Workspace:FindFirstChild(name)
        if found then return found end
    end
    
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Folder") then
            local n = child.Name:lower()
            if n:find("trash") or n:find("garbage") or n:find("litter") then
                return child
            end
        end
    end
    
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            for _, sub in ipairs(child:GetChildren()) do
                if sub:GetAttribute("RewardAmount") then
                    return child
                end
            end
        end
    end
    
    return nil
end

local function buildTrashList()
    local spawner = findTrashSpawner()
    if not spawner then
        Stats.TrashState = "Trash spawner not found"
        return {}
    end
    
    local root = getRoot()
    local here = root and root.Position or Vector3.zero
    local list = {}
    
    for _, model in ipairs(spawner:GetChildren()) do
        local reward = model:GetAttribute("RewardAmount")
        if not reward then
            local rv = model:FindFirstChild("RewardAmount") or model:FindFirstChild("Reward")
            if rv and rv:IsA("ValueBase") then reward = rv.Value end
        end
        if not reward then reward = 5 end
        
        local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
        local pos = pivotOf(model)
        
        if prompt and pos then
            table.insert(list, {
                model = model, prompt = prompt, pos = pos,
                reward = reward, dist = (pos - here).Magnitude,
            })
        end
    end
    
    if #list == 0 then
        Stats.TrashState = string.format("No valid items in '%s'", spawner.Name)
        return {}
    end
    
    if Config.TrashByValue then
        table.sort(list, function(a, b)
            if a.reward == b.reward then return a.dist < b.dist end
            return a.reward > b.reward
        end)
    else
        table.sort(list, function(a, b) return a.dist < b.dist end)
    end
    return list
end

local function sweepTrash(plot)
    local list = buildTrashList()
    if #list == 0 then return end
    
    local total = 0
    for _, entry in ipairs(list) do total = total + entry.reward end
    Stats.TrashState = string.format("Bypass to %d items", #list)

    if not acquireMove(30) then return end
    local origin = getRoot() and getRoot().Position
    local collected = 0
    local failed = 0

    for index, entry in ipairs(list) do
        if not Config.TrashEnabled then break end
        if Config.TrashYield and restaurantBusy(plot) then break end
        
        if entry.model.Parent then
            Stats.TrashState = string.format("Bypass %d/%d  %s", index, #list, entry.model.Name)

            local targetPos = entry.pos + Vector3.new(0, 2, 0)
            local root = getRoot()
            if not root then break end

            local prevCollide = {}
            if Config.WallBypass then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        prevCollide[part] = part.CanCollide
                        part.CanCollide = false
                    end
                end
            end

            teleportBypass(targetPos, Config.TrashMicroStuds, Config.TrashMicroDelay, Config.TrashMicroMax)

            task.wait(Config.TrashSettleTime)

            local gotIt = false
            for attempt = 1, Config.TrashMaxAttempts do
                if not entry.model.Parent then
                    gotIt = true
                    break
                end
                
                if entry.prompt.Parent and entry.prompt.Enabled then
                    pcall(fireproximityprompt, entry.prompt, 0)
                    task.wait(0.25)
                end
                
                if not entry.model.Parent then
                    gotIt = true
                    break
                end
                task.wait(0.12)
            end
            
            if gotIt then
                collected = collected + 1
                Stats.Trash = Stats.Trash + 1
                Stats.TrashCash = Stats.TrashCash + entry.reward
            else
                failed = failed + 1
                Stats.TrashFailed = Stats.TrashFailed + 1
            end

            if Config.WallBypass then
                for part, collide in pairs(prevCollide) do
                    if part and part.Parent then
                        pcall(function() part.CanCollide = collide end)
                    end
                end
            end
            
            task.wait(Config.TrashDelay)
        end
    end

    if Config.ReturnToStart and origin then
        local r = getRoot()
        if r then
            local backTarget = origin + Vector3.new(0, 2, 0)
            local dist = (r.Position - backTarget).Magnitude
            
            if dist > 1 then
                local prevCollide = {}
                if Config.WallBypass then
                    for _, part in ipairs(player.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            prevCollide[part] = part.CanCollide
                            part.CanCollide = false
                        end
                    end
                end

                teleportBypass(backTarget, Config.TrashMicroStuds, Config.TrashMicroDelay, Config.TrashMicroMax)

                if Config.WallBypass then
                    for part, collide in pairs(prevCollide) do
                        if part and part.Parent then
                            pcall(function() part.CanCollide = collide end)
                        end
                    end
                end
            end
        end
    end

    releaseMove()
    Stats.TrashState = string.format("Collected %d, failed %d", collected, failed)
end

