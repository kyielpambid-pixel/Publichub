task.spawn(function()
    while task.wait(Config.LoopDelay) do
        if Config.AutoServe or Config.DishEnabled or Config.AutoGrabCooked then
            local plot = getPlot()
            if plot and getRoot() then
                pcall(function()
                    if carryingFood() then
                        if Config.AutoServe then 
                            stepServe(plot)
                        else
                            Stats.Status = "Carrying food"
                        end
                        return
                    end

                    if Config.AutoServe and Config.SoftdrinkEnabled then
                        if stepFulfillSoftdrinkOrders() then return end
                    end

                    if Config.AutoServe then
                        stepTakeOrder()
                    end

                    if Config.AutoServe or Config.AutoGrabCooked then
                        if stepPickupCooked(plot) then return end
                    end

