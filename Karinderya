local shopBackoff = 0
local shopBusy = false

local SHOP_CATEGORIES = { "Tables", "Chairs", "Stoves", "Paints", "Materials" }
local SHOP_LABELS = {
    Tables = {}, Chairs = {}, Stoves = {}, Paints = {}, Materials = {},
}
local SHOP_KEY_BY_LABEL = {
    Tables = {}, Chairs = {}, Stoves = {}, Paints = {}, Materials = {},
}

local function formatShopPrice(value)
    local text = tostring(math.floor(tonumber(value) or 0))
    local reversed = text:reverse():gsub("(%d%d%d)", "%1,")
    local formatted = reversed:reverse():gsub("^,", "")
    return formatted
end

local function getShopItemConfig(entry)
    if entry.Category == "Paints" then
        local cfg = PaintConfig[entry.Key]
        if cfg then
            return {
                Name = cfg.Name,
                Price = cfg.Cost,
                LayoutOrder = cfg.LayoutOrder,
            }
        end
    elseif entry.Category == "Materials" then
        local cfg = MaterialConfig[entry.Key]
        if cfg then
            return {
                Name = cfg.Name,
                Price = cfg.Cost,
                LayoutOrder = cfg.LayoutOrder,
            }
        end
    else
        return FurnitureConfig.GetItemConfig(
            entry.SystemType, entry.Category, entry.Key)
    end

    return nil
end

local function buildShopCatalog()
    local ok, info = pcall(function() return GetShopInfo:InvokeServer() end)
    if not ok or type(info) ~= "table" then return false end

    for _, category in ipairs(SHOP_CATEGORIES) do
        local catalog = {}
        local list = info[category]

        if type(list) == "table" then
            for _, entry in ipairs(list) do
                local cfg = getShopItemConfig(entry)
                local price = cfg and tonumber(cfg.Price)

                if price and price > 0 then
                    table.insert(catalog, {
                        Key = entry.Key,
                        Name = tostring(cfg.Name or entry.Key),
                        Price = price,
                        Order = tonumber(cfg.LayoutOrder) or 0,
                    })
                end
            end
        end

        table.sort(catalog, function(a, b)
            if a.Order == b.Order then return a.Price < b.Price end
            return a.Order > b.Order
        end)

        table.clear(SHOP_LABELS[category])
        table.clear(SHOP_KEY_BY_LABEL[category])

        for _, item in ipairs(catalog) do
            local label = string.format("%s  -  \u{20B1}%s",
                item.Name, formatShopPrice(item.Price))
            table.insert(SHOP_LABELS[category], label)
            SHOP_KEY_BY_LABEL[category][label] = item.Key
        end
    end

    return true
end

local function setShopSelection(category, selectedLabels)
    local selectedKeys = {}

    for label, enabled in pairs(selectedLabels or {}) do
        local key = SHOP_KEY_BY_LABEL[category][label]
        if enabled and key then selectedKeys[key] = true end
    end

    State.ShopSelected[category] = selectedKeys
end

buildShopCatalog()

local function shopPass()
    if shopBusy or os.clock() < shopBackoff then return end
    shopBusy = true

    local okRun, runError = pcall(function()
        local info = GetShopInfo:InvokeServer()
        if type(info) ~= "table" then
            Stats.ShopState = "Shop unavailable"
            return
        end

        local cash = getCash()
        local bought = 0
        local spent = 0
        local selectedCount = 0
        local selectedInStock = false
        local blockedByCash = false

        for _, category in ipairs(SHOP_CATEGORIES) do
            if (Library and Library.Unloaded) or not State.ShopEnabled then break end

            local selected = State.ShopSelected[category] or {}
            for _ in pairs(selected) do selectedCount = selectedCount + 1 end

            local list = info[category]
            if type(list) == "table" then
                for _, entry in ipairs(list) do
                    if (Library and Library.Unloaded) or not State.ShopEnabled then break end

                    if selected[entry.Key] then
                        local stock = tonumber(entry.Stock) or 0
                        local cfg = getShopItemConfig(entry)
                        local price = cfg and tonumber(cfg.Price)

                        if stock > 0 and price and price > 0 then
                            selectedInStock = true

                            for copy = 1, stock do
                                if (Library and Library.Unloaded) or not State.ShopEnabled then break end

                                if (cash - price) < State.CashReserve then
                                    blockedByCash = true
                                    break
                                end

                                local okCall, success, msg = pcall(function()
                                    return BuyFurniture:InvokeServer(
                                        entry.SystemType, entry.Category, entry.Key)
                                end)

                                if not okCall or not success then
                                    shopBackoff = os.clock() + 2
                                    Stats.ShopState = string.format(
                                        "%s refused: %s", entry.Key, tostring(msg or success))
                                    return
                                end

                                bought = bought + 1
                                spent = spent + price
                                cash = cash - price
                                Stats.ShopBought = Stats.ShopBought + 1
                                Stats.ShopSpent = Stats.ShopSpent + price

                                if copy < stock then task.wait(0.05) end
                            end
                        end
                    end
                end
            end
        end

        if bought > 0 then
            Stats.ShopState = string.format("Bought %d selected item%s for \u{20B1}%s",
                bought, bought == 1 and "" or "s", formatShopPrice(spent))
        elseif selectedCount == 0 then
            Stats.ShopState = "Choose exact furniture, paints or materials below"
        elseif blockedByCash then
            Stats.ShopState = "Selected stock found, but cash reserve blocked purchase"
        elseif not selectedInStock then
            Stats.ShopState = "Selected items out of stock - watching restocks"
        end
    end)

    shopBusy = false

    if not okRun then
        shopBackoff = os.clock() + 2
        Stats.ShopState = "Shop error: " .. tostring(runError)
    end
end

ShopRestocked.OnClientEvent:Connect(function()
    if (Library and Library.Unloaded) or not State.ShopEnabled then return end
    task.spawn(function()
        task.wait(0.1)
        pcall(shopPass)
    end)
end)

