local function getCash()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    local c = ls and ls:FindFirstChild("Cash")
    return c and c.Value or 0
end

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getPlot()
    for _, folder in ipairs(Workspace:GetChildren()) do
        if folder.Name:match("^Karenderya")
        and tostring(folder:GetAttribute("Owner")) == tostring(LocalPlayer.UserId) then
            return folder
        end
    end
    return nil
end

local function pivotOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local part = inst:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function firePromptAt(prompt, position, alreadyLocked)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    if not position then return false end

    local root = getRoot()
    if not root then return false end

    if not alreadyLocked then
        if not acquireMove() then return false end
    end

    local origin = root.CFrame
    root.CFrame = CFrame.new(position + Vector3.new(0, 2, 0))
    task.wait(State.SettleTime)

    local fired = false
    if prompt.Parent and prompt.Enabled then
        pcall(fireproximityprompt, prompt, 0)
        task.wait(0.2)
        fired = true
    end

    if State.ReturnToStart then
        root.CFrame = origin
    end

    if not alreadyLocked then
        releaseMove()
    end
    return fired
end

