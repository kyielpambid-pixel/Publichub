local function resolveDrinkKey(rawKey)
    if not rawKey then return "Kola" end
    local str = tostring(rawKey)
    local lower = str:lower():gsub("%s+", "")
    for ingName, _ in pairs(IngredientsConfig or {}) do
        if tostring(ingName):lower():gsub("%s+", "") == lower then
            return ingName
        end
    end
    if lower == "cola" or lower == "kola" or lower == "cocacola" then
        if IngredientsConfig["Kola"] then return "Kola" end
        if IngredientsConfig["Cola"] then return "Cola" end
        return "Kola"
    elseif lower == "suprise" or lower == "surprise" then
        if IngredientsConfig["Suprise"] then return "Suprise" end
        if IngredientsConfig["Surprise"] then return "Surprise" end
        return "Suprise"
    end
    return str
end

local function missingIngredients(foodKey)
    local food = FoodConfig[foodKey]
    if not food then return {} end
    local inv = player:FindFirstChild("Ingredients")
    local missing = {}
    for _, name in ipairs(food.RequiredIngredients or {}) do
        local value = inv and inv:FindFirstChild(name)
        if not value or value.Value <= 0 then table.insert(missing, name) end
    end
    return missing
end

local function buyIngredient(key)
    if not BuyIngredient then return false end
    local resolvedKey = resolveDrinkKey(key)
    local cfg = IngredientsConfig[resolvedKey] or IngredientsConfig[key]
    if not cfg or not cfg.Cost then return false end
    if getCash() - cfg.Cost < Config.CashReserve then return false end
    local okCall, success = pcall(function()
        return BuyIngredient:InvokeServer(resolvedKey, 1, "Cash")
    end)
    if okCall and success then
        Stats.Bought = Stats.Bought + 1
        return true
    end
    return false
end

