local function restaurantBusy(plot)
    if not plot then return false end
    if carryingFood() then return true end
    if State.DishEnabled then
        if countHeldAttribute("IsDirty") > 0 then return true end
        if countSinkDishes(plot) >= State.DishBatchSize then return true end
        if #findDirtyPrompts(plot) > 0 then return true end
    end
    return false
end

local function buildTrashList()
    local spawner = Workspace:FindFirstChild("GlobalTrashSpawner")
    if not spawner then return {} end

    local root = getRoot()
    local here = root and root.Position or Vector3.zero
    local list = {}

    for _, model in ipairs(spawner:GetChildren()) do
        local reward = model:GetAttribute("RewardAmount")
        local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
        local pos    = pivotOf(model)
        if reward and prompt and pos then
            table.insert(list, {
                model  = model,
                prompt = prompt,
                pos    = pos,
                reward = reward,
                dist   = (pos - here).Magnitude,
            })
        end
    end

    if State.TrashByValue then
        table.sort(list, function(a, b)
            if a.reward == b.reward then return a.dist < b.dist end
            return a.reward > b.reward
        end)
    else
        table.sort(list, function(a, b) return a.dist < b.dist end)
    end

    return list
end

local function sweepTrash(plot)
    local list = buildTrashList()
    if #list == 0 then
        Stats.TrashState = "Nothing on the ground"
        return
    end

    local total = 0
    for _, entry in ipairs(list) do total = total + entry.reward end
    Stats.TrashState = string.format("Sweeping %d items (\u{20B1}%d)", #list, total)

    local root = getRoot()
    if not root then return end
    if not acquireMove(5) then return end

    local origin = root.CFrame
    local collected = 0

    for index, entry in ipairs(list) do
        if (Library and Library.Unloaded) or not State.TrashEnabled then break end
        if State.TrashYield and restaurantBusy(plot) then
            Stats.TrashState = "Paused - restaurant needs you"
            break
        end
        if entry.model.Parent then
            Stats.TrashState = string.format(
                "%d/%d  %s  (\u{20B1}%d)",
                index, #list, entry.model.Name, entry.reward
            )
            local root2 = getRoot()
            if not root2 then break end
            root2.CFrame = CFrame.new(entry.pos + Vector3.new(0, 2, 0))
            task.wait(State.SettleTime)
            if entry.prompt.Parent and entry.prompt.Enabled then
                pcall(fireproximityprompt, entry.prompt, 0)
                task.wait(0.15)
            end
            if not entry.model.Parent then
                collected = collected + 1
                Stats.Trash = Stats.Trash + 1
                Stats.TrashCash = Stats.TrashCash + entry.reward
            end
            task.wait(State.TrashDelay)
        end
    end

    local finalRoot = getRoot()
    if finalRoot and State.ReturnToStart then
        finalRoot.CFrame = origin
    end
    releaseMove()

    Stats.TrashState = string.format("Swept %d item%s", collected, collected == 1 and "" or "s")
end

