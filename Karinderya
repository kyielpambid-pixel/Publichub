local function missingIngredients(foodKey)
    local food = FoodConfig[foodKey]
    if not food then return {} end

    local inv = LocalPlayer:FindFirstChild("Ingredients")
    local missing = {}
    for _, name in ipairs(food.RequiredIngredients or {}) do
        local value = inv and inv:FindFirstChild(name)
        if not value or value.Value <= 0 then
            table.insert(missing, name)
        end
    end
    return missing
end

local function buyIngredient(key)
    local resolvedKey = resolveDrinkKey(key)
    local cfg = IngredientsConfig[resolvedKey] or IngredientsConfig[key]
    if not cfg or not cfg.Cost then return false end
    if getCash() - cfg.Cost < State.CashReserve then return false end

    local okCall, success = pcall(function()
        return BuyIngredient:InvokeServer(resolvedKey, 1, "Cash")
    end)
    if okCall and success then
        Stats.Bought = Stats.Bought + 1
        return true
    end
    return false
end

