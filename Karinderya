local function addUpgradeTarget(targets, slot, holder, category)
    if not slot or not holder then return end
    local currentName, currentOrder = currentFurniture(holder, category)
    table.insert(targets[category], {
        Slot = slot,
        Holder = holder,
        Category = category,
        CurrentName = currentName,
        CurrentOrder = currentOrder,
    })
end

local function placeFurniture()
    if furniturePlaceBusy then
        Stats.TableState = "Furniture upgrade already running"
        return
    end

    furniturePlaceBusy = true

    local okRun, runError = pcall(function()
        local plot = getPlot()
        local dining = plot and plot:FindFirstChild("DiningPlot1")
        local kitchen = plot and plot:FindFirstChild("KitchenPlot1")
        if not plot or not dining then
            Stats.TableState = "Furniture plots unavailable"
            return
        end

        local okInventory, inventory = pcall(function()
            return GetFurnitureInventory:InvokeServer()
        end)
        if not okInventory or type(inventory) ~= "table" then
            Stats.TableState = "Furniture inventory unavailable"
            return
        end

        local unlocked = unlockedTables()
        local targets = { Tables = {}, Chairs = {}, Stoves = {} }

        for i = 1, 12 do
            local slotName = "Table" .. i
            local isOpen = (i <= 6) or (unlocked and unlocked[slotName] == true)
            local slot = dining:FindFirstChild(slotName)

            if isOpen and slot then
                addUpgradeTarget(targets, slot, slot:FindFirstChild("CurrentTable"), "Tables")
                addUpgradeTarget(targets, slot, slot:FindFirstChild("CurrentChair"), "Chairs")
            end
        end

        if kitchen then
            for i = 1, 4 do
                local slot = kitchen:FindFirstChild("slot" .. i)
                if slot then
                    addUpgradeTarget(targets, slot,
                        slot:FindFirstChild("CurrentBuilding"), "Stoves")
                end
            end
        end

        local sent = 0
        local verified = 0
        local failed = 0
        local remembered = 0
        local verifiedByCategory = { Tables = 0, Chairs = 0, Stoves = 0 }

        for _, category in ipairs({ "Tables", "Chairs", "Stoves" }) do
            table.sort(targets[category], function(a, b)
                return a.CurrentOrder < b.CurrentOrder
            end)

            for _, target in ipairs(targets[category]) do
                if (Library and Library.Unloaded) or not State.TablePlaceEnabled then break end

                local currentName, currentOrder = currentFurniture(
                    target.Holder, category)
                local bestName, bestOrder = bestOwned(inventory, category)
                if bestName and bestOrder > currentOrder
                and not wasFurnitureAttempted(target.Slot, category, bestName) then
                    markFurnitureAttempted(target.Slot, category, bestName)
                    local inventoryKey = category .. "_" .. bestName
                    inventory[inventoryKey] = math.max(
                        0, (tonumber(inventory[inventoryKey]) or 0) - 1)

                    if category == "Stoves" then
                        PlaceFurnitureEvent:FireServer(
                            target.Slot, category, bestName, "Kitchen")
                    else
                        PlaceFurnitureEvent:FireServer(
                            target.Slot, category, bestName)
                    end

                    sent = sent + 1
                    task.wait(0.25)

                    local applied = false
                    local deadline = os.clock() + 1.25
                    repeat
                        local _, placedOrder = currentFurniture(
                            target.Holder, category)
                        applied = placedOrder >= bestOrder
                        if not applied then task.wait(0.05) end
                    until applied or os.clock() >= deadline

                    if applied then
                        verified = verified + 1
                        verifiedByCategory[category] =
                            verifiedByCategory[category] + 1

                        if currentName then
                            local returnedKey = category .. "_" .. currentName
                            inventory[returnedKey] =
                                (tonumber(inventory[returnedKey]) or 0) + 1
                        end
                    else
                        inventory[inventoryKey] =
                            (tonumber(inventory[inventoryKey]) or 0) + 1
                        failed = failed + 1
                    end
                elseif bestName and bestOrder > currentOrder then
                    remembered = remembered + 1
                end
            end
        end

        if sent == 0 then
            Stats.TableState = remembered > 0
                and "Watching - current best furniture was already handled"
                or "Watching - placed furniture matches best items owned"
            return
        end

        Stats.Placed = Stats.Placed + verified

        if verified > 0 then
            Stats.TableState = string.format(
                "One pass: %d table%s, %d chair%s, %d stove%s upgraded%s",
                verifiedByCategory.Tables,
                verifiedByCategory.Tables == 1 and "" or "s",
                verifiedByCategory.Chairs,
                verifiedByCategory.Chairs == 1 and "" or "s",
                verifiedByCategory.Stoves,
                verifiedByCategory.Stoves == 1 and "" or "s",
                failed > 0 and string.format(" (%d busy slot%s skipped)",
                    failed, failed == 1 and "" or "s") or ""
            )
        else
            Stats.TableState = string.format(
                "%d busy slot%s skipped; run once again when free",
                failed, failed == 1 and "" or "s")
        end
    end)

    furniturePlaceBusy = false

    if not okRun then
        Stats.TableState = "Furniture error: " .. tostring(runError)
    end
end

