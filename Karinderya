local buyBackoff = {}

local function restockIngredients()
    if not BuyIngredient then return end
    local inv = player:FindFirstChild("Ingredients")
    if not inv then Stats.StockState = "No ingredients" return end
    local cash = getCash()
    local now = os.clock()
    local packsBought, spent = 0, 0

    local keys = {}
    for key, cfg in pairs(IngredientsConfig) do
        if type(key) == "string" and type(cfg) == "table"
        and tonumber(cfg.Cost) and tonumber(cfg.YieldAmount) then
            table.insert(keys, key)
        end
    end

    local sharedTotals, sharedCounts = {}, {}
    for _, key in ipairs(keys) do
        local cfg = IngredientsConfig[key]
        local category = cfg.Category
        if SharedIngredientCaps[category] then
            local child = inv:FindFirstChild(key)
            sharedTotals[category] = (sharedTotals[category] or 0) + (child and tonumber(child.Value) or 0)
            sharedCounts[category] = (sharedCounts[category] or 0) + 1
        end
    end

    for _, key in ipairs(keys) do
        if not Config.StockEnabled then break end
        local cfg = IngredientsConfig[key]
        local child = inv:FindFirstChild(key)
        local units = child and tonumber(child.Value) or 0
        local cost = tonumber(cfg.Cost)
        local yieldAmount = tonumber(cfg.YieldAmount)
        local category = cfg.Category
        local sharedCap = SharedIngredientCaps[category]
        local cap = sharedCap or tonumber(cfg.StockCap or cfg.MaxStock) or Config.StockCap
        local target = sharedCap and math.min(Config.StockTarget,
            math.floor(sharedCap / math.max(1, sharedCounts[category] or 1)))
            or math.min(Config.StockTarget, cap)
        local threshold = math.min(Config.StockThreshold, target)

        if (not buyBackoff[key] or now >= buyBackoff[key]) and units < threshold then
            local headroom = math.floor((cap - units) / yieldAmount)
            if sharedCap then
                headroom = math.min(headroom, math.floor((sharedCap - (sharedTotals[category] or 0)) / yieldAmount))
            end
            local packs = math.min(math.ceil(math.max(0, target - units) / yieldAmount), headroom)
            local affordable = math.floor(math.max(0, cash - Config.CashReserve) / cost)
            packs = math.min(packs, affordable)

            for _ = 1, packs do
                if not Config.StockEnabled then break end
                local okCall, success = pcall(function()
                    return BuyIngredient:InvokeServer(key, 1, "Cash")
                end)
                if okCall and success then
                    packsBought = packsBought + 1
                    spent = spent + cost
                    cash = cash - cost
                    Stats.StockBought = Stats.StockBought + 1
                    task.wait(0.15)
                else
                    buyBackoff[key] = os.clock() + Config.BrokeBackoff
                    break
                end
            end
        end
    end

    if packsBought > 0 then
        Stats.StockState = string.format("Bought %d packs (₱%d)", packsBought, spent)
    else
        Stats.StockState = "All stocked"
    end
end

