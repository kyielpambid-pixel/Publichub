--=====================================================================
-- DRINK KEY RESOLUTION
--=====================================================================

local function resolveDrinkKey(rawKey)
    if not rawKey then return "Kola" end
    local str = tostring(rawKey)
    local lower = str:lower():gsub("%s+", "")

    for ingName, _ in pairs(IngredientsConfig or {}) do
        if tostring(ingName):lower():gsub("%s+", "") == lower then
            return ingName
        end
    end

    if lower == "cola" or lower == "kola" or lower == "coca-cola" or lower == "cocacola" then
        if IngredientsConfig and IngredientsConfig["Kola"] then return "Kola" end
        if IngredientsConfig and IngredientsConfig["Cola"] then return "Cola" end
        return "Kola"
    elseif lower == "suprise" or lower == "surprise" then
        if IngredientsConfig and IngredientsConfig["Suprise"] then return "Suprise" end
        if IngredientsConfig and IngredientsConfig["Surprise"] then return "Surprise" end
        return "Suprise"
    elseif lower == "loyal" then
        return "Loyal"
    end

    return str
end

--=====================================================================
-- MOVEMENT LOCK
--=====================================================================

local MoveLock = false
local MoveLockTime = 0

local function acquireMove(timeout)
    local now = os.clock()
    if MoveLock and (now - MoveLockTime > 3.5) then
        MoveLock = false
    end

    local waited = 0
    timeout = timeout or 3
    while MoveLock and waited < timeout do
        task.wait(0.05)
        waited = waited + 0.05
        if MoveLock and (os.clock() - MoveLockTime > 3.5) then
            MoveLock = false
            break
        end
    end
    if MoveLock then return false end
    MoveLock = true
    MoveLockTime = os.clock()
    return true
end

local function releaseMove()
    MoveLock = false
end

