local function tryWhack(npcModel)
    if not Config.WhackEnabled then return end
    if not npcModel or not npcModel.Parent then return end
    if npcModel:GetAttribute("IsRunaway") ~= true then return end
    local last = whackFired[npcModel]
    if last and (os.clock() - last) < Config.WhackRetry then return end
    whackFired[npcModel] = os.clock()
    local name = npcModel.Name
    pendingAck[name] = true
    Stats.WhackTries = Stats.WhackTries + 1
    local target = npcModel:FindFirstChild("HumanoidRootPart") or npcModel.PrimaryPart
    if Config.WhackTeleport and target and HitRunawayEvent then
        if acquireMove(2) then
            local origin = getRoot() and getRoot().Position
            teleportBypass(target.Position + Vector3.new(0, 0, 3))
            task.wait(0.15)
            pcall(function() HitRunawayEvent:FireServer(name) end)
            task.wait(0.15)
            if Config.ReturnToStart and origin then teleportBypass(origin) end
            releaseMove()
            return
        end
    end
    if HitRunawayEvent then
        pcall(function() HitRunawayEvent:FireServer(name) end)
    end
end

