task.spawn(function()
    while task.wait(State.LoopDelay) do
        if (Library and Library.Unloaded) then break end

        if State.Enabled or State.DishEnabled then
            local plot = getPlot()
            if not plot then
                Stats.Status = "No plot owned - claim one first"
            elseif not getRoot() then
                Stats.Status = "Waiting for character"
            else
                pcall(function()
                    -- 1. High Priority: Serve carried food plate to table
                    if carryingFood() then
                        if State.Enabled then
                            stepServe(plot)
                        else
                            Stats.DishState = "Waiting for carried food to be served"
                            Stats.Status = Stats.DishState
                        end
                        return
                    end

                    -- 2. Instant Softdrink Orders: Fulfill directly via server remote
                    if State.Enabled and State.SoftdrinkEnabled then
                        if stepFulfillSoftdrinkOrders() then
                            return
                        end
                    end

                    -- 3. Take order & seat waiting customer at counter
                    if State.Enabled then
                        stepTakeOrder()
                    end

                    -- 4. Pickup freshly cooked food plate from serve counter
                    if State.Enabled then
                        if stepPickupCooked(plot) then
                            return
                        end
                    end

                    -- 5. Clean dirty dishes
                    if State.DishEnabled then
                        runDishCycle(plot)
                    end
                end)
            end
        else
            Stats.Status = "Idle"
        end
    end
end)

