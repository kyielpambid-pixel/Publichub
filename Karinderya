local function findDirtyPrompts(plot)
    local result = {}
    local dining = plot and plot:FindFirstChild("DiningPlot1")
    if not dining then return result end

    for _, prompt in ipairs(dining:QueryDescendants("ProximityPrompt")) do
        if prompt.Parent and prompt.Enabled then
            local tableAction = tostring(prompt:GetAttribute("TableAction") or "")
            local actionText  = tostring(prompt.ActionText or ""):lower()
            local promptName  = tostring(prompt.Name):lower()

            if tableAction == "GetDirty"
            or actionText:match("dirty") or actionText:match("clear") or actionText:match("dish")
            or promptName:match("dirty") then
                table.insert(result, prompt)
            end
        end
    end
    table.sort(result, function(a, b)
        return a:GetFullName() < b:GetFullName()
    end)
    return result
end

local function sinkParts(plot)
    local sinkFolder = plot and plot:FindFirstChild("Sink")
    local sink = sinkFolder and sinkFolder:FindFirstChild("Sink")
    local promptPart = sink and sink:FindFirstChild("PromptPart")
    local putPrompt  = promptPart and promptPart:FindFirstChild("Put")
    local washPrompt = promptPart and promptPart:FindFirstChild("Wash")

    if not putPrompt or not washPrompt then
        if sinkFolder then
            for _, prompt in ipairs(sinkFolder:QueryDescendants("ProximityPrompt")) do
                if prompt.Name == "Put" then putPrompt = prompt end
                if prompt.Name == "Wash" then washPrompt = prompt end
            end
        end
    end

    return sink, putPrompt, washPrompt
end

local function countSinkDishes(plot)
    local sink = sinkParts(plot)
    local place = sink and sink:FindFirstChild("place")
    local count = 0
    if place then
        for _, child in ipairs(place:GetChildren()) do
            if child.Name:match("^StackedDirty%d+$") then
                count = count + 1
            end
        end
    end
    return count
end

local function waitForSinkPrompt(plot, promptName, timeout)
    local deadline = os.clock() + (timeout or 0)
    repeat
        local _, putPrompt, washPrompt = sinkParts(plot)
        local prompt = promptName == "Put" and putPrompt or washPrompt
        if prompt and prompt.Parent and prompt.Enabled then
            return prompt
        end
        if os.clock() >= deadline then break end
        task.wait(0.05)
    until (Library and Library.Unloaded) or not State.DishEnabled
    return nil
end

local function waitForCountChange(readCount, before, timeout)
    local deadline = os.clock() + timeout
    local current = readCount()
    while current == before and os.clock() < deadline do
        task.wait(0.05)
        current = readCount()
    end
    return current, current ~= before
end

local function fireDishPromptLocked(prompt, completeHold)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local root = getRoot()
    local position = pivotOf(prompt.Parent)
    if not root or not position then return false end

    local target = CFrame.new(position + Vector3.new(0, 2, 0))
    root.CFrame = target
    task.wait(State.DishSettleTime)

    local ok
    if completeHold then
        local holdDuration = State.DishWashHoldDuration or 10
        if prompt.HoldDuration and prompt.HoldDuration > 0 then
            holdDuration = math.min(prompt.HoldDuration, holdDuration)
        end

        local began = false
        ok = pcall(function()
            prompt:InputHoldBegin()
            began = true
            local deadline = os.clock() + holdDuration + 0.05
            while os.clock() < deadline do
                if (Library and Library.Unloaded) or not State.DishEnabled or not prompt.Parent then
                    break
                end
                local currentRoot = getRoot()
                if currentRoot then currentRoot.CFrame = target end
                task.wait(0.1)
            end
        end)
        if began and prompt.Parent then
            pcall(function() prompt:InputHoldEnd() end)
        end
    else
        ok = pcall(fireproximityprompt, prompt, 0)
    end
    if completeHold then
        task.wait(0.05)
    else
        task.wait(0.15)
    end
    return ok
end

local function restoreAfterDish(savedCFrame)
    local root = getRoot()
    if not root or not savedCFrame then return false end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = savedCFrame
    task.wait()

    root = getRoot()
    if not root then return false end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = savedCFrame
    return true
end

local dishCycleBusy = false
local dishServeYieldUntil = 0
local dishWashRetryUntil = 0

local function runDishCycle(plot)
    if dishCycleBusy or not State.DishEnabled then return dishCycleBusy end

    if os.clock() < dishWashRetryUntil then
        Stats.DishState = string.format(
            "Back at saved position - next dish check in %ds",
            math.max(1, math.ceil(dishWashRetryUntil - os.clock())))
        return false
    end

    if State.Enabled and os.clock() < dishServeYieldUntil then
        Stats.DishState = string.format(
            "Auto Serve priority - dishes resume in %ds",
            math.max(1, math.ceil(dishServeYieldUntil - os.clock())))
        return false
    end

    local dirtyPrompts = findDirtyPrompts(plot)
    local carriedBefore = countHeldAttribute("IsDirty")
    local sinkBefore = countSinkDishes(plot)
    local batchAt = math.max(1, math.floor(State.DishBatchSize))

    if carriedBefore == 0 and sinkBefore < batchAt and #dirtyPrompts == 0 then
        Stats.DishState = string.format(
            "Watching for dirty dishes - sink %d/%d", sinkBefore, batchAt)
        return false
    end
    if carryingFood() then return false end
    if not acquireMove(2) then
        Stats.DishState = "Waiting for movement"
        return true
    end

    dishCycleBusy = true
    local root = getRoot()
    local origin = root and root.CFrame
    local washedCountThisCycle = 0
    local returnedImmediately = false

    local ok, err = pcall(function()
        if carriedBefore == 0 and sinkBefore >= batchAt then
            local washPrompt = waitForSinkPrompt(plot, "Wash", State.DishConfirmTime)
            if not washPrompt then
                Stats.DishState = "Sink has dishes, but Wash is unavailable"
                return
            end

            local holdTime = math.min(washPrompt.HoldDuration > 0 and washPrompt.HoldDuration or 10, State.DishWashHoldDuration)
            Stats.DishState = string.format(
                "Washing %d sink dish%s (%ds hold)", sinkBefore,
                sinkBefore == 1 and "" or "s", math.ceil(holdTime))
            local fired = fireDishPromptLocked(washPrompt, true)
            returnedImmediately = restoreAfterDish(origin)
            dishWashRetryUntil = os.clock() + State.DishServeYield
            dishServeYieldUntil = dishWashRetryUntil
            if fired then
                Stats.WashCycles = Stats.WashCycles + 1
                washedCountThisCycle = math.max(1, sinkBefore)
                Stats.DishState = string.format(
                    "Washed %d dishes - back at saved position; Auto Serve priority",
                    washedCountThisCycle)
            else
                Stats.DishState = "Wash input finished - returning to serve"
            end
            return
        end

        dirtyPrompts = findDirtyPrompts(plot)
        local pickupLimit = #dirtyPrompts

        for index = 1, pickupLimit do
            if (Library and Library.Unloaded) or not State.DishEnabled then break end
            local prompt = dirtyPrompts[index]
            local before = countHeldAttribute("IsDirty")
            Stats.DishState = string.format(
                "Collecting dirty dish %d/%d", index, pickupLimit)
            if prompt.Parent and prompt.Enabled then
                fireDishPromptLocked(prompt, false)
            end
            local after = waitForCountChange(
                function() return countHeldAttribute("IsDirty") end,
                before, State.DishConfirmTime)
            if after > before then
                local added = after - before
                Stats.DishesPicked = Stats.DishesPicked + added
            end
        end

        local held = countHeldAttribute("IsDirty")
        if held > 0 then
            Stats.DishState = string.format("Putting %d dishes in sink", held)
            local stalled = 0
            while held > 0 and stalled < 2 do
                local putPrompt = waitForSinkPrompt(plot, "Put", State.DishConfirmTime)
                if not putPrompt then
                    Stats.DishState = "Waiting for sink Put prompt"
                    break
                end

                fireDishPromptLocked(putPrompt, false)
                local remaining, changed = waitForCountChange(
                    function() return countHeldAttribute("IsDirty") end,
                    held, State.DishConfirmTime)
                if remaining < held then
                    Stats.DishesSunk = Stats.DishesSunk + (held - remaining)
                    held = remaining
                    stalled = 0
                else
                    stalled = stalled + 1
                end
            end
            if held > 0 then
                Stats.DishState = string.format(
                    "Sink refused %d carried dish%s; retrying", held,
                    held == 1 and "" or "es")
                return
            end
        end

        local sinkAfterPut = countSinkDishes(plot)
        if sinkAfterPut >= batchAt then
            local washPrompt = waitForSinkPrompt(plot, "Wash", State.DishConfirmTime)
            if not washPrompt then
                Stats.DishState = "Dishes loaded; waiting for Wash prompt"
                return
            end
            local holdTime = math.min(washPrompt.HoldDuration > 0 and washPrompt.HoldDuration or 10, State.DishWashHoldDuration)
            Stats.DishState = string.format(
                "Washing %d sink dish%s (%ds hold)", sinkAfterPut,
                sinkAfterPut == 1 and "" or "s", math.ceil(holdTime))
            local fired = fireDishPromptLocked(washPrompt, true)
            returnedImmediately = restoreAfterDish(origin)
            dishWashRetryUntil = os.clock() + State.DishServeYield
            dishServeYieldUntil = dishWashRetryUntil
            if fired then
                Stats.WashCycles = Stats.WashCycles + 1
                washedCountThisCycle = math.max(1, sinkAfterPut)
                Stats.DishState = string.format(
                    "Washed %d dishes - back at saved position; Auto Serve priority",
                    washedCountThisCycle)
            else
                Stats.DishState = "Wash finished - back at saved position"
            end
        else
            Stats.DishState = string.format(
                "Loaded sink %d/%d - waiting for full batch",
                sinkAfterPut, batchAt)
        end
    end)

    local returned = returnedImmediately or restoreAfterDish(origin)
    if washedCountThisCycle > 0 and returned then
        Stats.DishState = string.format(
            "Washed %d dishes - back at saved position; Auto Serve priority",
            washedCountThisCycle)
    end
    releaseMove()
    dishCycleBusy = false

    if not ok then
        Stats.DishState = "Dish cycle error: " .. tostring(err)
    end
    return true
end

