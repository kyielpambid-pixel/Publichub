local function slider(parent, labelText, min, max, default, callback, isInt)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundTransparency = 1
    row.ZIndex = 17
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.7, 0, 0, 16)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextColor3 = THEME.text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 18
    lbl.Parent = row

    local function fmt(v)
        if isInt then return tostring(math.floor(v + 0.5)) end
        return (string.format("%.3f", v):gsub("%.?0+$", ""))
    end

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.3, 0, 0, 16)
    val.Position = UDim2.new(0.7, 0, 0, 0)
    val.BackgroundTransparency = 1
    val.Text = fmt(default)
    val.Font = Enum.Font.Code
    val.TextSize = 11
    val.TextColor3 = THEME.gold
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.ZIndex = 18
    val.Parent = row

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, 7)
    bar.Position = UDim2.new(0, 0, 0, 24)
    bar.BackgroundColor3 = Color3.fromRGB(45, 30, 65)
    bar.ZIndex = 18
    bar.Parent = row
    corner(bar, 4)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = THEME.violet
    fill.ZIndex = 19
    fill.Parent = bar
    corner(fill, 4)

    local dragging = false
    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * rel
        if isInt then v = math.floor(v + 0.5) end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        val.Text = fmt(v)
        if callback then pcall(callback, v) end
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; setFromX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return bar
end

local function input(parent, labelText, default, callback, isNumeric)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 46)
    row.BackgroundTransparency = 1
    row.ZIndex = 17
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 16)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextColor3 = THEME.text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 18
    lbl.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 24)
    box.Position = UDim2.new(0, 0, 0, 20)
    box.BackgroundColor3 = Color3.fromRGB(18, 12, 28)
    box.BackgroundTransparency = 0.15
    box.Text = tostring(default or "")
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.TextColor3 = THEME.gold
    box.PlaceholderText = "..."
    box.PlaceholderColor3 = THEME.dim
    box.ClearTextOnFocus = false
    box.ZIndex = 18
    box.Parent = row
    corner(box, 5)
    mkstroke(box, THEME.stroke, 1, 0.5)

    box.FocusLost:Connect(function()
        if callback then
            if isNumeric then pcall(callback, tonumber(box.Text))
            else pcall(callback, box.Text) end
        end
    end)
    return box
end

