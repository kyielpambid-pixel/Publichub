local SIGNAGE_LABELS = {}
local SIGNAGE_KEY_BY_LABEL = {}
local SIGNAGE_CATALOG = {}

for key, cfg in pairs(SignageConfig) do
    local price = tonumber(cfg.CostCash) or 0
    if not cfg.IsDefault and cfg.Purchasable ~= false and price > 0 then
        table.insert(SIGNAGE_CATALOG, {
            Key = key,
            Name = tostring(cfg.Name or key),
            Price = price,
            CashMultiplier = tonumber(cfg.CashMultiplier) or 1,
            LuckMultiplier = tonumber(cfg.LuckMultiplier) or 1,
        })
    end
end

table.sort(SIGNAGE_CATALOG, function(a, b)
    if a.CashMultiplier ~= b.CashMultiplier then
        return a.CashMultiplier > b.CashMultiplier
    end
    if a.LuckMultiplier ~= b.LuckMultiplier then
        return a.LuckMultiplier > b.LuckMultiplier
    end
    return a.Name < b.Name
end)

for _, item in ipairs(SIGNAGE_CATALOG) do
    local label = string.format("%s  -  \u{20B1}%s  -  %.1fx cash / %.1fx luck",
        item.Name, formatShopPrice(item.Price),
        item.CashMultiplier, item.LuckMultiplier)
    table.insert(SIGNAGE_LABELS, label)
    SIGNAGE_KEY_BY_LABEL[label] = item.Key
end

local function setSignageSelection(selectedLabels)
    local selected = {}
    for label, enabled in pairs(selectedLabels or {}) do
        local key = SIGNAGE_KEY_BY_LABEL[label]
        if enabled and key then selected[key] = true end
    end
    State.SignageSelected = selected
end

local function signageMultipliers(key)
    local cfg = SignageConfig[key]
    return cfg and (tonumber(cfg.CashMultiplier) or 1) or 0,
        cfg and (tonumber(cfg.LuckMultiplier) or 1) or 0
end

local function strictlyBetterSignage(candidate, current)
    local candidateCash, candidateLuck = signageMultipliers(candidate)
    local currentCash, currentLuck = signageMultipliers(current)
    return candidateCash > currentCash
        or (candidateCash == currentCash and candidateLuck > currentLuck)
end

local function bestOwnedSignage(info)
    local unlocked = type(info.UnlockedSignages) == "table"
        and info.UnlockedSignages or {}
    local current = tostring(info.EquippedSignage or "Wooden")
    local best = SignageConfig[current] and current or "Wooden"

    local keys = {}
    for key, cfg in pairs(SignageConfig) do
        if cfg.IsDefault or unlocked[key] then
            table.insert(keys, key)
        end
    end
    table.sort(keys)

    for _, key in ipairs(keys) do
        if strictlyBetterSignage(key, best) then best = key end
    end
    return best
end

local signageBusy = false
local signageBackoff = {}

local function signagePass(forceBuy, forceEquip)
    if signageBusy then return end
    signageBusy = true

    local okRun, runError = pcall(function()
        local info = GetMyInfoData:InvokeServer()
        if type(info) ~= "table" then
            Stats.SignageState = "Signage data unavailable"
            return
        end

        local unlocked = type(info.UnlockedSignages) == "table"
            and info.UnlockedSignages or {}
        unlocked.Wooden = true
        info.UnlockedSignages = unlocked

        local shouldBuy = forceBuy or State.SignageBuyEnabled
        local shouldEquip = forceEquip or State.SignageEquipEnabled
        local cash = getCash()
        local bought = 0
        local spent = 0
        local selectedCount = 0
        local waitingCash = false

        if shouldBuy then
            for _, item in ipairs(SIGNAGE_CATALOG) do
                if State.SignageSelected[item.Key] then
                    selectedCount = selectedCount + 1
                    if not unlocked[item.Key]
                    and os.clock() >= (signageBackoff[item.Key] or 0) then
                        if (cash - item.Price) < State.CashReserve then
                            waitingCash = true
                        else
                            local okCall, success, message = pcall(function()
                                return BuySignage:InvokeServer(item.Key)
                            end)
                            if okCall and success then
                                unlocked[item.Key] = true
                                info.EquippedSignage = item.Key
                                cash = cash - item.Price
                                bought = bought + 1
                                spent = spent + item.Price
                                Stats.SignagesBought = Stats.SignagesBought + 1
                                Stats.SignageSpent = Stats.SignageSpent + item.Price
                                task.wait(0.15)
                            else
                                signageBackoff[item.Key] = os.clock() + 10
                                Stats.SignageState = string.format(
                                    "%s purchase refused: %s",
                                    item.Key, tostring(message or success))
                            end
                        end
                    end
                end
            end
        end

        if shouldEquip then
            local current = tostring(info.EquippedSignage or "Wooden")
            local best = bestOwnedSignage(info)
            local equipBackoffKey = "equip_" .. best
            if strictlyBetterSignage(best, current)
            and os.clock() >= (signageBackoff[equipBackoffKey] or 0) then
                local okCall, success, message = pcall(function()
                    return EquipSignage:InvokeServer(best)
                end)
                if okCall and success then
                    info.EquippedSignage = best
                    Stats.SignageState = string.format(
                        "Equipped best owned signage: %s", best)
                else
                    signageBackoff[equipBackoffKey] = os.clock() + 10
                    Stats.SignageState = string.format(
                        "%s equip refused: %s", best,
                        tostring(message or success))
                end
            elseif bought == 0 then
                local cashMulti, luckMulti = signageMultipliers(current)
                Stats.SignageState = string.format(
                    "Best equipped: %s (%.1fx cash / %.1fx luck)",
                    current, cashMulti, luckMulti)
            end
        end

        if bought > 0 then
            Stats.SignageState = string.format(
                "Bought %d signage%s for \u{20B1}%s; equipped %s",
                bought, bought == 1 and "" or "s",
                formatShopPrice(spent), tostring(info.EquippedSignage))
        elseif shouldBuy and selectedCount == 0 then
            Stats.SignageState = "Choose specific cash signages below"
        elseif waitingCash then
            Stats.SignageState = string.format(
                "Waiting for cash while keeping \u{20B1}%s reserve",
                formatShopPrice(State.CashReserve))
        end
    end)

    signageBusy = false
    if not okRun then
        Stats.SignageState = "Signage error: " .. tostring(runError)
    end
end

local firedCodes = {}

local function activeCodes()
    local list = {}
    for code, data in pairs(CodeConfig) do
        if type(code) == "string" and type(data) == "table" and data.Expired ~= true then
            table.insert(list, code)
        end
    end
    table.sort(list)
    return list
end

local function redeemAll(force)
    local list = activeCodes()
    if #list == 0 then
        Stats.CodeState = "No active codes in CodeConfig"
        return 0
    end

    local sent = 0
    for index, code in ipairs(list) do
        if (Library and Library.Unloaded) then break end
        if force or not firedCodes[code] then
            Stats.CodeState = string.format("Redeeming %d/%d - %s", index, #list, code)
            local ok = pcall(function()
                RedeemCode:FireServer(code)
            end)
            if ok then
                firedCodes[code] = true
                sent = sent + 1
                Stats.Codes = Stats.Codes + 1
            end
            task.wait(State.CodeDelay)
        end
    end

    if sent > 0 then
        Stats.CodeState = string.format("Sent %d code%s (%d active)", sent, sent == 1 and "" or "s", #list)
    else
        Stats.CodeState = string.format("All %d active code%s already sent", #list, #list == 1 and "" or "s")
    end
    return sent
end

local whackFired = setmetatable({}, { __mode = "k" })
local pendingAck = {}

local NPCRagdolled = Remotes:FindFirstChild("NPCRagdolled", true)
if NPCRagdolled and NPCRagdolled:IsA("RemoteEvent") then
    local ackConn
    ackConn = NPCRagdolled.OnClientEvent:Connect(function(npcName)
        if (Library and Library.Unloaded) then
            ackConn:Disconnect()
            return
        end
        if pendingAck[npcName] then
            pendingAck[npcName] = nil
            Stats.Whacked = Stats.Whacked + 1
        end
    end)
end

local function tryWhack(npcModel)
    if not State.WhackEnabled then return end
    if not npcModel or not npcModel.Parent then return end
    if npcModel:GetAttribute("IsRunaway") ~= true then return end

    local last = whackFired[npcModel]
    if last and (os.clock() - last) < State.WhackRetry then return end
    whackFired[npcModel] = os.clock()

    local name = npcModel.Name
    pendingAck[name] = true
    Stats.WhackTries = Stats.WhackTries + 1

    local target = npcModel:FindFirstChild("HumanoidRootPart") or npcModel.PrimaryPart

    if State.WhackTeleport and target then
        local root = getRoot()
        if root and acquireMove(2) then
            local origin = root.CFrame
            root.CFrame = target.CFrame * CFrame.new(0, 0, 3)
            task.wait(0.15)
            pcall(function() HitRunawayEvent:FireServer(name) end)
            task.wait(0.15)
            local back = getRoot()
            if back and State.ReturnToStart then back.CFrame = origin end
            releaseMove()
            return
        end
    end

    pcall(function() HitRunawayEvent:FireServer(name) end)
end

local whackFolder, whackFolderConn

task.spawn(function()
    while task.wait(State.WhackPoll) do
        if (Library and Library.Unloaded) then
            if whackFolderConn then whackFolderConn:Disconnect() end
            break
        end
        if State.WhackEnabled then
            local folder = Workspace:FindFirstChild("ClientNPCs")
            if folder then
                if folder ~= whackFolder then
                    whackFolder = folder
                    if whackFolderConn then whackFolderConn:Disconnect() end
                    whackFolderConn = folder.ChildAdded:Connect(function(child)
                        if child:IsA("Model") and child:GetAttribute("IsRunaway") == true then
                            task.spawn(tryWhack, child)
                        end
                    end)
                end
                for _, npc in ipairs(folder:GetChildren()) do
                    if npc:GetAttribute("IsRunaway") == true then
                        task.spawn(tryWhack, npc)
                    end
                end
            end
        end
    end
end)

