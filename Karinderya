local tableBackoff = 0
local tableBuyBusy = false
local furniturePlaceBusy = false
local furnitureAttempts = setmetatable({}, { __mode = "k" })

local function wasFurnitureAttempted(slot, category, itemName)
    local byCategory = furnitureAttempts[slot]
    return byCategory and byCategory[category] == itemName
end

local function markFurnitureAttempted(slot, category, itemName)
    local byCategory = furnitureAttempts[slot]
    if not byCategory then
        byCategory = {}
        furnitureAttempts[slot] = byCategory
    end
    byCategory[category] = itemName
end

local FURNITURE_SYSTEM = {
    Tables = "Dining",
    Chairs = "Dining",
    Stoves = "Kitchen",
}

local function furnitureOrder(category, itemName)
    if not itemName then return -1 end
    local cfg = FurnitureConfig.GetItemConfig(
        FURNITURE_SYSTEM[category], category, itemName)
    return cfg and (tonumber(cfg.LayoutOrder) or 0) or -1
end

local function bestOwned(inventory, category)
    local bestName, bestOrder
    for key, count in pairs(inventory) do
        local cat, item = tostring(key):match("^(%a+)_(.+)$")
        if cat == category and (tonumber(count) or 0) > 0 then
            local order = furnitureOrder(category, item)
            if order >= 0 and (not bestOrder or order > bestOrder) then
                bestOrder, bestName = order, item
            end
        end
    end
    return bestName, bestOrder
end

local function currentFurniture(holder, category)
    if not holder then return nil, -1 end
    local placed = holder:GetChildren()[1]
    if not placed then return nil, -1 end

    local itemName = placed:GetAttribute("OriginalItemName") or placed.Name
    return itemName, furnitureOrder(category, itemName)
end

local function unlockedTables()
    local ok, t = pcall(function() return GetUnlockedTables:InvokeServer() end)
    return ok and type(t) == "table" and t or nil
end

local function nextLockedTable(unlocked)
    local unlockedCount = 0
    for _, isUnlocked in pairs(unlocked) do
        if isUnlocked == true then
            unlockedCount = unlockedCount + 1
        end
    end

    local target
    for i = 7, 12 do
        local name = "Table" .. i
        if unlocked[name] ~= true then
            target = name
            break
        end
    end
    return target, (unlockedCount + 1) * 20000
end

local function buyNextTablePass()
    local unlocked = unlockedTables()
    if not unlocked then
        Stats.TableState = "Waiting for live table-slot data"
        return
    end

    local target, exactPrice = nextLockedTable(unlocked)
    if not target then
        Stats.TableState = "All 12 tables unlocked"
        return
    end

    local cash = getCash()
    if cash < exactPrice then
        Stats.TableState = string.format(
            "%s costs \u{20B1}%d - cash \u{20B1}%d (need \u{20B1}%d more)",
            target, exactPrice, cash, exactPrice - cash)
        return
    end

    local okCall, success, msg = pcall(function()
        return BuyTableEvent:InvokeServer(target)
    end)

    if okCall and success then
        Stats.TablesBought = Stats.TablesBought + 1
        tableBackoff = 0
        Stats.TableState = string.format(
            "Unlocked %s for \u{20B1}%d", target, exactPrice)
    else
        tableBackoff = os.clock() + 10
        Stats.TableState = string.format("%s refused: %s", target, tostring(msg))
    end
end

local function buyNextTable()
    if tableBuyBusy or os.clock() < tableBackoff then return end
    tableBuyBusy = true
    local ok, err = pcall(buyNextTablePass)
    tableBuyBusy = false
    if not ok then
        tableBackoff = os.clock() + 10
        Stats.TableState = "Error: " .. tostring(err)
    end
end

