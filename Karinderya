    for id, btn in pairs(TabButtons) do
        if type(id) == "string" and not id:find("_") then
            local active = (id == name)
            local iconFrame = TabButtons[id .. "_Frame"]
            local glow      = TabButtons[id .. "_Glow"]
            local bar       = TabButtons[id .. "_Bar"]
            local lbl       = TabButtons[id .. "_Label"]
            local icon      = TabButtons[id .. "_Icon"]
            local stroke    = TabButtons[id .. "_Stroke"]

            if active then
                TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundTransparency = 0.05 }):Play()
