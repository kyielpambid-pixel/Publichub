local function stepFulfillSoftdrinkOrders()
    if not State.SoftdrinkEnabled or #activeDrinkOrders == 0 then return false end

    local drinkKey = activeDrinkOrders[1]
    drinkKey = resolveDrinkKey(drinkKey)

    local now = os.clock()
    if now < (lastDrinkAttempt[drinkKey] or 0) then return false end
    lastDrinkAttempt[drinkKey] = now + State.SoftdrinkRetry

    -- 1. Ensure ingredient is in stock
    local ingredients = LocalPlayer:FindFirstChild("Ingredients")
    local stock = ingredients and ingredients:FindFirstChild(drinkKey)
    if not stock or stock.Value <= 0 then
        if State.AutoBuy then
            buyIngredient(drinkKey)
            task.wait(0.2)
            ingredients = LocalPlayer:FindFirstChild("Ingredients")
            stock = ingredients and ingredients:FindFirstChild(drinkKey)
        end
        if not stock or stock.Value <= 0 then
            lastDrinkAttempt[drinkKey] = now + 5
            Stats.SoftdrinkState = drinkKey .. " out of stock"
            return false
        end
    end

    -- 2. Directly fulfill softdrink order via game remote
    local okCall, success, msg = pcall(function()
        return GiveSoftdrink:InvokeServer(drinkKey)
    end)

    if okCall and success then
        table.remove(activeDrinkOrders, 1)
        Stats.SoftdrinksGiven = Stats.SoftdrinksGiven + 1
        Stats.SoftdrinkState = string.format("Delivered %s to customer!", drinkKey)
        return true
    else
        if tostring(msg):match("Nobody") or tostring(msg):match("ordered") then
            table.remove(activeDrinkOrders, 1)
        end
        Stats.SoftdrinkState = string.format("%s: %s", drinkKey, tostring(msg or success))
    end
    return false
end

