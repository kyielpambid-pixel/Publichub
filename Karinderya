--=====================================================================
local currentServeTarget = nil
local currentServeAttempts = 0
local currentServeStart = 0

local function findServePrompt(plot, targetNpcId)
    local dining = plot:FindFirstChild("DiningPlot1")
    if not dining then return nil end

    if not targetNpcId then
        local char = player.Character
        if char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Accessory") and item:GetAttribute("IsFood") then
                    local val = item:FindFirstChild("TargetNPCId")
                    if val and val.Value ~= "" then targetNpcId = val.Value break end
                    local val2 = item:GetAttribute("TargetNPCId")
                    if val2 and val2 ~= "" then targetNpcId = val2 break end
                end
            end
        end
    end

    local targetPos = nil
    if targetNpcId then
        local clientNPCs = Workspace:FindFirstChild("ClientNPCs")
        local npcModel = clientNPCs and clientNPCs:FindFirstChild(targetNpcId)
        if npcModel then
            targetPos = pivotOf(npcModel)
        end
    end

    if targetPos then
        local closestPrompt, closestDist = nil, math.huge
        for _, node in ipairs(dining:GetDescendants()) do
            if node:IsA("ProximityPrompt") and node.Enabled
            and (node:GetAttribute("TableAction") == "Serve" or node.ActionText:lower():match("serve")) then
                local pPos = pivotOf(node.Parent)
                if pPos then
                    local d = (pPos - targetPos).Magnitude
                    if d < closestDist then
                        closestDist = d; closestPrompt = node
                    end
                end
            end
        end
        if closestPrompt and closestDist < 25 then
            return { prompt = closestPrompt, pos = pivotOf(closestPrompt.Parent), npcPos = targetPos }
        end
    end

    for _, node in ipairs(dining:GetDescendants()) do
        if node:IsA("ProximityPrompt") and node.Enabled
        and (node:GetAttribute("TableAction") == "Serve" or node.ActionText:lower():match("serve")) then
            return { prompt = node, pos = pivotOf(node.Parent) }
        end
    end
    return nil
end

local function stepServe(plot)
    if not carryingFood() then
        currentServeTarget = nil
        currentServeAttempts = 0
        return false
    end

    if not currentServeTarget or not currentServeTarget.prompt.Parent then
        local target = findServePrompt(plot)
        if not target then
            Stats.Status = "No serve prompt found"
            return false
        end
        currentServeTarget = target
        currentServeAttempts = 0
        currentServeStart = os.clock()
    end

    local target = currentServeTarget
    local prompt = target.prompt

    if not prompt.Parent or not prompt.Enabled then
        currentServeTarget = nil
        currentServeAttempts = 0
        return false
    end

    if os.clock() - currentServeStart > Config.ParkMaxTime then
        Stats.Status = "Serve timeout"
        currentServeTarget = nil
        currentServeAttempts = 0
        return false
    end

    if currentServeAttempts >= Config.ParkMaxAttempts then
        Stats.Status = "Serve gave up"
        currentServeTarget = nil
        currentServeAttempts = 0
        return false
    end

    local pos = target.pos or pivotOf(prompt.Parent)
    if not pos then
        currentServeTarget = nil
        return false
    end

    if acquireMove(3) then
        local root = getRoot()
        local servePos = pos + Vector3.new(0, 2, 0)
        
        if not root or (root.Position - servePos).Magnitude > 3 then
            Stats.Status = string.format("Parking at customer (%d)", currentServeAttempts + 1)
            teleportBypass(servePos)
        end
        
        task.wait(Config.SettleTime)
        currentServeAttempts = currentServeAttempts + 1
        Stats.Status = string.format("Serving (%d/%d)", currentServeAttempts, Config.ParkMaxAttempts)

        if prompt.Parent and prompt.Enabled then
            pcall(fireproximityprompt, prompt, 0)
            task.wait(0.4)
        end

        if not carryingFood() then
            Stats.Served = Stats.Served + 1
            Stats.Status = "Food served!"
            currentServeTarget = nil
            currentServeAttempts = 0
            releaseMove()
            return true
        end

        releaseMove()

        if Config.ParkModeEnabled then
            task.wait(Config.ParkAttemptDelay)
            return true
        end
    end
    return false
end

