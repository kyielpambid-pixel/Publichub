    if name == "" then
        StatusLbl.Text = "Status: Type a name first"
        StatusLbl.TextColor3 = THEME.red
        return
    end
    ensureFolder()
    local ok, err = pcall(function()
        if not writefile then error("writefile not supported") end
        writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(Config))
    end)
    if ok then
        selectedConfig = name
        StatusLbl.Text = "Status: Saved \"" .. name .. "\""
        StatusLbl.TextColor3 = THEME.green
        refreshConfigList()
    else
        StatusLbl.Text = "Status: Failed — " .. tostring(err)
        StatusLbl.TextColor3 = THEME.red
    end
end)

