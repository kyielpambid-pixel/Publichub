local function stepTakeOrder()
    local ok, npc, freeTables = pcall(function()
        return GetCounterInfo:InvokeServer()
    end)
    if not ok or type(npc) ~= "table" then return end

    local order    = npc.Order
    local food     = order and FoodConfig[order]
    local template = npc.TemplateName or ""
    local npcData  = NPCTypes[template]

    if food and State.MinOrderValue > 0 and (food.Cost or 0) < State.MinOrderValue then
        if State.AutoReject then
            pcall(function() RejectNPC:FireServer() end)
            Stats.Rejected = Stats.Rejected + 1
            Stats.Status = "Rejected " .. template .. " (low value: " .. tostring(order) .. ")"
        end
        return
    end

    if npcData and State.MaxRunaway < 100 then
        local runaway = npcData.RunawayChance or 0
        if runaway > State.MaxRunaway then
            if State.AutoReject then
                pcall(function() RejectNPC:FireServer() end)
                Stats.Rejected = Stats.Rejected + 1
                Stats.Status = string.format("Rejected %s (%s, %d%% runaway)",
                    template, npcData.Rarity or "?", runaway)
            end
            return
        end
    end

    local missing = missingIngredients(order)
    if #missing > 0 then
        if State.AutoBuy then
            Stats.Status = "Buying " .. table.concat(missing, ", ")
            for _, key in ipairs(missing) do
                buyIngredient(key)
            end
            task.wait(0.2)
            missing = missingIngredients(order)
        end
        if #missing > 0 then
            if State.AutoReject then
                pcall(function() RejectNPC:FireServer() end)
                Stats.Rejected = Stats.Rejected + 1
            end
            return
        end
    end

    freeTables = (type(freeTables) == "table") and freeTables or {}
    local slot = freeTables[1]
    if not slot then
        Stats.Status = "Waiting for tables to free up"
        return
    end

    local npcId = npc.NpcId or npc.TemplateName or ""
    local sent = pcall(function()
        AssignNPC:FireServer({
            Slot    = slot.Slot,
            Seat    = slot.Seat,
            NPCName = npcId,
            NpcId   = npcId,
        })
    end)

    if sent then
        Stats.Assigned = Stats.Assigned + 1
        Stats.Status = "Seated " .. tostring(npc.TemplateName) .. " -> " .. tostring(slot.Name)
    end
end

local function carryingFood()
    if HandState and typeof(HandState.IsHoldingFood) == "function" then
        return HandState.IsHoldingFood()
    end
    local char = LocalPlayer.Character
    if not char then return false end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Accessory") and item:GetAttribute("IsFood") then
            return true
        end
    end
    return false
end

local plateBackoff = {}

local function stepPickupCooked(plot)
    if HandState and typeof(HandState.CanPickUpFood) == "function" then
        if not HandState.CanPickUpFood() then
            return false
        end
    end

    local serve = plot:FindFirstChild("Serve")
    if not serve then return false end

    local now = os.clock()
    for _, spot in ipairs(serve:GetChildren()) do
        for _, model in ipairs(spot:GetChildren()) do
            if model.Name:match("^Cooked_") and now >= (plateBackoff[model] or 0) then
                local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled then
                    Stats.Status = "Picking up " .. model.Name:gsub("^Cooked_", "")
                    local platePart = prompt.Parent
                    local pos = platePart:IsA("BasePart") and platePart.Position or platePart:GetPivot().Position

                    local root = getRoot()
                    if root and acquireMove(2) then
                        local origin = root.CFrame
                        root.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                        task.wait(State.SettleTime)

                        pcall(fireproximityprompt, prompt, 0)
                        task.wait(0.25)

                        if carryingFood() then
                            Stats.PickedUp = Stats.PickedUp + 1
                            releaseMove()
                            return true
                        else
                            plateBackoff[model] = os.clock() + 4
                            if State.ReturnToStart and getRoot() then
                                getRoot().CFrame = origin
                            end
                        end
                        releaseMove()
                    end
                end
            end
        end
    end
    return false
end

local function findServePrompt(plot)
    local dining = plot:FindFirstChild("DiningPlot1")
    if not dining then return nil, nil end

    local char = LocalPlayer.Character
    local targetNpcId
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Accessory") and item:GetAttribute("IsFood") then
                local val = item:FindFirstChild("TargetNPCId")
                if val and val.Value ~= "" then
                    targetNpcId = val.Value
                    break
                end
            end
        end
    end

    if targetNpcId then
        local clientNPCs = Workspace:FindFirstChild("ClientNPCs")
        local npcModel = clientNPCs and clientNPCs:FindFirstChild(targetNpcId)
        if npcModel then
            local npcPos = pivotOf(npcModel)
            if npcPos then
                local closestPrompt, closestDist = nil, math.huge
                for _, node in ipairs(dining:GetDescendants()) do
                    if node:IsA("ProximityPrompt") and node.Enabled
                    and (node:GetAttribute("TableAction") == "Serve" or node.ActionText:lower():match("serve")) then
                        local pPos = pivotOf(node.Parent)
                        if pPos then
                            local d = (pPos - npcPos).Magnitude
                            if d < closestDist then
                                closestDist = d
                                closestPrompt = node
                            end
                        end
                    end
                end
                if closestPrompt and closestDist < 15 then
                    return closestPrompt, closestPrompt.Parent
                end
            end
        end
    end

    for _, node in ipairs(dining:GetDescendants()) do
        if node:IsA("ProximityPrompt") and node.Enabled
        and (node:GetAttribute("TableAction") == "Serve" or node.ActionText:lower():match("serve")) then
            return node, node.Parent
        end
    end

    return nil, nil
end

local function stepServe(plot)
    if not carryingFood() then return false end

    local prompt, tbl = findServePrompt(plot)
    if prompt and prompt.Parent then
        Stats.Status = "Serving food to table..."
        local pos = pivotOf(prompt.Parent) or pivotOf(tbl)
        if pos and firePromptAt(prompt, pos) then
            task.wait(0.25)
            if not carryingFood() then
                Stats.Served = Stats.Served + 1
                Stats.Status = "Food served!"
                return true
            end
        end
    end
    return true
end

