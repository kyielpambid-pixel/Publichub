end

--=====================================================================
-- PARK MODE PICKUP
--=====================================================================
local plateBackoff = {}
local currentPickupTarget = nil
local currentPickupAttempts = 0
local currentPickupStart = 0

local function findCookedPlate(plot)
    local serve = plot:FindFirstChild("Serve")
    if not serve then return nil end

    local now = os.clock()
    local best = nil
    local bestDist = math.huge
    local root = getRoot()
    local here = root and root.Position or Vector3.zero

    for _, spot in ipairs(serve:GetChildren()) do
        for _, model in ipairs(spot:GetChildren()) do
            local isCooked = model.Name:match("^Cooked_") or 
                            model.Name:match("^Food_") or
                            model.Name:match("^Dish_") or
                            model:GetAttribute("IsFood") == true
            if isCooked and now >= (plateBackoff[model] or 0) then
                local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled then
                    local pos = pivotOf(prompt.Parent) or pivotOf(model)
                    if pos then
                        local d = (pos - here).Magnitude
                        if d < bestDist then
                            bestDist = d
                            best = { model = model, prompt = prompt, pos = pos }
                        end
                    end
                end
            end
        end
    end
    return best
end

local function stepPickupCooked(plot)
    if not Config.AutoServe and not Config.AutoGrabCooked then return false end
    if carryingFood() then
        currentPickupTarget = nil
        currentPickupAttempts = 0
        return false
    end

    if HandState and typeof(HandState.CanPickUpFood) == "function" then
        local ok, canPickup = pcall(HandState.CanPickUpFood)
        if ok and not canPickup then return false end
    end

    if not currentPickupTarget or not currentPickupTarget.model.Parent then
        local target = findCookedPlate(plot)
        if not target then
            currentPickupTarget = nil
            currentPickupAttempts = 0
            return false
        end
        currentPickupTarget = target
        currentPickupAttempts = 0
        currentPickupStart = os.clock()
    end

    local target = currentPickupTarget
    local prompt = target.prompt
    local model = target.model

    if not model.Parent or not prompt.Parent or not prompt.Enabled then
        currentPickupTarget = nil
        currentPickupAttempts = 0
        plateBackoff[model] = os.clock() + 2
        return false
    end

    if os.clock() - currentPickupStart > Config.ParkMaxTime then
        Stats.Status = "Pickup timeout"
        plateBackoff[model] = os.clock() + 3
        currentPickupTarget = nil
        currentPickupAttempts = 0
        return false
    end

    if currentPickupAttempts >= Config.ParkMaxAttempts then
        Stats.Status = "Pickup gave up"
        plateBackoff[model] = os.clock() + 3
        currentPickupTarget = nil
        currentPickupAttempts = 0
        return false
    end

    local cleanName = model.Name:gsub("^Cooked_", ""):gsub("^Food_", ""):gsub("^Dish_", "")

    if acquireMove(3) then
        local root = getRoot()
        local platePos = target.pos + Vector3.new(0, 2, 0)
        
        if not root or (root.Position - platePos).Magnitude > 3 then
            Stats.Status = string.format("Parking at %s (%d)", cleanName, currentPickupAttempts + 1)
            teleportBypass(platePos)
        end
        
        task.wait(Config.SettleTime)
        currentPickupAttempts = currentPickupAttempts + 1
        Stats.Status = string.format("Grabbing %s (%d/%d)", cleanName, currentPickupAttempts, Config.ParkMaxAttempts)

        pcall(fireproximityprompt, prompt, 0)
        task.wait(0.3)

        if carryingFood() then
            Stats.PickedUp = Stats.PickedUp + 1
            Stats.Status = "Got " .. cleanName
            currentPickupTarget = nil
            currentPickupAttempts = 0
            releaseMove()
            return true
        end

        releaseMove()

        if Config.ParkModeEnabled and currentPickupTarget then
            task.wait(Config.ParkAttemptDelay)
            return true
        end

        plateBackoff[model] = os.clock() + 3
        currentPickupTarget = nil
        currentPickupAttempts = 0
    end
    return false
end

