local function performAutoSellSweep()
    if not State.AutoSellEnabled or not NetworkModule or not SaveModule or not AssetsDirectory then
        return 0
    end

    if BackpackEndpoints then
        local sellMap = {}
        for rarity, enabled in pairs(State.AutoSellRarities) do
            if enabled then sellMap[rarity] = true end
        end
        pcall(function()
            NetworkModule.Invoke(BackpackEndpoints.SET_AUTO_SELL_STATE, sellMap)
        end)
    end

    local uidsToSell = {}
    local data = nil
    pcall(function() data = SaveModule.Get() end)

    if data and data.Inventory and AssetInventoryEndpoints then
        for uid, raw in pairs(data.Inventory) do
            local deserialized = nil
            if AssetItemSerialization then
                pcall(function() deserialized = AssetItemSerialization.Deserialize(raw) end)
            end

            local cat = deserialized and deserialized.Category or (type(raw) == "table" and raw.Category)
            local config = cat and AssetsDirectory.Directory and AssetsDirectory.Directory[cat]
            local rarity = config and config.Rarity and (config.Rarity._id or config.Rarity.DisplayName) or "Unknown"
            local name = config and config.DisplayName or cat
            local isEquipped = data.EquippedAssets and table.find(data.EquippedAssets, uid) ~= nil

            local matchRarity = State.AutoSellRarities[rarity] == true
            local matchSpecific = name and State.AutoSellSpecificPets[name] == true

            if (matchRarity or matchSpecific) and not isEquipped then
                table.insert(uidsToSell, uid)
            end
        end

        if #uidsToSell > 0 then
            pcall(function()
                NetworkModule.Fire(AssetInventoryEndpoints.SELL_ALL_ASSETS, uidsToSell)
            end)
        end
    end

    return #uidsToSell
end

