function Runtime.Destroy()
    State.Enabled = false
    State.AutoTreadmill = false
    State.IsHopping = false
    State.LoopGeneration += 1
    State.TreadmillGeneration += 1
    if State.CarryListener then State.CarryListener:Disconnect(); State.CarryListener = nil end
    if State.MoneyListener then State.MoneyListener:Disconnect(); State.MoneyListener = nil end
    if State.TreadmillLevelListener then State.TreadmillLevelListener:Disconnect(); State.TreadmillLevelListener = nil end
    if State.BaseUpgradeListener then State.BaseUpgradeListener:Disconnect(); State.BaseUpgradeListener = nil end
    if State.IndexListener then State.IndexListener:Disconnect(); State.IndexListener = nil end
    if State.TeleportListener then State.TeleportListener:Disconnect(); State.TeleportListener = nil end
    if State.FuseListener then State.FuseListener:Disconnect(); State.FuseListener = nil end
    pcall(function() Library:Destroy() end)
    if getgenv().KYIEL_STEAL_AN_EGG == Runtime then getgenv().KYIEL_STEAL_AN_EGG = nil end
end

