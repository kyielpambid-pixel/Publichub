-- client layout - NOT the Library/Directory tree the original script assumed.
-- Everything below resolves the real modules and adapts them to the exact
-- interface the rest of this script expects, so the automation logic is unchanged.
local function safeRequire(inst)
    if not inst then return nil end
    local ok, mod = pcall(require, inst)
    if ok then return mod end
    return nil
end

local function findChild(root, path)
    local cur = root
    for seg in string.gmatch(path, "[^%.]+") do
        cur = cur and cur:FindFirstChild(seg)
        if not cur then return nil end
    end
    return cur
end

