            return NetworkModule.Invoke(TrailsEndpoints.REQUEST_PURCHASE, nextUnowned.Name)
        end)
        if ok and success ~= false then
            task.wait(0.2)
            pcall(function()
                NetworkModule.Invoke(TrailsEndpoints.REQUEST_EQUIP, nextUnowned.Name)
            end)
            updateTrailStatusUI()
            return true, string.format("Successfully bought and equipped %s for $%s cash!", nextUnowned.DisplayName, formatCash(nextUnowned.Cost))
        end
    end

    return false, "Not enough cash"
end

