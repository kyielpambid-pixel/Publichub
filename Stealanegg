local function parseSelectedAreasFromDropdown(values)
    local selected = {}
    if type(values) == "table" then
        for k, v in pairs(values) do
            local optStr = (type(k) == "number" and type(v) == "string") and v or (type(k) == "string" and k)
            local isEnabled = (type(k) == "number") or (v == true)
            if optStr and isEnabled then
                local areaName = OptionToArea[optStr]
                if not areaName then
                    for _, m in ipairs(AreaMeta) do
                        if string.find(optStr, m.Name, 1, true) then
                            areaName = m.Name
                            break
                        end
                    end
                end
                if areaName then
                    selected[areaName] = true
                end
            end
        end
    elseif type(values) == "string" then
        for _, m in ipairs(AreaMeta) do
            if string.find(values, m.Name, 1, true) then
                selected[m.Name] = true
            end
        end
    end
    if next(selected) == nil then
        selected.Forest = true
    end
    return selected
end

