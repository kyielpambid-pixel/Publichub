local function checkAndEquipBestPet(force)
    if not NetworkModule or not BackpackEndpoints then return false, "Modules not loaded" end
    if State.EquipBestBusy then return false, "BUSY" end

    local shouldEquip = force == true
    if not shouldEquip then
        local statusOk, status, statusReason = pcall(function()
            return NetworkModule.Invoke(BackpackEndpoints.GET_EQUIP_BEST_STATUS)
        end)
        if not statusOk then
            State.LastEquipBestError = tostring(status)
            return false, State.LastEquipBestError
        end
        if status ~= true then
            return false, statusReason or "UP_TO_DATE"
        end
        shouldEquip = true
    end

    local now = Workspace:GetServerTimeNow()
    local remaining = 5 - (now - (State.LastEquipBestAttemptAt or 0))
    if remaining > 0 then
        return false, "DEBOUNCE", remaining
    end

    State.EquipBestBusy = true
    State.LastEquipBestAttemptAt = now
    local callOk, success, reason = pcall(function()
        return NetworkModule.Invoke(BackpackEndpoints.EQUIP_BEST)
    end)
    State.EquipBestBusy = false

    if callOk and success == true then
        State.LastEquipBestError = nil
        return true, nil
    end

    State.LastEquipBestError = callOk and tostring(reason or "Equip best rejected") or tostring(success)
    return false, State.LastEquipBestError
end

local function scheduleEquipBestRetry()
    if not State.AutoEquipBest then return end
    State.EquipBestRetryGeneration += 1
    local generation = State.EquipBestRetryGeneration

    task.spawn(function()
        for _, delaySeconds in ipairs({ 0.8, 1.5, 3.0, 5.2 }) do
            task.wait(delaySeconds)
            if generation ~= State.EquipBestRetryGeneration or not State.AutoEquipBest then return end
            local equipped, reason = checkAndEquipBestPet(false)
            if equipped then
                pcall(function()
                    Library:Notify({
                        Type = "Success",
                        Title = "Equip Best",
                        Content = "Automatically equipped the new best pet(s)!",
                        Duration = 4,
                    })
                end)
                return
            end
            if reason == "UP_TO_DATE" then return end
        end
    end)
end

local function hatchEggUid(uid)
    if PlacedEggRenderer and PlacedEggRenderer.ActivateLocalEgg then
        local renderOk, activated, renderReason = pcall(function()
            return PlacedEggRenderer.ActivateLocalEgg(uid)
        end)
        if not renderOk then return false, tostring(activated) end
        if activated == true then return true, nil end
        if renderReason ~= "Egg is not rendered" then
            return false, tostring(renderReason or "Hatch activation rejected")
        end
    end

    local startOk, started, startReason = pcall(function()
        return EggCmds.RequestHatchEgg(uid)
    end)
    if not startOk or started ~= true then
        return false, startOk and tostring(startReason or "Hatch request rejected") or tostring(started)
    end

    local completeOk, completed, completeReason = pcall(function()
        return EggCmds.RequestCompleteHatchEgg(uid)
    end)
    if completeOk and completed == true then
        return true, nil
    end
    return false, completeOk and tostring(completeReason or "Hatch completion rejected") or tostring(completed)
end

local function hatchAllAvailableEggs()
    if State.HatchSweepBusy or not EggCmds then return 0 end
    State.HatchSweepBusy = true
    local hatchedCount = 0

    local sweepOk, sweepError = xpcall(function()
        local records = EggCmds.GetOwnerRuntimeRecords(LocalPlayer.UserId)
        local now = os.clock()
        for uid, record in pairs(records) do
            -- Owned egg records here ARE the placed eggs (no separate Placement field).
            if now >= (State.HatchRetryAt[uid] or 0) then
                local readyOk, isReady = pcall(EggCmds.IsLocalEggReady, uid)
                if readyOk and isReady == true then
                    local hatched, reason = hatchEggUid(uid)
                    if hatched then
                        State.HatchRetryAt[uid] = nil
                        State.LastHatchError = nil
                        hatchedCount += 1
                    else
                        State.HatchRetryAt[uid] = now + 1.5
                        State.LastHatchError = string.format("%s: %s", uid, tostring(reason))
                    end
                end
            end
        end
    end, function(message)
        return tostring(message)
    end)

    State.HatchSweepBusy = false
    if not sweepOk then State.LastHatchError = sweepError end

    if hatchedCount > 0 then
        scheduleEquipBestRetry()
        if State.AutoSellEnabled then
            task.delay(1.0, performAutoSellSweep)
        end
    end

    return hatchedCount
end

