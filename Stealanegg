-- SMART SERVER HOPPER
-- ==============================================================================
-- Issue a single teleport attempt to a fresh (non-full) server, falling back to
-- generic matchmaking. Returns true only if the teleport request was accepted.
local function performTeleport()
    local candidates = {}
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/0?sortOrder=Asc&limit=100", game.PlaceId)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and res then
        local data = nil
        pcall(function() data = HttpService:JSONDecode(res) end)
        if data and data.data then
            for _, s in ipairs(data.data) do
                local maxP = s.maxPlayers or 7
                local curP = s.playing or 0
                if s.id ~= game.JobId and curP > 0 and curP < maxP then
                    table.insert(candidates, s.id)
                end
            end
        end
    end

    if #candidates > 0 then
        -- Randomise among the first few so repeated retries don't all pick the same server.
        local target = candidates[math.random(1, math.min(#candidates, 8))]
        local tpOk = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target, LocalPlayer)
        end)
        if tpOk then return true end
    end

    return (pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end))
end

-- AUTO-LOAD AFTER SERVER HOP
-- The bundled version of this file injects KYIEL_STEAL_SCRIPT_SOURCE before the
-- main script starts, so clipboard execution works without needing a hosted URL.
-- Advanced users may set KYIEL_STEAL_SCRIPT_URL to a raw script URL before launch;
-- that creates a smaller queued loader and always fetches the latest version.
local SELF_CACHE_FILE = "kyiel_steal_an_egg_autoload_body.lua"
local SELF_SOURCE_CANDIDATES = {
    SELF_CACHE_FILE,
    getgenv().KYIEL_STEAL_SCRIPT_FILE,
    "steal_an_egg.lua",
    "SsaEgg.lua",
    "main.lua",
}

local function readSelfSource()
    local src = getgenv().KYIEL_STEAL_SCRIPT_SOURCE
    if type(src) == "string" and #src > 100 then return src end
    if typeof(readfile) ~= "function" then return nil end
    for _, name in ipairs(SELF_SOURCE_CANDIDATES) do
        if type(name) == "string" and name ~= "" then
            local ok, contents = pcall(readfile, name)
            if ok and type(contents) == "string" and #contents > 100 then
                return contents
            end
        end
    end
    return nil
end

local function cacheSelfSource()
    local src = readSelfSource()
    if type(src) ~= "string" or #src <= 100 then return false end
    getgenv().KYIEL_STEAL_SCRIPT_SOURCE = src
    if typeof(writefile) == "function" then
        pcall(writefile, SELF_CACHE_FILE, src)
    end
    return true
end

local function getTeleportQueue()
    local env = getgenv()
    local candidates = {
        env.queue_on_teleport,
        env.queueonteleport,
        queue_on_teleport,
        queueonteleport,
        syn and syn.queue_on_teleport,
        fluxus and fluxus.queue_on_teleport,
    }
    for _, candidate in ipairs(candidates) do
        if type(candidate) == "function" then return candidate end
    end
    return nil
end

local function buildResumeLoader()
    local scriptUrl = getgenv().KYIEL_STEAL_SCRIPT_URL
    if type(scriptUrl) == "string" and scriptUrl:match("^https?://") then
        return string.format([[
repeat task.wait() until game:IsLoaded()
repeat task.wait() until game:GetService("Players").LocalPlayer
task.wait(3)
local ok, source = pcall(function() return game:HttpGet(%q, true) end)
if ok and type(source) == "string" then
    local chunk = loadstring(source)
    if chunk then chunk() end
end
]], scriptUrl), "URL"
    end

    local src = readSelfSource()
    if type(src) == "string" and #src > 100 then
        return string.format([[
repeat task.wait() until game:IsLoaded()
repeat task.wait() until game:GetService("Players").LocalPlayer
task.wait(3)
local source = %q
getgenv().KYIEL_STEAL_SCRIPT_SOURCE = source
if typeof(writefile) == "function" then
    pcall(writefile, %q, source)
end
local chunk = loadstring(source)
if chunk then chunk() end
]], src, SELF_CACHE_FILE), "embedded source"
    end

    if typeof(readfile) == "function" then
        local names = {}
        for _, name in ipairs(SELF_SOURCE_CANDIDATES) do
            if type(name) == "string" and name ~= "" then
                names[#names + 1] = string.format("%q", name)
            end
        end
        return string.format([[
repeat task.wait() until game:IsLoaded()
repeat task.wait() until game:GetService("Players").LocalPlayer
task.wait(3)
local source
for _, name in ipairs({%s}) do
    local ok, contents = pcall(readfile, name)
    if ok and type(contents) == "string" and #contents > 100 then
        source = contents
        break
    end
end
if source then
    getgenv().KYIEL_STEAL_SCRIPT_SOURCE = source
    local chunk = loadstring(source)
    if chunk then chunk() end
end
]], table.concat(names, ", ")), "cached file"
    end

    return nil, "script source is unavailable"
end

local function queueResumeScript()
    local queue = getTeleportQueue()
    if not queue then
        State.AutoReloadQueued = false
        return false, "executor does not support queue_on_teleport"
    end

    pcall(cacheSelfSource)
    local loader, method = buildResumeLoader()
    if not loader then
        State.AutoReloadQueued = false
        return false, method
    end

    local ok, err = pcall(queue, loader)
    State.AutoReloadQueued = ok
    State.AutoReloadMethod = ok and method or nil
    return ok, ok and method or tostring(err)
end

do
    local ok, cached = pcall(cacheSelfSource)
    State.SelfSourceCached = ok and cached == true
end

Runtime.QueueResumeScript = queueResumeScript

local function hopServer()
    if State.IsHopping then return end
    State.IsHopping = true
    State.HopAttempt += 1

    -- Persist Enabled + AutoServerHop + area/filter so the new server resumes farming.
    saveConfig()
    -- Queue the script to re-run automatically after the teleport lands.
    local queued, queueInfo = queueResumeScript()
    if not queued then
        pcall(function()
            Library:Notify({
                Type = "Warning",
                Title = "Auto-Load Unavailable",
                Content = "The hop will continue, but the executor could not queue this script: " .. tostring(queueInfo),
                Duration = 8,
            })
        end)
    end

    pcall(function()
        Library:Notify({
            Type = "Info",
            Title = "Area Cleared -> Server Hopping",
            Content = string.format("All '%s' in selected area(s) cleared! Finding a new server...", State.EggPriorityFilter),
            Duration = 5,
        })
    end)

    -- Persistent hop: keep retrying every 5 seconds until the client actually
    -- teleports out (which tears this loop down) or hopping is cancelled.
    task.spawn(function()
        local attempt = 0
        while State.IsHopping do
            attempt += 1
            setStatus(string.format("Server hopping... retry every 5s (attempt %d)", attempt))
            performTeleport()
            -- Wait ~5s in small slices so a cancel takes effect quickly.
            for _ = 1, 50 do
                if not State.IsHopping then break end
                task.wait(0.1)
            end
        end
    end)
end

-- Teleport Failure Hook: a failed attempt should NOT stop the retry loop; just
-- re-queue the resume script (some executors drop the queue on a failed teleport)
-- and let the 5s loop try the next server.
if TeleportService and TeleportService.TeleportInitFailed then
    pcall(function()
        State.TeleportListener = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            if player == LocalPlayer and State.IsHopping then
                queueResumeScript()
                setStatus(string.format("Hop failed (%s) - retrying in 5s...", tostring(errorMessage or teleportResult)))
            end
        end)
    end)
end

