-- ==============================================================================
-- FUSE MACHINE INSTANT PREDICTOR
-- The Fuse Machine decides the result server-side and broadcasts the reward the
-- instant fusion starts (via FuseMachineSignals.FuseStarted), well before the
-- reveal animation. We decode that reward and show exactly which egg you get and
-- which pet it hatches into (the egg's AssetCategory == the pet it produces).
-- ==============================================================================
local FuseResultParagraph

local function describeFuseReward(reward)
    if type(reward) ~= "table" then return nil end
    local cat = reward.AssetCategory
    -- Fall back to the game's own decoder if the payload is wrapped.
    if not cat and FuseMachineTypes and FuseMachineTypes.FuseResult then
        local ok, decoded = pcall(FuseMachineTypes.FuseResult, reward)
        if ok and type(decoded) == "table" then
            cat = decoded.AssetCategory
            reward = decoded
        end
    end
    if not cat then return nil end

    local cfg = AssetsDirectory and AssetsDirectory.Directory and AssetsDirectory.Directory[cat]
    local petName = cfg and cfg.DisplayName or cat
    local rarity = cfg and cfg.Rarity and (cfg.Rarity._id or cfg.Rarity.DisplayName) or "Unknown"
    local eggName = cfg and cfg.Egg and cfg.Egg.DisplayName or (petName .. " Egg")
    local growth = cfg and cfg.Egg and cfg.Egg.GrowthTime or nil
    local scale = reward.AssetScale or 1

    local sizeLabel
    if AssetSizeClassification and AssetSizeClassification.Classify then
        local ok, cls = pcall(AssetSizeClassification.Classify, scale)
        if ok and type(cls) == "table" then
            sizeLabel = cls.DisplayName or cls.Name or cls.RichText
        end
    end
    if not sizeLabel then sizeLabel = string.format("%.2fx", scale) end

    local mutations = {}
    if type(reward.Mutations) == "table" then
        for _, m in pairs(reward.Mutations) do
            mutations[#mutations + 1] = tostring(type(m) == "table" and (m._id or m.DisplayName) or m)
        end
    end

    return {
        Category = cat,
        PetName = petName,
        EggName = eggName,
        Rarity = rarity,
        Scale = scale,
        SizeLabel = sizeLabel,
        GrowthTime = growth,
        Mutations = mutations,
    }
end

local function formatGrowth(seconds)
    if not seconds or seconds <= 0 then return nil end
    local m = math.floor(seconds / 60)
    local s = math.floor(seconds % 60)
    if m > 0 then return string.format("%dm %ds", m, s) end
    return string.format("%ds", s)
end

local function updateFuseResultUI()
    if not FuseResultParagraph then return end
    local info = State.LastFuseResult
    pcall(function()
        if not info then
            FuseResultParagraph:SetTitle("Fuse Result: (none yet)")
            FuseResultParagraph:SetContent("Fuse pets at the Fuse Machine and the exact result appears here instantly.")
            return
        end
        FuseResultParagraph:SetTitle(string.format("Fuse Result: %s (%s)", info.PetName, info.Rarity))
        local mut = (#info.Mutations > 0) and (" | Mutations: " .. table.concat(info.Mutations, ", ")) or ""
        local growth = formatGrowth(info.GrowthTime)
        local growthLine = growth and string.format("<br/><b>Hatch Time:</b> %s", growth) or ""
        FuseResultParagraph:SetContent(string.format(
            "<b>Egg Produced:</b> %s<br/><b>Hatches Into:</b> <font color='#00FF88'><b>%s</b></font> (%s)<br/><b>Size:</b> %s%s%s",
            info.EggName, info.PetName, info.Rarity, info.SizeLabel, growthLine, mut
        ))
    end)
end

-- Shows the fuse result. MUST be called from the script's own thread (not the
-- game's signal thread) so the notification GUI is reachable under executor caps.
local function displayFuseResult(info)
    if not info then return end
    updateFuseResultUI()
    if State.FusePredictNotify then
        pcall(function()
            Library:Notify({
                Type = "Success",
                Title = string.format("Fuse -> %s (%s)", info.PetName, info.Rarity),
                Content = string.format("Egg: %s  |  Hatches into: %s  |  Size: %s", info.EggName, info.PetName, info.SizeLabel),
                Duration = 8,
            })
        end)
    end
end

-- Runs on the game's signal thread (limited capability): only decode + store.
-- A background worker on our own thread performs the actual display.
local function handleFuseStarted(reward)
    if not State.FusePredictEnabled then return end
    local info = describeFuseReward(reward)
    if not info then return end
    State.LastFuseResult = info
    State.FuseDisplayVersion = (State.FuseDisplayVersion or 0) + 1
end

-- Fuse the currently-loaded pets and show the predicted result. Fusion requires
-- 3 pets of the SAME category; on failure we surface the server's exact reason so
-- the user is never left wondering why "nothing happened".
local function fuseLoadedPetsAndPredict()
    if not (R and R.Fusery and R.Fusery.BeginFuse) then
        return false, "Fuse remote unavailable"
    end
    local beginOk, success, reason, reward = pcall(function()
        return R.Fusery.BeginFuse:InvokeServer()
    end)
    if not beginOk then
        return false, "Fuse request errored"
    end
    if success ~= true then
        return false, (type(reason) == "string" and reason) or "Fuse failed - load 3 pets of the SAME category first"
    end
    -- Show the prediction immediately (this call is on our own thread).
    if reward then handleFuseStarted(reward) end
    -- Grant the fused egg right away (skips the reveal animation). Retry briefly
    -- since the reveal may still be settling server-side.
    local granted = false
    for _ = 1, 5 do
        local ok, ok2 = pcall(function() return R.Fusery.FinishReveal:InvokeServer() end)
        if ok and ok2 == true then granted = true break end
        task.wait(0.2)
    end
    local info = State.LastFuseResult
    return true, info and string.format("%s (%s)%s", info.PetName, info.Rarity, granted and "" or " (granted pending)") or "Fused!"
end

Runtime.DescribeFuseReward = describeFuseReward
Runtime.HandleFuseStarted = handleFuseStarted
Runtime.FuseLoadedPetsAndPredict = fuseLoadedPetsAndPredict

if FuseMachineSignals and FuseMachineSignals.FuseStarted and FuseMachineSignals.FuseStarted.Connect then
    pcall(function()
        State.FuseListener = FuseMachineSignals.FuseStarted:Connect(handleFuseStarted)
