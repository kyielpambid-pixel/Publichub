-- Owned eggs not yet placed on the plot, matching selected rarities.
-- The game marks an unplaced egg with Placement == nil on its EggInventory entry
-- (this is exactly how the game's own countUnplacedEggs works).
-- If no rarity is selected, every unplaced egg is eligible.
local function getPlaceableEggs()
    local list = {}
    if not SaveModule then return list end
    local data = nil
    pcall(function() data = SaveModule.Get() end)
    if not data or type(data.EggInventory) ~= "table" then return list end

    local anyRaritySelected = next(State.AutoPlaceRarities) ~= nil
    for uid, egg in pairs(data.EggInventory) do
        if type(egg) == "table" and egg.Placement == nil then
            local cat = egg.AssetCategory
            local rarity = getEggRarity(cat)
            if not anyRaritySelected or State.AutoPlaceRarities[rarity] == true then
                table.insert(list, { Uid = uid, Category = cat, Rarity = rarity, Name = getEggDisplayName(cat) })
            end
        end
    end
    return list
end

-- Candidate placement CFrames (object space of CenterPoint) spread over the PetArea grid.
local function buildPlacementSlots(plotData)
    local slots = {}
    local size = plotData.PetArea.Size
    local areaCF = plotData.PetArea.CFrame
    local centerCF = plotData.CenterPoint.CFrame
    local margin, step = 5, 6
    local halfX = math.max(size.X / 2 - margin, 0)
    local halfZ = math.max(size.Z / 2 - margin, 0)
    local x = -halfX
    while x <= halfX do
        local z = -halfZ
        while z <= halfZ do
            local worldPos = (areaCF * CFrame.new(x, 0, z)).Position
            table.insert(slots, centerCF:ToObjectSpace(CFrame.new(worldPos)))
            z += step
        end
        x += step
    end
    return slots
end

-- Places up to `maxThisSweep` eligible eggs, trying grid slots until each lands.
local function autoPlaceEggsSweep(maxThisSweep)
    if State.AutoPlaceBusy or not EggCmds or not EggCmds.RequestPlaceEgg then return 0 end
    local plotData = getPlayerPlotInfo()
    if not plotData or not plotData.PetArea or not plotData.CenterPoint then
        State.LastPlaceError = "Plot not found"
        return 0
    end

    local eggs = getPlaceableEggs()
    if #eggs == 0 then return 0 end

    State.AutoPlaceBusy = true
    local placedCount = 0
    local limit = maxThisSweep or 20

    local sweepOk, sweepErr = pcall(function()
        local slots = buildPlacementSlots(plotData)
        local slotIndex = 1
        for _, egg in ipairs(eggs) do
            if placedCount >= limit then break end
            local landed = false
            while slotIndex <= #slots do
                local cf = slots[slotIndex]
                slotIndex += 1
                local ok, success, reason = pcall(function()
                    return EggCmds.RequestPlaceEgg(egg.Uid, cf)
                end)
                if ok and success == true then
                    placedCount += 1
                    landed = true
                    State.LastPlaceError = nil
                    task.wait(0.2)
                    break
                elseif ok and reason == "Egg is already placed" then
                    landed = true -- already on the plot; skip
                    break
                else
                    State.LastPlaceError = tostring(reason or success)
                    task.wait(0.12) -- "too close" or transient: advance to the next slot
                end
            end
            if not landed and slotIndex > #slots then break end -- ran out of free slots
        end
    end)

    State.AutoPlaceBusy = false
    if not sweepOk then State.LastPlaceError = tostring(sweepErr) end
    return placedCount
end

Runtime.AutoPlaceEggsSweep = autoPlaceEggsSweep

-- Egg Holding Check
local function isCarryingEgg()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if root and isInsideSafeZone(root.Position) then
        return false, nil, nil, nil
    end

    if State.IsCurrentlyCarryingEgg then
        return true, State.CarriedEggName or "Egg", nil, State.CarriedEggUid
    end

    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                if EggToolDisplay and EggToolDisplay.IsEggTool(item) then
                    return true, item.Name, item, EggToolDisplay.GetToolUid(item)
                end
                if item:GetAttribute("ItemType") == "AssetEgg" or (string.find(item.Name, "Egg") and not string.find(item.Name, "Hatch")) then
                    return true, item.Name, item, nil
                end
            end
        end
    end

    return false, nil, nil, nil
end

