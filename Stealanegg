local function parseCompactPower(text)
    local normalized = string.upper(tostring(text)):gsub(",", ""):gsub("%s+", "")
    local numberText, suffix = string.match(normalized, "^([%d%.]+)([%a]*)$")
    local value = tonumber(numberText)
    if not value then return nil end
    local multipliers = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12,
        QA = 1e15,
        QI = 1e18,
    }
    return value * (multipliers[suffix] or 1)
end

