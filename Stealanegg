    local currentWalkSpeed = math.max(humanoid.WalkSpeed or 16, 16)
    local timeoutAt = os.clock() + math.max(((root.Position - eggPos).Magnitude / currentWalkSpeed) * 1.5 + 3.0, 5.0)

    while State.Enabled and generation == State.LoopGeneration do
        task.wait(0.05)

        local carrying, toolName = isCarryingEgg()
        if carrying then return true, toolName end
        if os.clock() >= timeoutAt then break end

        local rootPos = root.Position
        local distToEgg = (rootPos - eggPos).Magnitude

        if distToEgg <= 40.0 then
            if EggCmds then
                pcall(function() EggCmds.RequestCarryAreaEgg(rec.Uid, slotKey) end)
            end
            local clientSlots = Workspace:FindFirstChild("AreaEggSlotsClient")
            if clientSlots then
                local slotModel = clientSlots:FindFirstChild(rec.Uid)
                if slotModel then
                    local prompt = slotModel:FindFirstChildOfClass("ProximityPrompt")
                    if prompt and typeof(fireproximityprompt) == "function" then
                        pcall(function() fireproximityprompt(prompt, 0, true) end)
                    end
                end
            end
        end

        local dx = eggPos.X - rootPos.X
        if rootPos.X < 535 and math.abs(rootPos.Z - (-364)) > 20 then
            humanoid:MoveTo(Vector3.new(540, 68, -364))
        elseif math.abs(dx) > 30 then
            local stepX = rootPos.X + math.clamp(dx, -70, 70)
            humanoid:MoveTo(Vector3.new(stepX, 68, -364))
        else
            humanoid:MoveTo(eggPos)
        end
    end

    local carryingFinal, toolFinalName = isCarryingEgg()
    if carryingFinal then return true, toolFinalName end
    return false, nil
end

-- ==============================================================================
-- MASTER AUTO GET EGGS COLLECTOR
-- ==============================================================================
local function runCollector(generation)
    local emptyRetries = 0

    while State.Enabled and generation == State.LoopGeneration and not State.IsHopping do
        task.wait(0.05)

        local character, humanoid, root = getCharacter()
        if not root or not humanoid or humanoid.Health <= 0 or not character.Parent then
            setStatus("Respawning... (Auto Farm Active)")
            task.wait(1)
            character, humanoid, root = getCharacter()
            continue
        end

        if character:GetAttribute("IsTrapped") == true then
            setStatus("Trapped: waiting release...")
            task.wait(1)
            continue
        end

        if next(State.SelectedAreas) == nil then
            setStatus("Please select at least one area!")
            task.wait(0.5)
            continue
        end

        local carrying, carriedName = isCarryingEgg()
        if carrying then
            setStatus(string.format("Holding %s! SPRINTING TO SAFE ZONE...", carriedName or "Egg"))
            if State.ReturnDestination == "Plot Pen (Deposits into Pen)" then
                directReturnToPen(generation)
            else
                directReturnToSafeZone(generation)
            end
            emptyRetries = 0
            continue
        end

        local target, dist = findBestTargetEgg(root)
        if not target then
            emptyRetries += 1
            if emptyRetries < 4 then
                setStatus(string.format("Scanning '%s' in selected area(s)...", State.EggPriorityFilter))
                task.wait(0.5)
                continue
            end

            -- All target eggs cleared in selected areas
            if State.AutoServerHop and not State.IsHopping then
                if humanoid and root then
                    humanoid:Move(Vector3.zero, false)
                    humanoid:MoveTo(root.Position)
                end
                hopServer()
                break
            else
                setStatus("Selected areas cleared. Waiting for respawn...")
                task.wait(1.5)
            end
            continue
        end

        emptyRetries = 0
        local eggLabel = string.format("%s (%s, %.1fx)", target.Name, target.Rarity, target.Scale)
        setStatus(string.format("[%s] Scooping %s (%.0f studs)", target.Area, eggLabel, dist or 0))

        local grabbed, toolName = sprintAndGrabEggFlyby(target, generation)

        if grabbed or isCarryingEgg() then
            State.Collected += 1
            setStatus(string.format("Scooped %s! SPRINTING TO SAFE ZONE...", toolName or "Egg"))
            if State.ReturnDestination == "Plot Pen (Deposits into Pen)" then
                directReturnToPen(generation)
            else
                directReturnToSafeZone(generation)
            end
        else
            State.Failed += 1
            State.Blacklist[target.Uid] = os.clock() + 1.5
            setStatus("Missed: seeking next egg...")
        end
    end

    if generation == State.LoopGeneration and not State.IsHopping then
        setStatus("Idle")
    end
end

-- Programmatic controls (also used to script the farm without the UI toggle)
function Runtime.StartCollector()
    State.Enabled = true
    State.IsHopping = false
    State.LoopGeneration += 1
    task.spawn(runCollector, State.LoopGeneration)
end

function Runtime.StopCollector()
    State.Enabled = false
    State.LoopGeneration += 1
    setStatus("Idle")
end

