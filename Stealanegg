-- ==============================================================================
local function directReturnToSafeZone(generation)
    local character, humanoid, root = getCharacter()
    if not root or not humanoid or humanoid.Health <= 0 then return false end

    humanoid.AutoRotate = true
    humanoid.Jump = false

    local SAFE_ZONE_POS = Vector3.new(545, 68, -364)
    local currentWalkSpeed = math.max(humanoid.WalkSpeed or 16, 16)
    local timeoutAt = os.clock() + math.max(((root.Position - SAFE_ZONE_POS).Magnitude / currentWalkSpeed) * 1.5 + 3.0, 5.0)

    setStatus("Returning egg to Safe Zone...")

    while State.Enabled and generation == State.LoopGeneration do
        task.wait(0.05)
        local rootPos = root.Position

        if isInsideSafeZone(rootPos) then
            setStatus("Safe Zone Reached! Unequipping & depositing egg...")
            unequipHeldEgg()

            local carrying, _, heldTool, uid = isCarryingEgg()
            local eggUid = uid or State.CarriedEggUid or (heldTool and EggToolDisplay and EggToolDisplay.GetToolUid(heldTool))
            if eggUid then
                placeEggOnPlot(eggUid)
            end

            unequipHeldEgg()
            task.wait(0.1)
            break
        end

        if os.clock() >= timeoutAt then break end

        local dx = SAFE_ZONE_POS.X - rootPos.X
        if math.abs(dx) > 30 then
            local stepX = rootPos.X + math.clamp(dx, -70, 70)
            humanoid:MoveTo(Vector3.new(stepX, 68, -364))
        else
            humanoid:MoveTo(SAFE_ZONE_POS)
        end
    end

    return true
end

local function directReturnToPen(generation)
    local plotData = getPlayerPlotInfo()
    if not plotData or not plotData.PetArea then return false end

    local character, humanoid, root = getCharacter()
    if not root or not humanoid or humanoid.Health <= 0 then return false end

    humanoid.AutoRotate = true
    humanoid.Jump = false

    local petAreaPos = plotData.PetArea.Position
    local HIGHWAY_JUNCTION = Vector3.new(540, 68, -364)
    local currentWalkSpeed = math.max(humanoid.WalkSpeed or 16, 16)
    local timeoutAt = os.clock() + math.max(((root.Position - petAreaPos).Magnitude / currentWalkSpeed) * 1.5 + 3.0, 5.0)

    setStatus("Returning egg to Plot Pen...")

    while State.Enabled and generation == State.LoopGeneration do
        task.wait(0.05)
        local carrying, _, heldTool, uid = isCarryingEgg()
        local rootPos = root.Position
        local distToPen = (rootPos - petAreaPos).Magnitude

        if distToPen <= 30.0 or rootPos.X <= 490 then
            local eggUid = uid or State.CarriedEggUid or (heldTool and EggToolDisplay and EggToolDisplay.GetToolUid(heldTool))
            if eggUid then
                placeEggOnPlot(eggUid)
            end
            unequipHeldEgg()
            task.wait(0.1)
            break
        end

        if os.clock() >= timeoutAt then break end

        if rootPos.X > 545 then
            humanoid:MoveTo(HIGHWAY_JUNCTION)
        else
            humanoid:MoveTo(petAreaPos)
        end
    end

    local junctionTimeout = os.clock() + 2.0
    while State.Enabled and generation == State.LoopGeneration do
        local rootPos = root.Position
        if math.abs(rootPos.Z - (-364)) <= 15 or rootPos.X >= 535 or os.clock() >= junctionTimeout then
            break
        end
        humanoid:MoveTo(HIGHWAY_JUNCTION)
        task.wait(0.05)
    end

    unequipHeldEgg()
    return true
end

local function sprintAndGrabEggFlyby(target, generation)
