local function getFilteredSnapshotRecords()
    if not EggCmds then return {} end
    local snapshot = nil
    pcall(function() snapshot = EggCmds.GetAreaEggSnapshot() end)
    if not snapshot or not snapshot.Records then return {} end

    local matched = {}
    local now = os.clock()

    for _, rec in ipairs(snapshot.Records) do
        local isAreaSelected = rec.AreaId and State.SelectedAreas[rec.AreaId] == true
        -- A free-standing field egg has State == "Slot"; carried/claimed eggs leave the snapshot.
        local isUnclaimed = (rec.State == nil or rec.State == "Slot")
        local pos = (rec.BottomCFrame and rec.BottomCFrame.Position) or (rec.CFrame and rec.CFrame.Position)

        if isAreaSelected and isUnclaimed and pos then
            if (State.Blacklist[rec.Uid] or 0) <= now then
                local cat = rec.AssetCategory
                local config = cat and AssetsDirectory and AssetsDirectory.Directory and AssetsDirectory.Directory[cat]
                local rarity = config and config.Rarity and (config.Rarity._id or config.Rarity.DisplayName) or "Unknown"
                local name = config and config.DisplayName or cat or "Unknown"
                local scale = rec.AssetScale or 1
                local isBig = scale >= 1.2
                local isBest = (rarity == "Secret" or rarity == "Cosmic" or rarity == "Mythic" or rarity == "Divine" or rarity == "Eternal" or rarity == "Legendary")

                local passFilter = false
                local filter = State.EggPriorityFilter
                if filter == "All Eggs" then
                    passFilter = true
                elseif filter == "Big Eggs Only (Scale >= 1.2x)" then
                    passFilter = isBig
                elseif filter == "Best Eggs Only (High Tier)" then
                    passFilter = isBest
                elseif filter == "Big OR Best Eggs" then
                    passFilter = isBig or isBest
                else
                    passFilter = true
                end

                if passFilter then
                    table.insert(matched, {
                        Record = rec,
                        Uid = rec.Uid,
                        Area = rec.AreaId,
                        Name = name,
                        Rarity = rarity,
                        Scale = scale,
                        IsBig = isBig,
                        IsBest = isBest,
                        Position = pos,
                    })
                end
            end
        end
    end

    return matched
end

local function findBestTargetEgg(root)
    local candidates = getFilteredSnapshotRecords()
    if #candidates == 0 then return nil end

    local best = nil
    local bestDist = math.huge
    for _, item in ipairs(candidates) do
        local dist = (root.Position - item.Position).Magnitude
        if dist < bestDist then
            bestDist = dist
            best = item
        end
    end
    return best, bestDist
end

