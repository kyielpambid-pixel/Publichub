-- Network adapter: transparently drives RemoteFunction/RemoteEvent instances
local NetworkModule = {
    Invoke = function(endpoint, ...)
        if endpoint == nil then return nil end
        if type(endpoint) == "function" then return endpoint(...) end
        if typeof(endpoint) == "Instance" then
            if endpoint:IsA("RemoteFunction") then return endpoint:InvokeServer(...) end
            if endpoint:IsA("RemoteEvent") then endpoint:FireServer(...) return true end
        end
        return nil
    end,
    Fire = function(endpoint, ...)
        if endpoint == nil then return false end
        if type(endpoint) == "function" then return endpoint(...) end
        if typeof(endpoint) == "Instance" then
            if endpoint:IsA("RemoteEvent") then endpoint:FireServer(...) return true end
            if endpoint:IsA("RemoteFunction") then return endpoint:InvokeServer(...) end
        end
        return false
    end,
}

