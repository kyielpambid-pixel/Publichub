RunService.Heartbeat:Connect(function()
	local character = LocalPlayer.Character
	if not character then return end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local myRoot = character:FindFirstChild("HumanoidRootPart")
	if not hum or not myRoot then return end

	if State.AntiRagdoll then
		if hum.PlatformStand then hum.PlatformStand = false end
		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.FallingDown then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		if myRoot.AssemblyAngularVelocity.Magnitude > 5 then
			myRoot.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if not State.isRunning then
		if State.runVelocity then
			pcall(function() State.runVelocity:Destroy() end)
			State.runVelocity = nil
		end
		return
	end

	if State.currentTargetItem and not State.currentTargetItem.Parent then
		table.remove(State.pathQueue, 1)
		if #State.pathQueue > 0 then
			State.currentTargetItem = State.pathQueue[1]
			State.arrivalTime = 0
			setStatus("Moving to next...")
		else
			State.isRunning = false
			State.currentTargetItem = nil
			pcall(function() hum:MoveTo(myRoot.Position) end)
			if State.runVelocity then
				pcall(function() State.runVelocity:Destroy() end)
				State.runVelocity = nil
			end
			setStatus("Finished Zone!")
			return
		end
	end

	if not State.currentTargetItem then return end
	local targetPos = getItemPosition(State.currentTargetItem)
	if not targetPos then
		table.remove(State.pathQueue, 1)
		if #State.pathQueue > 0 then
			State.currentTargetItem = State.pathQueue[1]
			State.arrivalTime = 0
		else
			State.isRunning = false
			State.currentTargetItem = nil
			if State.runVelocity then
				pcall(function() State.runVelocity:Destroy() end)
				State.runVelocity = nil
			end
		end
		return
	end

	local distance = (myRoot.Position - targetPos).Magnitude
	if distance < 6 then
		if State.arrivalTime == 0 then State.arrivalTime = tick() end
		if tick() - State.arrivalTime > State.MAX_WAIT_TIME then
			table.remove(State.pathQueue, 1)
			if #State.pathQueue > 0 then
				State.currentTargetItem = State.pathQueue[1]
				State.arrivalTime = 0
				setStatus("Force moving to next...")
			else
				State.isRunning = false
				State.currentTargetItem = nil
				pcall(function() hum:MoveTo(myRoot.Position) end)
				if State.runVelocity then
					pcall(function() State.runVelocity:Destroy() end)
					State.runVelocity = nil
				end
				setStatus("Zone Finished!")
			end
			return
		end
		if not State.runVelocity then
			State.runVelocity = Instance.new("BodyVelocity")
			State.runVelocity.MaxForce = Vector3.new(math.huge, 0, math.huge)
			State.runVelocity.Parent = myRoot
		end
		State.runVelocity.Velocity = Vector3.zero
		hum:MoveTo(myRoot.Position)
		setStatus(string.format("Waiting for hatch... (%.1fs)", State.MAX_WAIT_TIME - (tick() - State.arrivalTime)))
	else
		if not State.runVelocity then
			for _, desc in pairs(character:GetDescendants()) do
				if desc:IsA("BodyPosition") or desc:IsA("BodyVelocity") or desc:IsA("AlignPosition") then
					pcall(function() desc:Destroy() end)
				end
			end
			State.runVelocity = Instance.new("BodyVelocity")
			State.runVelocity.MaxForce = Vector3.new(math.huge, 0, math.huge)
			State.runVelocity.Parent = myRoot
		end
		hum:MoveTo(targetPos)
		hum:ChangeState(Enum.HumanoidStateType.Running)
		local direction = (targetPos - myRoot.Position).Unit
		State.runVelocity.Velocity = direction * 125
	end
end)

