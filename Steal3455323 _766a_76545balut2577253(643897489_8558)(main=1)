local function flingTarget(targetChar, myRoot)
	local hum = targetChar:FindFirstChildOfClass("Humanoid")
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChildWhichIsA("BasePart")
	if not (hum and targetRoot and hum.Health > 0) then return false end

	local now = tick()
	if State.flingCooldowns[targetChar] and now - State.flingCooldowns[targetChar] < 2 then
		return false
	end
	State.flingCooldowns[targetChar] = now

	for _, desc in pairs(targetChar:GetDescendants()) do
		if desc:IsA("AlignPosition") or desc:IsA("LinearVelocity") or desc:IsA("BodyPosition")
			or desc:IsA("BodyVelocity") or desc:IsA("BodyGyro") then
			pcall(function() desc:Destroy() end)
		end
		if desc:IsA("BasePart") then
			desc.Anchored = false
			pcall(function() desc:SetNetworkOwner(LocalPlayer) end)
		end
	end

	hum.PlatformStand = true
	hum.Sit = true
	hum.WalkSpeed = 0

	local direction = (targetRoot.Position - myRoot.Position).Unit
	if direction.Y < 0.1 then
		direction = (direction + Vector3.new(0, 0.5, 0)).Unit
	end
	targetRoot.AssemblyLinearVelocity = direction * State.pushVelocity
	targetRoot.CFrame = targetRoot.CFrame + (direction * 5)

	task.delay(1.5, function()
		if hum and hum.Parent then
			hum.PlatformStand = false
			hum.Sit = false
		end
	end)
	return true
end

local function flingGuard(guard, myRoot)
	if not guard or not guard.Parent then return false end
	if guard == LocalPlayer.Character then return false end
	if Players:GetPlayerFromCharacter(guard) then return false end

	local hum = guard:FindFirstChildOfClass("Humanoid")
	local targetRoot = guard:FindFirstChild("HumanoidRootPart")
		or (guard:IsA("BasePart") and guard)
		or guard:FindFirstChildWhichIsA("BasePart")
	if not targetRoot then return false end

	local now = tick()
	if State.flingCooldowns[guard] and now - State.flingCooldowns[guard] < 1.5 then return false end
	State.flingCooldowns[guard] = now

	for _, desc in pairs(guard:GetDescendants()) do
		if desc:IsA("AlignPosition") or desc:IsA("AlignOrientation")
			or desc:IsA("LinearVelocity") or desc:IsA("AngularVelocity")
			or desc:IsA("BodyPosition") or desc:IsA("BodyVelocity")
			or desc:IsA("BodyGyro") or desc:IsA("BodyAngularVelocity")
			or desc:IsA("BodyForce") or desc:IsA("BodyThrust") then
			pcall(function() desc:Destroy() end)
		end
		if desc:IsA("BasePart") then
			pcall(function() desc:SetNetworkOwner(LocalPlayer) end)
			pcall(function() desc.Anchored = false end)
			pcall(function() desc.CanCollide = false end)
		end
	end

	if hum then
		pcall(function() hum.PlatformStand = true end)
		pcall(function() hum.Sit = true end)
		pcall(function() hum.WalkSpeed = 0 end)
		pcall(function() hum.JumpPower = 0 end)
	end

	local offset = targetRoot.Position - myRoot.Position
	local direction = Vector3.new(offset.X, 0, offset.Z)
	if direction.Magnitude < 1 then
		direction = myRoot.CFrame.LookVector
	else
		direction = direction.Unit
	end
	direction = (direction + Vector3.new(0, 0.55, 0)).Unit

	pcall(function() targetRoot.AssemblyLinearVelocity = direction * 2200 end)
	pcall(function()
		targetRoot.AssemblyAngularVelocity = Vector3.new(
			math.random(-250, 250), math.random(-250, 250), math.random(-250, 250)
		)
	end)

	task.spawn(function()
		local startT = tick()
		while tick() - startT < 1.5 do
			if not targetRoot or not targetRoot.Parent then return end
			pcall(function() targetRoot.AssemblyLinearVelocity = direction * 2200 end)
			pcall(function() targetRoot.CFrame = targetRoot.CFrame + direction * 12 end)
			task.wait(0.03)
		end
	end)

	if hum then
		task.delay(1.5, function()
			if hum and hum.Parent then
				pcall(function() hum.PlatformStand = false end)
				pcall(function() hum.Sit = false end)
			end
		end)
	end
	return true
end

