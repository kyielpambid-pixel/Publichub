local function collectGuards()
	local result = {}
	local seen = {}
	local map = Workspace:FindFirstChild("Map")
	if not map then return result end

	local folders = {}
	local function tryAdd(parent)
		if not parent then return end
		for _, name in ipairs({"Guards", "Guard", "Guardians", "Guardian"}) do
			local f = parent:FindFirstChild(name)
			if f then table.insert(folders, f) end
		end
	end
	tryAdd(map:FindFirstChild("Decor"))
	tryAdd(map)

	for _, folder in ipairs(folders) do
		for _, child in ipairs(folder:GetChildren()) do
			if not seen[child] then
				if child:IsA("Model") or child:IsA("BasePart") then
					seen[child] = true
					table.insert(result, child)
				elseif child:IsA("Folder") then
					for _, gc in ipairs(child:GetChildren()) do
						if not seen[gc] and (gc:IsA("Model") or gc:IsA("BasePart")) then
							seen[gc] = true
							table.insert(result, gc)
						end
					end
				end
			end
		end
	end
	return result
end

local function getZoneEggs(zoneIndex)
	local eggs = {}
	local map = Workspace:FindFirstChild("Map")
	local eggSpawns = map and map:FindFirstChild("EggSpawns")
	if not eggSpawns then return eggs end
	local zone = eggSpawns:FindFirstChild("Zone" .. zoneIndex)
	if not zone then return eggs end
	for _, item in pairs(zone:GetDescendants()) do
		if item:IsA("Model") or item:IsA("Tool") then
			table.insert(eggs, item)
		elseif item:IsA("BasePart") and item.Parent and not item.Parent:IsA("Model") then
			table.insert(eggs, item)
		end
	end
	return eggs
end

local function runZone(zoneIndex)
	local eggs = getZoneEggs(zoneIndex)
	State.pathQueue = {}
	for _, egg in ipairs(eggs) do
		table.insert(State.pathQueue, egg)
	end
	if #State.pathQueue > 0 then
		State.currentTargetItem = State.pathQueue[1]
		State.arrivalTime = 0
		State.isRunning = true
		setStatus("Running Zone " .. zoneIndex)
		return true
	end
	setStatus("Zone " .. zoneIndex .. " empty")
	return false
end

-- Guard fling loop
task.spawn(function()
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	while true do
		task.wait(0.25)
		if State.GuardFling then
			local character = LocalPlayer.Character
			local myRoot = character and character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				overlapParams.FilterDescendantsInstances = { character }
				local pushed = 0
				local processed = {}

				local parts = Workspace:GetPartBoundsInRadius(myRoot.Position, State.auraRadius, overlapParams)
				for _, part in pairs(parts) do
					local targetChar = part.Parent
					if targetChar and targetChar:FindFirstChildOfClass("Humanoid")
						and targetChar ~= character and not processed[targetChar] then
						processed[targetChar] = true
						if flingTarget(targetChar, myRoot) then
							pushed = pushed + 1
						end
					end
				end

				for _, guard in ipairs(collectGuards()) do
					if not processed[guard] then
						local gRoot = guard:FindFirstChild("HumanoidRootPart")
							or (guard:IsA("BasePart") and guard)
							or guard:FindFirstChildWhichIsA("BasePart")
						if gRoot and (gRoot.Position - myRoot.Position).Magnitude <= (State.auraRadius * 1.5) then
							processed[guard] = true
							local ok = false
							if guard.Name == "Marites" then
								ok = superFlingMarites(guard, myRoot)
								if ok then setStatus("SENT Marites TO THE SKY") end
							else
								ok = flingGuard(guard, myRoot)
							end
							if ok then pushed = pushed + 1 end
						end
					end
				end

				if pushed > 0 and not State.isRunning then
					setStatus("Repelling " .. pushed)
				end
			end
		end
	end
end)

