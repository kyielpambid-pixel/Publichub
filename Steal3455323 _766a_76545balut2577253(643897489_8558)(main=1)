local function getTierName(item)
	local keywords = {
		rare = "Rare", epic = "Epic", legendary = "Legendary",
		mythic = "Mythic", secret = "Secret", divine = "Divine",
		common = "Common", uncommon = "Uncommon", godly = "Godly",
	}
	for _, tag in ipairs(CollectionService:GetTags(item)) do
		local lowerTag = string.lower(tag)
		for k, v in pairs(keywords) do
			if string.find(lowerTag, k) then return v end
		end
	end
	for _, attrValue in pairs(item:GetAttributes()) do
		local lowerAttr = string.lower(tostring(attrValue))
		for k, v in pairs(keywords) do
			if string.find(lowerAttr, k) then return v end
		end
	end
	for _, desc in ipairs(item:GetDescendants()) do
		if desc:IsA("StringValue") then
			local lowerVal = string.lower(desc.Value)
			for k, v in pairs(keywords) do
				if string.find(lowerVal, k) then return v end
			end
		elseif desc:IsA("TextLabel") or desc:IsA("TextButton") then
			local lowerText = string.lower(desc.Text)
			for k, v in pairs(keywords) do
				if string.find(lowerText, k) then return v end
			end
		end
	end
	local lowerName = string.lower(item.Name)
	for k, v in pairs(keywords) do
		if string.find(lowerName, k) then return v end
	end
	return item.Name
end

local function getBasePart(item)
	if item:IsA("BasePart") then return item end
	if item:IsA("Model") or item:IsA("Tool") then
		return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function getItemPosition(item)
	if not item or not item.Parent then return nil end
	local basePart = getBasePart(item)
	if basePart then return basePart.Position end
	if item:IsA("Model") then
		local ok, pivot = pcall(function() return item:GetPivot() end)
		if ok and pivot then return pivot.Position end
	end
	return nil
end

local function stopAutoRun()
	if not State.isRunning then return end
	State.isRunning = false
	State.currentTargetItem = nil
	State.pathQueue = {}
	State.arrivalTime = 0
	if State.runVelocity then
		pcall(function() State.runVelocity:Destroy() end)
		State.runVelocity = nil
	end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hum and hrp then
		pcall(function() hum:MoveTo(hrp.Position) end)
	end
	setStatus("Stopped (Manual Move)")
end

