	Sess:AddButton({
		Text = "Server Hop",
		Callback = function()
			pcall(function()
				local HttpService = game:GetService("HttpService")
				local req = (syn and syn.request) or (http and http.request) or request or http_request
				if not req then
					notify("Server Hop", "Request not supported", false)
					return
				end
				local res = req({
					Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100",
					Method = "GET",
				})
				local body = res and (res.Body or res.body)
				local data = body and HttpService:JSONDecode(body)
				if data and data.data then
					for _, s in ipairs(data.data) do
						if s.id ~= game.JobId and s.playing < s.maxPlayers then
							TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
							return
						end
					end
				end
