local function MA_Visible(fromPos, toPos, ignoreChar)
	if not _G.MobileAimbotWallCheck then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character, ignoreChar }
	return workspace:Raycast(fromPos, toPos - fromPos, params) == nil
end

local function MA_GetTarget()
	if not _G.MobileAimbot then return nil end
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	local origin = cam.CFrame.Position
	local best, bestDist = nil, math.huge
	local partName = _G.MobileAimbotPart or "Head"
	local fov = tonumber(_G.MobileAimbotFOV) or 180
	local minD = tonumber(_G.MobileAimbotMinDist) or 6
	local maxD = tonumber(_G.MobileAimbotMaxDist) or 400

	for _, plr in ipairs(Players:GetPlayers()) do
		if SA_IsValidTeam(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local part = plr.Character:FindFirstChild(partName) or plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and part then
				local worldDist = (part.Position - origin).Magnitude
				-- skip too close = prevents camera clip / "zoom" feel
				if worldDist < minD or worldDist > maxD then
					continue
				end
				if not MA_Visible(origin, part.Position, plr.Character) then
					continue
				end
				local sp, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen and sp.Z > 0 then
					local d = (center - Vector2.new(sp.X, sp.Y)).Magnitude
					if d <= fov and d < bestDist then
						bestDist = d
						best = part
					end
				end
			end
		end
	end
	return best
end

