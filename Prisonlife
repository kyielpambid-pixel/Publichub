local function SA_GetClosest()
	if not _G.SilentAimEnabled then return nil end
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	local best, bestDist = nil, math.huge
	local partName = _G.SilentAimPart or "HumanoidRootPart"
	local fov = tonumber(_G.SilentAimFOV) or 120
	for _, plr in ipairs(Players:GetPlayers()) do
		if SA_IsValidTeam(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local part = plr.Character:FindFirstChild(partName) or plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and part then
				local sp, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen then
					local d = (center - Vector2.new(sp.X, sp.Y)).Magnitude
					if d <= fov and d < bestDist then
						bestDist = d
						best = part
					end
				end
			end
		end
	end
	return best
end

local function SA_Chance(pct)
	pct = math.floor(tonumber(pct) or 100)
	return (math.random() * 100) <= pct
end

local function SA_Redirect(origin, originalDir, hitPart)
	if not hitPart or not hitPart.Parent then return originalDir end
	local base = SA_Smoothed or hitPart.Position
	local mag = originalDir.Magnitude
	if mag < 1 then mag = 1000 end
	local dir = (base - origin)
	if dir.Magnitude < 0.01 then return originalDir end
	return dir.Unit * mag
end

local function SA_IsLocalShot(args, method, origin, dir)
	local char = player.Character
	if not char then return false end
	local rayLen = dir and dir.Magnitude or 0
	if origin and (origin - Workspace.CurrentCamera.CFrame.Position).Magnitude <= 2 then
		if rayLen < 25 then return false end
		return true
	end
	local ignoreList
	if method == "Raycast" and typeof(args[4]) == "RaycastParams" then
		ignoreList = args[4].FilterDescendantsInstances
	elseif method == "FindPartOnRayWithIgnoreList" and typeof(args[3]) == "table" then
		ignoreList = args[3]
	end
	if ignoreList then
		for _, inst in ipairs(ignoreList) do
			if inst == char then return true end
		end
	end
	return false
end

