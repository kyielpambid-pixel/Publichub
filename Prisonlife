	tool:SetAttribute("FireRate", GunModState.FireRate)
end
local function startGunMods()
	for _, c in gunModConns do pcall(function() c:Disconnect() end) end
	table.clear(gunModConns)
	local function onCharacter(char)
		if not char then return end
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		table.insert(gunModConns, char.ChildAdded:Connect(applyToTool))
		if backpack then table.insert(gunModConns, backpack.ChildAdded:Connect(applyToTool)) end
		for _, v in char:GetChildren() do applyToTool(v) end
		if backpack then for _, v in backpack:GetChildren() do applyToTool(v) end end
	end
	if LocalPlayer.Character then onCharacter(LocalPlayer.Character) end
	table.insert(gunModConns, LocalPlayer.CharacterAdded:Connect(onCharacter))
end

-- Pickup aura
local pickupItems, PALastTick = {}, 0
local GiverRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("GiverPressed")
local function addPickup(obj)
	if obj:IsA("Model") and obj.Name ~= "TouchGiver" and obj.Name ~= "Model" and obj:GetAttribute("ToolName") then
		table.insert(pickupItems, obj)
	end
end
task.spawn(function()
	while ScriptAlive do
		if PAPickup.Enabled and next(PAPickup.Items) and LocalPlayer.Character and GiverRemote then
			local now = tick()
			if (now - PALastTick) >= PAPickup.Cooldown then
				local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local backpack = LocalPlayer:FindFirstChildWhichIsA("Backpack")
				if root and backpack then
					for _, model in pickupItems do
						local toolName = model:GetAttribute("ToolName")
						if toolName and PAPickup.Items[toolName] and model.PrimaryPart then
							if (model.PrimaryPart.Position - root.Position).Magnitude <= PAPickup.Radius then
								if not backpack:FindFirstChild(toolName) then
									PALastTick = now
									pcall(GiverRemote.FireServer, GiverRemote, model)
									break
								end
							end
						end
					end
				end
			end
		end
		task.wait(0.1)
	end
end)

-- Simulate keycard
local function openDoor(door)
	door:SetAttribute("LocalPlayerOpened", true)
	local glow = door:FindFirstChild("scn") and door.scn:FindFirstChild("glow")
	if glow then glow.BrickColor = BrickColor.new("Bright green") glow.Material = Enum.Material.Neon end
	task.delay(2, function()
		door:SetAttribute("LocalPlayerOpened", false)
		if glow then glow.BrickColor = BrickColor.new("Bright red") glow.Material = Enum.Material.SmoothPlastic end
	end)
end
local function startKeycard()
	if SKState.CharConnection then return end
	local function onCharacterAdded(character)
		if SKState.Connection then SKState.Connection:Disconnect() end
		local root = character:WaitForChild("HumanoidRootPart", 5)
		if not root then return end
		SKState.Connection = root.Touched:Connect(function(hit)
			if not SKState.Enabled then return end
			if hit.Name ~= "hitbox" then return end
			local door = hit.Parent and hit.Parent.Parent
			if door and CollectionService:HasTag(door, "Door") then openDoor(door) end
		end)
	end
	if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
	SKState.CharConnection = LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
end

