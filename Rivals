		obj.name.Outline = true
		obj.name.Visible = false
		obj.dist = Drawing.new("Text")
		obj.dist.Size = 11
		obj.dist.Center = true
		obj.dist.Outline = true
		obj.dist.Visible = false
		obj.tracer = Drawing.new("Line")
		obj.tracer.Thickness = 1
		obj.tracer.Visible = false
		obj.hp = Drawing.new("Line")
		obj.hp.Thickness = 2
		obj.hp.Visible = false
	end
	obj.chams = Instance.new("Highlight")
	obj.chams.Name = "KHUB_RivalsESP"
	obj.chams.FillTransparency = 0.55
	obj.chams.OutlineTransparency = 0.2
	obj.chams.Enabled = false
	obj.chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	pcall(function()
		obj.chams.Parent = (gethui and gethui()) or CoreGui
	end)
	espObjects[plr] = obj
end

local function removeESP(plr)
	local obj = espObjects[plr]
	if not obj then return end
	for _, d in pairs(obj) do
		if typeof(d) == "Instance" then
			pcall(function() d:Destroy() end)
		elseif type(d) == "table" or (d and d.Remove) then
			pcall(function() d:Remove() end)
		end
	end
	espObjects[plr] = nil
end

