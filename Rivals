local function getChar()
	return player.Character
end

local function getHum()
	local c = getChar()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
	local c = getChar()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function isAlive(plr)
	local c = plr.Character
	if not c then return false end
	local h = c:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0
end

local function getPart(char, name)
	if name == "Best" or name == "Head" then
		return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	end
	return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local visParams = RaycastParams.new()
visParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(part)
	if not Config.SilentAimVisCheck then return true end
	local origin = Camera.CFrame.Position
	visParams.FilterDescendantsInstances = { getChar(), Camera }
	local dir = part.Position - origin
	local hit = Workspace:Raycast(origin, dir, visParams)
	if not hit then return true end
	return hit.Instance and hit.Instance:IsDescendantOf(part.Parent)
end

local function getClosestTarget(fovPx, partName)
	local mouse = UserInputService:GetMouseLocation()
	local best, bestDist = nil, fovPx
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and isAlive(plr) then
			if Config.ESPTeamCheck and plr.Team and player.Team and plr.Team == player.Team then
				-- team check for combat too when enabled
			else
				local char = plr.Character
				local part = getPart(char, partName)
				if part and part:IsA("BasePart") and isVisible(part) then
					local sp, on = Camera:WorldToViewportPoint(part.Position)
					if on and sp.Z > 0 then
						local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
						if d < bestDist then
							bestDist = d
							best = part
						end
					end
				end
			end
		end
	end
	return best
end

