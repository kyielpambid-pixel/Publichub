RunService.RenderStepped:Connect(function()
	if fovCircle then
		local show = Config.SilentAim and Config.SilentAimShowFOV
		fovCircle.Visible = show
		if show then
			fovCircle.Radius = Config.SilentAimFOV
			local vs = Camera.ViewportSize
			fovCircle.Position = Vector2.new(vs.X / 2, vs.Y / 2)
		end
	end

	if Config.SilentAim then
		local tgt = getClosestTarget(Config.SilentAimFOV, Config.SilentAimTargetPart)
		if tgt and math.random(1, 100) <= Config.SilentAimHitChance then
			-- soft camera assist toward target for silent feel
			local desired = CFrame.new(Camera.CFrame.Position, tgt.Position)
			Camera.CFrame = Camera.CFrame:Lerp(desired, 0.35)
		end
	end

	if Config.Aimbot and State.aiming then
		local tgt = getClosestTarget(Config.AimbotFOV, Config.AimbotTargetPart)
		if tgt then
			local desired = CFrame.new(Camera.CFrame.Position, tgt.Position)
			local s = math.clamp(1 - Config.AimbotSmooth, 0.05, 1)
			Camera.CFrame = Camera.CFrame:Lerp(desired, s)
		end
	end

	local myHRP = getHRP()
	local myPos = myHRP and myHRP.Position or Vector3.zero
	for plr, obj in pairs(espObjects) do
		local show = Config.ESP and isAlive(plr)
		if show and Config.ESPTeamCheck and plr.Team and player.Team and plr.Team == player.Team then
			show = false
		end
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local head = char and char:FindFirstChild("Head")

		if show and hrp then
			local dist = (hrp.Position - myPos).Magnitude
			if Config.ESPMaxDistance > 0 and dist > Config.ESPMaxDistance then
				show = false
			end
		else
			show = false
		end

		if show and hrp then
			local sp, on = Camera:WorldToViewportPoint(hrp.Position)
			local headSp = head and Camera:WorldToViewportPoint(head.Position)
			local color = Color3.fromRGB(255, 80, 100)
			if on and sp.Z > 0 then
				local h = headSp and math.abs(sp.Y - headSp.Y) * 2.2 or 40
				local w = h * 0.55
				local x, y = sp.X - w / 2, sp.Y - h / 2
				if Config.ESPBox and obj.box then
					obj.box.Visible = true
					obj.box.Color = color
					obj.box.Size = Vector2.new(w, h)
					obj.box.Position = Vector2.new(x, y)
				elseif obj.box then
					obj.box.Visible = false
				end
				if Config.ESPName and obj.name then
					obj.name.Visible = true
					obj.name.Text = plr.DisplayName
					obj.name.Color = color
					obj.name.Position = Vector2.new(sp.X, y - 14)
				elseif obj.name then
					obj.name.Visible = false
				end
				if Config.ESPDistance and obj.dist then
					obj.dist.Visible = true
					obj.dist.Text = string.format("%.0fm", dist)
					obj.dist.Color = Color3.fromRGB(220, 220, 220)
					obj.dist.Position = Vector2.new(sp.X, y + h + 2)
				elseif obj.dist then
					obj.dist.Visible = false
				end
				if Config.ESPTracers and obj.tracer then
					obj.tracer.Visible = true
					obj.tracer.Color = color
					local vs = Camera.ViewportSize
					obj.tracer.From = Vector2.new(vs.X / 2, vs.Y)
					obj.tracer.To = Vector2.new(sp.X, y + h)
				elseif obj.tracer then
					obj.tracer.Visible = false
				end
				if Config.ESPHealth and hum and obj.hp then
					local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
					obj.hp.Visible = true
					obj.hp.Color = Color3.fromRGB(math.floor(255 * (1 - frac)), math.floor(255 * frac), 0)
					obj.hp.From = Vector2.new(x - 4, y + h)
					obj.hp.To = Vector2.new(x - 4, y + h * (1 - frac))
				elseif obj.hp then
					obj.hp.Visible = false
				end
			else
				if obj.box then obj.box.Visible = false end
				if obj.name then obj.name.Visible = false end
				if obj.dist then obj.dist.Visible = false end
				if obj.tracer then obj.tracer.Visible = false end
				if obj.hp then obj.hp.Visible = false end
			end
			if Config.ESPChams and obj.chams then
				obj.chams.Adornee = char
				obj.chams.FillColor = color
				obj.chams.OutlineColor = color
				obj.chams.Enabled = true
			elseif obj.chams then
				obj.chams.Enabled = false
			end
		else
			if obj.box then obj.box.Visible = false end
			if obj.name then obj.name.Visible = false end
			if obj.dist then obj.dist.Visible = false end
			if obj.tracer then obj.tracer.Visible = false end
			if obj.hp then obj.hp.Visible = false end
			if obj.chams then obj.chams.Enabled = false end
		end
	end
end)

