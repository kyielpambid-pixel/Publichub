	b.Text = "  " .. name
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.TextColor3 = THEME.dim
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.ZIndex = 50
	b.LayoutOrder = order or 10
	b.Parent = Rail
	corner(b, 8)
	mkstroke(b, THEME.accent, 1.2, 0.5)
	tabs[name] = b
	local p = makePage()
	pages[name] = p
	b.MouseButton1Click:Connect(function() go(name) end)
	b.Activated:Connect(function() go(name) end)
	return p
end

local function makeToggle(parent, text, default, callback)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 30)
	row.BackgroundTransparency = 1
	row.ZIndex = 18
	row.Parent = parent
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -56, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 12
	lbl.TextColor3 = THEME.text
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 19
	lbl.Parent = row
	local state = default and true or false
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(48, 24)
	btn.Position = UDim2.new(1, -48, 0.5, -12)
	btn.BackgroundColor3 = state and THEME.green or Color3.fromRGB(50, 35, 70)
	btn.Text = state and "ON" or "OFF"
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 11
	btn.TextColor3 = THEME.text
	btn.ZIndex = 19
	btn.Parent = row
	corner(btn, 6)
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = state and "ON" or "OFF"
		btn.BackgroundColor3 = state and THEME.green or Color3.fromRGB(50, 35, 70)
		if callback then pcall(callback, state) end
	end)
end

local function makeSlider(parent, text, minV, maxV, default, callback)
	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, 0, 0, 52)
	box.BackgroundTransparency = 1
	box.ZIndex = 18
	box.Parent = parent
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -50, 0, 18)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 12
	lbl.TextColor3 = THEME.text
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 19
	lbl.Parent = box
	local valL = Instance.new("TextLabel")
	valL.Size = UDim2.fromOffset(48, 18)
	valL.Position = UDim2.new(1, -48, 0, 0)
	valL.BackgroundTransparency = 1
	valL.Text = tostring(default)
	valL.Font = Enum.Font.Code
	valL.TextSize = 11
	valL.TextColor3 = THEME.gold
	valL.TextXAlignment = Enum.TextXAlignment.Right
	valL.ZIndex = 19
	valL.Parent = box
	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 8)
	track.Position = UDim2.new(0, 0, 0, 28)
	track.BackgroundColor3 = Color3.fromRGB(40, 28, 60)
	track.BorderSizePixel = 0
	track.ZIndex = 19
	track.Parent = box
	corner(track, 4)
	local fill = Instance.new("Frame")
	local pct = math.clamp((default - minV) / math.max(maxV - minV, 1), 0, 1)
	fill.Size = UDim2.new(pct, 0, 1, 0)
	fill.BackgroundColor3 = THEME.accent
	fill.BorderSizePixel = 0
	fill.ZIndex = 20
	fill.Parent = track
	corner(fill, 4)
	local dragging = false
	local function setFromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = minV + (maxV - minV) * rel
		v = math.floor(v * 10 + 0.5) / 10
		fill.Size = UDim2.new(rel, 0, 1, 0)
		valL.Text = tostring(v)
		if callback then pcall(callback, v) end
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(i.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setFromX(i.Position.X)
		end
	end)
end

