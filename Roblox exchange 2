local PriceEngine, GameConfig, MarketSeed, Client

local function looksLikeClient(t)
	return type(t) == "table" and type(t.trade) == "function" and (t.profile ~= nil or type(t.marketNow) == "function")
end

local function resolveRSE()
	pcall(function()
		PriceEngine = require(game.ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PriceEngine"))
	end)
	pcall(function()
		GameConfig = require(game.ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
	end)
	pcall(function()
		local st = require(LocalPlayer.PlayerScripts:WaitForChild("Client"):WaitForChild("State"))
		if type(st) == "table" and type(st.seed) == "function" then
			MarketSeed = st.seed()
		else
			MarketSeed = st
		end
	end)
	pcall(function()
		local cf = LocalPlayer.PlayerScripts:FindFirstChild("Client")
		if not cf then return end
		for _, m in ipairs(cf:GetDescendants()) do
			if m:IsA("ModuleScript") then
				local ok, mod = pcall(require, m)
				if ok and looksLikeClient(mod) then Client = mod return end
				if ok and type(mod) == "table" then
					for _, v in pairs(mod) do
						if looksLikeClient(v) then Client = v return end
					end
				end
			end
		end
	end)
	if not Client and type(getgc) == "function" then
		pcall(function()
			for _, v in ipairs(getgc(true)) do
				if looksLikeClient(v) then Client = v break end
			end
		end)
	end
end
resolveRSE()

