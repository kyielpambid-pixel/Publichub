                dot.Position = UDim2.new(0.5, math.cos(a2) * r - 4, 0.5, math.sin(a2) * r - 4)
                dot.BackgroundTransparency = 0.3
            end
            task.wait(0.016)
        end
        for _, dot in ipairs(fireDots) do
            if dot.Parent then dot.BackgroundTransparency = 0.3 end
        end
        task.wait(0.2)
    end
end)

