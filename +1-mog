local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = p
    return c
end

local function mkstroke(p, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or THEME.stroke
    s.Thickness = th or 1.2
    s.Transparency = tr or 0.35
    s.Parent = p
    return s
end

local function openLink(url)
    local opened = false
    pcall(function()
        if type(openlink) == "function" then
            openlink(url)
            opened = true
        end
    end)
    if not opened and setclipboard then
        setclipboard(url)
    end
    return opened
end

