local Pages = {}
local TabButtons = {}
TabButtons.ActiveId = nil

local function createPage(name)
    local sf = Instance.new("ScrollingFrame")
    sf.Name = name .. "Page"
    sf.Size = UDim2.new(1, -34, 1, -90)
    sf.Position = UDim2.new(0, 22, 0, 80)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel = 0
    sf.ScrollBarThickness = 3
    sf.ScrollBarImageColor3 = THEME.accent
    sf.CanvasSize = UDim2.new(0, 0, 0, 0)
    sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
    sf.ZIndex = 6
    sf.Visible = false
    sf.Parent = Main

    local lay = Instance.new("UIListLayout")
    lay.Padding = UDim.new(0, 14)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = sf

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 18)
    pad.Parent = sf

    Pages[name] = sf
    return sf
end

local function switchPage(name, title, subtitle)
    for k, p in pairs(Pages) do p.Visible = (k == name) end
    PageTitle.Text = title or name
    PageSub.Text = subtitle or ""
    TabButtons.ActiveId = name

    local page = Pages[name]
    if page then
        local idx = 0
        for _, child in ipairs(page:GetChildren()) do
            if child:IsA("Frame") then
                idx = idx + 1
                local fp = child.Position
                local fbt = child.BackgroundTransparency
                child.Position = UDim2.new(fp.X.Scale, fp.X.Offset, fp.Y.Scale, fp.Y.Offset + 18)
                child.BackgroundTransparency = 0.6
                task.delay((idx - 1) * 0.055, function()
                    if not child.Parent then return end
                    TweenService:Create(child, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        Position = fp,
                        BackgroundTransparency = fbt,
                    }):Play()
                end)
            end
        end
    end

    for id, btnRef in pairs(TabButtons) do
        if type(id) == "string" and not id:find("_") then
            local active = (id == name)
            local iconFrame = TabButtons[id .. "_Frame"]
            local glow      = TabButtons[id .. "_Glow"]
            local bar       = TabButtons[id .. "_Bar"]
            local lbl       = TabButtons[id .. "_Label"]
            local icon      = TabButtons[id .. "_Icon"]
            local stroke    = TabButtons[id .. "_Stroke"]
            local pop       = TabButtons[id .. "_Pop"]
            local tabCol    = TabButtons[id .. "_Color"]
            if active then
                TweenService:Create(btnRef, TweenInfo.new(0.22), { BackgroundTransparency = 0.05 }):Play()
                if iconFrame then TweenService:Create(iconFrame, TweenInfo.new(0.22), { BackgroundColor3 = tabCol, BackgroundTransparency = 0 }):Play() end
                if glow then TweenService:Create(glow, TweenInfo.new(0.3), { BackgroundTransparency = 0.45, Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0, 5, 0.5, -20) }):Play() end
                -- bar: force-set full width first so a stuck tween can never hide it
                if bar then
                    bar.Visible = true
                    bar.Size = UDim2.new(0, 4, 0.62, 0)
                    TweenService:Create(bar, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Size = UDim2.new(0, 4, 0.62, 0),
                    }):Play()
                end
                if lbl then lbl.TextColor3 = THEME.gold end
                if icon then icon.ImageColor3 = Color3.new(1, 1, 1) end
                if stroke then stroke.Color = tabCol; stroke.Transparency = 0.1; stroke.Thickness = 2 end
                if pop then
                    pop.Scale = 0.55
                    TweenService:Create(pop, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
                end
            else
                TweenService:Create(btnRef, TweenInfo.new(0.22), { BackgroundTransparency = 0.3 }):Play()
                if iconFrame then TweenService:Create(iconFrame, TweenInfo.new(0.22), { BackgroundColor3 = Color3.fromRGB(24, 30, 60), BackgroundTransparency = 0.15 }):Play() end
                if glow then TweenService:Create(glow, TweenInfo.new(0.25), { BackgroundTransparency = 0.88, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 9, 0.5, -15) }):Play() end
                if bar then
                    bar.Visible = false
                    bar.Size = UDim2.new(0, 0, 0.62, 0)
                end
                if lbl then lbl.TextColor3 = THEME.dim end
                if icon then icon.ImageColor3 = Color3.fromRGB(200, 215, 250) end
                if stroke then stroke.Color = THEME.stroke; stroke.Transparency = 0.45; stroke.Thickness = 1.2 end
            end
        end
    end
end

local function ripple(b, inputPos)
    local rel = Vector2.new(inputPos.X - b.AbsolutePosition.X, inputPos.Y - b.AbsolutePosition.Y)
    local circle = Instance.new("Frame")
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Position = UDim2.new(0, rel.X, 0, rel.Y)
    circle.Size = UDim2.fromOffset(8, 8)
    circle.BackgroundColor3 = Color3.new(1, 1, 1)
    circle.BackgroundTransparency = 0.5
    circle.BorderSizePixel = 0
    circle.ZIndex = b.ZIndex + 3
    circle.Parent = b
    corner(circle, 99)
    local target = math.max(b.AbsoluteSize.X, b.AbsoluteSize.Y) * 2.2
    TweenService:Create(circle, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(target, target),
        BackgroundTransparency = 1,
    }):Play()
    task.delay(0.5, function()
        if circle.Parent then circle:Destroy() end
    end)
end

