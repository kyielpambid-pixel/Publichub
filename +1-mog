    return ok
end

local function fireWin()
    local character = player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    local winPads = Workspace:FindFirstChild("WinPads")
    local normal = winPads and winPads:FindFirstChild("Normal")
    local pad = normal and normal:FindFirstChild("15")
    local hitbox = pad and pad:FindFirstChild("Hitbox")
    if not root or not hitbox then return false end
    if hasFireTouch then
        local ok = pcall(function()
            firetouchinterest(root, hitbox, 0)
            task.wait()
            firetouchinterest(root, hitbox, 1)
        end)
        if ok then Session.wins = Session.wins + 1 end
        return ok
    else
