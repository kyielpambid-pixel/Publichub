			elseif noclipParts[d] ~= nil then
				d.CanCollide = noclipParts[d]
			end
		end
	end
	if not on then table.clear(noclipParts) end
end

local function buildPath(from, to, opts)
	if Vector3.new(to.X - from.X, 0, to.Z - from.Z).Magnitude < 80 and math.abs(to.Y - from.Y) < 30 then
		return { to }
	end
	if opts and opts.Void then
		local voidY = math.min(from.Y, to.Y) - H.VoidDepth
		voidY = math.max(voidY, workspace.FallenPartsDestroyHeight + 60)
		return {
			Vector3.new(from.X, voidY, from.Z),
			Vector3.new(to.X, voidY, to.Z),
			to,
		}
	end
	local cruise = (opts and opts.Over) and H.OverHeight or H.CruiseHeight
	local y = math.max(from.Y, to.Y) + cruise
	return {
		Vector3.new(from.X, y, from.Z),
		Vector3.new(to.X, y, to.Z),
		to,
	}
end

H.TravelTime = function(from, to, opts)
	local n = 0
	local cur = from
	for _, p in ipairs(buildPath(from, to, opts)) do
		n = n + (p - cur).Magnitude
		cur = p
	end
	return n / math.max((opts and opts.Speed) or H.FlySpeed, 20)
end

H.FlyTo = function(target, cancelFn, arrive, opts)
	local root = H.Root()
	if not root or typeof(target) ~= "Vector3" then return false end
	local n = arrive or 3
	if (root.Position - target).Magnitude <= n then return true end
	local startPos = root.Position
	local path = buildPath(root.Position, target, opts)
	local deadline = os.clock() + H.TravelTime(root.Position, target, opts) + 6
	local speed = (opts and opts.Speed) or H.FlySpeed
	H.SetNoclip(true)
	local conn = RunService.Stepped:Connect(function()
		local char = localPlayer.Character
		if not char then return end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
		end
	end)
	local idx = 1
	local ok = false
	while os.clock() < deadline do
		if cancelFn and cancelFn() then break end
		local dt = RunService.Heartbeat:Wait()
		local r = H.Root()
		if not r then break end
		local isLast = idx == #path
		local delta = path[idx] - r.Position
		local mag = delta.Magnitude
		if mag <= (isLast and n or 2) then
			if isLast then ok = true break end
			idx = idx + 1
		else
			local step = math.min(mag, math.max(speed, 20) * dt)
			local flat = Vector3.new(delta.X, 0, delta.Z)
			local rot = flat.Magnitude > 0.1 and CFrame.lookAt(Vector3.zero, flat.Unit) or r.CFrame.Rotation
			local nextPos = r.Position + delta.Unit * step
			if step > 60 then
				pcall(function()
					if typeof(workspace.RequestStreamAroundAsync) == "function" then
						workspace:RequestStreamAroundAsync(nextPos, 16)
					end
				end)
			end
			pcall(function()
				r.CFrame = CFrame.new(nextPos) * rot
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end)
		end
	end
	local r = H.Root()
	if r and r.Position.Y < math.min(target.Y, startPos.Y) - 15 then
		local recover = ok and target or startPos
		pcall(function()
			local was = r.Anchored
			r.Anchored = true
			r.AssemblyLinearVelocity = Vector3.zero
			r.CFrame = CFrame.new(recover)
			RunService.Heartbeat:Wait()
			r.Anchored = was
		end)
		r = H.Root()
	end
	conn:Disconnect()
	H.SetNoclip(false)
	r = H.Root()
	if r then
		pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
		return (r.Position - target).Magnitude <= n + 1 or ok
	end
	return ok
end

H.InstantFlyTo = function(target, cancelFn, arrive)
	local root = H.Root()
	if not root or typeof(target) ~= "Vector3" then return false end
	local n = arrive or 3
	if (root.Position - target).Magnitude <= n then return true end
	if cancelFn and cancelFn() then return false end
	H.SetNoclip(true)
	local conn = RunService.Stepped:Connect(function()
		local char = localPlayer.Character
		if not char then return end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
		end
	end)
	local wasAnchored = root.Anchored
	local function teleportTo(pos)
		local r = H.Root()
		if not r then return end
		pcall(function()
			r.Anchored = true
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
			r.CFrame = CFrame.new(pos)
		end)
	end
	teleportTo(target)
	pcall(function()
		if typeof(workspace.RequestStreamAroundAsync) == "function" then
			workspace:RequestStreamAroundAsync(target, 16)
		end
	end)
	for _ = 1, 5 do
		if cancelFn and cancelFn() then break end
		RunService.Heartbeat:Wait()
	end
	local r = H.Root()
	if r and r.Position.Y < target.Y - 15 then
		teleportTo(target)
		RunService.Heartbeat:Wait()
		r = H.Root()
	end
	pcall(function()
		if r then
			r.Anchored = wasAnchored
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
	end)
	conn:Disconnect()
	H.SetNoclip(false)
	r = H.Root()
	if not r then return false end
	pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
	return (r.Position - target).Magnitude <= n + 1
end

