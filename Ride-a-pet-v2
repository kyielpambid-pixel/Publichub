local eggCooldowns = {}
local function listEggs(fromPos)
	local out = {}
	local plotTop = H.PlotTop()
	local now = os.clock()
	for _, child in ipairs(activeEggs:GetChildren()) do
		local egg = child:GetAttribute("Egg")
		local pos = child:GetAttribute("Position")
		local priv = child:GetAttribute("PrivateTo")
		local cd = eggCooldowns[child.Name]
		local ok = type(egg) == "string" and typeof(pos) == "Vector3" and (priv == nil or priv == localPlayer.UserId)
		if ok then ok = not (cd and cd > now) end
		if ok and not collectedAttr(egg) then
			local rank = H.EggRank(egg)
			if rank >= Farm.minRarity and (next(Farm.targetEggs) == nil or Farm.targetEggs[egg]) then
				if (plotTop and H.TravelTime(pos, plotTop) or 0) < 18 then
					table.insert(out, {
						Config = child,
						Name = egg,
						Position = pos,
						Rank = rank,
						Luck = H.EggLuck(egg) * (tonumber(child:GetAttribute("Weight")) or 1),
						Distance = (pos - fromPos).Magnitude,
					})
				end
			end
		end
	end
	table.sort(out, function(a, b)
		if Farm.priority == "Nearest" then return a.Distance < b.Distance end
		if Farm.priority == "Farthest" then return a.Distance > b.Distance end
		if Farm.priority == "Highest Rarity" then
			if a.Rank ~= b.Rank then return a.Rank > b.Rank end
			if a.Luck ~= b.Luck then return a.Luck > b.Luck end
			return a.Distance < b.Distance
		end
		if a.Luck ~= b.Luck then return a.Luck > b.Luck end
		return a.Distance < b.Distance
	end)
	return out
end

local function deliverEggs(cancelFn)
	if H.BasketCount() <= 0 then return true end
	local top = H.PlotTop()
	if not top then return false end
	H.Status = "Bringing eggs home"
	if Farm.StealMethod == "Instant" then
		H.InstantFlyTo(top + Vector3.new(0, 4, 0), cancelFn, 4)
	else
		H.FlyTo(top + Vector3.new(0, 4, 0), cancelFn, 4, { Speed = Farm.ReturnSpeed })
	end
	local deadline = os.clock() + 3
	while H.BasketCount() > 0 and os.clock() < deadline do
		RunService.Heartbeat:Wait()
	end
	if H.BasketCount() == 0 then
		table.clear(Farm.Carried)
		Farm.PickupPos = nil
	end
	return H.BasketCount() == 0
end

local function popManual()
	while #Farm.Manual > 0 do
		local cfg = activeEggs:FindFirstChild(Farm.Manual[1])
		local egg = cfg and cfg:GetAttribute("Egg")
		local pos = cfg and cfg:GetAttribute("Position")
		local priv = cfg and cfg:GetAttribute("PrivateTo")
		if type(egg) == "string" and typeof(pos) == "Vector3" and (priv == nil or priv == localPlayer.UserId) then
			return { Config = cfg, Name = egg, Position = pos, Manual = true }
		end
		table.remove(Farm.Manual, 1)
	end
	return nil
end

local function removeManual(name)
	local i = table.find(Farm.Manual, name)
	if i then table.remove(Farm.Manual, i) end
end

local function collectStep(cancelFn)
	if not H.Root() then return false end
	local cap = H.BasketCapacity()
	local got = false
	while H.BasketCount() < cap do
		if cancelFn() then break end
		local root = H.Root()
		if not root then break end
		local target = popManual()
		if not target and Farm.Collect then
			for _, e in ipairs(listEggs(root.Position)) do
				if not table.find(Farm.Manual, e.Config.Name) then
					target = e
					break
				end
			end
		end
		if not target then
			if not got then H.Status = "No egg matches the filters" end
			break
		end
		local name = target.Config.Name
		Farm.Target = name
		Farm.TargetManual = target.Manual == true
		Farm.Dropped = nil
		H.Status = "Collecting " .. target.Name
		local reached = H.FlyTo(target.Position + Vector3.new(0, 3, 0), function()
			return cancelFn() or target.Config.Parent == nil or Farm.Dropped == name
		end, 6, Farm.RouteOpts())
		if Farm.Dropped == name then
			Farm.Target = nil
			Farm.Dropped = nil
		elseif target.Config.Parent == nil and not reached then
			removeManual(name)
			Farm.Target = nil
		elseif not reached then
			eggCooldowns[name] = os.clock() + 20
			removeManual(name)
			Farm.Target = nil
			break
		else
			local before = H.BasketCount()
			Farm.LastPickupAt = os.clock()
			if before == 0 then Farm.PickupPos = target.Position end
			H.Fire("EggPickup", name)
			local dl = os.clock() + 1.2
			while H.BasketCount() == before and os.clock() < dl do
				RunService.Heartbeat:Wait()
			end
			removeManual(name)
			Farm.Target = nil
			if H.BasketCount() > before then
				Farm.Carried[name] = target.Config
				got = true
			else
				eggCooldowns[name] = os.clock() + 20
			end
		end
	end
	Farm.Target = nil
	if H.BasketCount() > 0 then deliverEggs(nil) end
	return got
end

local plantCD, plantCountAtCD = 0, 0
local function plotEggs()
	local p = H.Plot()
	local eggs = p and p:FindFirstChild("Eggs")
	return eggs and eggs:GetChildren() or {}
end
local function occupiedPoints()
	local pts = {}
	for _, e in ipairs(plotEggs()) do
		local ok, pos = pcall(function() return e:GetPivot().Position end)
		if ok then table.insert(pts, pos) end
	end
	local pets = H.Plot()
	pets = pets and pets:FindFirstChild("Pets")
	if pets then
		for _, c in ipairs(pets:GetChildren()) do
			local ok, pos = pcall(function() return c:GetPivot().Position end)
			if ok then table.insert(pts, pos) end
		end
	end
	return pts
end

local function plantStep(cancelFn)
	if os.clock() < plantCD and #plotEggs() >= plantCountAtCD then return false end
	local tools = {}
	for _, t in ipairs(H.Tools("Egg")) do
		if H.EggRank(t.Name) >= Farm.plantMinRarity then table.insert(tools, t) end
	end
	if #tools == 0 then return false end
	table.sort(tools, function(a, b) return H.EggLuck(a.Name) > H.EggLuck(b.Name) end)
	local planted = 0
	for _, tool in ipairs(tools) do
		if cancelFn() then break end
		if not tool.Parent then continue end
		local pt = H.RandomPlotPoint(8, occupiedPoints(), 5)
		if not pt then continue end
		H.Status = "Planting " .. tool.Name
		if H.Equip(tool) then
			local before = #plotEggs()
			H.Fire("EggPlaced", { PlantPosition = pt })
			local dl = os.clock() + 1.2
			while os.clock() < dl and #plotEggs() == before do RunService.Heartbeat:Wait() end
			if #plotEggs() > before then
				planted = planted + 1
			else
				plantCD = os.clock() + 15
				plantCountAtCD = #plotEggs()
				break
			end
		end
	end
	H.Unequip()
	return planted > 0
end

local function readyHatches()
	local out = {}
	for _, egg in ipairs(plotEggs()) do
		local timer = egg:FindFirstChild("Timer", true)
		local hatch = egg:FindFirstChild("Hatch", true)
		if hatch and hatch:IsA("ProximityPrompt") and hatch.Enabled and timer and timer:IsA("TextLabel") and timer.Text == "Ready" then
			table.insert(out, { Egg = egg, Prompt = hatch })
		end
	end
	return out
end

local function hatchStep(cancelFn)
	local n = 0
	for _, item in ipairs(readyHatches()) do
		if cancelFn() then break end
		if not item.Egg.Parent then continue end
		local ok, pos = pcall(function() return item.Egg:GetPivot().Position end)
		if not ok then continue end
		H.Status = "Hatching eggs"
		H.FlyTo(pos + Vector3.new(0, 3, 3), cancelFn, 5)
		H.FirePrompt(item.Prompt)
		local dl = os.clock() + 2
		while os.clock() < dl and item.Egg.Parent do RunService.Heartbeat:Wait() end
		if not item.Egg.Parent then n = n + 1 end
	end
	if n > 0 then task.wait(0.5) H.Unequip() end
	return n > 0
end

-- Pets place/feed
local feedCD = {}
local function plotPets()
	local p = H.Plot()
	local pets = p and p:FindFirstChild("Pets")
	return pets and pets:GetChildren() or {}
end
local function maxPets()
	return math.max(1, tonumber(localPlayer:GetAttribute("MaxPets")) or tonumber(H.Saved("MaxPets")) or 5)
end
local function petToolScore(tool)
	return H.PetScore(H.PetNameOf(tool), tool:GetAttribute("Weight"), tool:GetAttribute("Mutation"))
end
local function petPlotScore(pet)
	return H.PetScore(pet:GetAttribute("PetName") or pet.Name, pet:GetAttribute("Weight"), pet:GetAttribute("Mutation"))
end
local function bestPetTool()
	local best, score = nil, -1
	for _, t in ipairs(H.Tools("Pet")) do
		local s = petToolScore(t)
		if s > score then best, score = t, s end
	end
	return best, score
end
local function weakestPlotPet()
	local weak, score = nil, math.huge
	for _, p in ipairs(plotPets()) do
		local s = petPlotScore(p)
		if s < score then weak, score = p, s end
	end
	return weak, score
end
local function placePetTool(tool, cancelFn)
	local key = tool:GetAttribute("PetKey")
	if not key then return false end
	local top = H.PlotTop()
	if top then H.FlyTo(top + Vector3.new(0, 4, 0), cancelFn, 20) end
	if not H.Equip(tool) then return false end
	local pt = H.RandomPlotPoint(10, nil, 0)
	local before = #plotPets()
	H.Fire("PlacePet", key, (pt or Vector3.zero) + Vector3.new(0, 2, 0))
	task.wait(0.35)
	H.Unequip()
	local dl = os.clock() + 1.5
	while os.clock() < dl and #plotPets() == before do RunService.Heartbeat:Wait() end
	return #plotPets() > before
end
local function placeStep(cancelFn)
	local placed = 0
	for _ = 1, maxPets() do
		if cancelFn() or not Farm.Place then break end
		local best = bestPetTool()
		if not best then break end
		if #plotPets() < maxPets() then
			H.Status = "Placing " .. H.PetNameOf(best)
			if placePetTool(best, cancelFn) then placed = placed + 1 end
		elseif Farm.Swap then
			local weak = weakestPlotPet()
			local key = weak and weak:GetAttribute("PetKey")
			if key then
				H.Status = "Swapping in a stronger pet"
				local top = H.PlotTop()
				if top then H.FlyTo(top + Vector3.new(0, 4, 0), cancelFn, 20) end
				H.Fire("PickupPet", key)
				local dl = os.clock() + 1.5
				while os.clock() < dl and weak.Parent do RunService.Heartbeat:Wait() end
				if not weak.Parent then
					H.Status = "Placing " .. H.PetNameOf(best)
					if placePetTool(best, cancelFn) then placed = placed + 1 end
				end
			end
		else
			break
		end
	end
	return placed > 0
end
local function bestFood()
	local best, cost = nil, math.huge
	for _, t in ipairs(H.Tools("Food")) do
		local amt = t:FindFirstChild("Amount", true)
		if (amt and tonumber(amt.Value) or 1) > 0 and (next(Farm.foodsToUse) == nil or Farm.foodsToUse[t.Name]) then
			local d = type(GameData.Foods) == "table" and GameData.Foods[t.Name] or nil
			local c = type(d) == "table" and tonumber(d.Cost) or 0
			if c < cost then best, cost = t, c end
		end
	end
	return best
end
local function feedStep(cancelFn)
	local pets = plotPets()
	table.sort(pets, function(a, b) return petPlotScore(a) > petPlotScore(b) end)
	local n = 0
	for _, pet in ipairs(pets) do
		if cancelFn() then break end
		local key = pet:GetAttribute("PetKey")
		local food = bestFood()
		if not food or not key then break end
		if (feedCD[key] or 0) > os.clock() then continue end
		local ok, pos = pcall(function() return pet:GetPivot().Position end)
		if not ok then continue end
		H.Status = "Feeding " .. tostring(pet:GetAttribute("PetName") or pet.Name)
		H.FlyTo(pos + Vector3.new(0, 4, 4), cancelFn, 8)
		if H.Equip(food) then
			local age = pet:GetAttribute("Age")
			H.Fire("FeedPet", key, food.Name)
			local dl = os.clock() + 1.2
			while os.clock() < dl and pet:GetAttribute("Age") == age do RunService.Heartbeat:Wait() end
			feedCD[key] = os.clock() + 2
			n = n + 1
		end
	end
	H.Unequip()
	return n > 0
end

-- Main farm loop
task.spawn(function()
	while true do
		local any = Farm.Collect or #Farm.Manual > 0 or Farm.Plant or Farm.Hatch or Farm.Place or Farm.Feed or H.BasketCount() > 0
		local did = false
		if any and H.Root() and H.Plot() then
			Farm.Busy = true
			pcall(function()
				local function cancel() return false end
				if H.BasketCount() > 0 then deliverEggs(cancel) did = true end
				if Farm.Plant then if plantStep(function() return not Farm.Plant end) then did = true end end
				if Farm.Hatch and #readyHatches() > 0 then if hatchStep(function() return not Farm.Hatch end) then did = true end end
				if Farm.Place then if placeStep(function() return not Farm.Place end) then did = true end end
				if Farm.Feed then if feedStep(function() return not Farm.Feed end) then did = true end end
				if Farm.Collect or #Farm.Manual > 0 then
					if collectStep(function() return not (Farm.Collect or #Farm.Manual > 0) end) then did = true end
				end
			end)
			Farm.Busy = false
			if not did and not Farm.Collect then H.Status = "Waiting for work" end
		elseif not any then
			H.Status = "Idle"
		end
		local waitUntil = os.clock() + (did and 0.15 or 1)
		while os.clock() < waitUntil and not Farm.WakeFlag do
			RunService.Heartbeat:Wait()
		end
		Farm.WakeFlag = false
	end
end)

