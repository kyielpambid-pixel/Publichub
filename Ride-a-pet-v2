local function shopList(kind)
	local out = {}
	local shop = GameData.Shop
	local cat = type(shop) == "table" and shop[kind] or nil
	if type(cat) == "table" then
		local tmp = {}
		for k, v in pairs(cat) do
			if type(v) == "table" then table.insert(tmp, { Name = k, Price = tonumber(v.Price) or 0 }) end
		end
		table.sort(tmp, function(a, b) return a.Price < b.Price end)
		for _, e in ipairs(tmp) do table.insert(out, e.Name) end
	end
	return out
end
local function shopPrice(kind, name)
	local shop = GameData.Shop
	local cat = type(shop) == "table" and shop[kind] or nil
	local item = type(cat) == "table" and cat[name] or nil
	return type(item) == "table" and tonumber(item.Price) or math.huge
end
local function toolCount(name)
	local n = 0
	for _, parent in ipairs({ localPlayer:FindFirstChildOfClass("Backpack"), localPlayer.Character }) do
		if parent then
			for _, c in ipairs(parent:GetChildren()) do
				if c:IsA("Tool") and string.gsub(c.Name, "%s*%[.*$", "") == name then
					local amt = c:FindFirstChild("Amount", true)
					n = n + (amt and tonumber(amt.Value) or 1)
				end
			end
		end
	end
	return n
end

task.spawn(function()
	while true do
		for _, kind in ipairs({ "Food", "Gears" }) do
			local enabled = kind == "Food" and Shop.BuyFood or Shop.BuyGears
			local sel = kind == "Food" and Shop.foodSel or Shop.gearSel
			if enabled then
				local opened = false
				for _, name in ipairs(shopList(kind)) do
					if sel[name] then
						local price = shopPrice(kind, name)
						local stock = Shop.stock[kind] and Shop.stock[kind][name]
						local can = stock == nil or stock > 0
						local tries = 0
						while can and tries < 20 and H.Cash() - price >= Shop.keepCash do
							if not opened then H.Fire("SetOpenShop", kind) task.wait(0.15) opened = true end
							local before = toolCount(name)
							H.Fire("BuyWithCash", kind, name)
							tries = tries + 1
							local dl = os.clock() + 0.8
							while os.clock() < dl and toolCount(name) <= before do RunService.Heartbeat:Wait() end
							if toolCount(name) > before then
								if stock and Shop.stock[kind] then
									Shop.stock[kind][name] = math.max(0, (Shop.stock[kind][name] or 1) - 1)
									can = Shop.stock[kind][name] > 0
								end
							else
								can = false
							end
						end
					end
				end
			end
		end
		task.wait(3)
	end
end)

task.spawn(function()
	while true do
		if Progress.AutoRebirth then
			local rebirths = GameData.Rebirths
			local n = tonumber(H.Saved("Rebirths")) or 0
			local cost = nil
			if type(rebirths) == "table" then
				local cap = tonumber(rebirths.Cap)
				if not (cap and n >= cap) and type(rebirths.GetCost) == "function" then
					local ok, r = pcall(rebirths.GetCost, n)
					if ok then cost = tonumber(r) end
				end
			end
			if cost and H.Cash() >= cost then H.Fire("Rebirth") end
		end
		if Progress.AutoIndex then H.Fire("ClaimIndexReward") end
		task.wait(3)
	end
end)

