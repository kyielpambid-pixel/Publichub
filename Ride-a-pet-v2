local function addSlider(parent, title, minV, maxV, default, step, onChange)
	local val = default or minV
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1,0,0,48)
	wrap.BackgroundTransparency = 1
	wrap.ZIndex = 9
	wrap.Parent = parent
	local lab = Instance.new("TextLabel")
	lab.Size = UDim2.new(1,0,0,16)
	lab.BackgroundTransparency = 1
	lab.Text = title .. ": " .. tostring(val)
	lab.TextColor3 = THEME.dim
	lab.Font = Enum.Font.Gotham
	lab.TextSize = 11
	lab.TextXAlignment = Enum.TextXAlignment.Left
	lab.ZIndex = 10
	lab.Parent = wrap
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1,0,0,28)
	row.Position = UDim2.new(0,0,0,18)
	row.BackgroundTransparency = 1
	row.ZIndex = 10
	row.Parent = wrap
	local function bump(d)
		val = math.clamp(val + d, minV, maxV)
		if step and step > 1 then val = math.floor(val / step + 0.5) * step end
		lab.Text = title .. ": " .. tostring(val)
		if onChange then onChange(val) end
	end
	local m = Instance.new("TextButton")
	m.Size = UDim2.new(0,40,0,26)
	m.Text = "-"
	m.BackgroundColor3 = THEME.element
	m.BackgroundTransparency = 0.3
	m.TextColor3 = THEME.text
	m.ZIndex = 11
	m.Parent = row
	corner(m, 5)
	m.MouseButton1Click:Connect(function() bump(-(step or 1)) end)
	local p = Instance.new("TextButton")
	p.Size = UDim2.new(0,40,0,26)
	p.Position = UDim2.new(0,48,0,0)
	p.Text = "+"
	p.BackgroundColor3 = THEME.element
	p.BackgroundTransparency = 0.3
	p.TextColor3 = THEME.text
	p.ZIndex = 11
	p.Parent = row
	corner(p, 5)
	p.MouseButton1Click:Connect(function() bump(step or 1) end)
	return wrap
end

