H.RandomPlotPoint = function(margin, avoid, minDist)
	local b = H.PlotBase()
	if not b then return nil end
	local n = math.max(1, b.Size.X / 2 - margin)
	local n2 = math.max(1, b.Size.Z / 2 - margin)
	local n3 = b.Position.Y + b.Size.Y / 2
	local fallback = nil
	for _ = 1, 24 do
		local vector = Vector3.new(rng:NextNumber(-n, n), 0, rng:NextNumber(-n2, n2))
		local v8 = b.CFrame:PointToWorldSpace(vector)
		local vector2 = Vector3.new(v8.X, n3, v8.Z)
		local ok = true
		if avoid then
			for _, v9 in ipairs(avoid) do
				if Vector3.new(v9.X - vector2.X, 0, v9.Z - vector2.Z).Magnitude < minDist then
					ok = false
					break
				end
			end
		end
		if ok then return vector2 end
		fallback = fallback or vector2
	end
	return fallback
end
