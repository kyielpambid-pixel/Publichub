local function getMyTeamKey()
	for key, team in pairs(Match.teams) do
		for _, member in pairs(team.members or {}) do
			if member.userId == LocalPlayer.UserId then
				return key
			end
		end
	end
	return nil
end

if Remotes then
	local matchState = Remotes:FindFirstChild("MatchState")
	if matchState then
		matchState.OnClientEvent:Connect(function(data)
			if type(data) ~= "table" then return end
			if data.teams then
				Match.teams = data.teams
				Match.myTeam = getMyTeamKey()
			end
			if data.phase then Match.phase = data.phase end
			if data.round then Match.round = data.round end
		end)
	end
end

local function isAlive(plr)
	for _, team in pairs(Match.teams) do
		for _, member in pairs(team.members or {}) do
			if member.userId == plr.UserId then
				return member.alive == true
			end
		end
	end
	return nil
end

local function getTeamKey(plr)
	for key, team in pairs(Match.teams) do
		for _, member in pairs(team.members or {}) do
			if member.userId == plr.UserId then
				return key
			end
		end
	end
	return nil
end

local function isEnemy(plr, teamCheck)
	if plr == LocalPlayer then return false end
	if not teamCheck then return true end
	local myTeam = Match.myTeam
	local theirTeam = getTeamKey(plr)
	if not myTeam or not theirTeam then return true end
	return myTeam ~= theirTeam
end

