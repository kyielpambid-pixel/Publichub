local EspPool = { pool = {}, active = {} }
local RED = Color3.fromRGB(220, 70, 70)
local VIOLET = Color3.fromRGB(175, 110, 255)

local function releaseEsp(obj)
	if not obj then return end
	obj.Box.Visible = false
	obj.Name.Visible = false
	obj.Dist.Visible = false
	obj.HealthBg.Visible = false
	obj.HealthBar.Visible = false
	if #EspPool.pool < 100 then
		table.insert(EspPool.pool, obj)
	else
		obj.Box:Destroy()
		obj.Name:Destroy()
		obj.Dist:Destroy()
		obj.HealthBg:Destroy()
		obj.HealthBar:Destroy()
	end
end

local function hideEsp(obj)
	obj.Box.Visible = false
	obj.Name.Visible = false
	obj.Dist.Visible = false
	obj.HealthBg.Visible = false
	obj.HealthBar.Visible = false
end

local function makeEspLabel(size, textSize)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.RobotoMono
	l.TextSize = textSize
	l.TextStrokeTransparency = 0
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.Size = size
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.Visible = false
	l.Parent = EspGui
	return l
end

local function acquireEsp()
	local obj = table.remove(EspPool.pool)
	if obj then
		hideEsp(obj)
		return obj
	end
	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Visible = false
	box.Parent = EspGui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1
	stroke.Parent = box
	local name = makeEspLabel(UDim2.new(0, 240, 0, 14), 12)
	local dist = makeEspLabel(UDim2.new(0, 120, 0, 12), 10)
	local hbg = Instance.new("Frame")
	hbg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	hbg.BorderSizePixel = 0
	hbg.Visible = false
	hbg.Parent = EspGui
	local hbar = Instance.new("Frame")
	hbar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	hbar.BorderSizePixel = 0
	hbar.Visible = false
	hbar.Parent = EspGui
	return { Box = box, Stroke = stroke, Name = name, Dist = dist, HealthBg = hbg, HealthBar = hbar }
end

RunService.RenderStepped:Connect(function()
	local hrp = getHRP()
	if not hrp then
		for char, obj in pairs(EspPool.active) do
			releaseEsp(obj)
			EspPool.active[char] = nil
		end
		return
	end

	local still = {}
	if CFG.ESPEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				if not (CFG.ESPTeamCheck and not isEnemy(plr, true)) then
					local char = plr.Character
					if char then
						local root = char:FindFirstChild("HumanoidRootPart")
						local hum = char:FindFirstChildOfClass("Humanoid")
						if root and hum and hum.Health > 0 and isAlive(plr) ~= false then
							local col = isEnemy(plr, true) and RED or VIOLET
							local mag = (root.Position - hrp.Position).Magnitude
							local obj = EspPool.active[char]
							if not obj then
								obj = acquireEsp()
								EspPool.active[char] = obj
							end
							still[char] = true
							local sp, onScreen = Camera:WorldToViewportPoint(root.Position)
							if onScreen and sp.Z > 0 then
								local scale = math.clamp(3 * (1000 / math.max(mag, 1)), 12, 220)
								local h = scale * 1.5
								obj.Box.Size = UDim2.new(0, scale, 0, h)
								obj.Box.Position = UDim2.new(0, sp.X - scale * 0.5, 0, sp.Y - h * 0.5)
								obj.Stroke.Color = col
								obj.Box.Visible = true
								if CFG.ESPNames then
									obj.Name.Text = plr.Name
									obj.Name.TextColor3 = col
									obj.Name.Position = UDim2.new(0, sp.X - 120, 0, sp.Y - h * 0.5 - 16)
									obj.Name.Visible = true
								else
									obj.Name.Visible = false
								end
								if CFG.ESPDistance then
									obj.Dist.Text = string.format("%dm", math.floor(mag))
									obj.Dist.TextColor3 = col
									obj.Dist.Position = UDim2.new(0, sp.X - 60, 0, sp.Y + h * 0.5 + 2)
									obj.Dist.Visible = true
								else
									obj.Dist.Visible = false
								end
								if CFG.ESPHealth then
									local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
									local bx = sp.X - scale * 0.5 - 6
									obj.HealthBg.Size = UDim2.new(0, 4, 0, h + 2)
									obj.HealthBg.Position = UDim2.new(0, bx - 1, 0, sp.Y - h * 0.5 - 1)
									obj.HealthBg.Visible = true
									local bh = h * pct
									obj.HealthBar.Size = UDim2.new(0, 4, 0, bh)
									obj.HealthBar.Position = UDim2.new(0, bx, 0, sp.Y + h * 0.5 - bh)
									obj.HealthBar.BackgroundColor3 = pct > 0.6 and Color3.fromRGB(0, 255, 0)
										or pct > 0.3 and Color3.fromRGB(255, 255, 0)
										or Color3.fromRGB(255, 0, 0)
									obj.HealthBar.Visible = true
								else
									obj.HealthBg.Visible = false
									obj.HealthBar.Visible = false
								end
							else
								hideEsp(obj)
							end
						end
					end
				end
			end
		end
	end

	for char, obj in pairs(EspPool.active) do
		if not still[char] or not char.Parent then
			releaseEsp(obj)
			EspPool.active[char] = nil
		end
	end
end)

-- Projectile ESP
local Projectiles = {}
local ProjVisuals = {}
local ProjPool = {}

local function releaseProj(frame)
	frame.Visible = false
	table.insert(ProjPool, frame)
end

local function acquireProj()
	local f = table.remove(ProjPool)
	if f then return f end
	f = Instance.new("Frame")
	f.BackgroundTransparency = 0.3
	f.BorderSizePixel = 0
	f.AnchorPoint = Vector2.new(0, 0.5)
	f.Visible = false
	f.Parent = EspGui
	return f
end

if Remotes then
	local combatFX = Remotes:FindFirstChild("CombatFX")
	if combatFX then
		combatFX.OnClientEvent:Connect(function(kind, data)
			if kind == "Projectile" and type(data) == "table" then
				if data.origin and data.velocity then
					table.insert(Projectiles, {
						origin = data.origin,
						velocity = data.velocity,
						shooter = data.shooter,
						kind = data.kind,
						spawnedAt = tick(),
						key = data.key,
					})
					if #Projectiles > 50 then table.remove(Projectiles, 1) end
				end
			elseif kind == "ProjectileHit" and type(data) == "table" and data.key then
				for i, p in ipairs(Projectiles) do
					if p.key == data.key then
						table.remove(Projectiles, i)
						break
					end
				end
			end
		end)
	end
end

RunService.RenderStepped:Connect(function()
	local now = tick()
	for i = #Projectiles, 1, -1 do
		if now - Projectiles[i].spawnedAt > 5 then
			table.remove(Projectiles, i)
		end
	end

	if not CFG.ESPProjectiles then
		for _, f in pairs(ProjVisuals) do
			releaseProj(f)
		end
		ProjVisuals = {}
		return
	end

	local keep = {}
	for i, proj in ipairs(Projectiles) do
		local age = now - proj.spawnedAt
		local pos = proj.origin + proj.velocity * age + Vector3.new(0, -27.5 * age * age, 0)
		local sp, onScreen = Camera:WorldToViewportPoint(pos)
		if onScreen and sp.Z > 0 then
			local frame = ProjVisuals[i]
			if not frame then
				frame = acquireProj()
				ProjVisuals[i] = frame
			end
			local tip = pos + proj.velocity * 0.05 + Vector3.new(0, -55 * age * 0.05, 0)
			local tipSp, tipOn = Camera:WorldToViewportPoint(tip)
			if tipOn then
				local dx = tipSp.X - sp.X
				local dy = tipSp.Y - sp.Y
				local len = math.sqrt(dx * dx + dy * dy)
				if len < 1 then len = 1 end
				local ang = math.deg(math.atan2(dy, dx))
				local enemy = false
				if proj.shooter and proj.shooter.Parent then
					local shooterPlr = Players:GetPlayerFromCharacter(proj.shooter)
					if shooterPlr then
						enemy = isEnemy(shooterPlr, CFG.ESPTeamCheck)
					end
				end
				frame.Size = UDim2.new(0, math.clamp(len, 20, 400), 0, 2)
				frame.Position = UDim2.new(0, sp.X, 0, sp.Y)
				frame.Rotation = ang
				frame.BackgroundColor3 = enemy and RED or VIOLET
				frame.Visible = true
				keep[i] = true
			end
		end
	end
	for i, f in pairs(ProjVisuals) do
		if not keep[i] then
			releaseProj(f)
			ProjVisuals[i] = nil
		end
	end
end)

