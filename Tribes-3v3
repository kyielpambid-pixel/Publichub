		"> Noclip disables collisions on your character.",
	})
	local s = section(PageMove, "SPEED")
	addToggle(s, "WalkSpeed", false, function(v)
		CFG.WalkSpeed = v
		local hum = getHum()
		if hum then hum.WalkSpeed = v and CFG.WSpeed or 16 end
	end)
	addSlider(s, "WalkSpeed Value", 16, 200, 30, function(v)
		CFG.WSpeed = v
		if CFG.WalkSpeed then
			local hum = getHum()
			if hum then hum.WalkSpeed = v end
		end
	end)
	addToggle(s, "JumpPower", false, function(v)
		CFG.JumpPower = v
		local hum = getHum()
		if hum then
			hum.UseJumpPower = true
			hum.JumpPower = v and CFG.JPower or 50
		end
	end)
	addSlider(s, "JumpPower Value", 50, 300, 60, function(v)
		CFG.JPower = v
		if CFG.JumpPower then
			local hum = getHum()
			if hum then
				hum.UseJumpPower = true
				hum.JumpPower = v
			end
		end
	end)
	local m = section(PageMove, "MOVEMENT")
	addToggle(m, "Infinite Jump", false, function(v) CFG.InfiniteJump = v end)
	addToggle(m, "Fly", false, function(v)
		CFG.Fly = v
		if not v then stopFly() end
	end)
	addSlider(m, "Fly Speed", 20, 200, 60, function(v) CFG.FlySpeed = v end)
	addToggle(m, "Noclip", false, function(v) CFG.Noclip = v end)
end

do
	tabMessages(PageMisc, {
		"<> Script made by KHUB · Kyiel Pambid",
		"<> Anti-AFK clicks every 60s while enabled.",
		"$ Server hop finds a less full public server.",
		"> Unload removes ESP / FOV helpers for this script.",
	})
	local s = section(PageMisc, "UTILITY")
	addToggle(s, "Anti-AFK", false, function(v) CFG.AntiAFK = v end)
	addButton(s, "Server Hop", function()
		local ok, data = pcall(function()
			return HttpService:JSONDecode(game:HttpGet(
				"https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
			))
		end)
		if not ok or not data or not data.data then
			notify("Server Hop", "Failed", false)
			return
		end
		for _, server in ipairs(data.data) do
			if server.playing < server.maxPlayers and server.id ~= game.JobId then
				TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
				return
			end
		end
		notify("Server Hop", "No server found", false)
	end)
	addButton(s, "Rejoin Server", function()
		TeleportService:Teleport(game.PlaceId, LocalPlayer)
	end)
	addButton(s, "Unload Script", function()
		CFG.AimLock = false
		CFG.ESPEnabled = false
		CFG.ESPProjectiles = false
		CFG.Fly = false
		CFG.Noclip = false
		stopFly()
		pcall(function() EspGui:Destroy() end)
		pcall(function() FovGui:Destroy() end)
		notify("Unload", "Tribes helpers removed", false)
	end, Color3.fromRGB(80, 30, 40))
end

