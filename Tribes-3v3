local function screenCenter()
	local vs = Camera.ViewportSize
	return Vector2.new(vs.X * 0.5, vs.Y * 0.5)
end

local function validAimTarget(plr, part, fov)
	if not plr or not plr.Character or not part then return false, math.huge end
	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false, math.huge end
	if isAlive(plr) == false then return false, math.huge end
	if CFG.AimLockWallCheck and not canSee(part) then return false, math.huge end
	local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
	if not onScreen or sp.Z <= 0 then return false, math.huge end
	local dist = (Vector2.new(sp.X, sp.Y) - screenCenter()).Magnitude
	if dist > fov then return false, math.huge end
	return true, dist
end

local function getBestTarget()
	local sticky = AimState.currentTarget
	if sticky and sticky.Parent then
		local plr = Players:GetPlayerFromCharacter(sticky)
		if plr and isEnemy(plr, CFG.AimLockTeamCheck) then
			local part = getAimPart(sticky)
			if validAimTarget(plr, part, CFG.AimLockFOV * 1.5) then
				return plr, part
			end
		end
		AimState.currentTarget = nil
	end

	local bestDist, bestPlr, bestPart = CFG.AimLockFOV, nil, nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and isEnemy(plr, CFG.AimLockTeamCheck) and plr.Character then
			local part = getAimPart(plr.Character)
			local ok, dist = validAimTarget(plr, part, CFG.AimLockFOV)
			if ok and dist < bestDist then
				bestDist, bestPlr, bestPart = dist, plr, part
			end
		end
	end
	if bestPlr then
		AimState.currentTarget = bestPlr.Character
	end
	return bestPlr, bestPart
end

RunService.RenderStepped:Connect(function()
	if not CFG.AimLock or not AimState.holdActive then return end
	local plr, part = getBestTarget()
	if not plr or not part then return end
	local camPos = Camera.CFrame.Position
	local dir = (part.Position - camPos).Unit
	local targetCF = CFrame.new(camPos, camPos + dir)
	local alpha = math.clamp(0.08 + (CFG.AimLockSmooth - 0.05) * 0.96842105263158, 0.08, 1)
	if Camera.CFrame.LookVector:Dot(dir) > 0.9995 then
		Camera.CFrame = targetCF
	else
		Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
	end
end)

