local function initRemotes()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
	if not remotes then return false end
	local gameplay = remotes:WaitForChild("Gameplay", 10)
	local extras = remotes:WaitForChild("Extras", 10)
	if not gameplay or not extras then return false end
	waitForChild = gameplay:WaitForChild("GetCurrentPlayerData", 10)
	waitForChild2 = extras:WaitForChild("GetChance", 10)
	return waitForChild ~= nil and waitForChild2 ~= nil
end

local function getPlayerGui()
	local pg = player:FindFirstChild("PlayerGui")
	if pg then return pg end
	local ok, res = pcall(function()
		return player:WaitForChild("PlayerGui", 10)
	end)
	if ok then return res end
	return nil
end

