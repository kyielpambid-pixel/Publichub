		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if locked then return end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	lockBtn.MouseButton1Click:Connect(function()
		locked = not locked
		lockBtn.Text = locked and "L" or "U"
		lockBtn.BackgroundColor3 = locked and Color3.fromRGB(40, 90, 55) or Color3.fromRGB(28, 32, 48)
		lockBtn.TextColor3 = locked and THEME.green or THEME.dim
	end)
	button.MouseButton1Click:Connect(function() if callback then callback() end end)
	-- when main button shown/hidden, sync lock
	button:GetPropertyChangedSignal("Visible"):Connect(function()
		lockBtn.Visible = button.Visible
	end)
	return button
end

