-- Floating KHUB icon
do
	local host = (type(gethui) == "function" and gethui()) or CoreGui
	pcall(function()
		local old = host:FindFirstChild("KHUB_MM2_Float")
		if old then old:Destroy() end
	end)

	task.spawn(function()
		for _ = 1, 25 do
			task.wait(0.1)
			for _, parent in ipairs({ host, CoreGui, LocalPlayer:FindFirstChild("PlayerGui") }) do
				if not parent then continue end
				for _, g in ipairs(parent:GetChildren()) do
					if g:IsA("ScreenGui") and g.Name ~= "KHUB_MM2_Float" then
						for _, d in ipairs(g:GetDescendants()) do
							if (d:IsA("TextLabel") or d:IsA("TextButton")) then
								local t = string.lower(tostring(d.Text or ""))
								if t:find("lua land") or t:find("lualand") then
									pcall(function() d.Text = "KHUB" end)
								end
							end
						end
					end
				end
			end
		end
	end)

	local floatGui = Instance.new("ScreenGui")
	floatGui.Name = "KHUB_MM2_Float"
	floatGui.ResetOnSpawn = false
	floatGui.IgnoreGuiInset = true
	floatGui.DisplayOrder = 99999
	pcall(function() floatGui.Parent = host end)
	if not floatGui.Parent then floatGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

	local OpenBtn = Instance.new("ImageButton")
	OpenBtn.Size = UDim2.fromOffset(58, 58)
	OpenBtn.Position = UDim2.new(0, 16, 0.45, 0)
	OpenBtn.BackgroundColor3 = Color3.fromRGB(18, 14, 10)
	OpenBtn.BorderSizePixel = 0
	OpenBtn.Image = LOGO_ID
	OpenBtn.ScaleType = Enum.ScaleType.Fit
	OpenBtn.Parent = floatGui
	Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 160, 40)
	stroke.Thickness = 2
	stroke.Parent = OpenBtn
	local nameTag = Instance.new("TextLabel")
	nameTag.Size = UDim2.new(0, 64, 0, 16)
	nameTag.Position = UDim2.new(0.5, -32, 1, 2)
	nameTag.BackgroundTransparency = 1
	nameTag.Text = "KHUB"
	nameTag.Font = Enum.Font.GothamBold
	nameTag.TextSize = 11
	nameTag.TextColor3 = Color3.fromRGB(255, 180, 60)
	nameTag.Parent = OpenBtn

	local function findLandMain()
		for _, parent in ipairs({ host, CoreGui, LocalPlayer:FindFirstChild("PlayerGui") }) do
			if parent then
				for _, g in ipairs(parent:GetChildren()) do
					if g:IsA("ScreenGui") and g.Name ~= "KHUB_MM2_Float" then
						local mf = g:FindFirstChild("MainFrame")
						if mf and mf:IsA("Frame") and mf.Size.X.Offset > 200 then
							return mf
						end
					end
				end
			end
		end
	end

	local dragMoved, btnDragging, btnStart, btnPos
	OpenBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			btnDragging = true
			dragMoved = false
			btnStart = input.Position
			btnPos = OpenBtn.Position
		end
	end)
	OpenBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			btnDragging = false
			if not dragMoved then
				local main = findLandMain()
				if main then main.Visible = not main.Visible end
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not btnDragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - btnStart
			if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then dragMoved = true end
			OpenBtn.Position = UDim2.new(btnPos.X.Scale, btnPos.X.Offset + d.X, btnPos.Y.Scale, btnPos.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.RightControl then
			local main = findLandMain()
			if main then main.Visible = not main.Visible end
		end
	end)
end

