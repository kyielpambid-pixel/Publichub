end

local function findMurderer(p)
	if not p or not p.Character then return false end
	local bp = p:FindFirstChild("Backpack")
	return p.Character:FindFirstChild("Knife") ~= nil or (bp and bp:FindFirstChild("Knife") ~= nil)
end
local function findSheriff(p)
	if not p or not p.Character then return false end
	local bp = p:FindFirstChild("Backpack")
	return p.Character:FindFirstChild("Gun") ~= nil or (bp and bp:FindFirstChild("Gun") ~= nil)
end
local function GetPredicted(part)
	if not part then return nil end
	return part.Position + part.AssemblyLinearVelocity * 0.12
end

local function ShootMurderer()
	if not findSheriff(LocalPlayer) then return end
	local murd = nil
	for plr in pairs(cachedPlayers) do
		if PlayersRole[plr] == "Murderer" or findMurderer(plr) then murd = plr break end
	end
	if not murd or not murd.Character then return end
	local gun = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")
	if not gun then
		local g = LocalPlayer.Backpack:FindFirstChild("Gun")
		if g then LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):EquipTool(g) gun = LocalPlayer.Character:FindFirstChild("Gun") end
	end
	if not gun then return end
	local mHRP = murd.Character:FindFirstChild("HumanoidRootPart")
	local rh = LocalPlayer.Character:FindFirstChild("RightHand") or LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if mHRP and rh then
		pcall(function()
			gun:WaitForChild("Shoot"):FireServer(CFrame.new(rh.Position), CFrame.new(GetPredicted(mHRP)))
		end)
	end
end

