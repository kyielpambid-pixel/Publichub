	for _, conns in pairs(AntiFlingCharConn) do
		for _, conn in pairs(conns) do conn:Disconnect() end
	end
	table.clear(AntiFlingCharConn)
	table.clear(partCache)
end

local function noclip()
	local function hookCharacter(character)
		table.clear(noclipParts)
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") then noclipParts[d] = true end
		end
		if NoclipConn.added then NoclipConn.added:Disconnect() end
		if NoclipConn.removing then NoclipConn.removing:Disconnect() end
		NoclipConn.added = character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then noclipParts[d] = true end
		end)
		NoclipConn.removing = character.DescendantRemoving:Connect(function(d) noclipParts[d] = nil end)
	end
	if LocalPlayer.Character then hookCharacter(LocalPlayer.Character) end
	NoclipConn.characterAdded = CharacterAdded:Connect(hookCharacter)
	NoclipConn.stepped = RunService.Stepped:Connect(function()
		for part in pairs(noclipParts) do part.CanCollide = false end
	end)
end

local function unnoclip()
	for _, conn in pairs(NoclipConn) do conn:Disconnect() end
	table.clear(NoclipConn)
	for part in pairs(noclipParts) do part.CanCollide = true end
	table.clear(noclipParts)
end

local function findNearestPlayer()
	local nearest, shortest = nil, math.huge
	for player in pairs(cachedPlayers) do
		if player ~= LocalPlayer and player.Character then
			local lrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local orp = player.Character:FindFirstChild("HumanoidRootPart")
			if lrp and orp then
				local dist = (lrp.Position - orp.Position).Magnitude
				if dist < shortest then shortest = dist nearest = player end
			end
		end
	end
	return nearest
end

local function knifeThrow(silent)
	if not findMurderer(LocalPlayer) then
		if not silent then notify("You're not murderer.", "lucide:x") end
		return
	end
	if not LocalPlayer.Character:FindFirstChild("Knife") then
		if LocalPlayer.Backpack:FindFirstChild("Knife") then
			LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):EquipTool(LocalPlayer.Backpack:FindFirstChild("Knife"))
		else
			if not silent then notify("You don't have the knife..?", "lucide:x") end
			return
		end
	end
	local target = findNearestPlayer()
	if not target or not target.Character then
		if not silent then notify("Can't find a player!?", "lucide:x") end
		return
	end
	local hrp = target.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if not silent then notify("Can't find player's HRP.", "lucide:x") end
		return
	end
	LocalPlayer.Character:WaitForChild("Knife"):WaitForChild("Events"):WaitForChild("KnifeThrown"):FireServer(
		CFrame.new(LocalPlayer.Character.RightHand.Position),
		CFrame.new(GetPredictedPosition(hrp))
	)
end

local wfConn = {}
local function walkfling(power)
	power = power or 100000
	for _, c in pairs(wfConn) do c:Disconnect() end
	table.clear(wfConn)
	local function applywf()
		if wfConn.wf then wfConn.wf:Disconnect() end
		wfConn.wf = RunService.Heartbeat:Connect(function()
			local char = LocalPlayer.Character
			local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
			if not root then return end
			local v = root.Velocity
			root.Velocity = v * power
			RunService.RenderStepped:Wait()
			root.Velocity = v
		end)
	end
	applywf()
	wfConn.respawn = CharacterAdded:Connect(function()
