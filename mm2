		if hum then hum.UseJumpPower = true; hum.JumpPower = v and jpValue or 50 end
	end)
	slider(MiscPage, "JumpPower Value", 50, 150, 75, function(v)
		jpValue = v
		if jpEnabled then local hum = GetHumanoid(); if hum then hum.UseJumpPower = true; hum.JumpPower = v end end
	end)

	card(MiscPage, "Visual & Performance")
	toggle(MiscPage, "FPS Boost", false, function(v)
		if v then
			Lighting.GlobalShadows = false
			Lighting.EnvironmentDiffuseScale = 0
			Lighting.EnvironmentSpecularScale = 0
		else
			Lighting.GlobalShadows = true
			Lighting.EnvironmentDiffuseScale = 1
			Lighting.EnvironmentSpecularScale = 1
		end
	end)
	toggle(MiscPage, "Remove Fog", false, function(v)
		if v then Lighting.FogEnd = 1000000 else Lighting.FogEnd = 100000 end
	end)
	toggle(MiscPage, "Fullbright", false, function(v)
		if v then
			Lighting.Brightness = 3
			Lighting.ClockTime = 14
			Lighting.GlobalShadows = false
			Lighting.Ambient = Color3.fromRGB(255, 255, 255)
			Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
		else
			Lighting.Brightness = 1
			Lighting.ClockTime = 14
			Lighting.GlobalShadows = true
			Lighting.Ambient = Color3.fromRGB(70, 70, 70)
			Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 70)
		end
	end)

	RunService.Heartbeat:Connect(function()
		if wsEnabled or jpEnabled then
			local hum = GetHumanoid()
			if hum then
				if wsEnabled and hum.WalkSpeed ~= wsValue then hum.WalkSpeed = wsValue end
				if jpEnabled then
					if not hum.UseJumpPower then hum.UseJumpPower = true end
					if hum.JumpPower ~= jpValue then hum.JumpPower = jpValue end
				end
			end
		end
	end)
end

