local function Fling(target)
	if not target or target == LocalPlayer then return end
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	local TCharacter = target.Character
	local THumanoid = TCharacter and TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart
	local THead = TCharacter and TCharacter:FindFirstChild("Head")
	if not (Character and Humanoid and RootPart and TCharacter) then return end
	local oldPos = RootPart.CFrame
	if THead then cam.CameraSubject = THead else cam.CameraSubject = THumanoid end
	local BV = Instance.new("BodyVelocity")
	BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
	BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)
	BV.Parent = RootPart
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
	local tpart = TRootPart or THead
	local t0 = tick()
	while tpart and tpart.Parent and tick() < t0 + 2 do
		RootPart.CFrame = CFrame.new(tpart.Position + Vector3.new(0, 1.5, 0))
		RootPart.Velocity = Vector3.new(9e7, 9e8, 9e7)
		task.wait()
	end
	BV:Destroy()
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	cam.CameraSubject = Humanoid
	RootPart.CFrame = oldPos
	RootPart.Velocity = Vector3.zero
end

local function knifeThrow()
	if not findMurderer(LocalPlayer) then return end
	local char = LocalPlayer.Character
	if not char then return end
	if not char:FindFirstChild("Knife") then
		local k = LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife")
		if k then char:FindFirstChildOfClass("Humanoid"):EquipTool(k) else return end
	end
	local nearest, nd = nil, math.huge
	local lHRP = char:FindFirstChild("HumanoidRootPart")
	if not lHRP then return end
	for plr in pairs(cachedPlayers) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local d = (plr.Character.HumanoidRootPart.Position - lHRP.Position).Magnitude
			if d < nd then nd = d nearest = plr end
		end
	end
	if nearest then
		pcall(function()
			char.Knife.Events.KnifeThrown:FireServer(
				CFrame.new((char:FindFirstChild("RightHand") or lHRP).Position),
				CFrame.new(GetPredicted(nearest.Character.HumanoidRootPart))
			)
		end)
	end
end

