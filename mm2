task.spawn(function()
	local wasUnderground = false
	while true do
		if coinFarmEnabled then
			local character = LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root or not Map then
				task.wait(0.25)
			else
				if not preFarmCFrame then preFarmCFrame = root.CFrame end
				local nearest, nearestDist = nil, 0
				local container = Map:FindFirstChild("CoinContainer")
				if container then
					local shortestDistSq = math.huge
					for _, coin in ipairs(container:GetChildren()) do
						if coin:IsA("BasePart") then
							local diff = root.Position - coin.Position
							local distSq = diff:Dot(diff)
							if distSq < 90000 and distSq < shortestDistSq then
								shortestDistSq = distSq
								nearestDist = diff.Magnitude
								nearest = coin
							end
						end
					end
				end
				if nearest then
					wasUnderground = true
					local targetCFrame = nearest.CFrame * CFrame.new(0, -6.5, 0)
					root.AssemblyLinearVelocity = Vector3.zero
					root.Anchored = true
					if currentCoinTween then currentCoinTween:Cancel() end
					currentCoinTween = TweenService:Create(root, TweenInfo.new(math.max(nearestDist / 30, 0.05), Enum.EasingStyle.Linear), { CFrame = targetCFrame })
					currentCoinTween:Play()
					currentCoinTween.Completed:Wait()
					root.Anchored = false
					root.CFrame = nearest.CFrame
					task.wait(0.4)
					root.Anchored = true
					if nearest and nearest.Parent then nearest:Destroy() end
					root.CFrame = targetCFrame
				else
					root.AssemblyLinearVelocity = Vector3.zero
					if not wasUnderground then
						root.CFrame = root.CFrame * CFrame.new(0, -6.5, 0)
						wasUnderground = true
					end
					root.Anchored = true
					task.wait(0.25)
				end
			end
		else
			if wasUnderground then
				local character = LocalPlayer.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root then
					root.Anchored = false
					if preFarmCFrame then root.CFrame = preFarmCFrame else root.CFrame = root.CFrame * CFrame.new(0, 7.5, 0) end
					root.AssemblyLinearVelocity = Vector3.zero
				end
				wasUnderground = false
				preFarmCFrame = nil
			end
			task.wait(0.5)
		end
	end
end)

