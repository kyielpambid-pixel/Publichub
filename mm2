local function removeESP(inst)
	local o = espObjects[inst]
	if o then
		if o.highlight then o.highlight:Destroy() end
		if o.billboard then o.billboard:Destroy() end
		espObjects[inst] = nil
	end
end

local function applyESP(inst, color, labelText, adornee)
	if hideMyOwn and inst == LocalPlayer.Character then return end
	removeESP(inst)
	local hl = Instance.new("Highlight")
	hl.Adornee = inst
	hl.FillColor = color
	hl.OutlineColor = color
	hl.FillTransparency = 0.65
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espFolder
	local bb = nil
	if labelText then
		local part = adornee or inst:FindFirstChild("Head") or inst:FindFirstChild("HumanoidRootPart")
		if part then
			bb = Instance.new("BillboardGui")
			bb.Adornee = part
			bb.AlwaysOnTop = true
			bb.Size = UDim2.new(0, 80, 0, 24)
			bb.StudsOffset = Vector3.new(0, 2.5, 0)
			bb.Parent = espFolder
			local t = Instance.new("TextLabel")
			t.Size = UDim2.new(1,0,1,0)
			t.BackgroundTransparency = 1
			t.Text = labelText
			t.TextColor3 = color
			t.Font = Enum.Font.GothamBold
			t.TextScaled = true
			t.Parent = bb
		end
	end
	espObjects[inst] = { highlight = hl, billboard = bb }
end

local function clearAllESP()
	for _, c in ipairs(espFolder:GetChildren()) do c:Destroy() end
