local function addTab(name, iconType, order)
	local b = Instance.new("TextButton")
	b.Name = "Tab_" .. name
	b.Size = UDim2.new(1, 0, 0, 36)
	b.BackgroundColor3 = Color3.fromRGB(36, 24, 55)
	b.Text = ""
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.ZIndex = 50
	b.AutoButtonColor = true
	b.LayoutOrder = order or 10
	b.Parent = Rail
	corner(b, 7)
	mkstroke(b, THEME.accent, 1.2, 0.55)

	local iconHolder = Instance.new("Frame")
	iconHolder.Size = UDim2.fromOffset(24, 24)
	iconHolder.Position = UDim2.fromOffset(8, 6)
	iconHolder.BackgroundTransparency = 1
	iconHolder.ZIndex = 51
	iconHolder.Parent = b
	makeIcon(iconHolder, iconType, 24)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -44, 1, 0)
	lbl.Position = UDim2.fromOffset(38, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = name
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 14
	lbl.TextColor3 = THEME.dim
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 51
	lbl.Parent = b

	tabs[name] = { button = b, label = lbl, icon = iconHolder }
	local p = makePage()
	pages[name] = p

	b.MouseButton1Click:Connect(function()
		for n, data in pairs(tabs) do
			data.button.BackgroundColor3 = Color3.fromRGB(36, 24, 55)
			data.label.TextColor3 = THEME.dim
		end
		b.BackgroundColor3 = Color3.fromRGB(55, 35, 90)
		lbl.TextColor3 = THEME.gold
		for n, pg in pairs(pages) do
			pg.Visible = (n == name)
		end
		HeadTitle.Text = name
	end)

	return p
end

