local function Fling(playerToFling)
	if not playerToFling or playerToFling == LocalPlayer then
		notify("Invalid fling target.", "lucide:user-x")
		return
	end
	local Character = LocalPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	local TCharacter = playerToFling.Character
	local THumanoid = TCharacter and TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart
	local THead = TCharacter and TCharacter:FindFirstChild("Head")
	if not (Character and Humanoid and RootPart and TCharacter) then
		notify("Character not ready.", "lucide:x")
		return
	end
	local oldPos = RootPart.CFrame
	if THead then cam.CameraSubject = THead else cam.CameraSubject = THumanoid end
	local BV = Instance.new("BodyVelocity")
	BV.Name = "EpixVel"
	BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
	BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)
	BV.Parent = RootPart
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
	local target = TRootPart or THead
	local t0 = tick()
	while target and target.Parent and tick() < t0 + 2 do
		RootPart.CFrame = CFrame.new(target.Position + Vector3.new(0, 1.5, 0))
		RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
		RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
		task.wait()
	end
	BV:Destroy()
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	cam.CameraSubject = Humanoid
	RootPart.CFrame = oldPos
	RootPart.Velocity = Vector3.zero
end

