local function Notify(title, content)
	print("[KHUB MM2]", title, content or "")
end

local function getRoles()
	local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	if not remote then return {} end
	local ok, data = pcall(function() return remote:InvokeServer() end)
	if not ok or type(data) ~= "table" then return {} end
	local roles = {}
	for plr, plrData in pairs(data) do
		if type(plrData) == "table" and not plrData.Dead then
			roles[plr] = plrData.Role
		end
	end
	return roles
end

local function getMurdererTarget()
	local dataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	if not dataRemote then return nil, false end
	local ok, data = pcall(function() return dataRemote:InvokeServer() end)
	if not ok or type(data) ~= "table" then return nil, false end
	for plr, plrData in pairs(data) do
		if type(plrData) == "table" and plrData.Role == "Murderer" then
			local player = Players:FindFirstChild(plr)
			if player then
				if player == LocalPlayer then return nil, true end
				local char = player.Character
				if char then
					local hrp = char:FindFirstChild("HumanoidRootPart")
					if hrp then return hrp.Position, false end
					local head = char:FindFirstChild("Head")
					if head then return head.Position, false end
				end
			end
		end
	end
	return nil, false
end


local function getGunRemote(char)
	if not char then return nil end
	local gun = char:FindFirstChild("Gun")
	if not gun then return nil end
	-- path variants used by MM2
	local r = gun:FindFirstChild("KnifeLocal")
	r = r and r:FindFirstChild("CreateBeam")
	r = r and r:FindFirstChild("RemoteFunction")
	if r then return r end
	r = gun:FindFirstChild("KnifeServer")
	r = r and r:FindFirstChild("ShootGun")
	if r then return r end
	r = gun:FindFirstChild("ShootGun", true)
	return r
end

local function shootMurdererNow()
	if not Char then return false, "no character" end
	local gun = Char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
	if not gun then return false, "no gun — grab gun first" end
	if gun.Parent == backpack then
		pcall(function() Hum:EquipTool(gun) end)
		task.wait(0.15)
		gun = Char:FindFirstChild("Gun")
	end
	if not gun then return false, "equip failed" end
	local pos, isSelf = getMurdererTarget()
	if isSelf then return false, "you are murderer" end
	if not pos then return false, "murderer not found" end
	local remote = getGunRemote(Char)
	if not remote then return false, "gun remote missing" end
	local ok, err = pcall(function()
		if remote:IsA("RemoteFunction") then
			remote:InvokeServer(1, pos, "AH2")
		else
			remote:FireServer(1, pos, "AH2")
		end
	end)
	if not ok then
		pcall(function() remote:InvokeServer(1, pos, "AH") end)
	end
	return true
end

local function equipKnife()
	if not Char or not Hum then return nil end
	local knife = Char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
	if not knife then return nil end
	if knife.Parent ~= Char then
		pcall(function() Hum:EquipTool(knife) end)
		task.wait(0.1)
		knife = Char:FindFirstChild("Knife")
	end
	return knife
end

local function stabRemote(knife)
	if not knife then return end
	local stab = knife:FindFirstChild("Stab") or knife:FindFirstChild("Slash") or knife:FindFirstChildWhichIsA("RemoteEvent", true)
	if stab and stab:IsA("RemoteEvent") then
		pcall(function() stab:FireServer("Slash") end)
		pcall(function() stab:FireServer("Stab") end)
		pcall(function() stab:FireServer() end)
	end
	-- also try gameplay remotes if present
	local rs = ReplicatedStorage:FindFirstChild("Remotes")
	rs = rs and rs:FindFirstChild("Gameplay")
	if rs then
		local kh = rs:FindFirstChild("KnifeHit")
		if kh then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and plr.Character then
					local hum = plr.Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						pcall(function() kh:FireServer(hum) end)
					end
				end
			end
		end
	end
end

local function KillAllMurderer()
	local roles = getRoles()
	local myRole = roles[LocalPlayer.Name]
	-- also detect by knife
	local hasKnife = (Char and Char:FindFirstChild("Knife")) or (backpack and backpack:FindFirstChild("Knife"))
	if myRole and myRole ~= "Murderer" and not hasKnife then
		Notify("Kill All", "Murderer only (need Knife)")
		return
	end
	local knife = equipKnife()
	if not knife and not hasKnife then
		Notify("Kill All", "No Knife equipped")
		return
	end
	knife = equipKnife() or Char:FindFirstChild("Knife")
	local old = Root and Root.CFrame
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local th = plr.Character:FindFirstChildOfClass("Humanoid")
			local tr = plr.Character:FindFirstChild("HumanoidRootPart")
			if th and th.Health > 0 and tr and Root then
				pcall(function()
					Root.CFrame = tr.CFrame * CFrame.new(0, 0, 2)
				end)
				task.wait(0.08)
				stabRemote(knife or Char:FindFirstChild("Knife"))
				-- activate tool
				pcall(function()
					local k = Char:FindFirstChild("Knife")
					if k then k:Activate() end
				end)
				task.wait(0.12)
			end
		end
	end
	if old and Root then
		pcall(function() Root.CFrame = old end)
	end
	Notify("Kill All", "Done")
end

local function isLocalMurderer()
	local roles = getRoles()
	if roles[LocalPlayer.Name] == "Murderer" then return true end
	if Char and Char:FindFirstChild("Knife") then return true end
	if backpack and backpack:FindFirstChild("Knife") then return true end
	return false
end

local function SHubFling(TargetPlayer)
	if not (Char and Hum and Root) then return end
	local TCharacter = TargetPlayer.Character
	if not TCharacter then return end
	local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart
	local THead = TCharacter:FindFirstChild("Head")
	local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
	local Handle = Accessory and Accessory:FindFirstChild("Handle")
	env.OldPos = Root.CFrame
	repeat task.wait()
		Workspace.CurrentCamera.CameraSubject = THead or Handle or THumanoid
	until Workspace.CurrentCamera.CameraSubject == THead or Handle or THumanoid
	local function FPos(BasePart, Pos, Ang)
		local targetCF = CFrame.new(BasePart.Position) * Pos * Ang
		Root.CFrame = targetCF
		pcall(function() Char:SetPrimaryPartCFrame(targetCF) end)
		Root.Velocity = Vector3.new(9e7, 9e8, 9e7)
		Root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
	end
	local function SFBasePart(BasePart)
		local start = tick()
		local angle = 0
		env.timeout = env.timeout or 2.5
		repeat
			if Root and THumanoid then
				angle += 100
				for _, offset in ipairs({
					CFrame.new(0, 1.5, 0),
					CFrame.new(0, -1.5, 0),
					CFrame.new(2.25, 1.5, -2.25),
					CFrame.new(-2.25, -1.5, 2.25),
				}) do
					FPos(BasePart, offset + THumanoid.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
					task.wait()
				end
			end
		until BasePart.Velocity.Magnitude > 500 or tick() - start > env.timeout
	end
	local BV = Instance.new("BodyVelocity")
	BV.Name = "KHUB_FlingVel"
	BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
	BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	BV.Parent = Root
	Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
	local target = TRootPart or THead or Handle
	if target then SFBasePart(target) end
	BV:Destroy()
	Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	repeat task.wait()
		Workspace.CurrentCamera.CameraSubject = Hum
	until Workspace.CurrentCamera.CameraSubject == Hum
	repeat
		local cf = env.OldPos * CFrame.new(0, 0.5, 0)
		Root.CFrame = cf
		pcall(function() Char:SetPrimaryPartCFrame(cf) end)
		Hum:ChangeState("GettingUp")
		for _, part in ipairs(Char:GetChildren()) do
			if part:IsA("BasePart") then
				part.Velocity, part.RotVelocity = Vector3.zero, Vector3.zero
			end
		end
		task.wait()
	until (Root.Position - env.OldPos.Position).Magnitude < 25
end

-- Gun aimbot hook
local isUseHook = false
do
	if getnamecallmethod and checkcaller then
		local success = false
		local hookFunc
		local function handleNamecall(self, ...)
			local method = getnamecallmethod and getnamecallmethod()
			if not checkcaller() then
				if method == "InvokeServer" and tostring(self) == "RemoteFunction" and env.enabledGunBot then
					return nil
				end
			end
			return hookFunc(self, ...)
		end
		if hookmetamethod and newcclosure then
			hookFunc = hookmetamethod(game, "__namecall", newcclosure(handleNamecall))
			success = true
		end
		isUseHook = success
	end
end

