local function noclip()
	local function hook(character)
		table.clear(noclipParts)
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") then noclipParts[d] = true end
		end
	end
	if LocalPlayer.Character then hook(LocalPlayer.Character) end
	NoclipConn.ca = LocalPlayer.CharacterAdded:Connect(hook)
	NoclipConn.st = RunService.Stepped:Connect(function()
		for part in pairs(noclipParts) do part.CanCollide = false end
	end)
end
local function unnoclip()
	for _, c in pairs(NoclipConn) do c:Disconnect() end
	table.clear(NoclipConn)
	for part in pairs(noclipParts) do part.CanCollide = true end
	table.clear(noclipParts)
end

