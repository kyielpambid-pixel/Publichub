-- Walkspeed / jump / noclip
RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		if walkSpeedOn then hum.WalkSpeed = walkSpeedValue end
		if jumpPowerOn then hum.UseJumpPower = true hum.JumpPower = jumpPowerValue end
	end
	if noclipOn then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end
	if killAuraOn and findMurderer(LocalPlayer) then
		local lHRP = char:FindFirstChild("HumanoidRootPart")
		local knife = char:FindFirstChild("Knife")
		if lHRP and knife then
			for plr in pairs(cachedPlayers) do
				if plr ~= LocalPlayer and plr.Character then
					local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
					if hrp and (hrp.Position - lHRP.Position).Magnitude < 7 then
						pcall(function()
							hrp.CFrame = lHRP.CFrame + lHRP.CFrame.LookVector * 2
							knife.Stab:FireServer("Slash")
						end)
						break
					end
				end
			end
		end
	end
end)

