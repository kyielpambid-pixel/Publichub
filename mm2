						if bp and bp:FindFirstChild("Knife") then
							pcall(function() char:FindFirstChildOfClass("Humanoid"):EquipTool(bp.Knife) end)
							knife = char:FindFirstChild("Knife")
						end
					end
					if lHRP and knife then
