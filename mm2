local function handleRoleData(data)
	for username, info in pairs(data) do
		local player = Players:FindFirstChild(username)
		if player and info.Role then
			PlayersRole[player] = info.Role
			if espEnabled and player.Character then
				local config = ESPConfig[info.Role]
				if config then applyESP(player.Character, config.color, config.label) end
			end
		end
	end
end

local function findMurderer(player)
	if not player or not player.Character then return false end
	local character = player.Character
	local backpack = player:FindFirstChild("Backpack")
	return character:FindFirstChild("Knife") ~= nil or (backpack and backpack:FindFirstChild("Knife") ~= nil)
end

local function findSheriff(player)
	if not player or not player.Character then return false end
	local character = player.Character
	local backpack = player:FindFirstChild("Backpack")
	return character:FindFirstChild("Gun") ~= nil or (backpack and backpack:FindFirstChild("Gun") ~= nil)
end

local function GetPredictedPosition(TargetPart)
	if not TargetPart then return nil end
	return TargetPart.Position + (TargetPart.AssemblyLinearVelocity * 0.12)
end

local function ShootMurderer()
	if not findSheriff(LocalPlayer) then notify("You're not sheriff/hero.", "lucide:x") return end
	local murderer = nil
	for player in pairs(cachedPlayers) do
		if PlayersRole[player] == "Murderer" then murderer = player break end
	end
	if not murderer then
		for player in pairs(cachedPlayers) do
			if findMurderer(player) then murderer = player break end
		end
	end
	if not murderer then notify("No murderer to shoot.", "lucide:x") return end
	if not LocalPlayer.Character:FindFirstChild("Gun") then
		if LocalPlayer.Backpack:FindFirstChild("Gun") then
			LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):EquipTool(LocalPlayer.Backpack:FindFirstChild("Gun"))
		else
			notify("You don't have the gun..?", "lucide:x") return
		end
	end
	local mHRP = murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart")
	if not mHRP then notify("Can't find murderer's HRP.", "lucide:x") return end
	LocalPlayer.Character:WaitForChild("Gun"):WaitForChild("Shoot"):FireServer(
		CFrame.new(LocalPlayer.Character.RightHand.Position),
		CFrame.new(GetPredictedPosition(mHRP))
	)
end

