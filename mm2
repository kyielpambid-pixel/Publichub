local ESP = {
	enabled = false, mode = "Highlight", box = true, name = true, role = true,
	distance = true, tracer = false, murderer = true, sheriff = true, innocent = true,
	maxDistance = 1000, tracerOrigin = "Bottom", fillTransparency = 0.72,
	outlineTransparency = 0, thickness = 2, textSize = 13,
}
local espCache = {}

local function getESPData(plr)
	if not espCache[plr] then espCache[plr] = {} end
	return espCache[plr]
end

local function clearESP(plr)
	local data = espCache[plr]
	if not data then return end
	if data.highlight then pcall(function() data.highlight:Destroy() end) end
	espCache[plr] = nil
end

local function shouldRenderRole(role)
	local r = role
	if r == "Murderer" then return ESP.murderer
	elseif r == "Sheriff" or r == "Hero" then return ESP.sheriff
	elseif r == "Innocent" then return ESP.innocent end
	return false
end

local function getRoleColor(role)
	return ROLE_COLORS[role] or THEME.innocent
end

local function renderESP()
	if not ESP.enabled then
		for plr in pairs(espCache) do clearESP(plr) end
		return
	end
	RefreshRoles()
	local myHRP = GetHRP()
	local myPos = myHRP and myHRP.Position or Vector3.zero
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local data = getESPData(plr)
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local role = GetRole(plr)
			local dist = hrp and (hrp.Position - myPos).Magnitude or 99999
			local visible = char and hum and hum.Health > 0 and shouldRenderRole(role) and dist <= ESP.maxDistance
			if visible then
				if ESP.mode == "Highlight" or ESP.mode == "Both" then
					if not data.highlight or data.highlight.Parent ~= char then
						if data.highlight then pcall(function() data.highlight:Destroy() end) end
						local hl = Instance.new("Highlight")
						hl.Name = "KHUB_ESP"
						hl.Adornee = char
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillTransparency = ESP.fillTransparency
						hl.OutlineTransparency = ESP.outlineTransparency
						hl.Parent = char
						data.highlight = hl
					end
					data.highlight.FillColor = getRoleColor(role)
					data.highlight.OutlineColor = getRoleColor(role)
					data.highlight.Enabled = true
				elseif data.highlight then
					data.highlight.Enabled = false
				end
			else
				if data.highlight then data.highlight.Enabled = false end
			end
		end
	end
end

