	lockBtn.Position = UDim2.new(1, -36, 0.5, -18)
	lockBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 58)
	lockBtn.Text = "O"
	lockBtn.TextColor3 = Color3.fromRGB(160, 255, 180)
	lockBtn.Font = Enum.Font.GothamBold
	lockBtn.TextSize = 15
	lockBtn.Visible = false
	lockBtn.Parent = root
	Instance.new("UICorner", lockBtn).CornerRadius = UDim.new(1, 0)
	local lockStroke = Instance.new("UIStroke", lockBtn)
	lockStroke.Color = Color3.fromRGB(120, 255, 160)
	lockStroke.Thickness = 1.5

	local locked = false
	local dragging, dragStart, startPos

	local function setLocked(v)
		locked = v
		lockBtn.Text = locked and "X" or "O"
		lockBtn.BackgroundColor3 = locked and Color3.fromRGB(90, 28, 40) or Color3.fromRGB(35, 40, 58)
		lockStroke.Color = locked and Color3.fromRGB(255, 120, 140) or Color3.fromRGB(120, 255, 160)
		button.Text = locked and (text .. " LOCK") or text
	end

	lockBtn.Activated:Connect(function()
		setLocked(not locked)
	end)

	button.InputBegan:Connect(function(input)
		if locked then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if locked then return end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	button.Activated:Connect(function()
		if callback then callback() end
	end)

	local proxy = {}
	setmetatable(proxy, {
		__index = function(_, k)
			if k == "Visible" then return button.Visible end
			return button[k]
		end,
		__newindex = function(_, k, v)
			if k == "Visible" then
				button.Visible = v
				lockBtn.Visible = v
			else
				pcall(function() button[k] = v end)
			end
		end,
	})
	return proxy
end

local function antifling()
	local function hookCharacter(player, character)
		local parts = {}
		partCache[player] = parts
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") then parts[d] = true end
		end
		local c = AntiFlingCharConn[player]
		c.added = character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then parts[d] = true end
		end)
		c.removing = character.DescendantRemoving:Connect(function(d) parts[d] = nil end)
	end
	local function hookPlayer(player)
		if player == LocalPlayer then return end
		AntiFlingCharConn[player] = AntiFlingCharConn[player] or {}
		if player.Character then hookCharacter(player, player.Character) end
		AntiFlingCharConn[player].characterAdded = player.CharacterAdded:Connect(function(character)
			local c = AntiFlingCharConn[player]
			if c.added then c.added:Disconnect() end
			if c.removing then c.removing:Disconnect() end
			hookCharacter(player, character)
		end)
	end
	local function unhookPlayer(player)
		if AntiFlingCharConn[player] then
			for _, conn in pairs(AntiFlingCharConn[player]) do conn:Disconnect() end
			AntiFlingCharConn[player] = nil
		end
		partCache[player] = nil
	end
	for player in pairs(cachedPlayers) do hookPlayer(player) end
	AntiFlingConn.stepped = RunService.Stepped:Connect(function()
		for _, parts in pairs(partCache) do
			for part in pairs(parts) do part.CanCollide = false end
		end
	end)
	AntiFlingConn.playerAdded = PlayerAdded:Connect(hookPlayer)
	AntiFlingConn.playerRemoving = PlayerRemoving:Connect(unhookPlayer)
end

local function unantifling()
	for _, conn in pairs(AntiFlingConn) do conn:Disconnect() end
