local function GetRole(plr)
	plr = plr or player
	if not plr or not plr.Parent then return "Unknown" end
	return roleCache[plr.Name] or roleCache[tostring(plr.UserId)] or "Unknown"
end

local function RefreshRoles()
	local now = os.clock()
	if now - roleCacheTime < 3 then return end
	roleCacheTime = now
	if waitForChild then
		local ok, data = pcall(function() return waitForChild:InvokeServer() end)
		if ok and typeof(data) == "table" then
			roleCache = {}
			for key, value in pairs(data) do
				if typeof(value) == "table" then
					local role = value.Role or value.role
					if role then roleCache[tostring(key)] = tostring(role) end
				end
			end
		end
	end
end

