local function getChar()
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	return root, hum, char
end

local function isAlive()
	local root, hum = getChar()
	return root and hum and hum.Health > 0
end

local function getEquippedGlove()
	local _, _, char = getChar()
	if char then
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then return tool end
	end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp then
		return bp:FindFirstChildOfClass("Tool")
	end
	return nil
end

local function getGloveName(plr)
	if not plr or not plr.Character then return "None" end
	local tool = plr.Character:FindFirstChildOfClass("Tool")
	if tool then return tool.Name end
	local ls = plr:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Glove") then
		return tostring(ls.Glove.Value)
	end
	return "Default"
end

local function isReverseActive(plr)
	if not plr or not plr.Character then return false end
	local char = plr.Character
	if char:FindFirstChild("Reverse") or char:FindFirstChild("Defense") then
		return true
	end
	for _, child in pairs(char:GetChildren()) do
		if child:IsA("Highlight") and child.FillColor == Color3.fromRGB(255, 0, 0) then
			return true
		end
		if child:IsA("ParticleEmitter") and string.find(string.lower(child.Name), "reverse") then
			return true
		end
	end
	return false
end

local function UpdateCharacterSpeed()
	pcall(function()
		if isAlive() then
			local _, hum = getChar()
			if hum then
				hum.WalkSpeed = Config.WalkSpeedBoost and CustomSpeedValue or 16
			end
		end
	end)
end

local function UpdateCharacterJump()
	pcall(function()
		if isAlive() then
			local _, hum = getChar()
			if hum then
				hum.UseJumpPower = true
				hum.JumpPower = Config.JumpPowerBoost and CustomJumpPower or 50
			end
		end
	end)
end

