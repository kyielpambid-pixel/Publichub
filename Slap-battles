	b.TextXAlignment = Enum.TextXAlignment.Left
	b.ZIndex = 50
	b.LayoutOrder = order or 10
	b.Parent = Rail
	corner(b, 8)
	mkstroke(b, THEME.accent, 1.2, 0.5)
	tabs[name] = b
