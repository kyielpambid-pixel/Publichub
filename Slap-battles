local uiScale = Instance.new("UIScale")
uiScale.Parent = Win
local function applyAutoScale()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local vs = cam.ViewportSize
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local base = math.min(vs.X / 960, vs.Y / 720)
	if touch or vs.X < 700 then
		uiScale.Scale = math.clamp(base * 0.92, 0.55, 0.95)
	else
		uiScale.Scale = math.clamp(base, 0.75, 1.08)
	end
end
applyAutoScale()
pcall(function()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyAutoScale)
	end
end)

