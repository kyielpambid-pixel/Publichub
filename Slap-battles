local function go(name)
	for n, p in pairs(pages) do
		p.Visible = (n == name)
	end
	HeadTitle.Text = name
	for n, b in pairs(tabs) do
		if n == name then
			b.BackgroundColor3 = Color3.fromRGB(55, 35, 90)
			b.TextColor3 = THEME.gold
		else
			b.BackgroundColor3 = Color3.fromRGB(36, 24, 55)
			b.TextColor3 = THEME.dim
		end
	end
end

