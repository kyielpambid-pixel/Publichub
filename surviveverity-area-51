local function getBestTarget(roamingFolder)
    local bestBoss = nil
    local bestRegular = nil

    for _, verity in ipairs(roamingFolder:GetChildren()) do
        if not isVerityDead(verity) then
            local part = getVerityTorso(verity)
            if part then
                if priorityBossesEnabled and bossNames[verity.Name] then
                    bestBoss = verity
                    break
                elseif not bestRegular then
                    bestRegular = verity
                end
            end
        end
    end

    if priorityBossesEnabled and bestBoss then
        return bestBoss
    end
    return bestBoss or bestRegular
end

task.spawn(function()
    local currentTarget = nil
    local farmStartTime = 0

    while true do
        task.wait()
        local char = localPlayer and localPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if not char or not humanoid or humanoid.Health <= 0 then
            currentTarget = nil
            farmStartTime = 0
        else
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            local roamingFolder = workspace:FindFirstChild("RoamingVerities")

            if rootPart and roamingFolder then
                if autoApplyModsEnabled then
                    applyAllGunMods()
                end

                if autoFarmEnabled and not orbitAutoFarmEnabled then
                    if farmStartTime == 0 then
                        farmStartTime = tick()
                    end

                    local targetValid = false
                    if currentTarget and currentTarget.Parent == roamingFolder and not isVerityDead(currentTarget) then
                        if not priorityBossesEnabled or bossNames[currentTarget.Name] then
                            targetValid = true
                        else
                            local betterChoice = getBestTarget(roamingFolder)
                            if betterChoice == currentTarget then
                                targetValid = true
                            end
                        end
                    end

                    if not targetValid then
                        currentTarget = getBestTarget(roamingFolder)
                        farmStartTime = tick()
                    end

                    if currentTarget then
                        local torso = getVerityTorso(currentTarget)
                        if torso then
                            local targetPos = torso.Position + Vector3.new(0, normalFarmHeight, normalFarmDistance)
                            rootPart.CFrame = CFrame.new(targetPos, torso.Position)

                            if camera then
                                camera.CFrame = CFrame.new(camera.CFrame.Position, torso.Position)
                            end

                            if normalFarmClickerEnabled and (tick() - farmStartTime >= 1.5) then
                                spoofClickAndFire(currentTarget)
                            end
                        end
                    end
                else
                    currentTarget = nil
                    farmStartTime = 0
                end
            end
        end
    end
end)

task.spawn(function()
    local currentTarget = nil
    local angle = 0
    local orbitStartTime = 0

    while true do
        task.wait()
        local char = localPlayer and localPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if not char or not humanoid or humanoid.Health <= 0 then
            currentTarget = nil
            orbitStartTime = 0
        else
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            local roamingFolder = workspace:FindFirstChild("RoamingVerities")

            if rootPart and roamingFolder then
                if orbitAutoFarmEnabled and not autoFarmEnabled then
                    if orbitStartTime == 0 then
                        orbitStartTime = tick()
                    end

                    local targetValid = false
                    if currentTarget and currentTarget.Parent == roamingFolder and not isVerityDead(currentTarget) then
                        if not priorityBossesEnabled or bossNames[currentTarget.Name] then
                            targetValid = true
                        else
                            local betterChoice = getBestTarget(roamingFolder)
                            if betterChoice == currentTarget then
                                targetValid = true
                            end
                        end
                    end

                    if not targetValid then
                        currentTarget = getBestTarget(roamingFolder)
                        orbitStartTime = tick()
                    end

                    if currentTarget then
                        local torso = getVerityTorso(currentTarget)
                        if torso then
                            angle = angle + (orbitSpeed * 0.05)
                            local orbitPos = torso.Position + Vector3.new(math.cos(angle) * orbitRadius, 0, math.sin(angle) * orbitRadius)

                            rootPart.CFrame = CFrame.new(orbitPos, torso.Position)
                            if camera then
                                camera.CFrame = CFrame.new(camera.CFrame.Position, torso.Position)
                            end

                            if orbitFarmClickerEnabled and (tick() - orbitStartTime >= 1.5) then
                                spoofClickAndFire(currentTarget)
                            end
                        end
                    end
                else
                    currentTarget = nil
                    orbitStartTime = 0
                end
            end
        end
    end
end)

runService.RenderStepped:Connect(function()
    local roamingFolder = workspace:FindFirstChild("RoamingVerities")
    if not roamingFolder or not camera then return end

    local mouseLoc = userInputService:GetMouseLocation()
    local bestTriggerTarget = nil
    local shortestDist = triggerBotRadius

    for _, verity in ipairs(roamingFolder:GetChildren()) do
        local isDead = isVerityDead(verity)
        local torso = getVerityTorso(verity)
        local isBoss = bossNames[verity.Name] == true

        local highlight = verity:FindFirstChild("VerityHighlight")
        if chamsEnabled and not isDead then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "VerityHighlight"
                highlight.Adornee = verity
                highlight.FillColor = isBoss and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 255)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Parent = verity
            end
        elseif highlight then
            highlight:Destroy()
        end

        local billboard = verity:FindFirstChild("VerityESP")
        if espEnabled and torso and not isDead then
            if not billboard then
                billboard = Instance.new("BillboardGui")
                billboard.Name = "VerityESP"
                billboard.Size = UDim2.new(0, 100, 0, 40)
                billboard.AlwaysOnTop = true
                billboard.Adornee = torso

                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.TextColor3 = isBoss and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 255, 255)
                textLabel.TextStrokeTransparency = 0
                textLabel.TextSize = 14
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.Text = verity.Name
                textLabel.TextScaled = true
                textLabel.Parent = billboard

                billboard.Parent = verity
            end
        elseif billboard then
            billboard:Destroy()
        end

        if hitboxExpanderEnabled and torso and not isDead then
            torso.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            torso.Transparency = hitboxTransparency
            torso.CanCollide = false
        end

        if triggerBotEnabled and not isDead then
            local checkPart = torso or verity.PrimaryPart
            if checkPart then
                local screenPos, onScreen = camera:WorldToScreenPoint(checkPart.Position)
                if onScreen then
                    local dx = screenPos.X - mouseLoc.X
                    local dy = screenPos.Y - mouseLoc.Y
                    local dist = math.sqrt(dx * dx + dy * dy)
                    if dist < shortestDist then
                        shortestDist = dist
                        bestTriggerTarget = verity
                    end
                end
            end
        end
    end

    if triggerBotEnabled and bestTriggerTarget then
        spoofClickAndFire(bestTriggerTarget)
    end
end)

