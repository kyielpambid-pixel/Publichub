local function isVerityDead(verity)
    if not verity or not verity.Parent then return true end
    local humanoid = verity:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return true end
    local health = verity:GetAttribute("Health") or verity:GetAttribute("HP")
    if health and health <= 0 then return true end
    return false
end

local function getVerityTorso(verity)
    if not verity then return nil end
    if verity:IsA("Model") then
        return verity:FindFirstChild("HumanoidRootPart")
            or verity:FindFirstChild("Torso")
            or verity:FindFirstChild("UpperTorso")
            or verity:FindFirstChild("Hitbox")
            or verity.PrimaryPart
            or verity:FindFirstChildWhichIsA("BasePart")
    elseif verity:IsA("BasePart") then
        return verity
    end
    return nil
end

local function getAvailableWeapons()
    local weapons = {"none"}
    local backpack = localPlayer and localPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then
                table.insert(weapons, tool.Name)
            end
        end
    end
    
    local char = localPlayer and localPlayer.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and not table.find(weapons, tool.Name) then
                table.insert(weapons, tool.Name)
            end
        end
    end
    return weapons
end

local function equipSelectedWeapon(character)
    if selectedWeapon == "none" or not selectedWeapon then return end
    local char = character or (localPlayer and localPlayer.Character)
    local backpack = localPlayer and localPlayer:FindFirstChild("Backpack")
    if char and backpack then
        local tool = backpack:FindFirstChild(selectedWeapon)
        if tool and tool:IsA("Tool") then
            tool.Parent = char
        end
    end
end

local function applyModsToTool(tool)
    if not tool:IsA("Tool") then return end
    
    tool:SetAttribute("recoilMin", Vector2.zero)
    tool:SetAttribute("recoilMax", Vector2.zero)
    tool:SetAttribute("rateOfFire", 5000)
    tool:SetAttribute("RateOfFire", 5000)
    tool:SetAttribute("burstCooldown", 0)
    tool:SetAttribute("reloadTime", 0.01)
    tool:SetAttribute("_reloading", false)
    tool:SetAttribute("spread", 0)

    for _, child in ipairs(tool:GetDescendants()) do
        if child:IsA("Value") or child:IsA("Configuration") then
            local nameLower = child.Name:lower()
            if nameLower:find("recoil") then
                child.Value = 0
            elseif nameLower:find("rate") or nameLower:find("firerate") then
                child.Value = 5000
            end
        end
    end
end

local function applyAllGunMods()
    if not localPlayer then return end
    if localPlayer.Backpack then
        for _, tool in ipairs(localPlayer.Backpack:GetChildren()) do 
            pcall(applyModsToTool, tool) 
        end
    end
    if localPlayer.Character then
        for _, tool in ipairs(localPlayer.Character:GetChildren()) do 
            pcall(applyModsToTool, tool) 
        end
    end
end

local function setupToolListener(container)
    if not container then return end
    container.ChildAdded:Connect(function(child)
        if autoApplyModsEnabled and child:IsA("Tool") then
            task.wait(0.1)
            pcall(applyModsToTool, child)
        end
    end)
end

if localPlayer then
    if localPlayer.Backpack then setupToolListener(localPlayer.Backpack) end
    if localPlayer.Character then setupToolListener(localPlayer.Character) end
    localPlayer.CharacterAdded:Connect(function(newCharacter)
        newCharacter:WaitForChild("Humanoid", 5)
        task.wait(1)
        equipSelectedWeapon(newCharacter)
        setupToolListener(newCharacter)
        if localPlayer.Backpack then setupToolListener(localPlayer.Backpack) end
    end)
end

local function triggerInteractions(target)
    if not target then return end
    for _, descendant in ipairs(target:GetDescendants()) do
        if descendant:IsA("ClickDetector") and fireclickdetector then
            fireclickdetector(descendant)
        end
    end
end

local function spoofClickAndFire(target)
    local char = localPlayer and localPlayer.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            if autoApplyModsEnabled then
                pcall(applyModsToTool, tool)
            end
            tool:Activate()
        end
    end

    if mouse1click then
        mouse1click()
    elseif mouse1press and mouse1release then
        mouse1press()
        task.wait(0.01)
        mouse1release()
    end

    if target then
        triggerInteractions(target)
    end
end

