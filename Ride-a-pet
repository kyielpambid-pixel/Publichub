local function buildMobileFlyGui()
	destroyMobileFlyGui()
	local pg = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui")
	mobileFlyGui = Instance.new("ScreenGui")
	mobileFlyGui.Name = "KHUB_MobileFly"
	mobileFlyGui.ResetOnSpawn = false
	mobileFlyGui.IgnoreGuiInset = true
	mobileFlyGui.DisplayOrder = 999990
	mobileFlyGui.Parent = pg

	local function mkBtn(text, pos, size)
		local b = Instance.new("TextButton")
		b.Size = size or UDim2.fromOffset(56, 56)
		b.Position = pos
		b.BackgroundColor3 = Color3.fromRGB(20, 28, 55)
		b.BackgroundTransparency = 0.15
		b.Text = text
		b.Font = Enum.Font.GothamBold
		b.TextSize = 16
		b.TextColor3 = Color3.fromRGB(200, 230, 255)
		b.ZIndex = 50
		b.Parent = mobileFlyGui
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 12)
		c.Parent = b
		local s = Instance.new("UIStroke")
		s.Color = Color3.fromRGB(70, 180, 255)
		s.Thickness = 1.2
		s.Transparency = 0.3
		s.Parent = b
		return b
	end

	-- D-pad bottom left
	local baseX, baseY = 24, -200
	local up = mkBtn("▲", UDim2.new(0, baseX + 56, 1, baseY - 56))
	local dn = mkBtn("▼", UDim2.new(0, baseX + 56, 1, baseY + 56))
	local lf = mkBtn("◀", UDim2.new(0, baseX, 1, baseY))
	local rt = mkBtn("▶", UDim2.new(0, baseX + 112, 1, baseY))
	-- Up/Down height bottom right
	local rise = mkBtn("⬆", UDim2.new(1, -80, 1, baseY - 56))
	local fall = mkBtn("⬇", UDim2.new(1, -80, 1, baseY + 56))

	local held = { up=false, dn=false, lf=false, rt=false, rise=false, fall=false }
	local function bind(btn, key)
		btn.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
				held[key] = true
			end
		end)
		btn.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
				held[key] = false
			end
		end)
	end
	bind(up, "up"); bind(dn, "dn"); bind(lf, "lf"); bind(rt, "rt"); bind(rise, "rise"); bind(fall, "fall")

	task.spawn(function()
		while mobileFlyGui and mobileFlyGui.Parent do
			local x, y, z = 0, 0, 0
			if held.up then z = z - 1 end
			if held.dn then z = z + 1 end
			if held.lf then x = x - 1 end
			if held.rt then x = x + 1 end
			if held.rise then y = y + 1 end
			if held.fall then y = y - 1 end
			mobileMove = Vector3.new(x, y, z)
			task.wait(0.03)
		end
	end)
end

local function setFly(on)
	Opt.FlyOn = on
	local root = getRoot()
	if on and root then
		flyGyro = Instance.new("BodyGyro")
		flyGyro.P = 90000
		flyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
		flyGyro.cframe = root.CFrame
		flyGyro.Parent = root
		flyVel = Instance.new("BodyVelocity")
		flyVel.velocity = Vector3.new(0, 0.1, 0)
		flyVel.maxForce = Vector3.new(9e9, 9e9, 9e9)
		flyVel.Parent = root
		-- Mobile controls if touch enabled
		if UserInputService.TouchEnabled then
			buildMobileFlyGui()
		end
	else
		if flyGyro then pcall(function() flyGyro:Destroy() end); flyGyro = nil end
		if flyVel then pcall(function() flyVel:Destroy() end); flyVel = nil end
		destroyMobileFlyGui()
	end
end

local function applyFPSBoost(on)
	Opt.FPSBoost = on
	if on then
		pcall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
		Lighting.Brightness = 2
		pcall(function()
			for _, v in ipairs(Workspace:GetDescendants()) do
				if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
					v.Enabled = false
				elseif v:IsA("BasePart") then
					v.CastShadow = false
					v.Material = Enum.Material.SmoothPlastic
				end
			end
		end)
		setTexturesOff(true)
	else
		pcall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
		end)
		Lighting.GlobalShadows = true
		Lighting.Brightness = 1
		setTexturesOff(false)
	end
end

local function setTexturesOff(on)
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("Texture") or d:IsA("Decal") then
			if on then
				textureCache[d] = d.Texture
				d.Texture = ""
			elseif textureCache[d] then
				d.Texture = textureCache[d]
				textureCache[d] = nil
			end
		end
	end
end

local function setShadowsOff(on)
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CastShadow = not on
		end
	end
	Lighting.GlobalShadows = not on
	Lighting.Brightness = on and 2 or 1
end

RunService.RenderStepped:Connect(function()
	if Opt.FlyOn then
		local root = getRoot()
		if root and flyGyro and flyVel then
			flyGyro.cframe = camera.CFrame
			local dir = Vector3.new()
			-- PC keys
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				dir = dir - Vector3.new(0, 1, 0)
			end
			-- Mobile d-pad (relative to camera)
			if mobileMove.Magnitude > 0 then
				local look = camera.CFrame.LookVector
				local right = camera.CFrame.RightVector
				dir = dir
					+ look * (-mobileMove.Z)
					+ right * mobileMove.X
					+ Vector3.new(0, mobileMove.Y, 0)
			end
			flyVel.velocity = dir * Opt.FlySpeed
		end
	end
	if Opt.EggESP and eggFolder then
		local root = getRoot()
		if root then
			for _, egg in ipairs(eggFolder:GetChildren()) do
				local e = eggESPMap[egg]
				if e and e.Billboard and e.Info then
					local piv = getPivot(egg)
					if piv then
						e.Info.Text = math.floor((root.Position - piv.Position).Magnitude) .. " studs"
					end
				end
			end
		end
	end
end)

