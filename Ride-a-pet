local PageSave = createPage("Save")
createTabButton("Save", "Save Config", 6, "Save Config", "your setups")

local CONFIG_FOLDER = "KHUB_Configs"
local selectedConfig = nil
local configList = {}

local function ensureFolder()
	pcall(function()
		if makefolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
	end)
end

local function listConfigs()
	configList = {}
	pcall(function()
		if listfiles and isfolder and isfolder(CONFIG_FOLDER) then
			for _, path in ipairs(listfiles(CONFIG_FOLDER)) do
				local name = string.match(path, "([^/\\]+)%.json$")
				if name then table.insert(configList, name) end
			end
		end
	end)
	table.sort(configList)
	return configList
end

local SaveCard = card(PageSave, "Custom Config")
local SaveStatus = line(SaveCard, "status: ready", THEME.dim)
local NameBox = input(SaveCard, "config name", "", function() end)

local function setSaveStatus(txt, col)
	SaveStatus.Text = "status: " .. txt
	SaveStatus.TextColor3 = col or THEME.dim
end

local ListFrame = Instance.new("ScrollingFrame")
ListFrame.Size = UDim2.new(1, 0, 0, 120)
ListFrame.BackgroundColor3 = THEME.inner
ListFrame.BorderSizePixel = 0
ListFrame.ScrollBarThickness = 3
ListFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
ListFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
ListFrame.ZIndex = 11
ListFrame.Parent = SaveCard
corner(ListFrame, 8)
local LL = Instance.new("UIListLayout")
LL.Padding = UDim.new(0, 4)
LL.Parent = ListFrame

function refreshConfigList()
	for _, child in ipairs(ListFrame:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
	end
	listConfigs()
	if #configList == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -8, 0, 28)
		empty.BackgroundTransparency = 1
		empty.Text = "no configs yet"
		empty.Font = Enum.Font.Gotham
		empty.TextSize = 12
		empty.TextColor3 = THEME.mute
		empty.ZIndex = 12
		empty.Parent = ListFrame
	else
		for i, name in ipairs(configList) do
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, -8, 0, 30)
			local sel = selectedConfig == name
			b.BackgroundColor3 = sel and THEME.accent2 or Color3.fromRGB(22, 28, 56)
			b.Text = (sel and "✓  " or "     ") .. name
			b.Font = Enum.Font.GothamBold
			b.TextSize = 13
			b.TextColor3 = sel and THEME.gold or THEME.text
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.ZIndex = 12
			b.Parent = ListFrame
			corner(b, 7)
			b.MouseButton1Click:Connect(function()
				selectedConfig = name
				NameBox.Text = name
				setSaveStatus("selected " .. name, THEME.gold)
				refreshConfigList()
			end)
		end
	end
end

btn(SaveCard, "create / save config", function()
	local name = NameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then setSaveStatus("type a name first", THEME.red); return end
	ensureFolder()
	local ok, err = pcall(function()
		if not writefile then error("writefile not supported") end
		writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode({
			SavedAt = os.date("%Y-%m-%d %H:%M"),
			User = player.Name,
			Version = "ride-a-pet-1",
			Settings = {
				EggESP = Opt.EggESP,
				FlyOn = Opt.FlyOn,
				AutoReturn = Opt.AutoReturn,
				AutoBest = Opt.AutoBest,
				AutoHatch = Opt.AutoHatch,
				FPSBoost = Opt.FPSBoost,
				GlideSpeed = Opt.GlideSpeed,
				FlySpeed = Opt.FlySpeed,
				WalkSpeed = Opt.WalkSpeed,
			},
		}))
	end)
	if ok then
		selectedConfig = name
		setSaveStatus('saved "' .. name .. '"', THEME.green)
		refreshConfigList()
	else
		setSaveStatus("failed · " .. tostring(err), THEME.red)
	end
end, Color3.fromRGB(30, 84, 58))

btn(SaveCard, "load config", function()
	local name = selectedConfig or NameBox.Text
	if not name or name == "" then setSaveStatus("select a config first", THEME.red); return end
	local ok, data = pcall(function()
		if not readfile or not isfile then error("readfile not supported") end
		local path = CONFIG_FOLDER .. "/" .. name .. ".json"
		if not isfile(path) then error("file not found") end
		return HttpService:JSONDecode(readfile(path))
	end)
	if ok and type(data) == "table" and type(data.Settings) == "table" then
		local s = data.Settings
		if type(s.EggESP) == "boolean" then Opt.EggESP = s.EggESP; refreshAllESP() end
		if type(s.FlyOn) == "boolean" then setFly(s.FlyOn) end
		if type(s.AutoReturn) == "boolean" then Opt.AutoReturn = s.AutoReturn end
		if type(s.AutoBest) == "boolean" then Opt.AutoBest = s.AutoBest end
		if type(s.AutoHatch) == "boolean" then Opt.AutoHatch = s.AutoHatch end
		if type(s.FPSBoost) == "boolean" then applyFPSBoost(s.FPSBoost) end
		if tonumber(s.GlideSpeed) then Opt.GlideSpeed = tonumber(s.GlideSpeed) end
		if tonumber(s.FlySpeed) then Opt.FlySpeed = tonumber(s.FlySpeed) end
		if tonumber(s.WalkSpeed) then Opt.WalkSpeed = tonumber(s.WalkSpeed) end
		setSaveStatus('loaded "' .. name .. '"', THEME.green)
	else
		setSaveStatus("failed to load", THEME.red)
	end
end)

btn(SaveCard, "delete selected", function()
	local name = selectedConfig
	if not name or name == "" then setSaveStatus("select a config first", THEME.red); return end
	local ok = pcall(function()
		if not delfile then error("delfile not supported") end
		delfile(CONFIG_FOLDER .. "/" .. name .. ".json")
	end)
	if ok then
		setSaveStatus('deleted "' .. name .. '"', THEME.green)
		selectedConfig = nil
		NameBox.Text = ""
		refreshConfigList()
	else
		setSaveStatus("delete failed", THEME.red)
	end
end, THEME.red)

btn(SaveCard, "refresh list", function()
	refreshConfigList()
	setSaveStatus("refreshed", THEME.dim)
end)

task.defer(refreshConfigList)

