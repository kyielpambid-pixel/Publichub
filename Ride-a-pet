local function getRoot()
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end

local function getPivot(inst)
	if not inst or not inst.Parent then return nil end
	if inst:IsA("Model") then return inst:GetPivot() end
	if inst:IsA("BasePart") then return inst.CFrame end
	return nil
end

local function hasEggInHand()
	local ch = player.Character
	if not ch then return false end
	for _, t in ipairs(ch:GetChildren()) do
		if t:IsA("Tool") and string.find(string.lower(t.Name), "egg") then return true end
	end
	local bp = player:FindFirstChild("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") and string.find(string.lower(t.Name), "egg") then return true end
		end
	end
	return false
end

local function freezeChar()
	local ch = player.Character
	if not ch then return end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = true
		hum.AutoRotate = false
		local anim = hum:FindFirstChildOfClass("Animator")
		if anim then
			for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
				pcall(function() tr:Stop(0) end)
			end
		end
	end
end

local function unfreezeChar()
	local ch = player.Character
	if not ch then return end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
		hum.AutoRotate = true
	end
end

-- Fire ONLY prompts that belong to a specific egg model (no global radar spam)
local function fireEggPrompt(egg)
	if not egg then return end
	local prompts = {}
	for _, d in ipairs(egg:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			table.insert(prompts, d)
		end
	end
	-- parent chain one level up
	if egg.Parent then
		for _, d in ipairs(egg.Parent:GetChildren()) do
			if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
			for _, dd in ipairs(d:GetChildren()) do
				if dd:IsA("ProximityPrompt") then table.insert(prompts, dd) end
			end
		end
	end
	for _, d in ipairs(prompts) do
		pcall(function()
			if fireproximityprompt then
				fireproximityprompt(d)
			else
				d.HoldDuration = 0
				d:InputHoldBegin()
				task.wait(0.05)
				d:InputHoldEnd()
			end
		end)
	end
	-- ClickDetectors on egg only
	for _, d in ipairs(egg:GetDescendants()) do
		if d:IsA("ClickDetector") then
			pcall(function()
				if fireclickdetector then fireclickdetector(d) end
			end)
		end
	end
end

local function getMyPlot()
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, plot in ipairs(plots:GetChildren()) do
		local data = plot:FindFirstChild("Data")
		local owner = data and data:FindFirstChild("Owner")
		if owner then
			local isMine = false
			if owner:IsA("StringValue") then
				isMine = owner.Value == player.Name
			elseif owner:IsA("ObjectValue") then
				isMine = owner.Value == player
			else
				isMine = tostring(owner.Value) == player.Name
			end
			if isMine then return plot end
		end
	end
	return nil
end

-- Auto place egg on farm after returning home
local function placeEggOnFarm()
	local plot = getMyPlot()
	if not plot then return false end
	local root = getRoot()
	if not root then return false end
	-- equip egg tool if in backpack
	local bp = player:FindFirstChild("Backpack")
	local ch = player.Character
	if bp and ch then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") and string.find(string.lower(t.Name), "egg") then
				pcall(function()
					local hum = ch:FindFirstChildOfClass("Humanoid")
					if hum then hum:EquipTool(t) end
				end)
				break
			end
		end
	end
	task.wait(0.2)
	-- fire placement prompts / click detectors on plot only
	local placed = false
	for _, d in ipairs(plot:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			pcall(function()
				if fireproximityprompt then fireproximityprompt(d)
				else d.HoldDuration = 0; d:InputHoldBegin(); task.wait(0.05); d:InputHoldEnd() end
			end)
			placed = true
			task.wait(0.15)
		elseif d:IsA("ClickDetector") then
			pcall(function()
				if fireclickdetector then fireclickdetector(d) end
			end)
			placed = true
			task.wait(0.1)
		end
	end
	-- touch farm pads if any
	for _, d in ipairs(plot:GetDescendants()) do
		if d:IsA("BasePart") and (string.find(string.lower(d.Name), "place")
			or string.find(string.lower(d.Name), "slot")
			or string.find(string.lower(d.Name), "pad")
			or string.find(string.lower(d.Name), "farm")) then
			pcall(function()
				if root and firetouchinterest then
					firetouchinterest(root, d, 0)
					task.wait(0.05)
					firetouchinterest(root, d, 1)
				elseif root then
					root.CFrame = d.CFrame + Vector3.new(0, 3, 0)
				end
			end)
			task.wait(0.1)
		end
	end
	return placed or true
end

local function findBestEgg()
	if not eggFolder then return nil end
	local best, bestRank = nil, 999
	for _, egg in ipairs(eggFolder:GetChildren()) do
		local info = EGG_RANK[egg.Name]
		local rank = info and info.rank or 99
		if rank < bestRank then
			bestRank = rank
			best = egg
		end
	end
	return best, bestRank
end

local function interactEggInstant(egg)
	-- gentle take: stand at egg, fire ONLY that egg's prompt a few times (no radar/click spam)
	local root = getRoot()
	if not root then return false end
	local piv = getPivot(egg)
	if not piv then return false end
	root.CFrame = CFrame.new(piv.Position + Vector3.new(0, Opt.TPHeight, 0))
	task.wait(0.2)
	for i = 1, 5 do
		fireEggPrompt(egg)
		task.wait(0.25)
		if hasEggInHand() then return true end
	end
	return hasEggInHand()
end


local function glideTo(target, onDone)
	local root = getRoot()
	if not root then return false end
	local pivot = getPivot(target)
	if not pivot then return false end
	local dest = pivot.Position + Vector3.new(0, Opt.TPHeight, 0)
	local destCF = CFrame.new(dest)
	local dur = math.max((root.Position - dest).Magnitude / Opt.GlideSpeed, 0.2)
	local t0 = tick()
	local startCF = root.CFrame
	freezeChar()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not root or not root.Parent then
			if conn then conn:Disconnect() end
			unfreezeChar()
			return
		end
		local a = math.min((tick() - t0) / dur, 1)
		local pos = startCF.Position:Lerp(dest, a)
		root.CFrame = CFrame.new(pos) * CFrame.Angles(0, select(2, startCF:ToEulerAnglesYXZ()), 0)
		if a >= 1 then
			root.CFrame = destCF
			conn:Disconnect()
			unfreezeChar()
			if onDone then onDone() end
		end
	end)
	return true
end

local function tpHome(onDone)
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then return false end
	for _, plot in ipairs(plots:GetChildren()) do
		local data = plot:FindFirstChild("Data")
		local owner = data and data:FindFirstChild("Owner")
		if owner then
			local isMine = false
			if owner:IsA("StringValue") then
				isMine = owner.Value == player.Name
			elseif owner:IsA("ObjectValue") then
				isMine = owner.Value == player
			else
				isMine = tostring(owner.Value) == player.Name
			end
			if isMine then return glideTo(plot, onDone) end
		end
	end
	return false
end

local function tpByName(name)
