	corner(knob, 11)
	local function refresh()
		local on = getState()
		if on then
			TweenService:Create(pill, TweenInfo.new(0.22), { BackgroundColor3 = THEME.accent }):Play()
			TweenService:Create(knob, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Position = UDim2.new(1, -25, 0.5, -11), BackgroundColor3 = Color3.new(1, 1, 1),
			}):Play()
		else
			TweenService:Create(pill, TweenInfo.new(0.22), { BackgroundColor3 = THEME.off }):Play()
			TweenService:Create(knob, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 3, 0.5, -11), BackgroundColor3 = THEME.offKnob,
			}):Play()
		end
	end
	b.MouseButton1Click:Connect(function()
		setState(not getState())
		refresh()
	end)
	refresh()
	return b, refresh
end

