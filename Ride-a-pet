local draggingOrb, dragStartOrb, startPosOrb
Orb.InputBegan:Connect(function(input)
	if OrbState.locked then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingOrb = true
		dragStartOrb = input.Position
		startPosOrb = OrbRoot.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then draggingOrb = false end
		end)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if draggingOrb and not OrbState.locked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStartOrb
		OrbRoot.Position = UDim2.new(startPosOrb.X.Scale, startPosOrb.X.Offset + d.X, startPosOrb.Y.Scale, startPosOrb.Y.Offset + d.Y)
	end
end)

local function setVisible(on)
	if on then
		Win.Visible = true
		OrbRoot.Visible = false
	else
		Win.Visible = false
		OrbRoot.Visible = OrbState.visible
	end
end

