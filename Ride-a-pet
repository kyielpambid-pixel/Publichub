-- ============================================================
-- STRICT 1-EGG CYCLE
-- take ONE egg → auto home → auto place → (optional hatch) → THEN next egg
-- Never hunts a second egg while holding / mid-cycle
-- ============================================================
local CycleLock = false

local function hatchEggsOnFarm()
	if not Opt.AutoHatch then return end
	Opt.AutoBestStatus = "Hatching eggs..."
	local plot = getMyPlot()
	if not plot then return end
	-- fire hatch prompts / click detectors on plot
	for _, d in ipairs(plot:GetDescendants()) do
		local n = string.lower(d.Name)
		if d:IsA("ProximityPrompt") then
			if string.find(n, "hatch") or string.find(tostring(d.ActionText or ""):lower(), "hatch")
				or string.find(tostring(d.ObjectText or ""):lower(), "hatch")
				or true then
				pcall(function()
					if fireproximityprompt then fireproximityprompt(d)
					else d.HoldDuration = 0; d:InputHoldBegin(); task.wait(0.05); d:InputHoldEnd() end
				end)
				task.wait(0.12)
			end
		elseif d:IsA("ClickDetector") and (string.find(n, "hatch") or string.find(n, "egg")) then
			pcall(function() if fireclickdetector then fireclickdetector(d) end end)
			task.wait(0.1)
		end
	end
	-- also try any prompt near player on plot
	local root = getRoot()
	if root then
		for _, d in ipairs(plot:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				local part = d.Parent
				if part and part:IsA("BasePart") and (part.Position - root.Position).Magnitude < 25 then
					pcall(function()
						if fireproximityprompt then fireproximityprompt(d) end
					end)
				end
			end
		end
	end
	task.wait(0.4)
end

local function doHomePlaceHatch(doneMsg)
	-- ALWAYS go home first when we have an egg — never seek another egg here
	Opt.AutoBestStatus = "Auto Home..."
	local finished = false
	local function afterHome()
		task.wait(0.7)
		Opt.AutoBestStatus = "Auto Place egg..."
		for _ = 1, 4 do
			placeEggOnFarm()
			task.wait(0.45)
			if not hasEggInHand() then break end
		end
		if Opt.AutoHatch then
			task.wait(0.3)
			hatchEggsOnFarm()
		end
		Opt.AutoBestStatus = doneMsg or "Done · ready for next egg"
		finished = true
		CycleLock = false
		Opt.Busy = false
	end
	local ok = tpHome(afterHome)
	if not ok then
		task.wait(0.6)
		ok = tpHome(afterHome)
		if not ok then
			-- last resort: still try place where we are
			Opt.AutoBestStatus = "Home fail · placing here"
			placeEggOnFarm()
			if Opt.AutoHatch then hatchEggsOnFarm() end
			CycleLock = false
			Opt.Busy = false
			finished = true
		end
	end
	-- safety unlock if callback never fires
	task.delay(12, function()
		if not finished and CycleLock then
			CycleLock = false
			Opt.Busy = false
			Opt.AutoBestStatus = "Cycle timeout · unlocked"
		end
	end)
end

local function glideEgg(egg)
	if Opt.Busy or CycleLock then return end
	Opt.Busy = true
	CycleLock = true  -- LOCK: no other egg until home+place finishes
	Opt.AutoBestStatus = "Gliding → " .. tostring(egg and egg.Name)
	local started = glideTo(egg, function()
		task.wait(0.3)
		Opt.AutoBestStatus = "Taking 1 egg..."
		local got = interactEggInstant(egg)
		if not got then
			task.wait(0.4)
			fireEggPrompt(egg)
			task.wait(0.55)
			got = hasEggInHand()
		end
		if got or hasEggInHand() then
			-- MUST home — do NOT look for more eggs
			Opt.AutoBestStatus = "Got 1 egg · Auto Home now"
			task.wait(0.4)
			doHomePlaceHatch("Placed · next egg soon")
		else
			Opt.AutoBestStatus = "Missed · retry later"
			CycleLock = false
			Opt.Busy = false
		end
	end)
	if not started then
		CycleLock = false
		Opt.Busy = false
		Opt.AutoBestStatus = "Glide failed"
	end
end

-- Only hunt when fully idle (no lock, no busy, no egg in hand)
task.spawn(function()
	while true do
		if Opt.AutoBest and not Opt.Busy and not CycleLock then
			if hasEggInHand() then
				Opt.Busy = true
				CycleLock = true
				Opt.AutoBestStatus = "Egg in hand → Home first"
				doHomePlaceHatch("Placed from hand")
			else
				local best = findBestEgg()
				if best then
					glideEgg(best)
				else
					Opt.AutoBestStatus = "Waiting for eggs..."
				end
			end
		end
		task.wait(0.55)
	end
end)

local function applyEggESP(model)
	if not model or (not model:IsA("Model") and not model:IsA("BasePart")) then return end
	eggESPMap[model] = eggESPMap[model] or { Highlight = nil, Billboard = nil, Info = nil }
	local e = eggESPMap[model]
	if Opt.EggESP then
		if not e.Highlight or not e.Highlight.Parent then
			local h = Instance.new("Highlight")
			h.Adornee = model
			h.FillTransparency = Opt.ESPFillTransparency
			h.OutlineTransparency = Opt.ESPOutlineTransparency
			h.FillColor = Opt.GlobalESPColor
			h.OutlineColor = Opt.GlobalESPColor
			h.Parent = model
			e.Highlight = h
		end
		e.Highlight.Enabled = true
		if not e.Billboard or not e.Billboard.Parent then
			local bb = Instance.new("BillboardGui")
			bb.Name = "EggESPText"
			bb.Adornee = model
			bb.Size = UDim2.new(0, 200, 0, 40)
			bb.StudsOffset = Vector3.new(0, 3, 0)
			bb.AlwaysOnTop = true
			bb.Parent = model
			local nameL = Instance.new("TextLabel")
			nameL.Size = UDim2.new(1, 0, 0, 22)
			nameL.BackgroundTransparency = 1
			nameL.TextColor3 = Color3.new(1, 1, 1)
			nameL.TextStrokeTransparency = 0
			nameL.TextStrokeColor3 = Color3.new(0, 0, 0)
			nameL.TextSize = 16
			nameL.Font = Enum.Font.GothamBold
			nameL.Text = model.Name
			nameL.Parent = bb
			local info = Instance.new("TextLabel")
			info.Name = "Info"
			info.Size = UDim2.new(1, 0, 0, 16)
			info.Position = UDim2.new(0, 0, 0, 22)
			info.BackgroundTransparency = 1
			info.TextColor3 = Color3.new(1, 1, 1)
			info.TextStrokeTransparency = 0
			info.TextStrokeColor3 = Color3.new(0, 0, 0)
			info.TextSize = 13
			info.Font = Enum.Font.Gotham
			info.Text = "0 studs"
			info.Parent = bb
			e.Billboard = bb
			e.Info = info
		end
		e.Billboard.Enabled = true
	else
		if e.Highlight then e.Highlight.Enabled = false end
		if e.Billboard then e.Billboard.Enabled = false end
	end
end

local function refreshAllESP()
	if not eggFolder then return end
	for _, c in ipairs(eggFolder:GetChildren()) do
		applyEggESP(c)
	end
end

if eggFolder then
	eggFolder.ChildAdded:Connect(function(c)
		task.wait()
		applyEggESP(c)
	end)
	eggFolder.ChildRemoved:Connect(function(c)
		local e = eggESPMap[c]
		if e then
			if e.Highlight then pcall(function() e.Highlight:Destroy() end) end
			if e.Billboard then pcall(function() e.Billboard:Destroy() end) end
			eggESPMap[c] = nil
		end
	end)
end

