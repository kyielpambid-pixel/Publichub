local function updateScale()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local vx, vy = cam.ViewportSize.X, cam.ViewportSize.Y
	local scale
	if vx < 500 then scale = math.clamp(math.min(vx / 1000, vy / 760), 0.4, 0.62)
	elseif vx < 900 then scale = math.clamp(math.min(vx / 1200, vy / 860), 0.48, 0.72)
	else scale = math.clamp(math.min(vx / 1650, vy / 940), 0.6, 0.95) end
	WinUIScale.Scale = scale
end
