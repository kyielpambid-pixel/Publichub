-- ── PAGE: ESP ──────────────────────────────────────────────────────
-- BillboardGui name tags drawn on every player's HumanoidRootPart.
-- Box drawn via a 2D Frame border technique on the Highlight instance
-- (Roblox executor environments have Highlight; fallback is Billboard).
-- Color: green for same-team / unknown, red for flagged Murderer role.
-- ═══════════════════════════════════════════════════════════════════
descLabel(pgEsp,
    "Player ESP: name tags + highlights. Green = innocent side, Red = murderer flagged.",1)

local espEnabled   = false
local espHighlights = {}  -- [Player] = Highlight instance
local espBills      = {}  -- [Player] = BillboardGui name tag

-- role tracking: firesignal intercept sets this
local murdererUserId = nil

-- intercept RoleReveal so ESP knows who the murderer is
pcall(function()
    local ev = RS.NightfallGame.Remotes.RoleReveal
    ev.OnClientEvent:Connect(function(role, ...)
        if role == "Murderer" then
            murdererUserId = player.UserId   -- local player got murderer
        end
    end)
end)

local function espColorFor(p)
    if murdererUserId and p.UserId == murdererUserId then
        return Color3.fromRGB(255, 40, 40)
    end
    return Color3.fromRGB(40, 255, 80)
end

local function buildEspFor(p)
    if p == player then return end  -- skip self
    local function tryAttach()
        local char = p.Character or p.CharacterAdded:Wait()
        local hrp  = char:WaitForChild("HumanoidRootPart", 10)
        if not hrp then return end

        -- Highlight (outline + fill)
        local hl = Instance.new("Highlight")
        hl.Adornee        = char
        hl.OutlineColor   = espColorFor(p)
        hl.FillColor      = espColorFor(p)
        hl.FillTransparency    = 0.78
        hl.OutlineTransparency = 0.0
        hl.DepthMode      = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent         = ScreenGui
        espHighlights[p]  = hl

        -- Name tag BillboardGui
        local bill = Instance.new("BillboardGui")
        bill.Adornee        = hrp
        bill.Size           = UDim2.fromOffset(120, 30)
        bill.StudsOffset    = Vector3.new(0, 3.2, 0)
        bill.AlwaysOnTop    = true
        bill.ResetOnSpawn   = false
        bill.Parent         = ScreenGui
        espBills[p]         = bill

        local nameTag = Instance.new("TextLabel")
        nameTag.Size                 = UDim2.new(1, 0, 1, 0)
        nameTag.BackgroundTransparency = 1
        nameTag.Text                 = p.DisplayName .. "\n[" .. p.Name .. "]"
        nameTag.Font                 = Enum.Font.GothamBold
        nameTag.TextSize             = 11
        nameTag.TextColor3           = espColorFor(p)
        nameTag.TextStrokeColor3     = Color3.new(0,0,0)
        nameTag.TextStrokeTransparency = 0.3
        nameTag.ZIndex               = 99
        nameTag.Parent               = bill

        -- keep color updated as murderer flag changes
        RunService.Heartbeat:Connect(function()
            if not espEnabled then return end
            local col = espColorFor(p)
            hl.OutlineColor   = col
            hl.FillColor      = col
            nameTag.TextColor3 = col
        end)
    end
    task.spawn(tryAttach)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        -- re-attach on respawn
        if espEnabled then task.spawn(tryAttach) end
    end)
end

local function enableEsp()
    espEnabled = true
    for _, p in ipairs(Players:GetPlayers()) do
        buildEspFor(p)
    end
    Players.PlayerAdded:Connect(function(p)
        if espEnabled then buildEspFor(p) end
    end)
    setStatus("✓ ESP active — "..#Players:GetPlayers().." players tagged", THEME.accent)
end

local function disableEsp()
    espEnabled = false
    for p, hl in pairs(espHighlights) do
        pcall(function() hl:Destroy() end)
        espHighlights[p] = nil
    end
    for p, bill in pairs(espBills) do
        pcall(function() bill:Destroy() end)
        espBills[p] = nil
    end
    setStatus("ESP disabled", THEME.dim)
end

