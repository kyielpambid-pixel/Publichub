local DOT_COUNT = 22
local DOT_COLS  = {
    Color3.fromRGB(255, 80,  80),
    Color3.fromRGB(255, 170, 50),
    Color3.fromRGB(80,  255, 120),
    Color3.fromRGB(60,  160, 255),
    Color3.fromRGB(200, 90,  255),
    Color3.fromRGB(255, 230, 60),
}
local dots = {}
for i = 1, DOT_COUNT do
    local d = Instance.new("Frame")
    d.Size                   = UDim2.fromOffset(5, 5)
    d.BackgroundColor3       = DOT_COLS[(i % #DOT_COLS) + 1]
    d.BackgroundTransparency = 0.25
    d.BorderSizePixel        = 0
    d.ZIndex                 = 4   -- behind content (rail = 5)
    d.Active                 = false
    d.Parent                 = Win
    corner(d, 99)
    dots[i] = d
end

task.spawn(function()
    local t  = 0
    local CX, CY = 260, 190
    local RX, RY = 240, 155
    while dots[1].Parent do
        t = t + task.wait(0.03)
        for i, d in ipairs(dots) do
            local angle = t * 0.85 + (i / DOT_COUNT) * (math.pi * 2)
            local rx = i % 2 == 0 and RX or RX - 20
            local ry = i % 2 == 0 and RY or RY - 14
            local px = CX + math.cos(angle) * rx - 2.5
            local py = CY + math.sin(angle) * ry - 2.5
            d.Position               = UDim2.fromOffset(px, py)
            d.BackgroundTransparency = 0.15 + math.sin(angle*2+t)*0.22
        end
    end
end)

