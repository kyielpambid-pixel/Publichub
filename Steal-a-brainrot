end)

task.spawn(function()
	while true do
		task.wait(0.15)
		if not Config.AutoSteal then continue end
		pcall(function()
			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			local stolen = false
			for _, prompt in ipairs(Workspace:GetDescendants()) do
				if not Config.AutoSteal then break end
				if prompt:IsA("ProximityPrompt") and prompt.Enabled then
					local pPart = prompt.Parent
					if pPart and pPart:IsA("BasePart") then
						local dist = (pPart.Position - hrp.Position).Magnitude
						if dist <= prompt.MaxActivationDistance + 10 then
							local act = string.lower(prompt.ActionText .. " " .. prompt.ObjectText)
							if act:find("steal") or act:find("take") or act:find("grab") or act:find("loot")
								or act:find("brainrot") or act == " " or act == "" then
								InstantTriggerPrompt(prompt)
								stolen = true
								if Config.AutoTeleportToBase then
									task.wait(0.15)
									TeleportHome()
								end
								break
							end
						end
					end
				end
			end
			if not stolen then
				for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
					if remote:IsA("RemoteEvent") then
						local name = string.lower(remote.Name)
						if name:find("steal") or name:find("take") or name:find("loot") then
							pcall(function()
								remote:FireServer()
								remote:FireServer(true)
							end)
							if Config.AutoTeleportToBase then
								task.wait(0.15)
								TeleportHome()
							end
						end
					end
				end
			end
		end)
	end
end)

