local function createToggle(parent, text, yPos, key, callback)
	local f = Instance.new("TextButton")
	f.Size = UDim2.new(1, -16, 0, 30)
	f.Position = UDim2.new(0, 8, 0, yPos)
	f.BackgroundColor3 = Color3.fromRGB(30, 20, 45)
	f.BackgroundTransparency = 0.2
	f.Text = "  " .. text
	f.Font = Enum.Font.GothamBold
	f.TextSize = 11
	f.TextColor3 = THEME.text
	f.TextXAlignment = Enum.TextXAlignment.Left
	f.ZIndex = 11
	f.AutoButtonColor = false
	f.Parent = parent
	corner(f, 7)
	mkstroke(f, THEME.stroke, 1, 0.35)

	local status = Instance.new("TextLabel")
	status.Size = UDim2.fromOffset(42, 20)
	status.Position = UDim2.new(1, -48, 0.5, -10)
	status.BackgroundTransparency = 1
	status.Text = "OFF"
	status.Font = Enum.Font.GothamBold
	status.TextSize = 11
	status.TextColor3 = THEME.red
	status.TextXAlignment = Enum.TextXAlignment.Right
	status.ZIndex = 12
	status.Parent = f

	f.MouseButton1Click:Connect(function()
		Config[key] = not Config[key]
		status.Text = Config[key] and "ON" or "OFF"
		status.TextColor3 = Config[key] and THEME.green or THEME.red
		if callback then callback(Config[key]) end
	end)
	return f
end

