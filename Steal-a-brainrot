local function createPage(name)
	local sf = Instance.new("ScrollingFrame")
	sf.Name = name .. "Page"
	sf.Size = UDim2.new(1, -10, 1, -44)
	sf.Position = UDim2.new(0, 5, 0, 40)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 3
	sf.ScrollBarImageColor3 = THEME.accent
	sf.CanvasSize = UDim2.new(0, 0, 0, 420)
	sf.ZIndex = 6
	sf.Visible = false
	sf.Parent = Main
	pages[name] = sf
	return sf
end

local function switchPage(name, title)
	for k, p in pairs(pages) do p.Visible = (k == name) end
	PageTitle.Text = title or name
	for id, btn in pairs(tabButtons) do
		local active = (id == name)
		btn.BackgroundTransparency = active and 0.05 or 0.25
		btn.TextColor3 = active and THEME.gold or THEME.text
	end
end

local function createTabButton(id, label, yPos, title)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -10, 0, 32)
	b.Position = UDim2.fromOffset(5, yPos)
	b.BackgroundColor3 = THEME.card
	b.BackgroundTransparency = 0.25
	b.Text = "  " .. label
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.TextColor3 = THEME.text
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.ZIndex = 7
	b.AutoButtonColor = false
	b.Parent = Rail
	corner(b, 7)
	mkstroke(b, THEME.accent, 1, 0.4)
	tabButtons[id] = b
	b.MouseButton1Click:Connect(function() switchPage(id, title) end)
	return b
end

