local SortedBombs = {}
task.spawn(function()
	task.wait(2)
	if not BombsConfig then return end
	for Name, Config in pairs(BombsConfig) do
		if Name ~= "Default" and typeof(Config)=="table" then
			SortedBombs[#SortedBombs+1] = {Name=Name, Price=tonumber(Config.Price) or 0, Damage=tonumber(Config.DamagePerClick) or 0}
		end
	end
	table.sort(SortedBombs, function(A,B)
		if A.Damage~=B.Damage then return A.Damage>B.Damage end
		return A.Price>B.Price
	end)
end)
local function OwnsBomb(Name) return CallSession("OwnsBomb", Name)==true end
local function GetBestOwnedBomb()
	for _, Bomb in ipairs(SortedBombs) do if OwnsBomb(Bomb.Name) then return Bomb end end
	return nil
end
local function GetBestAffordableUnownedBomb()
	local Money = tonumber(SafeRawGet(Session, "Money")) or 0
	for _, Bomb in ipairs(SortedBombs) do
		if Bomb.Price <= Money and not OwnsBomb(Bomb.Name) then return Bomb end
	end
	return nil
end
local function InvokeBombAction(Action, Name)
	if not ClientAction then return nil end
	local Ok, Result = pcall(function() return ClientAction:InvokeServer({Action, {Name}}) end)
	return Ok and Result or nil
end
local function MirrorOwnedBomb(Name)
	local OwnedBombs = SafeRawGet(Session, "OwnedBombs")
	if typeof(OwnedBombs) ~= "table" then return end
	local ArrayStyle = false
	for Key, Value in pairs(OwnedBombs) do
		if typeof(Key)=="number" and typeof(Value)=="string" then ArrayStyle=true; break end
	end
	if ArrayStyle then
		if not table.find(OwnedBombs, Name) then table.insert(OwnedBombs, Name) end
	else OwnedBombs[Name]=true end
end
local function MirrorEquippedBomb(Name)
	if SafeRawGet(Session, "EquippedBomb") ~= Name then pcall(function() rawset(Session, "EquippedBomb", Name) end) end
end
local function RefreshBombUi(Action, Name)
	pcall(function()
		if not Signals then return end
		if Action=="BuyBomb" then Signals.Fire("BombGranted", Name); Signals.Fire("OwnedBombsChanged", Name) end
		if Action=="EquipBomb" then Signals.Fire("EquippedBombChanged", Name) end
	end)
end
local function WaitUntilNoActiveBombs(Timeout)
	local Deadline = os.clock() + (Timeout or 8)
	while os.clock() < Deadline do
		RefreshPendingBombs()
		if EffectiveActiveCount() <= 0 then return true end
		task.wait(0.1)
	end
	table.clear(PendingBombs)
	return EffectiveActiveCount() <= 0
end
local function GetBombShopPromptPart()
	local Map = workspace:FindFirstChild("Map")
	local Lobby = Map and Map:FindFirstChild("Lobby")
	local Shop = Lobby and Lobby:FindFirstChild("BombShop")
	local PromptPart = Shop and Shop:FindFirstChild("PromptPart")
	if PromptPart and PromptPart:IsA("BasePart") then return PromptPart end
	return nil
end
local function GoToBombShop()
	local Root, PromptPart = GetRoot(), GetBombShopPromptPart()
	if not Root or not PromptPart then return false end
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero
	Root.CFrame = PromptPart.CFrame * CFrame.new(0,3,-4)
	task.wait(BOMB_SHOP_LOBBY_WAIT)
	return true
end
local function WaitForBombOwned(Name, Timeout)
	local Deadline = os.clock() + (Timeout or 3)
	while os.clock() < Deadline do if OwnsBomb(Name) then return true end; task.wait(0.1) end
	return false
end
local function WaitForBombEquipped(Name, Timeout)
	local Deadline = os.clock() + (Timeout or 3)
	while os.clock() < Deadline do
		if SafeRawGet(Session, "EquippedBomb")==Name then return true end
		task.wait(0.1)
	end
	return false
end
local function BuyBombAtShop(Name)
	local Result = InvokeBombAction("BuyBomb", Name)
	if typeof(Result)=="table" and Result.Success==false then return false end
	local Confirmed = WaitForBombOwned(Name, 3)
	if not Confirmed and typeof(Result)=="table" and Result.Success==true then MirrorOwnedBomb(Name); Confirmed=true end
	if Confirmed then RefreshBombUi("BuyBomb", Name) end
	return Confirmed
end
local function EquipBombAtShop(Name)
	if not OwnsBomb(Name) then return false end
	if SafeRawGet(Session, "EquippedBomb")==Name then return true end
	local Result = InvokeBombAction("EquipBomb", Name)
	if typeof(Result)=="table" and Result.Success==false then return false end
	local Confirmed = WaitForBombEquipped(Name, 3)
	if not Confirmed and typeof(Result)=="table" and Result.Success==true then MirrorEquippedBomb(Name); Confirmed=true end
	if Confirmed then MirrorEquippedBomb(Name); RefreshBombUi("EquipBomb", Name) end
	return Confirmed
end
local function ReturnAfterBombShop(PreviousArea, PreviousCFrame)
	local TargetArea = GetOwnedArea() or PreviousArea
	if TargetArea and TeleportToAreaMine(TargetArea) then return true end
	local Root = GetRoot()
	if Root and PreviousCFrame then
		Root.AssemblyLinearVelocity = Vector3.zero
		Root.AssemblyAngularVelocity = Vector3.zero
		Root.CFrame = PreviousCFrame
		task.wait(0.35)
		return true
	end
	return false
end
local function RunBombShopTrip()
	if BombShopTripBusy or BombShopBusy or RefillBusy or RebirthBusy or AreaPurchaseBusy or MineReturnBusy or os.clock() < BombShopRetryAt then return false end
	local BombToBuy = AutoBuyBestBomb and GetBestAffordableUnownedBomb() or nil
	local BestOwned = AutoEquipBestBomb and GetBestOwnedBomb() or nil
	local NeedsEquip = BestOwned and SafeRawGet(Session, "EquippedBomb") ~= BestOwned.Name
	if not BombToBuy and not NeedsEquip then return false end
	BombShopTripBusy = true; FarmBusy = false; CollectBusy = false
	WaitUntilNoActiveBombs(8)
	local Root = GetRoot()
	local PreviousCFrame = Root and Root.CFrame or nil
	local PreviousArea = GetCurrentAreaName() or GetOwnedArea()
	if not GoToBombShop() then BombShopRetryAt=os.clock()+3; BombShopTripBusy=false; return false end
	BombShopBusy = true; BombShopBusySince = os.clock()
	local DidWork = false
	if AutoBuyBestBomb then
		BombToBuy = GetBestAffordableUnownedBomb()
		if BombToBuy and BuyBombAtShop(BombToBuy.Name) then
			DidWork = true
			if AutoEquipBestBomb then task.wait(0.1); EquipBombAtShop(BombToBuy.Name) end
		end
	end
	if AutoEquipBestBomb then
		BestOwned = GetBestOwnedBomb()
		if BestOwned and SafeRawGet(Session, "EquippedBomb") ~= BestOwned.Name then
			if EquipBombAtShop(BestOwned.Name) then DidWork = true end
		end
	end
	BombShopBusy = false; BombShopBusySince = 0
	task.wait(0.25)
	ReturnAfterBombShop(PreviousArea, PreviousCFrame)
	ClearReservations(); table.clear(PendingBombs); RejectStreak=0; LastFarmProgress=os.clock()
	task.wait(0.35)
	BombShopTripBusy = false
	if not DidWork then BombShopRetryAt = os.clock()+2 end
	return DidWork
end

