local function ParseBlockName(Name)
	if type(Name) ~= "string" then return nil end
	local CleanName = Name:match("^[^:]+:(.+)$") or Name
	local A, B, C = CleanName:match("^(%d+)_(%d+)_(%d+)$")
	if A then return tonumber(A), tonumber(B), tonumber(C) end
	local DynamicA, DynamicB = CleanName:match("^Dynamic_(%d+)_(%d+)$")
	if DynamicA then return 100000 + tonumber(DynamicA), tonumber(DynamicB), 0 end
	return nil
end
local function GetMineBlocks()
	if not IsInMine() then return {} end
	local Folder = workspace:FindFirstChild("ClientMineBlocks")
	if not Folder then return {} end
	local Blocks = {}
	for _, Object in ipairs(Folder:GetDescendants()) do
		if Object:IsA("BasePart") then
			local A, B, C = ParseBlockName(Object.Name)
			if A then Blocks[#Blocks+1] = {Part=Object, A=A, B=B, C=C} end
		end
	end
	table.sort(Blocks, function(X,Y)
		if X.A~=Y.A then return X.A<Y.A end
		if X.B~=Y.B then return X.B<Y.B end
		return X.C<Y.C
	end)
	return Blocks
end
local function ReserveBlock(Block, Seconds)
	if Block then ReservedBlocks[Block.Name] = os.clock() + (Seconds or 2) end
end
local function IsReserved(Block)
	local Expire = ReservedBlocks[Block.Name]
	if not Expire then return false end
	if os.clock() >= Expire then ReservedBlocks[Block.Name]=nil; return false end
	return true
end
local function ClearReservations() table.clear(ReservedBlocks) end

local function SessionActiveBombCount()
