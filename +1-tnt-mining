end
local function RefreshPendingBombs()
	if not ActiveBombsFolder then return end
	local SessionBombs = SafeRawGet(Session, "ActiveBombs")
	local Now = os.clock()
	for Id, Data in pairs(PendingBombs) do
		local InSession = SessionBombs and SessionBombs[Id] ~= nil
		local InWorkspace = ActiveBombsFolder:FindFirstChild(Id) ~= nil
		if InSession or InWorkspace then PendingBombs[Id]=nil
		elseif Now - Data.Created > 2.5 then PendingBombs[Id]=nil end
	end
end
local function EffectiveActiveCount()
	RefreshPendingBombs()
	local Replicated = math.max(SessionActiveBombCount(), ActiveBombsFolder and #ActiveBombsFolder:GetChildren() or 0)
	return Replicated + CountTable(PendingBombs)
end
local function IsNearRenderedBomb(Position)
	if not ActiveBombsFolder then return false end
	for _, Bomb in ipairs(ActiveBombsFolder:GetChildren()) do
		local BombPosition
		if Bomb:IsA("Model") then BombPosition = Bomb:GetPivot().Position
		elseif Bomb:IsA("BasePart") then BombPosition = Bomb.Position end
		if BombPosition then
			local Delta = Vector2.new(Position.X, Position.Z) - Vector2.new(BombPosition.X, BombPosition.Z)
			if Delta.Magnitude < 4 then return true end
		end
	end
	return false
end
local function IsNearPendingBomb(Position)
	for _, Data in pairs(PendingBombs) do
		local P = Data.Position
		if P then
			local Delta = Vector2.new(Position.X, Position.Z) - Vector2.new(P.X, P.Z)
			if Delta.Magnitude < 4 then return true end
		end
	end
	return false
end
local function GetNextBombBlock()
	if not IsInMine() then return nil end
	local Root = GetRoot()
	local Candidates = {}
	for _, Entry in ipairs(GetMineBlocks()) do
		local Part = Entry.Part
		if Part and Part.Parent and not IsReserved(Part) then
			local Distance = Root and (Part.Position - Root.Position).Magnitude or 0
			Candidates[#Candidates+1] = {Part=Part, Distance=Distance, A=Entry.A, B=Entry.B, C=Entry.C}
		end
	end
	table.sort(Candidates, function(X,Y)
		if X.Distance~=Y.Distance then return X.Distance<Y.Distance end
		if X.A~=Y.A then return X.A<Y.A end
		if X.B~=Y.B then return X.B<Y.B end
		return X.C<Y.C
	end)
	return Candidates[1] and Candidates[1].Part or nil
end
local function GetBombRootSize()
	local Models = ReplicatedStorage:FindFirstChild("Assets")
	Models = Models and Models:FindFirstChild("Models")
	local Template = Models and Models:FindFirstChild("BombTemplate")
	local Root = Template and Template:FindFirstChild("Root")
	if Root and Root:IsA("BasePart") then return Root.Size end
	return Vector3.new(4,4,4)
end
local function GetPlacementCandidates(Block)
	local BombSize = GetBombRootSize()
	local BlockHalf, BombHalf, Gap = Block.Size/2, BombSize/2, 0.2
	local Up = Block.CFrame.UpVector * (BlockHalf.Y + BombHalf.Y + Gap)
	local Right = Block.CFrame.RightVector * (BlockHalf.X + BombHalf.X + Gap)
	local Look = Block.CFrame.LookVector * (BlockHalf.Z + BombHalf.Z + Gap)
	local Position = Block.Position
	return {CFrame.new(Position+Up), CFrame.new(Position+Right), CFrame.new(Position-Right), CFrame.new(Position+Look), CFrame.new(Position-Look)}
end
local function PlaceBomb(Block)
	if not IsInMine() or not Block or not Block.Parent then return nil end
	local BombName = SafeRawGet(Session, "EquippedBomb")
	if not BombName then return nil end
	for _, PlacementCFrame in ipairs(GetPlacementCandidates(Block)) do
		if not IsInMine() or not Block.Parent then return nil end
		if not IsNearRenderedBomb(PlacementCFrame.Position) and not IsNearPendingBomb(PlacementCFrame.Position) then
			local Result = CallSession("PlaceBomb", PlacementCFrame, nil, BombName)
			if typeof(Result)=="table" and Result.Success and Result.Id then
				local Id = tostring(Result.Id)
				PendingBombs[Id] = {Created=os.clock(), Position=PlacementCFrame.Position}
				LastFarmProgress = os.clock()
				return Id
			end
		end
		task.wait(0.025)
	end
	return nil
end
local function IgniteBomb(Id)
	if not IsInMine() or not Id then return false end
	for Attempt = 1, 4 do
		local Result = CallSession("IgniteBomb", Id)
		if typeof(Result)=="table" and Result.Success==true then LastFarmProgress=os.clock(); return true end
		task.wait(Attempt*0.05)
	end
	return false
end

