local function CallSession(Name, ...)
	if not Session then return nil end
	local Method = GetMethodRaw(Session, Name)
	if type(Method) ~= "function" then return nil end
	local Args = table.pack(...)
	local Ok, Result = pcall(function()
		return Method(Session, table.unpack(Args, 1, Args.n))
	end)
	if not Ok then return nil end
	return Result
end

local function CountTable(T)
	local Count = 0
	if typeof(T) == "table" then for _ in pairs(T) do Count += 1 end end
	return Count
end

