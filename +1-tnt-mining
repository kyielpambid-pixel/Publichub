local function WaitForAreaRendered(AreaName, Timeout)
	local Deadline = os.clock() + (Timeout or 8)
	while os.clock() < Deadline do
		local Area = GetAreaModel(AreaName)
		if Area and Area:GetAttribute("MineRenderReady") ~= false then
			local Mine = Area:FindFirstChild("Mine")
			local BlocksArea = Mine and Mine:FindFirstChild("BlocksArea")
			if BlocksArea and BlocksArea:IsA("BasePart") then return Area end
		end
		task.wait(0.1)
	end
	return nil
end
local function TeleportToAreaMine(AreaName)
	local Area = WaitForAreaRendered(AreaName, 10)
	if not Area then return false end
	local Mine = Area:FindFirstChild("Mine")
	local BlocksArea = Mine and Mine:FindFirstChild("BlocksArea")
	local Root = GetRoot()
	if not Root or not BlocksArea or not BlocksArea:IsA("BasePart") then return false end
