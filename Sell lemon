local function VerifyKey(inputKey)
    local parts = string.split(inputKey, "-")
    if #parts < 6 then return false, "Invalid key format!" end
    local exp = tonumber(parts[#parts])
    if not exp then return false, "Invalid key!" end
    if os.time() > exp then return false, "Key expired!" end
    return true, "Key Verified!", exp
end

local function SaveKey(key)
    pcall(function() if writefile then writefile(KEY_FILE, key) end end)
end

local function ClearSavedKey()
    pcall(function()
        if isfile and isfile(KEY_FILE) and delfile then delfile(KEY_FILE)
        elseif writefile then writefile(KEY_FILE, "") end
    end)
end

local function LoadSavedKey()
