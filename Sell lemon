local function powerLevelText(name)
	local s = STATE.powerLevels and STATE.powerLevels[name]
	if not s then return name .. ": â€”" end
	local lvl = tostring(s.level or 0)
	local max = s.max and tostring(s.max) or "âˆž"
	local price = s.price and ("  (" .. fmt(s.price) .. " inv)") or ""
	return name .. ": " .. lvl .. "/" .. max .. price
end

local function setLabel(idx, text)
	local opt = Options[idx]
	if opt and opt.SetText then
		pcall(function() opt:SetText(text) end)
	end
end

task.spawn(function()
	while GEN == _G.__KHUB_SL do
		pcall(function()
			setLabel("StatusCash", "Cash: " .. fmt(STATE.cash) .. "   spent " .. fmt(STATE.spent))
			setLabel("StatusRate", "Income: " .. short(STATE.incomeRate) .. "/s")
			setLabel("StatusButtons", string.format(
				"Buttons: %d / 453  (%.1f%% to ascend)",
				STATE.purchased or 0,
				(STATE.ascendProgress or 0) * 100
			))
			setLabel("StatusInvestors",
				"Investors: " .. fmt(STATE.investors) .. "  |  Potential: " .. fmt(STATE.potential)
			)
			setLabel("StatusPrestige", string.format(
				"Rebirths: %d  |  Evolution: %d  |  Ascension: %d",
				STATE.rebirths or 0,
				STATE.evolution or 0,
				STATE.ascension or 0
			))
			do
				local buy = tostring(STATE.nextBuy or "-")
				if STATE.nextBuyPrice then buy = buy .. "  " .. fmt(STATE.nextBuyPrice) end
				local upg = tostring(STATE.nextUpgrade or "-")
				if STATE.nextUpgradePrice then
					upg = upg .. "  " .. fmt(STATE.nextUpgradePrice) .. " x" .. tostring(STATE.nextUpgradeCount or 1)
				end
				setLabel("StatusNext", "Next buy: " .. buy .. "\nNext upg: " .. upg)
			end
			do
				local note = tostring(STATE.note or "idle")
				if STATE.blocked then note = note .. "\nBlocked: " .. STATE.blocked end
				setLabel("StatusNote", "Note: " .. note)
			end

			setLabel("EarnFruit", string.format(
				"Fruit: %d picked  |  %d ripe  |  %s",
				STATE.fruits or 0,
				STATE.fruitRipe or 0,
				short(STATE.earnedFruit)
			))
			do
				local r = STATE.raceIn > 0 and (math.floor(STATE.raceIn) .. "s") or "ready"
				setLabel("EarnRace", string.format(
					"Race: %s  |  won %d  |  %s",
					r, STATE.races or 0, short(STATE.earnedRace)
				))
			end
			do
				local t = STATE.tradeIn > 0 and (math.floor(STATE.tradeIn) .. "s") or "ready"
				setLabel("EarnTrade", string.format(
					"Trade: %s  |  closed %d  |  %s",
					t, STATE.trades or 0, short(STATE.earnedTrade)
				))
			end
			setLabel("EarnDrops", string.format(
				"Drops: %d (%s)  |  Offers: %d (%s)",
				STATE.drops or 0, short(STATE.earnedDrop),
				STATE.offers or 0, short(STATE.earnedOffer)
			))

			setLabel("PowerClickFruit", powerLevelText("ClickFruitValue"))
			setLabel("PowerUpgradeStack", powerLevelText("UpgradeStack"))
			setLabel("PowerBuyNext", powerLevelText("BuyNext"))
			setLabel("PowerAutoFruit", powerLevelText("AutoFruit"))
			setLabel("PowerManage", powerLevelText("Manage"))
			setLabel("PowerWalkSpeed", powerLevelText("WalkSpeed"))
			do
				local np = tostring(STATE.nextPower or "-")
				if STATE.nextPowerPrice then np = np .. "  " .. fmt(STATE.nextPowerPrice) .. " investors" end
				setLabel("PowerNext", "Next: " .. np)
			end

			setLabel("OrchardStatus", "Orchard: " .. tostring(STATE.orchardNote or "off"))
			setLabel("PrestigeProgress", string.format(
				"Evolve: %.1f%%  |  Ascend: %.1f%%",
				(STATE.evolveProgress or 0) * 100,
				(STATE.ascendProgress or 0) * 100
			))
		end)
		task.wait(0.5)
	end
end)

