local function makeSlider(parent, text, min, max, default, callback)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 46)
	row.BackgroundColor3 = colors.card
	row.ZIndex = 17
	row.Parent = parent
	round(row, 7)
	local value = default
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -12, 0, 16)
	lbl.Position = UDim2.new(0, 10, 0, 4)
	lbl.BackgroundTransparency = 1
	lbl.Text = text .. ": " .. tostring(value)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 11
	lbl.TextColor3 = colors.text
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 18
	lbl.Parent = row
	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -20, 0, 8)
	track.Position = UDim2.new(0, 10, 0, 28)
	track.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
	track.ZIndex = 18
	track.Parent = row
	round(track, 4)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0)
	fill.BackgroundColor3 = colors.accent
	fill.ZIndex = 19
	fill.Parent = track
	round(fill, 4)
	local dragging = false
	local function setVal(v)
		value = math.clamp(math.floor(v + 0.5), min, max)
		fill.Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0)
		lbl.Text = text .. ": " .. tostring(value)
		if callback then callback(value) end
	end
	track.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local rel = math.clamp((inp.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			setVal(min + rel * (max - min))
		end
	end)
	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			local rel = math.clamp((inp.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			setVal(min + rel * (max - min))
		end
	end)
end

