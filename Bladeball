local setSword = function()
	if not skinchangerSystem.skinChangerEnabled then return end
	pcall(function() if skinchangerSystem.originalEquipSwordTo then setupvalue(skinchangerSystem.originalEquipSwordTo, 3, false) end end)
	if skinchangerSystem.changeSwordModel and LocalPlayer.Character and swordInstances then
