local function toggle(parent, text, get, set)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1,0,0,34); row.BackgroundTransparency = 1; row.ZIndex = 8; row.Parent = parent
	local lbl = Instance.new("TextLabel")
