-- White (top) / Pink (bottom) glow ring that pulses
local function attachCMHubGlow(host, imageObj, isCircle)
	-- Outer ring (gilid) + INNER glow inside logo + floating "burst" (CM Hub style)
	host.ClipsDescendants = false

	-- ===== OUTER RING (keep existing side effect) =====
	local ring = Instance.new("Frame")
	ring.Name = "CMRing"
	ring.Size = UDim2.new(1, 4, 1, 4)
	ring.Position = UDim2.new(0, -2, 0, -2)
	ring.BackgroundTransparency = 1
	ring.ZIndex = math.max(1, (host.ZIndex or 10) - 1)
	ring.Parent = host
	corner(ring, isCircle and 99 or 10)

	local st = Instance.new("UIStroke")
	st.Name = "CMStroke"
	st.Thickness = 1.8
	st.Transparency = 0.3
	st.Color = Color3.fromRGB(180, 210, 255)
	st.Parent = ring

	-- ===== INNER CLIP (glow stays INSIDE logo) =====
	local innerClip = Instance.new("Frame")
	innerClip.Name = "CMInnerClip"
	innerClip.Size = UDim2.new(1, 0, 1, 0)
	innerClip.BackgroundTransparency = 1
	innerClip.ClipsDescendants = true
	innerClip.ZIndex = (host.ZIndex or 10) + 2
	innerClip.Parent = host
	corner(innerClip, isCircle and 99 or 8)

	-- soft white fill pulse inside
	local innerGlow = Instance.new("Frame")
	innerGlow.Name = "CMInnerGlow"
	innerGlow.Size = UDim2.new(1, 0, 1, 0)
	innerGlow.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	innerGlow.BackgroundTransparency = 0.92
	innerGlow.BorderSizePixel = 0
	innerGlow.ZIndex = innerClip.ZIndex
	innerGlow.Parent = innerClip
	corner(innerGlow, isCircle and 99 or 8)

	local igGrad = Instance.new("UIGradient")
	igGrad.Rotation = 90
	igGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(200, 220, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 120, 255)),
	})
	igGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.5, 0.55),
		NumberSequenceKeypoint.new(1, 0.85),
	})
	igGrad.Parent = innerGlow

	-- bright core flash (appears then fades) — center of logo
	local core = Instance.new("Frame")
	core.Name = "CMCoreFlash"
	core.AnchorPoint = Vector2.new(0.5, 0.5)
	core.Position = UDim2.new(0.5, 0, 0.5, 0)
	core.Size = UDim2.new(0.35, 0, 0.35, 0)
	core.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	core.BackgroundTransparency = 1
	core.BorderSizePixel = 0
	core.ZIndex = innerClip.ZIndex + 1
	core.Parent = innerClip
	corner(core, 99)

	-- ===== FLOATING ICON only: expanding ring burst that appears then fades =====
	local burst = nil
	local burstStroke = nil
	if isCircle then
		burst = Instance.new("Frame")
		burst.Name = "CMBurst"
		burst.AnchorPoint = Vector2.new(0.5, 0.5)
		burst.Position = UDim2.new(0.5, 0, 0.5, 0)
		burst.Size = UDim2.new(1, 0, 1, 0)
		burst.BackgroundTransparency = 1
		burst.ZIndex = math.max(1, (host.ZIndex or 10) - 1)
		burst.Parent = host
		corner(burst, 99)
		burstStroke = Instance.new("UIStroke")
		burstStroke.Thickness = 2
		burstStroke.Transparency = 1
		burstStroke.Color = Color3.fromRGB(200, 230, 255)
		burstStroke.Parent = burst
	end

	task.spawn(function()
		local t0 = os.clock()
		local nextBurst = t0 + 1.2
		while host.Parent do
			local t = os.clock() - t0
			local s = (math.sin(t * 3.6) + 1) * 0.5

			-- outer ring pulse
			st.Transparency = 0.15 + s * 0.5
			st.Thickness = 1.4 + s * 1.2

			-- INNER glow pulse (loob ng logo)
			innerGlow.BackgroundTransparency = 0.78 + s * 0.18
			if imageObj then
				imageObj.ImageTransparency = s * 0.04
			end

			-- core flash every ~2s
			local flash = (math.sin(t * 2.2) + 1) * 0.5
			if flash > 0.85 then
				core.BackgroundTransparency = 0.35 + (1 - flash) * 2
				core.Size = UDim2.new(0.4 + flash * 0.15, 0, 0.4 + flash * 0.15, 0)
			else
				core.BackgroundTransparency = 1
			end

			-- floating burst expand
			if isCircle and burst and burstStroke and os.clock() >= nextBurst then
				nextBurst = os.clock() + 2.4
				burst.Size = UDim2.new(1, 0, 1, 0)
				burstStroke.Transparency = 0.2
				burstStroke.Thickness = 2.5
				TweenService:Create(burst, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Size = UDim2.new(1.85, 0, 1.85, 0),
				}):Play()
				TweenService:Create(burstStroke, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Transparency = 1,
					Thickness = 0.5,
				}):Play()
			end

			task.wait(0.03)
		end
	end)
end

