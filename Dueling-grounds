local function stripWeaponSuffix(skinName, weaponType)
	return skinName:gsub(weaponType, "")
end

local function applyCosmetic(handler, cosmeticName)
	local cosmetics = handler.WeaponInfo
		and handler.WeaponInfo.Cosmetics
		and handler.WeaponInfo.Cosmetics[cosmeticName]
	if not cosmetics then return false end
	local module = require(cosmetics)
	if type(module) ~= "table" or not module.WeaponModel then return false end
	local clone = module.WeaponModel:Clone()
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	local parent = handler.WeaponModel and handler.WeaponModel.Parent or handler.WeaponInstance
	if handler.WeaponModel then
		pcall(function() handler.WeaponModel:Destroy() end)
	end
	local blade = clone:FindFirstChild("Blade")
	local trail = blade and blade:FindFirstChild("Trail")
	local ultimateTrail = blade and blade:FindFirstChild("UltimateTrail")
	if trail then
		pcall(function()
			trail:SetAttribute("WidthScale", trail.WidthScale)
			trail:SetAttribute("MaxLength", trail.MaxLength)
			trail.Enabled = false
		end)
	end
	if ultimateTrail then
		pcall(function()
			ultimateTrail:SetAttribute("WidthScale", ultimateTrail.WidthScale)
			ultimateTrail:SetAttribute("MaxLength", ultimateTrail.MaxLength)
			ultimateTrail.Enabled = false
		end)
	end
	clone.Parent = parent
	handler.WeaponModel = clone
	handler.Blade = blade
	handler.Trail = trail
	handler.UltimateTrail = ultimateTrail
	handler.CurrentCosmetic = cosmeticName
	handler.CosmeticInfo = module
	return true
end

local function applySkinNow()
	local handler = getLocalHandler()
	local equipped = handler and handler:GetEquippedWeaponHandler()
	if not equipped then return false end
	local wtype = skinToWeapon[skinApplied]
	if not wtype then return false end
	local cosmetic = stripWeaponSuffix(skinApplied, wtype)
	if equipped.CurrentCosmetic == cosmetic then return true end
	local done, ok = false, false
	local thread = coroutine.create(function()
		ok = pcall(applyCosmetic, equipped, cosmetic)
		done = true
	end)
	pcall(setthreadcontext, thread, 8)
	pcall(coroutine.resume, thread)
	local deadline = os.clock() + 2
	while not done and os.clock() < deadline do
		task.wait()
	end
	return ok
end

track(RunService.Heartbeat:Connect(function()
	if not Toggles.CS_Apply then return end
	local handler = getLocalHandler()
	if not handler then return end
	local wtype = skinToWeapon[skinApplied]
	if not wtype or handler.EquippedWeapon ~= wtype then return end
	local equipped = handler:GetEquippedWeaponHandler()
	if not equipped then return end
	local cosmetic = stripWeaponSuffix(skinApplied, wtype)
	if equipped.CurrentCosmetic ~= cosmetic then
		pcall(applyCosmetic, equipped, cosmetic)
	end
end))


