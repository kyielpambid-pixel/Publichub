local function getLocalHandler()
	if not CharacterController then return nil end
	local ok, result = pcall(CharacterController.GetLocalCharacterHandler, CharacterController)
	if ok and type(result) == "table" and result.ActionManager then
		return result
	end
	return nil
end

local function forceParry(impactId)
	local handler = getLocalHandler()
	if not handler or handler.IsParrying == true then return end
	local actionManager = handler.ActionManager
	local prev = handler.IsParrying
	handler.IsParrying = true
	parryingFlag = true
	task.spawn(function()
		local deadline = os.clock() + 0.6
		while true do
			RunService.Heartbeat:Wait()
			local still = actionManager and actionManager.UnresolvedImpacts and actionManager.UnresolvedImpacts[impactId] ~= nil
			if not still or os.clock() > deadline then break end
		end
		local h = getLocalHandler()
		if h == handler and h.IsParrying == true then
			h.IsParrying = prev
		end
		parryingFlag = false
	end)
end

local function forceDodge(impactId)
	local handler = getLocalHandler()
	if not handler then return end
	local actionManager = handler.ActionManager
	local prev = handler.IsDodging
	handler.IsDodging = true
	task.spawn(function()
		local deadline = os.clock() + 0.6
		while true do
			RunService.Heartbeat:Wait()
			local still = actionManager and actionManager.UnresolvedImpacts and actionManager.UnresolvedImpacts[impactId] ~= nil
			if not still or os.clock() > deadline then break end
		end
		local h = getLocalHandler()
		if h == handler and h.IsDodging == true then
			h.IsDodging = prev
		end
	end)
end

