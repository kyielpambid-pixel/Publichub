local function tabMessages(parent, lines)
	if not lines or #lines == 0 then return end
	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, 0, 0, 0)
	box.AutomaticSize = Enum.AutomaticSize.Y
	box.BackgroundColor3 = Color3.fromRGB(8, 12, 10)
	box.BackgroundTransparency = 0.25
	box.BorderSizePixel = 0
	box.ZIndex = 9
	box.Parent = parent
	corner(box, 8)
	stroke(box, THEME.green, 1.4, 0.35)

	local lay = Instance.new("UIListLayout")
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Padding = UDim.new(0, 4)
	lay.Parent = box

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = box

	for i, raw in ipairs(lines) do
		local col = THEME.green
		local msg = raw
		if string.sub(raw, 1, 2) == "<>" then
			col = THEME.green
			msg = string.gsub(string.sub(raw, 3), "^%s+", "")
		elseif string.sub(raw, 1, 1) == "$" then
			col = THEME.accent2
			msg = string.gsub(string.sub(raw, 2), "^%s+", "")
		elseif string.sub(raw, 1, 1) == ">" then
			col = Color3.fromRGB(80, 160, 255)
			msg = string.gsub(string.sub(raw, 2), "^%s+", "")
		end
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Text = msg
		l.TextColor3 = col
		l.Font = Enum.Font.GothamMedium
		l.TextSize = 11
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.LayoutOrder = i
		l.ZIndex = 10
		l.Parent = box
	end
	return box
end

