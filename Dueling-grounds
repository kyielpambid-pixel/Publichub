MinBtn.MouseButton1Click:Connect(function() setVisible(false) end)
Orb.MouseButton1Click:Connect(function() setVisible(true) end)

do
	local dragging = false
	local dragInput, dragStart, startPos

	Orb.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = OrbWrap.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	Orb.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local d = input.Position - dragStart
			OrbWrap.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

UserInputService.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightShift
		or i.KeyCode == Enum.KeyCode.RightControl
		or i.KeyCode == Enum.KeyCode.K then
		setVisible(not Main.Visible)
	elseif i.KeyCode == Enum.KeyCode.G then
		Toggles.AP_Enabled = not Toggles.AP_Enabled
		notify("Auto Parry", Toggles.AP_Enabled and "ON" or "OFF", Toggles.AP_Enabled)
	elseif i.KeyCode == Enum.KeyCode.H then
		Toggles.GM_Enabled = not Toggles.GM_Enabled
		notify("God Mode", Toggles.GM_Enabled and "ON" or "OFF", Toggles.GM_Enabled)
	end
end)

