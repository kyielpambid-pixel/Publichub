	gui.StudsOffset=Vector3.new(0,2.5,0); gui.AlwaysOnTop=true; gui.Enabled=false; gui.Parent=lockInfo.Part
	local label=Instance.new("TextLabel")
	label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.TextScaled=true
	label.TextStrokeTransparency=0; label.Font=Enum.Font.GothamBold; label.Parent=gui
	LockESP[lockInfo.Container]={Info=lockInfo, Highlight=highlight, Gui=gui, Label=label}
