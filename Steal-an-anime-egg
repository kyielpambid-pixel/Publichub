	label.TextStrokeTransparency=0; label.Font=Enum.Font.GothamBold; label.Parent=gui
	local box=Instance.new("SelectionBox")
	box.Name="_MonsterBox"; box.Adornee=monster; box.SurfaceTransparency=1; box.LineThickness=0.04; box.Visible=false; box.Parent=monster
	MonsterESP[monster]={Highlight=highlight, Gui=gui, Label=label, Box=box}
end
local function UpdateMonsterESP()
	local root=GetRoot()
	for monster, data in pairs(MonsterESP) do
		if not monster.Parent then MonsterESP[monster]=nil
		else
			data.Highlight.Enabled=Config.ESP.MonsterHighlight
			data.Gui.Enabled=Config.ESP.MonsterDistance
			data.Box.Visible=Config.ESP.MonsterBox
			if Config.ESP.MonsterDistance and root then
				local mp=GetMonsterPart(monster)
				if mp then data.Label.Text=string.format("%s [%.0f studs]", monster.Name, (root.Position-mp.Position).Magnitude) end
			end
		end
	end
end
