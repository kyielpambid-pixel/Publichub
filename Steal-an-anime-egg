	highlight.Name="_MonsterHighlight"; highlight.Adornee=monster
	highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency=0.55; highlight.OutlineTransparency=0; highlight.Enabled=false; highlight.Parent=monster
	local gui=Instance.new("BillboardGui")
