local function GetCharacter() return player.Character end
local function GetRoot() local c=GetCharacter(); return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHumanoid() local c=GetCharacter(); return c and c:FindFirstChildOfClass("Humanoid") end
local function StopVelocity()
	local root=GetRoot(); if not root then return end
	root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
end
local function TeleportCharacter(targetCFrame)
	local character=GetCharacter(); if not character then return false end
	StopVelocity(); character:PivotTo(targetCFrame); StopVelocity(); return true
end
local function IsMonsterName(name)
	for _, wanted in ipairs(Config.MonsterNames) do if name==wanted then return true end end
	return false
end
local function GetMonsterPart(monster)
	if not monster then return nil end
	return monster:FindFirstChild("HumanoidRootPart") or monster.PrimaryPart or monster:FindFirstChildWhichIsA("BasePart", true)
end
local function GetMonsters()
	local result={}
	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("Model") and IsMonsterName(object.Name) then table.insert(result, object) end
	end
	return result
end
local function DistanceFromClosestMonster(position)
	local closest, found = math.huge, false
	for _, monster in ipairs(GetMonsters()) do
		local part=GetMonsterPart(monster)
		if part then found=true; local d=(position-part.Position).Magnitude; if d<closest then closest=d end end
	end
	return found and closest or math.huge
end
local function GetNearestMonster()
	local root=GetRoot(); if not root then return nil, math.huge end
	local nearest, bestDistance = nil, math.huge
	for _, monster in ipairs(GetMonsters()) do
		local part=GetMonsterPart(monster)
		if part then
			local d=(root.Position-part.Position).Magnitude
			if d<bestDistance then bestDistance=d; nearest=monster end
		end
	end
	return nearest, bestDistance
end
local function FaceTarget(position, targetPosition)
	local target=Vector3.new(targetPosition.X, position.Y, targetPosition.Z)
	if (target-position).Magnitude<0.1 then target=position+Vector3.new(0,0,-1) end
	return CFrame.lookAt(position, target)
end
local function FindSafestCirclePosition(part, radius, height, samples)
	if not part or not part.Parent then return nil, -math.huge end
	local bestPosition, bestMonsterDistance = nil, -math.huge
	samples=samples or 12
	for i=1, samples do
		local angle=((i-1)/samples)*math.pi*2
		local position=part.Position+Vector3.new(math.cos(angle)*radius, height, math.sin(angle)*radius)
		local monsterDistance=DistanceFromClosestMonster(position)
		if monsterDistance>bestMonsterDistance then bestMonsterDistance=monsterDistance; bestPosition=position end
	end
	return bestPosition, bestMonsterDistance
end
local function GetBackpacks()
	local folder=Workspace:FindFirstChild("BackPack"); if not folder then return {} end
	local result={}
	for _, backpack in ipairs(folder:GetChildren()) do
		local handle=backpack:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			local prompt=handle:FindFirstChild("SearchBackpack")
			if prompt and prompt:IsA("ProximityPrompt") then
				table.insert(result, {Model=backpack, Handle=handle, Prompt=prompt})
			end
		end
	end
	return result
end
local LockNames={"GreenLock","RedLock","WhiteLock"}
local function GetLockMainPart(container)
	if not container then return nil end
	local directLock=container:FindFirstChild("Lock")
	if directLock and directLock:IsA("BasePart") then return directLock end
	if container:IsA("BasePart") then return container end
	return container:FindFirstChildWhichIsA("BasePart", true)
end
local function GetLocks()
	local result={}
	for _, name in ipairs(LockNames) do
		local container=Workspace:FindFirstChild(name)
		if container then
			local part=GetLockMainPart(container)
			if part then table.insert(result, {Name=name, Container=container, Part=part}) end
		end
	end
	return result
end
local function GetLockTeleportCFrame(lockInfo)
	if not lockInfo or not lockInfo.Part then return nil end
	local part=lockInfo.Part
	local bestPosition, bestScore = nil, -math.huge
	for i=1,16 do
		local angle=((i-1)/16)*math.pi*2
		local candidate=part.Position+Vector3.new(math.cos(angle)*4, 0, math.sin(angle)*4)
		local position=candidate+Vector3.new(0,3,0)
		local monsterDistance=DistanceFromClosestMonster(position)
		if monsterDistance>bestScore then bestScore=monsterDistance; bestPosition=position end
	end
	if not bestPosition then bestPosition=part.Position+Vector3.new(0,2.5,4) end
	return FaceTarget(bestPosition, part.Position)
end
local function FindNearestLock()
	local root=GetRoot(); if not root then return nil end
	local best, bestDistance = nil, math.huge
	for _, lockInfo in ipairs(GetLocks()) do
		local d=(root.Position-lockInfo.Part.Position).Magnitude
		if d<bestDistance then bestDistance=d; best=lockInfo end
	end
	return best
end
local function FindSafestLock()
	local best, bestDistance = nil, -math.huge
	for _, lockInfo in ipairs(GetLocks()) do
		local d=DistanceFromClosestMonster(lockInfo.Part.Position)
		if d>bestDistance then bestDistance=d; best=lockInfo end
	end
	return best
end
local function TeleportToLock(lockInfo)
	if not lockInfo then return false end
	local cframe=GetLockTeleportCFrame(lockInfo)
	return cframe and TeleportCharacter(cframe)
end
local function GetExitTouchPart()
	local exit=Workspace:FindFirstChild("Exit"); if not exit then return nil end
	if exit:IsA("BasePart") then return exit end
	for _, object in ipairs(exit:GetDescendants()) do
		if object:IsA("BasePart") and object:FindFirstChildWhichIsA("TouchTransmitter") then return object end
	end
	for _, object in ipairs(exit:GetDescendants()) do
		if object:IsA("BasePart") and object:FindFirstChild("TouchInterest") then return object end
	end
	return exit:FindFirstChildWhichIsA("BasePart", true)
end
local function InstaWin()
	local root, character, exitPart = GetRoot(), GetCharacter(), GetExitTouchPart()
	if not root or not character or not exitPart then return end
	local oldCFrame=root.CFrame; StopVelocity()
	if type(firetouchinterest)=="function" then
		for _=1,5 do
			pcall(firetouchinterest, root, exitPart, 0); task.wait(0.03)
			pcall(firetouchinterest, root, exitPart, 1); task.wait(0.03)
		end
	end
	local exitCF=exitPart.CFrame
	local positions={exitCF*CFrame.new(0,2,5), exitCF*CFrame.new(0,2,1), exitCF*CFrame.new(0,2,0), exitCF*CFrame.new(0,2,-1), exitCF*CFrame.new(0,2,-5)}
	for _=1,3 do
		for _, cframe in ipairs(positions) do
			if not character.Parent then return end
			StopVelocity(); character:PivotTo(cframe); StopVelocity()
			RunService.Heartbeat:Wait(); RunService.Heartbeat:Wait()
		end
	end
	character:PivotTo(exitPart.CFrame); StopVelocity(); task.wait(0.35)
	if character.Parent and root.Parent and (root.Position-exitPart.Position).Magnitude<20 then
		character:PivotTo(oldCFrame); StopVelocity()
	end
end
local OriginalPromptTimes, PromptConnection = {}, nil
local function MakePromptInstant(prompt)
	if not prompt:IsA("ProximityPrompt") then return end
	if OriginalPromptTimes[prompt]==nil then OriginalPromptTimes[prompt]=prompt.HoldDuration end
	prompt.HoldDuration=0
end
local function SetInstantPrompts(enabled)
	Config.Auto.InstantPrompts=enabled
	if enabled then
		for _, object in ipairs(Workspace:GetDescendants()) do
			if object:IsA("ProximityPrompt") then MakePromptInstant(object) end
		end
		if PromptConnection then PromptConnection:Disconnect() end
		PromptConnection=Workspace.DescendantAdded:Connect(function(object)
			if Config.Auto.InstantPrompts and object:IsA("ProximityPrompt") then
				task.defer(function() if object.Parent then MakePromptInstant(object) end end)
			end
		end)
	else
		if PromptConnection then PromptConnection:Disconnect(); PromptConnection=nil end
		for prompt, oldTime in pairs(OriginalPromptTimes) do
			if prompt.Parent then prompt.HoldDuration=oldTime end
		end
		table.clear(OriginalPromptTimes)
	end
end
local function TriggerPrompt(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then return false end
	if type(fireproximityprompt)=="function" then
		local ok=pcall(fireproximityprompt, prompt); if ok then return true end
	end
	return pcall(function()
		prompt:InputHoldBegin()
		task.wait(Config.Auto.InstantPrompts and Config.Search.PressTime or math.max(prompt.HoldDuration, Config.Search.PressTime))
		prompt:InputHoldEnd()
	end)
end
local function TeleportToBackpack(info)
	if not info or not info.Handle or not info.Handle.Parent then return false, 0 end
	local position, monsterDistance = FindSafestCirclePosition(info.Handle, Config.Search.Radius, Config.Search.Height, 12)
	if not position or monsterDistance < Config.Search.MinimumCatDistance then return false, monsterDistance or 0 end
	return TeleportCharacter(FaceTarget(position, info.Handle.Position)), monsterDistance
end
local function SearchBackpack(info)
	if not info or not info.Handle.Parent or not info.Prompt.Parent then return true end
	local moved, monsterDistance = TeleportToBackpack(info)
	if not moved then return false, monsterDistance end
	task.wait(Config.Search.TeleportDelay)
	local root=GetRoot()
	if root and DistanceFromClosestMonster(root.Position) < Config.Search.MinimumCatDistance then return false, DistanceFromClosestMonster(root.Position) end
	StopVelocity()
	for _=1, Config.Search.Attempts do
		if not Config.Auto.SearchBackpacks then return false, 0 end
		if not info.Prompt.Parent or not info.Handle.Parent then return true, math.huge end
		TriggerPrompt(info.Prompt); task.wait(Config.Search.AfterPrompt)
		if not info.Prompt.Parent or not info.Prompt.Enabled then return true, math.huge end
	end
	return true, math.huge
end
local function UpdateSafeLocation()
	if Searching or SafetyBusy then return end
	local root=GetRoot(); if not root then return end
	local now=os.clock()
	if now-LastSafeSave < Config.Safety.SaveInterval then return end
	LastSafeSave=now
	if DistanceFromClosestMonster(root.Position) >= Config.Safety.RecordDistance then LastSafeCFrame=root.CFrame end
end
local function ReturnAfterSearch()
	local root=GetRoot(); if not root then return end
	if SearchStartCFrame and DistanceFromClosestMonster(SearchStartCFrame.Position)>=35 then TeleportCharacter(SearchStartCFrame); return end
	if LastSafeCFrame and DistanceFromClosestMonster(LastSafeCFrame.Position)>=35 then TeleportCharacter(LastSafeCFrame); return end
	if DistanceFromClosestMonster(root.Position)>=35 then return end
	local safestLock=FindSafestLock(); if safestLock then TeleportToLock(safestLock) end
end
local function AutoSearchBackpacks()
	if Searching then return end
	local root=GetRoot(); if not root then return end
	Searching=true; SearchStartCFrame=root.CFrame
	local waiting=GetBackpacks(); local total, searched, dangerRounds = #waiting, 0, 0
	while Config.Auto.SearchBackpacks and #waiting>0 do
		local madeProgress, nextRound = false, {}
		for _, info in ipairs(waiting) do
			if not Config.Auto.SearchBackpacks then break end
			local success = SearchBackpack(info)
			if success then searched=searched+1; madeProgress=true else table.insert(nextRound, info) end
			task.wait(Config.Search.BetweenBackpacks)
		end
		waiting=nextRound
		if #waiting==0 then break end
		dangerRounds=dangerRounds+1
		if dangerRounds>=Config.Search.MaxDangerRounds then break end
		task.wait(madeProgress and 0.08 or Config.Search.DangerRetryDelay)
	end
	Config.Auto.SearchBackpacks=false; Searching=false; ReturnAfterSearch()
	print("[KHUB] Auto Search finished", searched, "/", total)
end
local function AutoSafetyUpdate()
	UpdateSafeLocation()
	if not Config.Auto.AutoSafety or Searching or SafetyBusy then return end
	local monster, distance = GetNearestMonster()
	if not monster or distance > Config.Safety.DangerDistance then return end
	if os.clock()-LastSafetyTeleport < Config.Safety.Cooldown then return end
	SafetyBusy=true; LastSafetyTeleport=os.clock()
	if LastSafeCFrame and DistanceFromClosestMonster(LastSafeCFrame.Position) >= Config.Safety.DangerDistance then
		TeleportCharacter(LastSafeCFrame); task.wait(0.05); SafetyBusy=false; return
	end
	local lock=FindSafestLock()
	if lock then
		TeleportToLock(lock); task.wait(0.05)
		local _, afterDistance = GetNearestMonster()
		if afterDistance > Config.Safety.DangerDistance then SafetyBusy=false; return end
	end
	SafetyBusy=false
end
