-- AUTO LIFT (prompts)
task.spawn(function()
    while true do
        if F.liftOn then
            if not waitHRP(10) then task.wait(1)
            elseif F.liftAll then
                for idx=1,#MAPS do
                    if not F.liftOn then break end
                    local m = MAPS[idx]
                    if #m.lift>0 then
                        F.mapIndex = idx
                        refreshMapSel()
                        if F.autoEquip and m.equip then
                            tp(m.equip[1], m.equip[2], m.equip[3])
                            task.wait(0.2)
                            refreshCache(true)
                            for _=1,12 do
                                if iWord("equip", 18)>0 then break end
                                iWord("equip", 30)
                                task.wait(0.1)
                            end
                        end
                        for _,pos in ipairs(m.lift) do
                            if not F.liftOn then break end
                            spamPad(pos, F.padTime)
                        end
                    end
                end
            else
                local m = MAPS[F.mapIndex]
                if not m or #m.lift==0 then
                    task.wait(1)
                else
                    if F.autoEquip and m.equip and not F.equipped[F.mapIndex] then
                        tp(m.equip[1], m.equip[2], m.equip[3])
                        task.wait(0.2)
                        refreshCache(true)
                        for _=1,12 do
                            if iWord("equip", 18)>0 then break end
                            iWord("equip", 30)
                            task.wait(0.1)
                        end
                        F.equipped[F.mapIndex] = true
                    end
                    for _,pos in ipairs(m.lift) do
                        if not F.liftOn then break end
                        spamPad(pos, F.padTime)
                    end
                end
            end
        else
            task.wait(0.25)
        end
    end
end)

-- AUTO ROLL
task.spawn(function()
    while true do
        if F.rollOn then
            if waitHRP(10) then
                if F.rollAll then
                    for idx=1,#ROLLS do
                        if not F.rollOn then break end
                        F.rollIndex = idx
                        rollOnce(idx)
                    end
                else
                    rollOnce(F.rollIndex)
                end
            end
        else
            task.wait(0.25)
        end
    end
end)

