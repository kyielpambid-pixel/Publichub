local function formatNumber(n)
    local num = tonumber(n)
    if not num then return tostring(n or "0") end
    for _, item in ipairs(Suffixes) do
        if num >= item[1] then
            return string.format("%.2f%s", num / item[1], item[2])
        end
    end
    return tostring(math.floor(num))
end

