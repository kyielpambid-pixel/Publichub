local pCache, cTime = {}, 0
local function refreshCache(force)
    local n = os.clock()
    if not force and (n-cTime)<0.5 then return end
    cTime = n
    pCache = {}
    for _,d in ipairs(WS:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            table.insert(pCache, {obj=d, kind="prompt"})
        elseif d:IsA("ClickDetector") then
            table.insert(pCache, {obj=d, kind="click"})
        end
    end
end

local function ePos(e)
    local p = e.obj.Parent
    if not p then return nil end
    if p:IsA("BasePart") then return p.Position end
    if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent.Position end
    if p:IsA("Model") then
        local ok,pos = pcall(function() return p:GetPivot().Position end)
        if ok then return pos end
    end
    local pt = p:FindFirstChildWhichIsA("BasePart", true)
    return pt and pt.Position or nil
end

local function matchAny(e, words)
    local o = e.obj
    local t = string.lower(tostring(o.ActionText or "").." "..tostring(o.ObjectText or "").." "..o.Name)
    for _,w in ipairs(words) do
        if t:find(w,1,true) then return true end
    end
    return false
end

local function iFire(p)
    if not p or not p.Parent then return false end
    return pcall(function()
        local o = p.HoldDuration
        if o~=0 then p.HoldDuration=0 end
        if FPP then FPP(p) else p:InputHoldBegin(); p:InputHoldEnd() end
        if o~=0 then p.HoldDuration=o end
    end)
end

local function iWord(word, range)
    local h = hrp()
    if not h then return 0 end
    refreshCache()
    local n = 0
    local r = range or 18
    for _,e in ipairs(pCache) do
        if e.kind=="prompt" and matchAny(e,{word}) then
            local p = ePos(e)
            if p and (p-h.Position).Magnitude<=r then
                iFire(e.obj)
                n = n+1
            end
        end
    end
    return n
end

local function iBurst(n, range)
    local h = hrp()
    if not h then return 0 end
    refreshCache()
    local fired = 0
    local r = range or 18
    for _,e in ipairs(pCache) do
        if e.kind=="prompt" and matchAny(e,{"lift"}) then
            local p = ePos(e)
            if p and (p-h.Position).Magnitude<=r then
                for _=1,n do iFire(e.obj) end
                fired = fired+n
            end
        end
    end
    return fired
end

local function fireSignal(g)
    if not g or not g.Parent then return false end
    local fired = false
    if type(getconnections)=="function" then
        local ok1,c1 = pcall(getconnections, g.MouseButton1Click)
        if ok1 and c1 then for _,c in ipairs(c1) do pcall(function() c:Fire() end) end; fired=true end
        local ok2,c2 = pcall(getconnections, g.Activated)
        if ok2 and c2 then for _,c in ipairs(c2) do pcall(function() c:Fire() end) end; fired=true end
    end
    if not fired and type(firesignal)=="function" then
        pcall(firesignal, g.MouseButton1Click)
        pcall(firesignal, g.Activated)
        fired = true
    end
    if not fired then
        pcall(function() if g.MouseButton1Click then g.MouseButton1Click:Fire(); fired=true end end)
        pcall(function() if g.Activated then g.Activated:Fire(); fired=true end end)
    end
    return fired
end

