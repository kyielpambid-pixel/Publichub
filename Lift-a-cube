function refreshConfigList()
    for _, child in ipairs(ListFrame:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    listConfigs()
    if #configList == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1,-8,0,24)
        empty.BackgroundTransparency = 1
        empty.Text = "No configs yet"
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 11
        empty.TextColor3 = T.dim
        empty.ZIndex = 12
        empty.Parent = ListFrame
    else
        for i, name in ipairs(configList) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1,-8,0,26)
            b.BackgroundColor3 = (selectedConfig == name) and T.violet or Color3.fromRGB(30,22,42)
            b.BackgroundTransparency = (selectedConfig == name) and 0.3 or 0.2
            b.Text = "  " .. name
            b.Font = Enum.Font.GothamBold
            b.TextSize = 11
            b.TextColor3 = (selectedConfig == name) and T.gold or T.text
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.ZIndex = 12
            b.LayoutOrder = i
            b.Parent = ListFrame
            corner(b, 5)
            b.MouseButton1Click:Connect(function()
                selectedConfig = name
                NameBox.Text = name
                SaveStatus.Text = "Selected: " .. name
                SaveStatus.TextColor3 = T.gold
                refreshConfigList()
            end)
        end
    end
    ListFrame.CanvasSize = UDim2.new(0,0,0,math.max(90, #configList*30+8))
end

btn(SaveCard, "Load Config", function()
    local name = selectedConfig or NameBox.Text
    if not name or name == "" then SaveStatus.Text = "Status: Select a config"; return end
    local ok, data = pcall(function()
        if not readfile or not isfile then error("no readfile") end
        local path = CONFIG_FOLDER .. "/" .. name .. ".json"
        if not isfile(path) then error("not found") end
        return HS:JSONDecode(readfile(path))
    end)
    if ok and type(data) == "table" and type(data.Settings) == "table" then
        local s = data.Settings
        if tonumber(s.mapIndex) then F.mapIndex = math.clamp(math.floor(s.mapIndex), 1, #MAPS) end
        if tonumber(s.rollIndex) then F.rollIndex = math.clamp(math.floor(s.rollIndex), 1, #ROLLS) end
        if type(s.autoEquip) == "boolean" then F.autoEquip = s.autoEquip end
        if type(s.autoTrain) == "boolean" then F.autoTrain = s.autoTrain end
        if type(s.remote) == "boolean" then F.remote = s.remote end
        if tonumber(s.burst) then F.burst = math.clamp(math.floor(s.burst), 1, 30) end
        if type(s.autoBuy) == "boolean" then F.autoBuy = s.autoBuy end
        if tonumber(s.padTime) then F.padTime = math.clamp(s.padTime, 0.1, 10) end
        if tonumber(s.rollTime) then F.rollTime = math.clamp(s.rollTime, 0.2, 10) end
        if type(s.goodWords) == "string" and s.goodWords ~= "" then F.goodWords = s.goodWords end
        if tonumber(s.tapRate) then F.tapRate = math.clamp(s.tapRate, 0.005, 1) end
        rebuildGood()
        F.equipped = {}
        refreshMapSel()
        SaveStatus.Text = "Status: Loaded \"" .. name .. "\""
        SaveStatus.TextColor3 = T.green
    else
        SaveStatus.Text = "Status: Failed"; SaveStatus.TextColor3 = T.red
    end
end)

btn(SaveCard, "Delete Selected", function()
    local name = selectedConfig
    if not name or name == "" then SaveStatus.Text = "Status: Select a config"; return end
    local ok = pcall(function() if delfile then delfile(CONFIG_FOLDER .. "/" .. name .. ".json") end end)
    if ok then
        SaveStatus.Text = "Status: Deleted"; SaveStatus.TextColor3 = T.green
        selectedConfig = nil; NameBox.Text = ""
        refreshConfigList()
    end
end, T.red)

btn(SaveCard, "Refresh List", function()
    refreshConfigList()
    SaveStatus.Text = "Status: Refreshed"
    SaveStatus.TextColor3 = T.dim
end)

