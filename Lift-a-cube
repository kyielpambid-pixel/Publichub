local function switchPage(name, title)
    for k,p in pairs(Pages) do p.Visible = (k==name) end
    PTitle.Text = title or name
    TB.Active = name
    for id,btn in pairs(TB) do
        if type(id)=="string" and not id:find("_") then
            local active = (id==name)
            local iF = TB[id.."_F"]
            local gl = TB[id.."_G"]
            local br = TB[id.."_B"]
            local lb = TB[id.."_L"]
            if active then
                TS:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency=0.05}):Play()
                if iF then TS:Create(iF, TweenInfo.new(0.2), {BackgroundTransparency=0}):Play() end
                if gl then TS:Create(gl, TweenInfo.new(0.3), {BackgroundTransparency=0.55}):Play() end
                if br then br.Visible = true end
                if lb then lb.TextColor3 = T.gold end
            else
                TS:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency=0.25}):Play()
                if iF then TS:Create(iF, TweenInfo.new(0.2), {BackgroundTransparency=0.15}):Play() end
                if gl then TS:Create(gl, TweenInfo.new(0.25), {BackgroundTransparency=0.85}):Play() end
                if br then br.Visible = false end
                if lb then lb.TextColor3 = T.text end
            end
        end
    end
end

