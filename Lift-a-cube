local function switchPage(name, title)
    for k,p in pairs(Pages) do p.Visible = (k==name) end
    PTitle.Text = title or name
    TB.Active = name
    for id,btn in pairs(TB) do
        if type(id)=="string" and not id:find("_") then
            local active = (id==name)
            local iF = TB[id.."_F"]
            local gl = TB[id.."_G"]
            local br = TB[id.."_B"]
            local lb = TB[id.."_L"]
            if active then
                TS:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency=0.05}):Play()
                if iF then TS:Create(iF, TweenInfo.new(0.2), {BackgroundTransparency=0}):Play() end
