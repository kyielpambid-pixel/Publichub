local function findBtns(word)
    word = string.lower(word or "")
    local out = {}
    local pg = lp:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _,g in ipairs(pg:GetDescendants()) do
            if (g:IsA("TextButton") or g:IsA("ImageButton")) and g.Visible then
                local t = ""
                if g:IsA("TextButton") then t = g.Text end
                t = string.lower(tostring(t~="" and t or g.Name))
                if word=="" or t:find(word,1,true) then table.insert(out, g) end
            end
        end
    end
    for _,d in ipairs(WS:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
            local t = ""
            if d:IsA("TextButton") then t = d.Text end
            t = string.lower(tostring(t~="" and t or d.Name))
            if word=="" or t:find(word,1,true) then table.insert(out, d) end
        end
    end
    return out
end

local function clickTrainOnce()
    local btns = findBtns("train")
    for _,g in ipairs(btns) do
        if g and g.Parent and g.Visible then
            fireSignal(g)
        end
    end
    if #btns == 0 then
        doScreenTap()
    end
end

local function clickBtns(word)
    local out = findBtns(word)
    local hit = false
    for _,g in ipairs(out) do if fireSignal(g) then hit = true end end
    return hit
end

local goodList = {}
local function rebuildGood()
    goodList = {}
    for w in string.gmatch(string.lower(F.goodWords), "[^,%s]+") do
        table.insert(goodList, w)
    end
end
rebuildGood()

local function scanGood()
    local pg = lp:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _,g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextLabel") and g.Visible and g.Text~="" then
            local t = string.lower(g.Text)
            for _,w in ipairs(goodList) do
                if t:find(w,1,true) then return w end
            end
        end
    end
    return nil
end

local function spamPad(pos, dur)
    if not waitHRP(10) then return false end
    tp(pos[1], pos[2], pos[3])
    task.wait(0.05)
    refreshCache(true)
    local tEnd = os.clock()+dur
    while os.clock()<tEnd do
        if not F.liftOn then return false end
        local n = iBurst(F.burst)
        S.lifts = S.lifts+n
        if F.remote and Remote then
            for _=1,F.burst do
                pcall(function() Remote:FireServer({{Function="FinishLift", Args={F.arg}}, "y"}) end)
            end
        end
        RS.Heartbeat:Wait()
    end
    return true
end

local function rollOnce(idx)
    local r = ROLLS[idx]
    if not r then return false end
    if not waitHRP(10) then return false end
    tp(r.cf[1], r.cf[2], r.cf[3])
    task.wait(0.1)
    refreshCache(true)
    local tEnd = os.clock()+F.rollTime
    while os.clock()<tEnd do
        if not F.rollOn then return false end
        iWord("roll", 16)
        RS.Heartbeat:Wait()
    end
    if F.autoBuy then
        local g = scanGood()
        if g then
            clickBtns("buy")
            task.wait(0.2)
        end
    end
    clickBtns("next")
    task.wait(0.05)
    return true
end

