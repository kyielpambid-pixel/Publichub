UIS.TouchStarted:Connect(function(touch, gameProcessed)
    if gameProcessed then return end
    local vp = WS.CurrentCamera and WS.CurrentCamera.ViewportSize or Vector2.new(500, 900)
    local tx, ty = touch.Position.X, touch.Position.Y
    if tx <= vp.X * JOYSTICK_ZONE_X and ty >= vp.Y * (1 - JOYSTICK_ZONE_Y) then
        joystickTouch = touch
        joystickStart = Vector2.new(tx, ty)
        joystickActive = true
        if joyVisual then
            joyVisual.Position = UDim2.fromOffset(tx - 70, ty - 70)
            joyVisual.Visible = true
        end
    end
end)

UIS.TouchMoved:Connect(function(touch, gameProcessed)
    if joystickActive and joystickTouch and touch == joystickTouch then
        local d = Vector2.new(touch.Position.X, touch.Position.Y) - joystickStart
        local mag = math.sqrt(d.X*d.X + d.Y*d.Y)
        if mag > JOYSTICK_RADIUS then
            d = Vector2.new(d.X/mag*JOYSTICK_RADIUS, d.Y/mag*JOYSTICK_RADIUS)
        end
        if joyKnob then
            joyKnob.Position = UDim2.new(0.5, -30 + d.X, 0.5, -30 + d.Y)
        end
        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            local dir = Vector3.new(d.X / JOYSTICK_RADIUS, 0, d.Y / JOYSTICK_RADIUS)
            local moveDir = WS.CurrentCamera.CFrame:VectorToWorldSpace(dir)
            hum:Move(moveDir, false)
        end
    end
end)

UIS.TouchEnded:Connect(function(touch, gameProcessed)
    if joystickActive and joystickTouch and touch == joystickTouch then
        joystickActive = false
        joystickTouch = nil
        joystickStart = nil
        if joyKnob then
            joyKnob.Position = UDim2.new(0.5, -30, 0.5, -30)
        end
        if joyVisual then
            joyVisual.Visible = false
        end
        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:Move(Vector3.new(0,0,0), false)
        end
    end
end)

