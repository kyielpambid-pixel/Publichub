    nameLabel.TextColor3 = Settings.ESPOutlineColor
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Text = player.DisplayName
    nameLabel.Visible = false
    nameLabel.Parent = billboard
    objects.Name = nameLabel

    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Name = "Distance"
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Size = UDim2.new(1, 0, 0, 18)
    distanceLabel.Position = UDim2.fromOffset(0, 20)
    distanceLabel.Font = Enum.Font.Gotham
    distanceLabel.TextSize = 11
    distanceLabel.TextColor3 = Color3.fromRGB(210, 210, 210)
    distanceLabel.TextStrokeTransparency = 0
    distanceLabel.Visible = false
    distanceLabel.Parent = billboard
    objects.Distance = distanceLabel

    local healthLabel = Instance.new("TextLabel")
    healthLabel.Name = "Health"
    healthLabel.BackgroundTransparency = 1
    healthLabel.Size = UDim2.new(1, 0, 0, 18)
    healthLabel.Position = UDim2.fromOffset(0, 38)
    healthLabel.Font = Enum.Font.Gotham
    healthLabel.TextSize = 11
    healthLabel.TextStrokeTransparency = 0
    healthLabel.Visible = false
    healthLabel.Parent = billboard
    objects.Health = healthLabel

    ESPObjects[player] = objects
    return objects
end

local function UpdateESP()
    if not Settings.ESP then
        HideAllESP()
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local character = player.Character
        if not character then
            DestroyESP(player)
            continue
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local head = character:FindFirstChild("Head")
        if not humanoid or humanoid.Health <= 0 or not head then
            DestroyESP(player)
            continue
        end
        local objects = CreateESP(player, character)
        local isTarget = target ~= nil and target:IsDescendantOf(character)
        if Settings.TargetOnly and not isTarget then
            HideESP(player)
            continue
        end
        objects.Highlight.FillColor = Settings.ESPColor
        objects.Highlight.OutlineColor = Settings.ESPOutlineColor
        objects.Highlight.FillTransparency = Settings.ESPFillTransparency
        objects.Highlight.Enabled = Settings.BoxESP
        objects.Name.Text = player.DisplayName
        objects.Name.TextColor3 = Settings.ESPOutlineColor
        objects.Name.Visible = Settings.NameESP

        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            local camera = Workspace.CurrentCamera
            if camera then
                local distance = (camera.CFrame.Position - root.Position).Magnitude
                objects.Distance.Text = string.format("%.0f studs", distance)
                objects.Distance.Visible = Settings.DistanceESP
            end
        end

        local health = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
        objects.Health.Text = string.format("HP: %d / %d", health, humanoid.MaxHealth)
        local ratio = humanoid.Health / math.max(humanoid.MaxHealth, 1)
        objects.Health.TextColor3 = Color3.fromRGB(255 * (1 - ratio), 255 * ratio, 0)
        objects.Health.Visible = Settings.HealthESP

        objects.Billboard.Enabled = Settings.NameESP or Settings.DistanceESP or Settings.HealthESP
    end
end

