local CFGFolder = "BloodZone"

local function EnsureCFGFolder()
    if not makefolder or not isfolder then return end
    if not isfolder(CFGFolder) then
        pcall(function()
            makefolder(CFGFolder)
        end)
    end
end

local function GetCFGPath(name)
    return CFGFolder .. "/" .. tostring(name) .. ".json"
end

local function ColorToTable(color)
    return { R = color.R, G = color.G, B = color.B }
end

local function TableToColor(value, fallback)
    if type(value) ~= "table" then return fallback end
    if type(value.R) ~= "number" or type(value.G) ~= "number" or type(value.B) ~= "number" then return fallback end
    return Color3.new(value.R, value.G, value.B)
end

local function SaveCFG(name)
    if not writefile then return false end
    EnsureCFGFolder()
    local data = {
        Enabled = Settings.Enabled,
        TargetMethod = Settings.TargetMethod,
        FOVCheck = Settings.FOVCheck,
        VisibilityCheck = Settings.VisibilityCheck,
        Wallbang = Settings.Wallbang,
        FOV = Settings.FOV,
        FOVCircle = Settings.FOVCircle,
        ESP = Settings.ESP,
        BoxESP = Settings.BoxESP,
        NameESP = Settings.NameESP,
        DistanceESP = Settings.DistanceESP,
        HealthESP = Settings.HealthESP,
        TargetOnly = Settings.TargetOnly,
        SilentAimLimit = Settings.SilentAimLimit,
        ESPFillTransparency = Settings.ESPFillTransparency,
        ESPColor = ColorToTable(Settings.ESPColor),
        ESPOutlineColor = ColorToTable(Settings.ESPOutlineColor),
        FOVColor = ColorToTable(Settings.FOVColor),
    }
    local success, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not success then return false end
    local saved = pcall(function()
        writefile(GetCFGPath(name), encoded)
    end)
    if saved then Settings.CFGName = name end
    return saved
end

local function LoadCFG(name)
    if not readfile or not isfile then return false end
    local path = GetCFGPath(name)
    if not isfile(path) then return false end
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not success or type(data) ~= "table" then return false end
    if data.Enabled ~= nil then Settings.Enabled = data.Enabled end
    if data.TargetMethod == "Closest" or data.TargetMethod == "FOV" then Settings.TargetMethod = data.TargetMethod end
    if data.FOVCheck ~= nil then Settings.FOVCheck = data.FOVCheck end
    if data.VisibilityCheck ~= nil then Settings.VisibilityCheck = data.VisibilityCheck end
    if data.Wallbang ~= nil then Settings.Wallbang = data.Wallbang end
    if type(data.FOV) == "number" then Settings.FOV = math.clamp(data.FOV, 0, 500) end
    if data.FOVCircle ~= nil then Settings.FOVCircle = data.FOVCircle end
    if data.ESP ~= nil then Settings.ESP = data.ESP end
    if data.BoxESP ~= nil then Settings.BoxESP = data.BoxESP end
    if data.NameESP ~= nil then Settings.NameESP = data.NameESP end
    if data.DistanceESP ~= nil then Settings.DistanceESP = data.DistanceESP end
    if data.HealthESP ~= nil then Settings.HealthESP = data.HealthESP end
    if data.TargetOnly ~= nil then Settings.TargetOnly = data.TargetOnly end
    if type(data.SilentAimLimit) == "number" then Settings.SilentAimLimit = math.clamp(data.SilentAimLimit, 1, 1000) end
    if type(data.ESPFillTransparency) == "number" then Settings.ESPFillTransparency = math.clamp(data.ESPFillTransparency, 0, 1) end
    Settings.ESPColor = TableToColor(data.ESPColor, Settings.ESPColor)
    Settings.ESPOutlineColor = TableToColor(data.ESPOutlineColor, Settings.ESPOutlineColor)
    Settings.FOVColor = TableToColor(data.FOVColor, Settings.FOVColor)
    Settings.CFGName = name
    return true
end

local function DestroyESP(player)
    local objects = ESPObjects[player]
    if not objects then return end
    if objects.Highlight then objects.Highlight:Destroy() end
    if objects.Billboard then objects.Billboard:Destroy() end
    ESPObjects[player] = nil
end

local function DestroyAllESP()
    for player in pairs(ESPObjects) do
        DestroyESP(player)
    end
    table.clear(ESPObjects)
end

local function HideESP(player)
    local objects = ESPObjects[player]
    if not objects then return end
    if objects.Highlight then objects.Highlight.Enabled = false end
    if objects.Billboard then objects.Billboard.Enabled = false end
end

local function HideAllESP()
    for player in pairs(ESPObjects) do
        HideESP(player)
    end
end

local function GetTargetPart(character)
    if not character then return nil end
    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("Torso")
    local parts = {}
    if head and head:IsA("BasePart") then table.insert(parts, head) end
    if torso and torso:IsA("BasePart") then table.insert(parts, torso) end
    if #parts == 0 then return nil end
    return parts[math.random(1, #parts)]
end

local function IsWithinSilentAimDistance(part)
    if not part then return false end
    local camera = Workspace.CurrentCamera
    if not camera then return false end
    local distance = (camera.CFrame.Position - part.Position).Magnitude
    return distance <= Settings.SilentAimLimit
end

local function IsVisible(part)
    if not part then return false end
    local camera = Workspace.CurrentCamera
    local character = LocalPlayer.Character
    if not camera or not character then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    params.IgnoreWater = true
    local origin = camera.CFrame.Position
    local direction = part.Position - origin
    local result = Workspace:Raycast(origin, direction, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(part.Parent)
end

local function GetScreenDistance(part)
    local camera = Workspace.CurrentCamera
    if not camera or not part then return math.huge, false end
    local position, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen then return math.huge, false end
    local center = camera.ViewportSize / 2
    local distance = (Vector2.new(position.X, position.Y) - center).Magnitude
    return distance, true
end

local function IsInFOV(part)
    local distance, onScreen = GetScreenDistance(part)
    return onScreen and distance <= Settings.FOV
end

local function IsValidTarget(player)
    if player == LocalPlayer then return false end
    local character = player.Character
    if not character then return false end
    if character:GetAttribute("Immune") == true then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local part = GetTargetPart(character)
    if not part then return false end
    if not IsWithinSilentAimDistance(part) then return false end
    if Settings.FOVCheck then
        if not IsInFOV(part) then return false end
    end
    if not Settings.Wallbang and Settings.VisibilityCheck then
        if not IsVisible(part) then return false end
    end
    return true
end

local function GetClosestTarget()
    local closest = nil
    local closestDistance = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if not IsValidTarget(player) then continue end
        local character = player.Character
        local part = GetTargetPart(character)
        if not part then continue end
        if not IsWithinSilentAimDistance(part) then continue end
        local distance, onScreen = GetScreenDistance(part)
        if not onScreen then continue end
        if distance < closestDistance then
            closestDistance = distance
            closest = part
        end
    end
    return closest
end

local function GetFOVTarget()
    local closest = nil
    local closestDistance = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if not IsValidTarget(player) then continue end
        local character = player.Character
        local part = GetTargetPart(character)
        if not part then continue end
        if not IsWithinSilentAimDistance(part) then continue end
        local distance, onScreen = GetScreenDistance(part)
        if not onScreen then continue end
        if distance > Settings.FOV then continue end
        if distance < closestDistance then
            closestDistance = distance
            closest = part
        end
    end
    return closest
end

local function GetTarget()
    if not Settings.Enabled then return nil end
    if Settings.TargetMethod == "FOV" then return GetFOVTarget() end
    return GetClosestTarget()
end

