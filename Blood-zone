    local highlight = Instance.new("Highlight")
    highlight.Name = "BloodZoneESP"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Settings.ESPColor
    highlight.OutlineColor = Settings.ESPOutlineColor
    highlight.FillTransparency = Settings.ESPFillTransparency
    highlight.OutlineTransparency = 0
    highlight.Adornee = character
    highlight.Enabled = false
    highlight.Parent = character
    objects.Highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "BloodZoneInfo"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(180, 70)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
