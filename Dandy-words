local function espLoop()
	while alive() do
		if CFG.running then
		pcall(function()
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local rootPos = root and root.Position

			for obj in pairs(ESP_CACHE) do
				if not obj.Parent then clearEsp(obj) end
			end

			local room = workspace:FindFirstChild("CurrentRoom")

			-- Machines
			if CFG.machineEsp and room then
				for _, m in ipairs(room:GetDescendants()) do
					if m:IsA("Model") and not ESP_CACHE[m] then
						local stats = m:FindFirstChild("Stats")
						if stats then
							local cur = stats:FindFirstChild("CurrentAmount")
							local req = stats:FindFirstChild("RequiredAmount")
							if cur and req then
								local pct = math.floor(((tonumber(cur.Value) or 0) / math.max(tonumber(req.Value) or 1, 1)) * 100)
								local done = pct >= 100
								applyEsp(
									m,
									done and COL.machineDone or COL.machine,
									done and "Machine [DONE]" or string.format("Machine [%d%%]", pct),
									"machine"
								)
							end
						end
					end
				end
			elseif not CFG.machineEsp then
				clearCategory("machine")
			end

			-- Twisteds
			if CFG.twistedEsp then
				local monsters = (room and room:FindFirstChild("Monsters", true)) or workspace:FindFirstChild("Monsters", true)
				if monsters then
					for _, mon in ipairs(monsters:GetChildren()) do
						if mon:IsA("Model") and not ESP_CACHE[mon] then
							applyEsp(mon, COL.twisted, "Twisted " .. mon.Name:gsub("Monster", ""), "twisted")
						end
					end
				end
			else
				clearCategory("twisted")
			end

			-- Tapes
			if CFG.tapeEsp and room then
				for _, d in ipairs(room:GetDescendants()) do
					local n = d.Name:lower()
					if (n == "tape" or n == "cassette") and (d:IsA("Model") or (d:IsA("BasePart") and not d.Parent:IsA("Model"))) and not ESP_CACHE[d] then
						applyEsp(d, COL.tape, "TAPE", "tape")
					end
				end
			elseif not CFG.tapeEsp then
				clearCategory("tape")
			end

			-- Capsules
			if CFG.capsuleEsp and room then
				for _, d in ipairs(room:GetDescendants()) do
					local n = d.Name:lower()
					if (n:find("capsule") or n:find("research")) and (d:IsA("Model") or (d:IsA("BasePart") and not d.Parent:IsA("Model"))) and not ESP_CACHE[d] then
						applyEsp(d, COL.capsule, "RESEARCH", "capsule")
					end
				end
			elseif not CFG.capsuleEsp then
				clearCategory("capsule")
			end

			-- Items
			if CFG.itemEsp and room then
				for _, d in ipairs(room:GetDescendants()) do
					local n = d.Name:lower()
					local inItems = d.Parent and d.Parent.Name == "Items" and d:IsA("Model") and not n:find("tape") and not n:find("capsule")
					local named = d:IsA("Model") and (
						n:find("medkit") or n:find("bandage") or n:find("popcorn") or n:find("flashlight")
						or n:find("speedcandy") or n:find("skillcheckcandy") or n:find("candybowl")
					)
					if (inItems or named) and not ESP_CACHE[d] then
						local label = d.Name:gsub("Candy", " Candy"):gsub("Bowl", " Bowl")
						applyEsp(d, COL.item, label, "item")
					end
				end
			elseif not CFG.itemEsp then
				clearCategory("item")
			end

			-- Elevators
			if CFG.elevatorEsp then
				local elevators = workspace:FindFirstChild("Elevators")
				if elevators then
					for _, e in ipairs(elevators:GetChildren()) do
						if e.Name == "Elevator" and e:IsA("Model") and not ESP_CACHE[e] then
							applyEsp(e, COL.elevator, "ELEVATOR", "elevator")
						end
					end
				end
				if room then
					for _, e in ipairs(room:GetDescendants()) do
						if e.Name == "Elevator" and e:IsA("Model") and not e:GetFullName():find("Fake") and not ESP_CACHE[e] then
							applyEsp(e, COL.elevator, "ELEVATOR", "elevator")
						end
					end
				end
			else
				clearCategory("elevator")
			end

			-- Instant prompt + auto pickup
			if CFG.autoPickup or CFG.instantPrompt then
				for _, prompt in ipairs(workspace:GetDescendants()) do
					if prompt:IsA("ProximityPrompt") and prompt.Enabled ~= false then
						if CFG.instantPrompt then
							prompt.HoldDuration = 0
						end
						if CFG.autoPickup and prompt.Parent and rootPos then
							local pn = prompt.Parent.Name:lower()
							local pp = (prompt.Parent.Parent and prompt.Parent.Parent.Name:lower()) or ""
							local action = prompt.ActionText and prompt.ActionText:lower() or ""
							local isLoot = pn:find("tape") or pn:find("cassette") or pn:find("medkit") or pn:find("bandage")
								or pn:find("capsule") or pn:find("research") or pn:find("candy") or pn:find("popcorn")
								or pp:find("tape") or pp:find("cassette") or pp:find("medkit") or pp:find("bandage")
								or pp:find("capsule") or pp:find("research") or action:find("pick")
							if isLoot then
								local pos = (prompt.Parent:IsA("BasePart") and prompt.Parent.Position)
									or (prompt.Parent:IsA("Model") and prompt.Parent:GetPivot().Position)
									or prompt.Parent.Position
								if pos and (pos - rootPos).Magnitude < 12 then
									CFG._pickCd = CFG._pickCd or {}
									local now = os.clock()
									if not CFG._pickCd[prompt] or (now - CFG._pickCd[prompt]) > 1 then
										CFG._pickCd[prompt] = now
										pcall(function() fireproximityprompt(prompt) end)
									end
								end
							end
						end
					end
				end
			end

			-- Distance labels
			if rootPos then
				for obj, data in pairs(ESP_CACHE) do
					if data.tl then
						local pos = getPos(obj)
						if pos then
							local dist = math.floor((pos - rootPos).Magnitude)
							local stats = obj:FindFirstChild("Stats")
							if stats then
								local cur = stats:FindFirstChild("CurrentAmount")
								local req = stats:FindFirstChild("RequiredAmount")
								local completed = stats:FindFirstChild("Completed")
								if cur and req then
									local pct = math.floor(((tonumber(cur.Value) or 0) / math.max(tonumber(req.Value) or 1, 1)) * 100)
									local done = (completed and completed.Value == true) or pct >= 100
									data.tl.Text = string.format("%s [%dm]", done and "Machine [DONE]" or string.format("Machine [%d%%]", pct), dist)
									local c = done and COL.machineDone or COL.machine
									data.tl.TextColor3 = c
									if data.h then
										data.h.FillColor = c
										data.h.OutlineColor = c
									end
								end
							else
								local base = data.baseLabel or data.tl.Text:gsub("%s*%[%d+m%]$", "")
								data.tl.Text = string.format("%s [%dm]", base, dist)
							end
						end
					end
				end
			end
		end)
		end

		task.wait(1)
	end
end

