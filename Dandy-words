local function clearEsp(obj)
	local entry = ESP_CACHE[obj]
	if entry then
		pcall(function()
			if entry.h then entry.h:Destroy() end
			if entry.bb then entry.bb:Destroy() end
		end)
		ESP_CACHE[obj] = nil
	end
	if obj and obj.Parent then
		pcall(function()
			local h = obj:FindFirstChild("DWHUB_Highlight")
			if h then h:Destroy() end
			local bb = obj:FindFirstChild("DWHUB_Billboard")
			if bb then bb:Destroy() end
		end)
	end
end

local function clearCategory(cat)
	for obj, data in pairs(ESP_CACHE) do
		if data.category == cat then
			clearEsp(obj)
		end
	end
	pcall(function()
		for _, d in ipairs(workspace:GetDescendants()) do
			if (d.Name == "DWHUB_Highlight" or d.Name == "DWHUB_Billboard") and d:GetAttribute("DWHUB_Category") == cat then
				d:Destroy()
			end
		end
	end)
end

local function applyEsp(obj, color, label, category)
	if ESP_CACHE[obj] then return end
	pcall(function()
		local oldH = obj:FindFirstChild("DWHUB_Highlight")
		if oldH then oldH:Destroy() end
		local oldB = obj:FindFirstChild("DWHUB_Billboard")
		if oldB then oldB:Destroy() end

		local highlight = nil
		if category ~= "item" then
			highlight = Instance.new("Highlight")
			highlight.Name = "DWHUB_Highlight"
			highlight:SetAttribute("DWHUB_Category", category)
			highlight.FillColor = color
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.55
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Adornee = obj
			highlight.Parent = obj
		end

		local adornee = obj
		if obj:IsA("Model") then
			adornee = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj
		end

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "DWHUB_Billboard"
		billboard:SetAttribute("DWHUB_Category", category)
		billboard.Size = UDim2.fromOffset(130, 26)
