local function skillLoop()
	local lastBar, lastCircle, lastTap = 0, 0, 0
	local GameContext, CircleHandler, TreadmillHandler

	pcall(function() GameContext = require(ReplicatedStorage.Modules.Core.GameContext) end)
	pcall(function() CircleHandler = require(ReplicatedStorage.Modules.Gameplay.CircleSkillCheckHandler) end)
	pcall(function() TreadmillHandler = require(ReplicatedStorage.Modules.Gameplay.TreadmillTapSkillCheck) end)

	-- SwimmyBarnaby hook (auto arcade)
	pcall(function()
		local mod = ReplicatedStorage:FindFirstChild("Modules")
			and ReplicatedStorage.Modules:FindFirstChild("GenArcade")
			and ReplicatedStorage.Modules.GenArcade:FindFirstChild("SwimmyBarnaby")
		if not mod then return end
		local barnaby = require(mod)
		if barnaby._DWHUB_Hooked then return end
		barnaby._DWHUB_Hooked = true
		local oldNew = barnaby.new
		barnaby.new = function(...)
			local session = oldNew(...)
			if session and session.object_creators then
				local oldFish = session.object_creators.Fish
				session.object_creators.Fish = function(owner, a, b, c)
					local fish = oldFish(owner, a, b, c)
					fish.IsOutOfBounds = function() return false end
					fish.IsOverlapping = function() return false end
					return fish
				end
			end
			return session
		end
	end)

	local conn = RunService.RenderStepped:Connect(function()
		if not alive() or not CFG.autoSkill or not CFG.running then return end
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if not pg then return end
		local now = tick()

		-- Bar skillcheck
		local screen = pg:FindFirstChild("ScreenGui")
		local frame = screen and screen:FindFirstChild("Menu") and screen.Menu:FindFirstChild("SkillCheckFrame")
		local checking = (GameContext and GameContext.skillchecking) or (frame and frame.Visible)
		if checking and frame and frame.Visible and (now - lastBar) > 0.35 then
			local marker = frame:FindFirstChild("Marker")
			local required = frame:FindFirstChild("RequiredArea")
			local gold = frame:FindFirstChild("GoldArea")
			if marker and required then
				local mx = marker.Position.X.Scale
				local rx = required.Position.X.Scale
				local rw = required.Size.X.Scale
				local inRequired = mx >= rx and mx <= (rx + rw)
				local inGold = false
				if gold then
					local gx = gold.Position.X.Scale
					local gw = gold.Size.X.Scale
					inGold = mx >= gx and mx <= (gx + gw)
				end
				if inGold or inRequired then
					lastBar = now
					pressSpace()
				end
			end
		end

		-- Circle skillcheck
		local circleUi = CircleHandler and CircleHandler.ActiveSkillCheck and CircleHandler.ActiveSkillCheck.ui
		local circleGui = pg:FindFirstChild("CircleSkillCheckGui")
		local circleFrame = circleGui and circleGui:FindFirstChild("SkillCheckFrame")
		if ((circleUi) or (circleFrame and circleFrame.Visible)) and (now - lastCircle) > 0.35 then
			local shrink, yellow, black, container
			if circleUi and circleUi.ShrinkingCircle and circleUi.ShrinkingCircle.Parent then
				shrink = circleUi.ShrinkingCircle.Size.X.Offset
				yellow = circleUi.Zones and circleUi.Zones.yellow and circleUi.Zones.yellow.size
				black = circleUi.Zones and circleUi.Zones.black and circleUi.Zones.black.size
				container = circleUi.Container
			elseif circleFrame and circleFrame.Visible then
				container = circleFrame:FindFirstChild("Container")
			end
			if shrink and yellow and black and shrink > 0 then
				-- hit when circle is inside the good zone
				if shrink <= yellow * 1.15 and shrink >= black * 0.85 then
					lastCircle = now
					pressSpace()
					if container then
						local btn = container:FindFirstChild("CircleClickHandler")
						if btn then
							pcall(function() firesignal(btn.MouseButton1Down) end)
							pcall(function() firesignal(btn.Activated) end)
						end
					end
				end
			end
		end

		-- Treadmill tap
		local tapGui = pg:FindFirstChild("TreadmillTapSkillCheckGui")
		local tapFrame = tapGui and tapGui:FindFirstChild("TapSkillCheckFrame")
		local tapActive = (TreadmillHandler and TreadmillHandler.ActiveSkillCheck) or (tapFrame and tapFrame.Visible)
		if tapActive and (now - lastTap) > 0.05 then
			lastTap = now
			pressSpace()
			if tapFrame then
				local btn = tapFrame:FindFirstChild("TapButton")
				if btn then
					pcall(function() firesignal(btn.MouseButton1Down) end)
					pcall(function() firesignal(btn.Activated) end)
				end
			end
		end
	end)

	track(function() conn:Disconnect() end)
end

