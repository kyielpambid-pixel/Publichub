local warping = false

local function hardWarp(cf, hold)
	if warping then return false end
	warping = true
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and root) then
		warping = false
		return false
	end
	pcall(function() char:SetAttribute("CollisionExempt", true) end)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = cf
	root.AssemblyLinearVelocity = Vector3.zero
	hold = hold or 2
	local target = cf.Position
	task.spawn(function()
		local untilT = os.clock() + hold
		while os.clock() < untilT do
			task.wait(0.15)
			local c = LocalPlayer.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if not r then break end
			if (r.Position - target).Magnitude > 14 then
				r.CFrame = cf
				r.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
	task.delay(1, function()
		local c = LocalPlayer.Character
		if c and not CFG.noclip then
			pcall(function() c:SetAttribute("CollisionExempt", false) end)
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then
					p.CanCollide = p.Name:find("Torso") ~= nil
				end
			end
		end
	end)
	warping = false
	return true
end

local function isGenerator(model)
	if not (model and model:IsA("Model")) then return false end
	if model:FindFirstChildOfClass("Humanoid") then return false end
	if not model:FindFirstChild("Stats") then return false end
	if model:FindFirstChild("TeleportPositions")
		or model:FindFirstChild("Prompt")
		or model.Name:find("Gen")
		or model.Name:find("Arcade")
		or model:GetAttribute("MinigameType") then
		return true
	end
	return false
end

local function scanGenerators(timeout)
	timeout = timeout or 3
	local start = os.clock()
	while (os.clock() - start) <= timeout do
		local unfinished, all = {}, {}
		local seen = {}
		local roots = {}
		local room = workspace:FindFirstChild("CurrentRoom")
		if room and #room:GetChildren() > 0 then table.insert(roots, room) end
		table.insert(roots, workspace)

		for _, root in ipairs(roots) do
			for _, d in ipairs(root:GetDescendants()) do
				if not seen[d] and isGenerator(d) then
					seen[d] = true
					local stats = d:FindFirstChild("Stats")
					local completed = stats and stats:FindFirstChild("Completed")
					local cur = stats and stats:FindFirstChild("CurrentAmount")
					local req = stats and stats:FindFirstChild("RequiredAmount")
					local done = (completed and completed.Value == true)
						or (cur and req and tonumber(cur.Value) and tonumber(req.Value) and tonumber(cur.Value) >= tonumber(req.Value))
					local pos = d:GetPivot().Position
					local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					local dist = myRoot and (pos - myRoot.Position).Magnitude or 0
					local entry = { gen = d, dist = dist, isDone = done, pos = pos }
					table.insert(all, entry)
					if not done then table.insert(unfinished, entry) end
				end
			end
			if #all > 0 then break end
		end

		if #all > 0 then
			table.sort(unfinished, function(a, b) return a.dist < b.dist end)
			table.sort(all, function(a, b) return a.dist < b.dist end)
			return unfinished, all
		end

		local info = workspace:FindFirstChild("Info")
		local floorActive = info and info:FindFirstChild("FloorActive") and info.FloorActive.Value
		task.wait(floorActive == false and 0.4 or 0.2)
	end
	return {}, {}
end

local function getElevatorCFrame()
	local elevators = workspace:FindFirstChild("Elevators")
	local elev = elevators and elevators:FindFirstChild("Elevator")
	if elev then
		local base = elev:FindFirstChild("Base") or elev:FindFirstChild("Elevator")
		local pos = (base and base.Position) or elev:GetPivot().Position
		local target = pos + Vector3.new(0, 3.5, 0)
		return CFrame.new(target, Vector3.new(target.X, target.Y, target.Z - 20))
	end
	local room = workspace:FindFirstChild("CurrentRoom")
	if room then
		for _, d in ipairs(room:GetDescendants()) do
			if d.Name:find("Elevator") and d:IsA("Model") and not d.Name:lower():find("fake") then
				local base = d:FindFirstChild("Base") or d:FindFirstChild("Elevator")
				local pos = (base and base.Position) or d:GetPivot().Position
				return CFrame.new(pos + Vector3.new(0, 3.5, 0))
			end
		end
	end
	return nil
end

local function teleportElevator()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and root) then
		notify("Elevator", "Character not ready")
		return
	end
	local cf = getElevatorCFrame()
	if not cf then
		notify("Elevator", "Elevator not found — floor still loading?")
		return
	end
	if hardWarp(cf) then
		notify("Elevator", "Warped to elevator")
	else
		notify("Elevator", "Warp failed")
	end
end

local function teleportNearestMachine()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and root) then
		notify("Teleport", "Character not ready")
		return
	end
	local unfinished, all = scanGenerators(1)
	if #all > 0 and #unfinished == 0 then
		notify("Teleport", "All machines done on this floor")
		return
	end
	if #unfinished == 0 then
		notify("Teleport", "No generators found")
		return
	end

	local pool = {}
	for _, e in ipairs(unfinished) do
		local stats = e.gen:FindFirstChild("Stats")
		local active = stats and stats:FindFirstChild("ActivePlayer")
		local cur = stats and stats:FindFirstChild("CurrentAmount")
		local busy = (active and active.Value ~= nil) or ((tonumber(cur and cur.Value) or 0) > 0)
		if not busy then table.insert(pool, e) end
	end
	if #pool == 0 then pool = unfinished end

	local target = pool[1]
	if target.dist < 6 and #pool > 1 then
		target = pool[2]
	end

	local gen = target.gen
	local tps = gen:FindFirstChild("TeleportPositions")
	local tp = tps and (tps:FindFirstChild("TeleportPosition") or tps:GetChildren()[1])
	local cf
	if tp then
		cf = tp.CFrame + Vector3.new(0, 2.35, 0)
	else
		cf = CFrame.new(gen:GetPivot().Position + Vector3.new(0, 2.5, 3))
	end

	pcall(function() char:SetAttribute("CollisionExempt", true) end)
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = false end
	end

	root.CFrame = cf
	local dest = cf.Position
	task.spawn(function()
		local untilT = os.clock() + 1
		while os.clock() < untilT do
			task.wait(0.1)
			local c = LocalPlayer.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if r and (r.Position - dest).Magnitude > 10 then
				r.CFrame = cf
			end
		end
	end)
	task.delay(1, function()
		local c = LocalPlayer.Character
		if c and not CFG.noclip then
			pcall(function() c:SetAttribute("CollisionExempt", false) end)
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = true end
			end
		end
	end)

	notify("Teleport", target.isDone and "Warped to Machine (DONE)" or string.format("Warped to Machine (%dm)", math.floor(target.dist)))
end

