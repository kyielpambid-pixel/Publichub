local lastDefend = 0

local function useStunItem()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return false, "Character not found" end

	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local screen = pg and pg:FindFirstChild("ScreenGui")
	local inv = char:FindFirstChild("Inventory")
	local remote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("ItemEvent")
	if not remote then return false, "ItemEvent remote not found" end

	for i = 1, 4 do
		local slot = "Slot" .. i
		local uiSlot = screen and screen:FindFirstChild(slot)
		local obj = uiSlot and uiSlot:FindFirstChild("Object") and uiSlot.Object.Value
		local invSlot = inv and inv:FindFirstChild(slot)
		if obj and obj ~= "None" and obj ~= "" then
			local n = tostring(obj):lower()
			if n:find("smoke") or n:find("eject") or n:find("stealth") or n:find("speed") or n:find("horn") then
				local arg = invSlot or slot
				pcall(function() remote:InvokeServer(char, arg) end)
				return true, tostring(obj)
			end
		end
	end
	return false, "No defensive item in inventory"
end

local function autoDefendTick()
	if not CFG.autoDefend or not CFG.running then return end
	if tick() - lastDefend < 2 then return end
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local room = workspace:FindFirstChild("CurrentRoom")
	local monsters = (room and room:FindFirstChild("Monsters", true)) or workspace:FindFirstChild("Monsters", true)
	if not monsters then return end
	for _, mon in ipairs(monsters:GetChildren()) do
		if mon:IsA("Model") and mon:FindFirstChild("HumanoidRootPart") then
			local dist = (mon.HumanoidRootPart.Position - root.Position).Magnitude
			if dist < 16 then
				local ok, name = useStunItem()
				if ok then
					lastDefend = tick()
					notify("Auto Defend", string.format("Twisted %dm — used %s", math.floor(dist), name))
					break
				end
			end
		end
	end
end

local defendConn = RunService.Heartbeat:Connect(function()
	if alive() then pcall(autoDefendTick) end
end)
