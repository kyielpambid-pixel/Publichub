task.spawn(function()
	while alive() do
		pcall(function()
			local info = workspace:FindFirstChild("Info")
			local count = 0
			for _ in pairs(ESP_CACHE) do count = count + 1 end
			local floor = info and info:FindFirstChild("Floor") and info.Floor.Value or "?"
			local danger = info and info:FindFirstChild("Danger") and info.Danger.Value or 0
			local gensDone = info and info:FindFirstChild("GeneratorsCompleted") and info.GeneratorsCompleted.Value or "?"
			local gensReq = info and info:FindFirstChild("RequiredGenerators") and info.RequiredGenerators.Value or "?"
			local text = string.format(
				"Floor: %s | Danger: %.1f\nGenerators: %s/%s | Active ESP: %d",
				tostring(floor),
				tonumber(danger) or 0,
				tostring(gensDone),
				tostring(gensReq),
				count
			)
			if floorLabel then
				floorLabel.Text = text
			end
		end)
		task.wait(1)
	end
end)


