local function applyWalkSpeed()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local stats = char and char:FindFirstChild("Stats")
	if not (hum and stats) then return end

	local sprinting = false
	local sprintVal = stats:FindFirstChild("Sprinting") or stats:FindFirstChild("HoldingSprint")
	if sprintVal and sprintVal.Value == true then sprinting = true end

	local base = 15
	if sprinting then
		local run = stats:FindFirstChild("RunSpeed")
		local mod = stats:FindFirstChild("RunSpeedModifier")
		base = ((run and run.Value) or 25) * ((mod and mod.Value) or 1)
	else
		local walk = stats:FindFirstChild("WalkSpeed")
		local mod = stats:FindFirstChild("SpeedModifier")
		base = ((walk and walk.Value) or 15) * ((mod and mod.Value) or 1)
	end

	local mult = CFG.speedMult or 1
	if CFG.speedBoost then mult = mult * 1.6 end
	hum.WalkSpeed = base * mult
end

local function setStat(name, value)
	local char = LocalPlayer.Character
	local stats = char and char:FindFirstChild("Stats")
	if not stats then
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d.Name == "Stats" and d:IsA("Folder") then
					stats = d
					break
				end
			end
		end
	end
	if not stats then return end
	local v = stats:FindFirstChild(name)
	if v and v:IsA("NumberValue") then
		v.Value = value
	end
end

local function getStat(name)
	local char = LocalPlayer.Character
	local stats = char and char:FindFirstChild("Stats")
	if not stats then return nil end
	local v = stats:FindFirstChild(name)
	return v and tonumber(v.Value) or nil
end

local function bindCharacter(char)
	task.spawn(function()
		local stats = char:WaitForChild("Stats", 10)
		if not stats then return end
		local cur = stats:WaitForChild("CurrentStamina", 10)
		local max = stats:WaitForChild("Stamina", 10)
		if cur and max then
			local c = cur:GetPropertyChangedSignal("Value"):Connect(function()
				if CFG.infiniteStamina and cur.Value < max.Value then
					cur.Value = max.Value
				end
			end)
			if CFG.infiniteStamina then cur.Value = max.Value end
			track(function() c:Disconnect() end)
		end
		local sprint = stats:WaitForChild("Sprinting", 5)
		if sprint then
			local c = sprint:GetPropertyChangedSignal("Value"):Connect(applyWalkSpeed)
			track(function() c:Disconnect() end)
		end
		local hold = stats:WaitForChild("HoldingSprint", 5)
		if hold then
			local c = hold:GetPropertyChangedSignal("Value"):Connect(applyWalkSpeed)
			track(function() c:Disconnect() end)
		end
		applyWalkSpeed()
	end)
end

if LocalPlayer.Character then bindCharacter(LocalPlayer.Character) end
