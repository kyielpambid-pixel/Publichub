local function staminaLoop()
	while alive() do
		pcall(function()
			local char = LocalPlayer.Character
			if not char then return end
			if CFG.infiniteStamina then
				local stats = char:FindFirstChild("Stats")
				if stats then
					local cur = stats:FindFirstChild("CurrentStamina")
					local max = stats:FindFirstChild("Stamina")
					if cur and max and cur.Value < max.Value then
						cur.Value = max.Value
					end
				end
				pcall(function() char:SetAttribute("StaminaFatigued", nil) end)
			end
			if CFG.speedMult > 1 then
				setStat("SpeedModifier", CFG.speedMult)
