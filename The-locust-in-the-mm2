local function slider(parent, label, get, set, min, max)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1,0,0,48); row.BackgroundTransparency = 1; row.ZIndex = 8; row.Parent = parent
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1,0,0,18); lbl.BackgroundTransparency = 1
	lbl.Text = label .. ": " .. tostring(get())
	lbl.Font = Enum.Font.GothamMedium; lbl.TextSize = 13; lbl.TextColor3 = THEME.text
	lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.ZIndex = 9; lbl.Parent = row
	local bg = Instance.new("TextButton")
	bg.Size = UDim2.new(1,0,0,14); bg.Position = UDim2.new(0,0,0,26)
	bg.BackgroundColor3 = THEME.off; bg.Text = ""; bg.AutoButtonColor = false; bg.ZIndex = 9; bg.Parent = row
	corner(bg, 4)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(math.clamp((get()-min)/(max-min),0,1),0,1,0)
	fill.BackgroundColor3 = THEME.accent2; fill.BorderSizePixel = 0; fill.ZIndex = 10; fill.Parent = bg
	corner(fill, 4)
	local dragging = false
	local function update(input)
		local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / math.max(bg.AbsoluteSize.X,1), 0, 1)
		fill.Size = UDim2.new(rel,0,1,0)
		local val = math.floor(min + (max-min)*rel)
		set(val)
		lbl.Text = label .. ": " .. tostring(val)
	end
	bg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
	return row
end

