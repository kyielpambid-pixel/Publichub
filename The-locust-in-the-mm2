local espTimer = 0

-- Extra tight back-ride lock (RenderStepped = every frame, no lag gap)
RunService.RenderStepped:Connect(function()
	if not S.Troll then return end
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local nearestLocust, minDist = nil, math.huge
	local function consider(obj)
		local lRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
		if lRoot then
			local dist = (root.Position - lRoot.Position).Magnitude
			if dist < minDist then minDist = dist; nearestLocust = lRoot end
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and isLocustModel(plr.Character) then consider(plr.Character) end
	end
	for _, obj in ipairs(Workspace:GetChildren()) do
		if isLocustModel(obj) then consider(obj) end
	end
	if nearestLocust then
		root.CFrame = nearestLocust.CFrame * CFrame.new(0, 4.0, 11.5)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end)

RunService.Heartbeat:Connect(function(dt)
	espTimer = espTimer + dt
	if espTimer >= 0.5 then
		espTimer = 0
		if S.PlayerESP then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					if isLocustModel(plr.Character) then removeESP(trackedPlayers, plr)
					else applyPlayerESP(plr) end
				end
			end
		else
			for plr in pairs(trackedPlayers) do removeESP(trackedPlayers, plr) end
		end
		if S.LocustESP then
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if isLocustModel(obj) then applyLocustESP(obj) end
			end
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr.Character and isLocustModel(plr.Character) then applyLocustESP(plr.Character) end
			end
		else
			for model in pairs(trackedLocusts) do removeESP(trackedLocusts, model) end
		end
	end

	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		if hum and S.WalkSpeed > 16 then hum.WalkSpeed = S.WalkSpeed end
		if S.NoClip then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end
		if root and not S.LoopKill and not S.TweenKey then
			local nearestLocust, minDist = nil, math.huge
			local function consider(obj)
				local lRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
				if lRoot then
					local dist = (root.Position - lRoot.Position).Magnitude
					if dist < minDist then minDist = dist; nearestLocust = lRoot end
				end
			end
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if isLocustModel(obj) then consider(obj) end
			end
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr.Character and isLocustModel(plr.Character) then consider(plr.Character) end
			end
			if nearestLocust then
				if S.Troll then
					-- Far behind + high: out of locust camera / attack reach
					-- Local +Z = behind, +Y = up
					local BACK = 11.5  -- further back (was 6.8)
					local UP = 4.0     -- higher
					-- lock every frame to their CFrame (hard stick)
					root.CFrame = nearestLocust.CFrame * CFrame.new(0, UP, BACK)
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					for _, p in ipairs(char:GetDescendants()) do
						if p:IsA("BasePart") then
							p.AssemblyLinearVelocity = Vector3.zero
							p.AssemblyAngularVelocity = Vector3.zero
							p.CanCollide = false
							p.Massless = true
						end
					end
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum then
						pcall(function()
							hum.PlatformStand = true
							hum.AutoRotate = false
							hum:ChangeState(Enum.HumanoidStateType.Physics)
						end)
					end
				elseif S.PlaySafe and minDist < S.SafeDist then
					local away = (root.Position - nearestLocust.Position)
					if away.Magnitude > 0.1 then root.CFrame = root.CFrame + away.Unit * 3 end
				end
			end
		end
	end

	-- TweenKey runs on its own loop (not every Heartbeat frame)

	if S.AutoAttack or S.LoopKill then
		local myChar = player.Character
		if myChar then
			pcall(function()
				for _, tool in ipairs(player.Backpack:GetChildren()) do
					if tool:IsA("Tool") then tool.Parent = myChar end
				end
				for _, tool in ipairs(myChar:GetChildren()) do
					if tool:IsA("Tool") then tool:Activate() end
				end
			end)
		end
	end
	if S.LoopKill then
		local myChar = player.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if myRoot then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					local enemyHum = plr.Character:FindFirstChildOfClass("Humanoid")
					local enemyRoot = plr.Character:FindFirstChild("HumanoidRootPart")
					if enemyHum and enemyHum.Health > 0 and enemyRoot and enemyRoot.Position.Y > -200 then
						if not isLocustModel(plr.Character) then
							myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 2)
							break
						end
					end
				end
			end
		end
	end
end)

