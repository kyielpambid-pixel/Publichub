local function removeESP(tbl, key)
	if tbl[key] then
		for _, obj in ipairs(tbl[key]) do
			if obj and obj.Parent then pcall(function() obj:Destroy() end) end
		end
		tbl[key] = nil
	end
end

local function isLocustModel(model)
	if not model or not model:IsA("Model") then return false end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character == model then
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and model:FindFirstChild("HumanoidRootPart") then
				local backpack = plr:FindFirstChildOfClass("Backpack")
				if backpack and (#backpack:GetChildren() > 0 or backpack:FindFirstChildOfClass("Tool")) then
					return false
				end
				local name = plr.Name:lower()
				if name:find("locust") or name:find("monster") or name:find("beast") then return true end
			end
		end
	end
	local name = model.Name:lower()
	if name:find("locust") or name:find("monster") or name:find("zombie") or name:find("beast")
		or model:FindFirstChild("Locust") or model:GetAttribute("Locust") then
		return true
	end
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("Model") and (child.Name:lower():find("locust") or child.Name:lower():find("monster")) then
			return true
		end
	end
	return false
end

