-- Lobby vs Map: NEVER tween keys that live in lobby / hub / menu
local LOBBY_NAME_MARKERS = {
	"lobby", "menu", "title", "mainmenu", "main menu", "waiting", "queue",
	"spawnlobby", "lobbyspawn", "hub", "afk", "intermission", "voting",
	"votemap", "mapvote", "selection", "playergui", "cameralobby",
}
local MAP_NAME_MARKERS = {
	"map", "maps", "round", "game", "ingame", "currentmap", "level",
	"arena", "stage", "playarea", "match", "dungeon", "house", "locust",
	"mapmodel", "active map", "current round", "gamemap",
}

-- Max distance from player for a key to count as "same map"
local KEY_MAX_HORIZ = 450   -- studs on XZ (same map island)
local KEY_MAX_Y_UP = 35     -- never go "up into lobby"
local KEY_MAX_Y_DN = 60
local KEY_MAX_DIST = 500

local function pathString(inst)
	local parts = {}
	local p = inst
	while p and p ~= game do
		table.insert(parts, 1, string.lower(tostring(p.Name or "")))
		p = p.Parent
	end
	return table.concat(parts, "/")
end

local function pathIsLobby(inst)
	local full = pathString(inst)
	for _, m in ipairs(LOBBY_NAME_MARKERS) do
		if full:find(m, 1, true) then return true end
	end
	local p = inst
	while p and p ~= Workspace do
		local n = string.lower(p.Name or "")
		for _, m in ipairs(LOBBY_NAME_MARKERS) do
			if n == m or n:find(m, 1, true) then return true end
		end
		p = p.Parent
	end
	return false
end

local function pathLooksLikeMap(inst)
	local full = pathString(inst)
	for _, m in ipairs(MAP_NAME_MARKERS) do
		if full:find(m, 1, true) then return true end
	end
	return false
end

-- True if LOCAL PLAYER is standing in a lobby container
local function playerIsInLobby(playerRoot)
	if not playerRoot then return false end
	if pathIsLobby(playerRoot) then return true end
	-- high above typical maps often = lobby platforms
	return false
end

local function isValidMapKey(part, playerRoot)
	if not part or not part:IsA("BasePart") or not part.Parent then return false end
	if not part:IsDescendantOf(Workspace) then return false end
	-- hard reject lobby hierarchy
	if pathIsLobby(part) then return false end
	local pos = part.Position
	if pos.Y > 350 or pos.Y < -80 then return false end
	local size = part.Size
	if size.Magnitude < 0.15 or size.Magnitude > 60 then return false end
	if not playerRoot then return false end

	local ppos = playerRoot.Position
	local dy = pos.Y - ppos.Y
	-- reject keys clearly above player (lobby is often higher)
	if dy > KEY_MAX_Y_UP then return false end
	if dy < -KEY_MAX_Y_DN then return false end

	local horiz = Vector3.new(pos.X - ppos.X, 0, pos.Z - ppos.Z).Magnitude
	if horiz > KEY_MAX_HORIZ then return false end
	local dist = (pos - ppos).Magnitude
	if dist > KEY_MAX_DIST then return false end

	-- if key is under a known map folder, always ok
	-- if not, still ok only when close to player (same area)
	if not pathLooksLikeMap(part) and horiz > 220 then
		return false
	end
	return true
end

local function findKeyParts(playerRoot)
	local keys = {}
	local seen = {}
	if not playerRoot then return keys end
	-- while YOU are in lobby, do not tween any keys
	if playerIsInLobby(playerRoot) then return keys end

	local function consider(obj)
		local part = nil
		if obj:IsA("BasePart") then
			part = obj
		elseif obj:IsA("Model") then
			part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
		end
		if not part or seen[part] then return end
		if not isValidMapKey(part, playerRoot) then return end
		seen[part] = true
		table.insert(keys, part)
	end

	local function isLobbyFolder(inst)
		local n = string.lower(inst.Name or "")
		for _, m in ipairs(LOBBY_NAME_MARKERS) do
			if n:find(m, 1, true) then return true end
		end
		return pathIsLobby(inst)
	end

	local preferred = {}
	local nonLobbyRoots = {}
	for _, child in ipairs(Workspace:GetChildren()) do
		if isLobbyFolder(child) then
			-- skip entirely
		else
			local n = string.lower(child.Name or "")
			local mapped = false
			for _, m in ipairs(MAP_NAME_MARKERS) do
				if n:find(m, 1, true) then
					table.insert(preferred, child)
					mapped = true
					break
				end
			end
			if not mapped then
				table.insert(nonLobbyRoots, child)
			end
		end
	end

	local function scan(rootInst)
		if not rootInst or isLobbyFolder(rootInst) then return end
		local ok, descendants = pcall(function() return rootInst:GetDescendants() end)
		if not ok or not descendants then return end
		for _, obj in ipairs(descendants) do
			if pathIsLobby(obj) then
				-- skip lobby subtree items
			else
				local n = string.lower(obj.Name or "")
				if n:find("key", 1, true)
					and not n:find("keyboard", 1, true)
					and not n:find("hotkey", 1, true)
					and not n:find("keybind", 1, true)
					and not n:find("keyframe", 1, true) then
					consider(obj)
				end
			end
		end
	end

	-- 1) map-named folders first
	for _, folder in ipairs(preferred) do
		scan(folder)
	end
	-- 2) other non-lobby workspace children (still filtered by distance/Y)
	if #keys == 0 then
		for _, folder in ipairs(nonLobbyRoots) do
			scan(folder)
		end
	end
	-- NEVER bare-scan whole Workspace without folder filter (that was pulling lobby keys)

	table.sort(keys, function(a, b)
		return (a.Position - playerRoot.Position).Magnitude < (b.Position - playerRoot.Position).Magnitude
	end)
	return keys
end

local function fireKeyCollect(keyPart)
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local event = remotes and remotes:FindFirstChild("KeyCollected")
		if event then
			pcall(function() firesignal(event.OnClientEvent, keyPart, player, 0.65) end)
		end
		local roots = { keyPart }
		if keyPart.Parent then table.insert(roots, keyPart.Parent) end
		for _, root in ipairs(roots) do
			for _, d in ipairs(root:GetDescendants()) do
				if d:IsA("ProximityPrompt") then
					pcall(function()
						if fireproximityprompt then fireproximityprompt(d) end
					end)
				end
			end
		end
	end)
end

local function tweenToKeys()
	if isTweeningKey or not S.TweenKey then return end
	local myChar = player.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	local root = myChar.HumanoidRootPart
	if playerIsInLobby(root) then return end
	local keys = findKeyParts(root)
	if #keys == 0 then return end
	isTweeningKey = true
	for _, keyPart in ipairs(keys) do
		if not S.TweenKey then break end
		root = myChar:FindFirstChild("HumanoidRootPart")
		if not root then break end
		if playerIsInLobby(root) then break end
		if keyPart and keyPart.Parent and isValidMapKey(keyPart, root) then
			local dist = (root.Position - keyPart.Position).Magnitude
			local dy = keyPart.Position.Y - root.Position.Y
			local horiz = Vector3.new(keyPart.Position.X - root.Position.X, 0, keyPart.Position.Z - root.Position.Z).Magnitude
			-- map-only limits (no lobby hop)
			if dy <= KEY_MAX_Y_UP and horiz <= KEY_MAX_HORIZ and dist <= KEY_MAX_DIST then
				local time = math.clamp(dist / math.max(S.TweenKeySpeed, 1), 0.08, 2.0)
				local goalCF = keyPart.CFrame + Vector3.new(0, 2.2, 0)
				local tween = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {
					CFrame = goalCF,
				})
				tween:Play()
				local conn = RunService.Heartbeat:Connect(function()
					if keyPart and keyPart.Parent and isValidMapKey(keyPart, root) then
						fireKeyCollect(keyPart)
					end
				end)
				tween.Completed:Wait()
				conn:Disconnect()
				if keyPart and keyPart.Parent then fireKeyCollect(keyPart) end
				task.wait(0.08)
			end
		end
	end
	isTweeningKey = false
end


-- Separate loop so TweenKey only runs on map keys, not every frame
task.spawn(function()
	while true do
		if S.TweenKey and not isTweeningKey then
			pcall(tweenToKeys)
		end
		task.wait(0.35)
	end
end)

