track(RunService.RenderStepped:Connect(function()
	if isDead or not state.tracers then return end
	local vs = Camera.ViewportSize
	local origin = Vector2.new(vs.X / 2, vs.Y)
	local th = math.clamp(state.tracerthickness, 0.5, 6)
	for target, entry in pairs(tracerCache) do
		if not target or not target.Parent or not entry.frame then
			if entry.frame then entry.frame:Destroy() end
			tracerCache[target] = nil
		else
			local part
			if target:IsA("Model") then
				part = target:FindFirstChild("HumanoidRootPart")
					or target:FindFirstChild("Head")
					or target:FindFirstChildWhichIsA("BasePart")
			elseif target:IsA("BasePart") then
				part = target
			end
			if part then
				local sp, on = Camera:WorldToViewportPoint(part.Position)
				if on and sp.Z > 0 then
					local t2 = Vector2.new(sp.X, sp.Y)
					local d = t2 - origin
					local dist = math.max(d.Magnitude, 1)
					entry.frame.Size = UDim2.new(0, dist, 0, th)
					entry.frame.Position = UDim2.new(0, (origin.X + t2.X) / 2, 0, (origin.Y + t2.Y) / 2)
					entry.frame.Rotation = math.deg(math.atan2(d.Y, d.X))
					entry.frame.BackgroundColor3 = state.tracercolor
					entry.frame.Visible = true
				else
					entry.frame.Visible = false
				end
			end
		end
	end
end))

track(RunService.RenderStepped:Connect(function(dt)
