    handle.BrickColor   = BrickColor.new("Pastel orange")
    handle.Material     = Enum.Material.SmoothPlastic
    handle.Anchored     = false
    handle.CanCollide   = false
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale    = Vector3.new(1.2, 1, 1.2)
    mesh.Parent   = handle
    local earLeft = Instance.new("WedgePart")
    earLeft.Size        = Vector3.new(0.3, 0.4, 0.3)
    earLeft.BrickColor  = BrickColor.new("Pastel orange")
    earLeft.Material    = Enum.Material.SmoothPlastic
