local function fetchObject(itemname)
	if isBusy then return false end
	isBusy = true
	local root = getHRP()
	local hum = getHum()
	if not root then
		isBusy = false
		return false
	end
	local tn = string.lower(itemname)
	local prompt
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local a = string.lower(d.ActionText or "")
			local o = string.lower(d.ObjectText or "")
			local p = string.lower(d.Parent and d.Parent.Name or "")
			if string.find(a, tn, 1, true) or string.find(o, tn, 1, true) or string.find(p, tn, 1, true) then
				prompt = d
				break
			end
		end
	end
	if not prompt then
		isBusy = false
		return false
	end
	local parent = prompt.Parent
	local bp = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart", true)
	if not bp then
		isBusy = false
		return false
	end
	local saved = root.CFrame
	if hum then hum.PlatformStand = true end
	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = CFrame.lookAt(bp.Position + Vector3.new(0, 1.5, 0), bp.Position)
	task.wait(0.12)
	pcall(function()
		if fireproximityprompt then
			fireproximityprompt(prompt)
		end
	end)
	task.wait(0.2)
	root.CFrame = saved + Vector3.new(0, 0.5, 0)
	if hum then hum.PlatformStand = false end
	isBusy = false
	return true
end

