local function isUniqueTarget(target)
    if not target then return false end
    if target:GetAttribute("Unique") == true then return true end
    local success, hasTag = pcall(function() return target:HasTag("Unique") end)
    if success and hasTag then return true end
    for _, desc in ipairs(target:GetDescendants()) do
        if desc:GetAttribute("Unique") == true then return true end
        local dSuccess, dHasTag = pcall(function() return desc:HasTag("Unique") end)
        if dSuccess and dHasTag then return true end
    end
    return false
end

local function isAnomalyTarget(model)
    if not model then return false end
    if model:GetAttribute("Always Patient") == true then return false end
    if model:GetAttribute("HeadRotationEnabled") == true then return true end
    local headRotTag, tagSuccess = pcall(function() return model:HasTag("HeadRotationEnabled") end)
    if tagSuccess and headRotTag then return true end
    if model:GetAttribute("Skinwalker") == true
        or model:GetAttribute("SkinwalkerEasy") == true
        or model:GetAttribute("PenaltyWhenLettingIn") == true
        or model:GetAttribute("HasCameraEffect") == true then
        return true
    end
    local cameraFx = model:GetAttribute("Camera Effect")
    local photoFx  = model:GetAttribute("Photo Effect")
    if (cameraFx and cameraFx ~= "" and cameraFx ~= "None")
        or (photoFx and photoFx ~= "" and photoFx ~= "None") then
        return true
    end
    local originalFace = model:GetAttribute("OriginalFace")
    local head          = model:FindFirstChild("Head")
    local decal         = head and head:FindFirstChildOfClass("Decal")
    if originalFace and decal then
        if tostring(decal.Texture) ~= tostring(originalFace) then
            return true
        end
    end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:GetAttribute("HeadRotationEnabled") == true then return true end
        local dSuccess, dHasTag = pcall(function() return desc:HasTag("HeadRotationEnabled") end)
        if dSuccess and dHasTag then return true end
    end
    return false
end

local function applyHighlight(target, fillColor, espCategory)
    if not target or not target.Parent then return end
    local existing = highlightCache[target]
    if existing then
        existing.FillColor = fillColor
        existing:SetAttribute("espType", espCategory)
        return
    end
    local highlight = Instance.new("Highlight")
    highlight.Name                 = "espHighlight"
    highlight.Adornee              = target
    highlight.FillColor            = fillColor
    highlight.FillTransparency     = 0.4
    highlight.OutlineColor         = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency  = 0
    highlight.DepthMode            = Enum.HighlightDepthMode.AlwaysOnTop
    highlight:SetAttribute("espType", espCategory)
    highlight.Parent               = target
    highlightCache[target]        = highlight
end

clearEspByType = function(espCategory)
    for target, highlight in pairs(highlightCache) do
        if highlight and highlight.Parent and highlight:GetAttribute("espType") == espCategory then
            highlight:Destroy()
            highlightCache[target] = nil
        end
    end
end

local tracerGui = Instance.new("ScreenGui")
tracerGui.Name             = "tracerOverlay"
tracerGui.ResetOnSpawn     = false
tracerGui.IgnoreGuiInset   = true
tracerGui.DisplayOrder     = 9999
tracerGui.Parent           = playergui

local function addTracer(target, color)
    if not target or not target.Parent then return end
    if tracerCache[target] then
        tracerCache[target].frame.BackgroundColor3 = color
        return
    end
    local frame = Instance.new("Frame")
    frame.Name              = "tracerLine"
    frame.BorderSizePixel   = 0
    frame.BackgroundColor3  = color
    frame.AnchorPoint       = Vector2.new(0.5, 0.5)
    frame.Visible           = false
    frame.Parent            = tracerGui
    tracerCache[target]    = { frame = frame }
end

clearAllTracers = function()
    for _, entry in pairs(tracerCache) do
        if entry.frame and entry.frame.Parent then
            entry.frame:Destroy()
        end
    end
    tracerCache = {}
end

local function clearTracerFor(target)
    local entry = tracerCache[target]
    if entry then
        if entry.frame and entry.frame.Parent then entry.frame:Destroy() end
        tracerCache[target] = nil
    end
end

local function processModel(model)
    if not model:IsA("Model") then return end
    if not model:FindFirstChildOfClass("Humanoid") then return end
    if players:GetPlayerFromCharacter(model) then return end
    local head = model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
    if not head then return end
    if isUniqueTarget(model) then
        if state.uniqueesp then
            applyHighlight(model, state.uniquecolor, "unique")
            if state.tracers then addTracer(model, state.tracercolor) end
        end
    elseif isAnomalyTarget(model) then
        if state.anomaliesesp then
            applyHighlight(model, state.anomalycolor, "anomaly")
            if state.tracers then addTracer(model, state.tracercolor) end
        end
    else
        if state.patientsesp then
            applyHighlight(model, state.patientcolor, "patient")
            if state.tracers then addTracer(model, state.tracercolor) end
        end
    end
end

local function processUniqueObjects()
    if not state.uniqueesp then return end
    pcall(function()
        for _, desc in ipairs(workspace:GetDescendants()) do
            if not desc or not desc.Parent then continue end
            if desc:IsA("Model") and players:GetPlayerFromCharacter(desc) then continue end
            if isUniqueTarget(desc) then
                local target
                if desc:IsA("Model") then
                    target = desc
                elseif desc:IsA("BasePart") then
                    target = desc.Parent:IsA("Model") and desc.Parent or desc
                else
                    target = desc
                end
                if not target or not target.Parent then continue end
                applyHighlight(target, state.uniquecolor, "unique")
                if state.tracers then addTracer(target, state.tracercolor) end
            end
        end
    end)
end

task.spawn(function()
    while not isDead do
        task.wait(0.5)
        for target, highlight in pairs(highlightCache) do
            if not target or not target.Parent then
                if highlight and highlight.Parent then highlight:Destroy() end
                highlightCache[target] = nil
            end
        end
        for target, entry in pairs(tracerCache) do
            if not target or not target.Parent then
                if entry.frame and entry.frame.Parent then entry.frame:Destroy() end
                tracerCache[target] = nil
            end
        end
        if not state.anomaliesesp then clearEspByType("anomaly") end
        if not state.patientsesp   then clearEspByType("patient") end
        if not state.uniqueesp     then clearEspByType("unique") end
        if not state.tracers       then clearAllTracers() end
        for _, child in ipairs(workspace:GetChildren()) do
            if child:IsA("Model") and child ~= localplayer.Character then
                processModel(child)
            else
                local nameLower = string.lower(child.Name)
                if string.find(nameLower, "npc") or string.find(nameLower, "patient") then
                    for _, desc in ipairs(child:GetDescendants()) do
                        processModel(desc)
                    end
                end
            end
        end
        processUniqueObjects()
    end
end)

trackConnection(runservice.RenderStepped:Connect(function()
    if isDead then return end
    if not state.tracers then
        if next(tracerCache) then clearAllTracers() end
        return
    end
    local viewportSize = camera.ViewportSize
    local origin       = Vector2.new(viewportSize.X / 2, viewportSize.Y)
    local thickness    = math.clamp(state.tracerthickness, 0.5, 6)
    for target, entry in pairs(tracerCache) do
        if not target or not target.Parent then
            clearTracerFor(target)
        else
            local part
            if target:IsA("Model") then
                part = target:FindFirstChild("HumanoidRootPart")
                    or target:FindFirstChild("Head")
                    or target:FindFirstChildWhichIsA("BasePart")
            elseif target:IsA("BasePart") then
                part = target
            end
            if part and part.Parent and part:IsDescendantOf(workspace) then
                local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen and screenPos.Z > 0 then
                    local target2D = Vector2.new(screenPos.X, screenPos.Y)
                    local delta    = target2D - origin
                    local dist     = delta.Magnitude
                    if dist < 1 then dist = 1 end
                    local angle    = math.atan2(delta.Y, delta.X)
                    entry.frame.Size     = UDim2.new(0, dist, 0, thickness)
                    entry.frame.Position = UDim2.new(0, (origin.X + target2D.X) / 2, 0, (origin.Y + target2D.Y) / 2)
                    entry.frame.Rotation = math.deg(angle)
                    entry.frame.BackgroundColor3 = state.tracercolor
                    entry.frame.BackgroundTransparency = 0
                    entry.frame.Visible  = true
                else
                    entry.frame.Visible = false
                end
            else
                entry.frame.Visible = false
            end
        end
    end
end))

trackConnection(runservice.RenderStepped:Connect(function(dt)
    if isDead or not state.spinenabled then return end
    local root = getRootPart()
    if root then
        root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(state.spinspeed * 10 * dt * 60), 0)
    end
end))

removePlayerEsp = function(player)
    local char = player and player.Character
    if not char then return end
    local highlight = highlightCache[char]
    if highlight and highlight.Parent then
        highlight:Destroy()
        highlightCache[char] = nil
    end
    clearTracerFor(char)
end

trackConnection(runservice.RenderStepped:Connect(function()
    if isDead then return end
    if not (state.playeresp or state.tracers) then return end
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= localplayer then
            local char = p.Character
            if char then
                if state.playeresp then
                    local existing = highlightCache[char]
                    if existing then
                        existing.FillColor = state.playercolor
                    else
                        applyHighlight(char, state.playercolor, "player")
                    end
                end
                if state.tracers then
                    addTracer(char, state.tracercolor)
                end
            end
        end
    end
end))

