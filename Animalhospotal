local function isUniqueTarget(target)
	if not target then return false end
	if target:GetAttribute("Unique") == true then return true end
	if target:GetAttribute("IsUnique") == true then return true end
	if target:GetAttribute("Rare") == true then return true end
	local ok, has = pcall(function() return target:HasTag("Unique") end)
	if ok and has then return true end
	local n = string.lower(target.Name or "")
	if string.find(n, "unique", 1, true) or string.find(n, "rare", 1, true) or string.find(n, "legendary", 1, true) then
		return true
	end
	for _, d in ipairs(target:GetDescendants()) do
		if d:GetAttribute("Unique") == true or d:GetAttribute("IsUnique") == true then return true end
		local dok, dhas = pcall(function() return d:HasTag("Unique") end)
		if dok and dhas then return true end
	end
	return false
end

local function isAnomalyTarget(model)
	if not model then return false end
	if model:GetAttribute("Always Patient") == true then return false end
	if model:GetAttribute("IsPatient") == true then return false end
	if model:GetAttribute("Patient") == true then return false end

	-- strong anomaly signals
	local anomalyAttrs = {
		"HeadRotationEnabled", "Skinwalker", "SkinwalkerEasy",
		"PenaltyWhenLettingIn", "HasCameraEffect", "Anomaly",
		"IsAnomaly", "Monster", "Evil", "Fake",
	}
	for _, name in ipairs(anomalyAttrs) do
		local v = model:GetAttribute(name)
		if v == true or v == 1 then return true end
	end

	local ok, tag = pcall(function() return model:HasTag("HeadRotationEnabled") end)
	if ok and tag then return true end
	ok, tag = pcall(function() return model:HasTag("Anomaly") end)
	if ok and tag then return true end

	local cf = model:GetAttribute("Camera Effect") or model:GetAttribute("CameraEffect")
	local pf = model:GetAttribute("Photo Effect") or model:GetAttribute("PhotoEffect")
	if (cf and tostring(cf) ~= "" and tostring(cf) ~= "None")
		or (pf and tostring(pf) ~= "" and tostring(pf) ~= "None") then
		return true
	end

	local of = model:GetAttribute("OriginalFace")
	local head = model:FindFirstChild("Head")
	local decal = head and (head:FindFirstChildOfClass("Decal") or head:FindFirstChild("face") or head:FindFirstChild("Face"))
	if of and decal then
		local tex = decal.Texture or (decal.Value)
		if tex and tostring(tex) ~= tostring(of) then
			return true
		end
	end

	-- name hints
	local n = string.lower(model.Name)
	if string.find(n, "anomaly", 1, true)
		or string.find(n, "skinwalker", 1, true)
		or string.find(n, "monster", 1, true)
		or string.find(n, "impostor", 1, true)
		or string.find(n, "fake", 1, true) then
		return true
	end

	-- scan descendants for anomaly attributes
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:GetAttribute("HeadRotationEnabled") == true then return true end
		if desc:GetAttribute("Anomaly") == true then return true end
		local dok, dtag = pcall(function() return desc:HasTag("HeadRotationEnabled") end)
		if dok and dtag then return true end
	end
	return false
end

local function applyHighlight(target, fillColor, espCategory)
	if not target or not target.Parent then return end
	local existing = highlightCache[target]
	if existing and existing.Parent then
		existing.FillColor = fillColor
		existing:SetAttribute("espType", espCategory)
		return
	end
	local h = Instance.new("Highlight")
	h.Name = "KHUB_ESP"
	h.Adornee = target
	h.FillColor = fillColor
	h.FillTransparency = 0.4
	h.OutlineColor = Color3.fromRGB(255, 255, 255)
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h:SetAttribute("espType", espCategory)
	h.Parent = target
	highlightCache[target] = h
end

local function clearEspByType(cat)
	for t, h in pairs(highlightCache) do
		if h and h.Parent and h:GetAttribute("espType") == cat then
			h:Destroy()
			highlightCache[t] = nil
		elseif not h or not h.Parent then
			highlightCache[t] = nil
		end
	end
end

