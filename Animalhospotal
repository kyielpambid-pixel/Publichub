    earLeft.Parent      = tool
    local weldLeft = Instance.new("WeldConstraint")
    weldLeft.Part0 = handle
    weldLeft.Part1 = earLeft
    weldLeft.Parent = earLeft
    local earRight = Instance.new("WedgePart")
    earRight.Size        = Vector3.new(0.3, 0.4, 0.3)
    earRight.BrickColor  = BrickColor.new("Pastel orange")
    earRight.Material    = Enum.Material.SmoothPlastic
    earRight.CanCollide  = false
    earRight.CFrame      = handle.CFrame * CFrame.new(0.35, 0.6, 0) * CFrame.Angles(0, 0, math.rad(15))
    earRight.Parent      = tool
    local weldRight = Instance.new("WeldConstraint")
    weldRight.Part0 = handle
    weldRight.Part1 = earRight
    weldRight.Parent = earRight
    local faceGui = Instance.new("SurfaceGui")
    faceGui.Name = "catFaceGui"
    faceGui.Face = Enum.NormalId.Front
    faceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    faceGui.PixelsPerStud = 100
    faceGui.Parent = handle
    local faceLabel = Instance.new("TextLabel")
    faceLabel.Size = UDim2.new(0.6, 0, 0.6, 0)
    faceLabel.Position = UDim2.new(0.2, 0, 0.2, 0)
    faceLabel.BackgroundTransparency = 1
    faceLabel.Text = ":3"
    faceLabel.TextColor3 = Color3.fromRGB(30, 30, 30)
    faceLabel.TextScaled = true
    faceLabel.Font = Enum.Font.FredokaOne
    faceLabel.Parent = faceGui
    handle.Parent = tool
    local isActive = false
    tool.Activated:Connect(function()
        if isActive or isDead then return end
        isActive = true
        local char = getCharacter()
        local root = getRootPart()
        if char and root then
            catBoostUntil = os.clock() + 20
            local attachmentTop = Instance.new("Attachment")
            attachmentTop.Position = Vector3.new(0, 1, 0)
            attachmentTop.Parent = root
            local attachmentBottom = Instance.new("Attachment")
            attachmentBottom.Position = Vector3.new(0, -1, 0)
            attachmentBottom.Parent = root
            local faceTrailGui = Instance.new("BillboardGui")
            faceTrailGui.Name = "catTrailGui"
            faceTrailGui.Size = UDim2.new(0, 40, 0, 40)
            faceTrailGui.AlwaysOnTop = true
            faceTrailGui.Adornee = root
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = ":3"
            label.TextColor3 = Color3.fromRGB(255, 182, 193)
            label.TextScaled = true
            label.Font = Enum.Font.FredokaOne
            label.Parent = faceTrailGui
            faceTrailGui.Parent = root
            local trail = Instance.new("Trail")
            trail.Attachment0 = attachmentTop
            trail.Attachment1 = attachmentBottom
            trail.Lifetime = 0.6
            trail.Color = ColorSequence.new(Color3.fromRGB(255, 182, 193))
            trail.Transparency = NumberSequence.new(0.2, 1)
            trail.Parent = root
            task.delay(20, function()
                if trail then trail:Destroy() end
                if attachmentTop then attachmentTop:Destroy() end
                if attachmentBottom then attachmentBottom:Destroy() end
                if faceTrailGui then faceTrailGui:Destroy() end
            end)
        end
        task.wait(2)
        isActive = false
    end)
    return tool
end

