local isBusy = false
fetchObject = function(itemname)
    if isBusy then return false end
    isBusy = true
    local char = getCharacter()
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = getHumanoid()
    if not root or not char then isBusy = false return false end
    local targetName = string.lower(itemname)
    local targetPrompt = nil
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local actionText = string.lower(desc.ActionText or "")
            local objectText = string.lower(desc.ObjectText or "")
            local parentName = string.lower(desc.Parent and desc.Parent.Name or "")
            if string.find(actionText, targetName) or string.find(objectText, targetName) or string.find(parentName, targetName) then
                targetPrompt = desc
                break
            end
        end
    end
    if not targetPrompt then
        for _, itemFolder in ipairs(workspace:GetDescendants()) do
            if itemFolder:IsA("Model") or itemFolder:IsA("Folder") or itemFolder:IsA("BasePart") then
                if string.find(string.lower(itemFolder.Name), targetName) then
                    local prompt = itemFolder:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        targetPrompt = prompt
                        break
                    end
                end
            end
        end
    end
    if not targetPrompt then
        isBusy = false
        return false
    end
    local parent = targetPrompt.Parent
    local basePart = (parent:IsA("BasePart") and parent) or parent:FindFirstChildWhichIsA("BasePart", true)
    if not basePart then
        isBusy = false
        return false
    end
    local savedCFrame = root.CFrame
    local tempPlatform = Instance.new("Part")
    tempPlatform.Size = Vector3.new(12, 1, 12)
    tempPlatform.Anchored = true
    tempPlatform.CanCollide = true
    tempPlatform.Transparency = 1
    tempPlatform.Position = basePart.Position - Vector3.new(0, 2.5, 0)
    tempPlatform.Parent = workspace
    if humanoid then humanoid.PlatformStand = true end
    local targetPos = basePart.Position
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.CFrame = CFrame.lookAt(targetPos + Vector3.new(0, 1.5, 0), targetPos)
    task.wait(0.15)
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(targetPrompt)
        end
    end)
    task.wait(0.25)
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.CFrame = savedCFrame + Vector3.new(0, 0.5, 0)
    task.wait(0.05)
    if humanoid then humanoid.PlatformStand = false end
    tempPlatform:Destroy()
    isBusy = false
    return true
end

genv.cleanupScript = function()
    isDead = true
    for k in pairs(state) do
        if type(state[k]) == "boolean" then state[k] = false end
    end
    for _, conn in pairs(sanityConnections) do pcall(function() conn:Disconnect() end) end
    sanityConnections = {}
    clearAllTracers()
    for target, highlight in pairs(highlightCache) do
        if highlight and highlight.Parent then pcall(function() highlight:Destroy() end) end
        highlightCache[target] = nil
    end
    for _, p in ipairs(players:GetPlayers()) do removePlayerEsp(p) end
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    connections = {}
    pcall(function() if tracerGui and tracerGui.Parent then tracerGui:Destroy() end end)
    pcall(function()
        local parent = (gethui and gethui()) or CoreGui
        local f = parent:FindFirstChild("KYIEL_FloatIcon")
        if f then f:Destroy() end
    end)
    pcall(function() rayfield:Destroy() end)
end

