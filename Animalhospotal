local function addTracer(target, color)
	if not target or not target.Parent then return end
	if tracerCache[target] and tracerCache[target].frame and tracerCache[target].frame.Parent then
		tracerCache[target].frame.BackgroundColor3 = color
		return
	end
	local f = Instance.new("Frame")
	f.Name = "tracerLine"
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Visible = false
	f.Parent = tracerGui
	tracerCache[target] = { frame = f }
end

local function clearAllTracers()
	for _, e in pairs(tracerCache) do
		if e.frame and e.frame.Parent then e.frame:Destroy() end
	end
	tracerCache = {}
end

local function processModel(model)
	if not model or not model.Parent then return end
	if not model:IsA("Model") then return end
	if model == LocalPlayer.Character then return end
	if Players:GetPlayerFromCharacter(model) then return end

	local hum = model:FindFirstChildOfClass("Humanoid")
	local hasPart = model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Head")
		or model:FindFirstChildWhichIsA("BasePart", true)
	if not hum and not hasPart then return end
	-- skip pure tools / dead debris
	if model:FindFirstChildOfClass("Tool") and not hum then return end

	local unique = isUniqueTarget(model)
	local anomaly = (not unique) and isAnomalyTarget(model)

	if unique then
		if state.uniqueesp then
			applyHighlight(model, state.uniquecolor, "unique")
			if state.tracers then addTracer(model, state.tracercolor) end
		end
	elseif anomaly then
		if state.anomaliesesp then
			applyHighlight(model, state.anomalycolor, "anomaly")
			if state.tracers then addTracer(model, state.tracercolor) end
		end
	else
		-- treat non-player humanoid-like models as patients when patients ESP on
		if state.patientsesp and (hum or hasPart) then
			applyHighlight(model, state.patientcolor, "patient")
			if state.tracers then addTracer(model, state.tracercolor) end
		end
	end
end

local function scanAllNpcs()
	local seen = {}
	local function consider(model)
		if not model or seen[model] then return end
		if not model:IsA("Model") then return end
		seen[model] = true
		processModel(model)
	end

	-- deep scan: any Model under Workspace with Humanoid / Head
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Model") then
			local hum = desc:FindFirstChildOfClass("Humanoid")
			if hum or desc:FindFirstChild("Head") or desc:FindFirstChild("HumanoidRootPart") then
				consider(desc)
			end
		elseif desc:IsA("Humanoid") and desc.Parent and desc.Parent:IsA("Model") then
			consider(desc.Parent)
		end
	end
end

