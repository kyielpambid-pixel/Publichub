-- Floating Orb
local Orb = Instance.new("ImageButton")
Orb.Name = "Orb"
Orb.Size = UDim2.fromOffset(72, 72)
Orb.Position = UDim2.new(0, 20, 1, -100)
Orb.BackgroundColor3 = THEME.rail
Orb.Image = LOGO_ID
Orb.ScaleType = Enum.ScaleType.Fit
Orb.Visible = false
Orb.ZIndex = 50
Orb.Parent = ScreenGui
corner(Orb, 36)
mkstroke(Orb, THEME.accent, 2, 0.1)

local draggingOrb, dragInputOrb, dragStartOrb, startPosOrb
Orb.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingOrb = true
		dragStartOrb = input.Position
		startPosOrb = Orb.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then draggingOrb = false end
		end)
	end
end)
Orb.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInputOrb = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInputOrb and draggingOrb then
		local delta = input.Position - dragStartOrb
		Orb.Position = UDim2.new(startPosOrb.X.Scale, startPosOrb.X.Offset + delta.X, startPosOrb.Y.Scale, startPosOrb.Y.Offset + delta.Y)
	end
end)

local function setVisible(on)
	Win.Visible = on
	Orb.Visible = not on
end

MinBtn.MouseButton1Click:Connect(function() setVisible(false) end)
Orb.MouseButton1Click:Connect(function() setVisible(true) end)

UserInputService.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightShift or i.KeyCode == Enum.KeyCode.RightControl or i.KeyCode == Enum.KeyCode.K then
		setVisible(not Win.Visible)
	end
end)

