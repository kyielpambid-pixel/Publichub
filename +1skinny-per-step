local function getRoot()
	local c=player.Character; return c and c:FindFirstChild("HumanoidRootPart")
end
local function getStat(statName)
	local wanted=statName:lower()
	local ls=player:FindFirstChild("leaderstats")
	if ls then
		for _, o in ipairs(ls:GetChildren()) do
			if o.Name:lower()==wanted then
				local ok,v=pcall(function() return o.Value end)
				if ok then return tonumber(v) or 0 end
			end
		end
	end
	for n,v in pairs(player:GetAttributes()) do
		if n:lower()==wanted then return tonumber(v) or 0 end
	end
	return 0
end
local function getRequiredRebirth(treadmill)
	if not treadmill then return nil end
	local function check(obj)
		for name, value in pairs(obj:GetAttributes()) do
			local lower=name:lower()
			if lower=="requiredrebirth" or lower=="requiredrebirths" or lower=="rebirthrequired" or lower=="rebirthrequirement" then
				return tonumber(value)
			end
		end
		return nil
	end
	local r=check(treadmill); if r~=nil then return r end
	for _, o in ipairs(treadmill:GetDescendants()) do r=check(o); if r~=nil then return r end end
	return nil
end
local function findBestTreadmill()
	local rebirths=getStat("Rebirths"); local best, bestReq = nil, -math.huge
	for _, object in ipairs(Workspace:GetChildren()) do
		if object.Name:lower():find("treadmill") then
			local req=getRequiredRebirth(object)
			if req and req<=rebirths and req>bestReq then best, bestReq = object, req end
		end
	end
	return best, bestReq
end
local function findConveyor(treadmill)
	if not treadmill then return nil end
	local names={"conveyor","convey","belt","tread","track","walk"}
	for _, object in ipairs(treadmill:GetDescendants()) do
		if object:IsA("BasePart") then
			local lower=object.Name:lower()
			for _, kw in ipairs(names) do if lower:find(kw) then return object end end
		end
	end
	local best, bestScore = nil, -1
	for _, object in ipairs(treadmill:GetDescendants()) do
		if object:IsA("BasePart") then
			local size=object.Size
			local score=(size.X*size.Z)/math.max(size.Y,0.1)
			if score>bestScore then bestScore, best = score, object end
		end
	end
	return best
end
local function goToTreadmill()
	local root=getRoot(); if not root then return false end
	local treadmill=findBestTreadmill(); if not treadmill then return false end
	local conveyor=findConveyor(treadmill); if not conveyor then return false end
	local y=(conveyor.Size.Y/2)+(root.Size.Y/2)-0.35
	root.CFrame=conveyor.CFrame*CFrame.new(0,y,0)
	return true
end
local function getWinRequirement(model)
	return tonumber(model.Name:match("^WinZoneLevel(%d+)Model"))
end
local function findBestWinModel()
	local level=getStat("Level"); local best, bestReq = nil, -1
	for _, object in ipairs(Workspace:GetChildren()) do
		if object:IsA("Model") then
			local req=getWinRequirement(object)
			if req and req<=level and req>bestReq then best, bestReq = object, req end
		end
	end
	return best, bestReq
end
local function findTouchWin(model)
	if not model then return nil end
	local touch=model:FindFirstChild("TouchWin", true)
	if touch and touch:IsA("BasePart") then return touch end
	local timeout=os.clock()+3
	repeat
		touch=model:FindFirstChild("TouchWin", true)
		if touch and touch:IsA("BasePart") then return touch end
		task.wait(0.1)
	until os.clock()>timeout
	return nil
end
local function goToBestWin()
	local root=getRoot(); if not root then return false end
	local winModel=findBestWinModel(); if not winModel then return false end
	local touch=findTouchWin(winModel); if not touch then return false end
	root.CFrame=touch.CFrame; return true
end
task.spawn(function()
	while true do
		if State.AutoTreadmill and not State.Combo then pcall(goToTreadmill) end
		task.wait(TREADMILL_DELAY)
	end
end)
