				end
				if hrp then
					if hrp:FindFirstChild("KHUBFlyBV") then hrp.KHUBFlyBV:Destroy() end
					if hrp:FindFirstChild("KHUBFlyBG") then hrp.KHUBFlyBG:Destroy() end
				end
			end)
		end
	end
