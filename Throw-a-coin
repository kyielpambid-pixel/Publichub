local function executeThrowCoin()
	if isThrowing then return end
	isThrowing = true
	pcall(function()
		local char, root, hum = getPlayerChar()
		local fountainPart = getFountainTarget()
		local targetPos = fountainPart and fountainPart.Position or Vector3.new(0, 0, 0)

		if root and fountainPart then
			pcall(function()
				local lookPos = Vector3.new(fountainPart.Position.X, root.Position.Y, fountainPart.Position.Z)
				root.CFrame = CFrame.lookAt(root.Position, lookPos)
			end)
		end

		local tool = nil
		if char then
			tool = char:FindFirstChildOfClass("Tool")
			if not tool and LocalPlayer:FindFirstChild("Backpack") then
				for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
					if item:IsA("Tool") then
						local iName = item.Name:lower()
						if iName:find("coin") or iName:find("throw") or iName:find("gold")
							or iName:find("silver") or iName:find("bronze") or iName:find("default") or not tool then
							tool = item
						end
					end
				end
				if tool and hum then
					hum:EquipTool(tool)
					task.wait(0.04)
				end
			end
		end

		if tool then
			pcall(function()
				tool:Activate()
			end)
			fireSignalDirect(tool.Activated)
		end

		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			for _, gui in ipairs(playerGui:GetChildren()) do
				if gui:IsA("ScreenGui") and gui.Name ~= "KHUB_ThrowACoin" and gui.Enabled then
					local gName = gui.Name:lower()
					if gName:find("throw") or gName:find("meter") or gName:find("power") or gName:find("timing") then
						for _, btn in ipairs(gui:GetDescendants()) do
							if (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
								local bName = btn.Name:lower()
								if not bName:find("close") and not bName:find("shop") and not bName:find("buy")
									and not bName:find("sell") and not bName:find("menu") and not bName:find("quest")
									and not bName:find("daily") and not bName:find("gift") and not bName:find("pass")
									and not bName:find("spin") and not bName:find("setting") and not bName:find("trade")
									and not bName:find("code") and not bName:find("invite") then
									pcall(function()
										fireSignalDirect(btn.MouseButton1Down)
										fireSignalDirect(btn.MouseButton1Click)
										fireSignalDirect(btn.Activated)
										task.wait(0.04)
										fireSignalDirect(btn.MouseButton1Up)
									end)
								end
							end
						end
					end
				end
			end
		end

		for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
			if rem:IsA("RemoteEvent") then
				local rName = rem.Name:lower()
				if rName == "throw" or rName == "throwcoin" or rName == "throw_coin"
					or rName == "tosscoin" or rName == "toss" or rName == "flipcoin"
					or rName == "releasethrow" or rName == "fountainthrow" then
					pcall(function() rem:FireServer(100) end)
					pcall(function() rem:FireServer(targetPos) end)
					pcall(function() rem:FireServer(fountainPart) end)
					pcall(function() rem:FireServer(100, targetPos) end)
					pcall(function() rem:FireServer("Throw", 100) end)
					pcall(function() rem:FireServer() end)
				end
			elseif rem:IsA("RemoteFunction") then
				local rName = rem.Name:lower()
				if rName == "throw" or rName == "throwcoin" or rName == "tosscoin" or rName == "toss" then
					task.spawn(function()
						pcall(function() rem:InvokeServer(100) end)
						pcall(function() rem:InvokeServer(targetPos) end)
						pcall(function() rem:InvokeServer() end)
					end)
				end
			end
		end

		if fountainPart then
			local prompt = fountainPart:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt and prompt.Enabled then
				pcall(function()
					prompt.HoldDuration = 0
					prompt.MaxActivationDistance = 99999
				end)
				if fireproximityprompt then
					fireproximityprompt(prompt)
				end
			end
		end

		task.wait(0.05)
		if tool then
			pcall(function()
				tool:Deactivate()
			end)
			fireSignalDirect(tool.Deactivated)
		end
	end)
	isThrowing = false
end

