-- Stepped: walkspeed, noclip, fly, hitbox
RunService.Stepped:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if hum then
		if S.WalkSpeedOn then
			hum.WalkSpeed = S.WalkSpeed
		end
	end

	if S.Noclip then
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	if S.Fly and hrp then
		local camCF = Camera.CFrame
		local moveDir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
			moveDir = moveDir + camCF.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
			moveDir = moveDir - camCF.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
			moveDir = moveDir - camCF.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
			moveDir = moveDir + camCF.RightVector
		end
		-- mobile: use MoveDirection
		if moveDir.Magnitude < 0.1 and hum then
			local md = hum.MoveDirection
			if md.Magnitude > 0.1 then
				moveDir = Vector3.new(md.X, 0, md.Z)
				if moveDir.Magnitude > 0 then
					moveDir = (camCF.LookVector * md.Z + camCF.RightVector * md.X)
				end
			end
		end
		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit * S.FlySpeed
			hrp.AssemblyLinearVelocity = moveDir
		else
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local thrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if thrp then
				if S.Hitbox then
					thrp.Size = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
					thrp.Transparency = 0.7
					thrp.CanCollide = false
				else
					if thrp.Size.X > 3 then
						thrp.Size = Vector3.new(2, 2, 1)
						thrp.Transparency = 1
					end
				end
			end
		end
	end
end)

