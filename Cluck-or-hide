		if S.AutoClickDuck then screenTap(MobileClick.Duck.x, MobileClick.Duck.y) end
		if S.AutoClickAction3 then screenTap(MobileClick.Act3.x, MobileClick.Act3.y) end
		if S.AutoClickAction4 then screenTap(MobileClick.Act4.x, MobileClick.Act4.y) end
		task.wait(0.12)
