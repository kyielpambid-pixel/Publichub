local function screenTap(nx, ny)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local vs = cam.ViewportSize
	local x = math.floor(vs.X * nx)
	local y = math.floor(vs.Y * ny)
	if VirtualInputManager then
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
		end)
	end
	-- also try clicking GuiButtons near that area
	pcall(function()
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if not pg then return end
		for _, gui in ipairs(pg:GetDescendants()) do
			if gui:IsA("GuiButton") and gui.Visible and gui.AbsoluteSize.X > 20 then
				local pos = gui.AbsolutePosition
				local size = gui.AbsoluteSize
				local cx = pos.X + size.X / 2
				local cy = pos.Y + size.Y / 2
				if math.abs(cx - x) < 80 and math.abs(cy - y) < 80 then
					pcall(function()
						if firesignal then
							firesignal(gui.MouseButton1Click)
						end
						gui:Activate()
					end)
				end
			end
		end
	end)
end

task.spawn(function()
